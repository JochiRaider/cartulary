* text=auto eol=lf

# If Windows scripts are ever added, keep them CRLF for compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Treat common binary artifacts explicitly.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.parquet binary
*.db binary
*.sqlite binary

# Original IR source bytes (including quoted CRLF) are immutable fixture inputs.
fixtures/ir-incident/v1/*.csv -text whitespace=cr-at-eol
fixtures/ir-incident/v1/*.tsv -text whitespace=cr-at-eol
fixtures/network-flow-orientation/v1/*.csv -text whitespace=cr-at-eol
fixtures/network-flow/NF-FIX-029-cisco-sna-flow-search/source/*.csv -text whitespace=cr-at-eol

# Signed reference-pack USTAR containers are immutable binary artifacts.
*.pack binary
