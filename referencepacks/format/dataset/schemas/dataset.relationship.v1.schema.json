{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.reference_pack.dataset.relationship.v1",
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "cartulary.reference_pack.dataset.relationship.v1"
    },
    "relationship_id": {
      "type": "string",
      "minLength": 1,
      "x-maxUtf8Bytes": 512
    },
    "relationship_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "source_object_id": {
      "type": "string",
      "minLength": 1,
      "x-maxUtf8Bytes": 512
    },
    "target_object_id": {
      "type": "string",
      "minLength": 1,
      "x-maxUtf8Bytes": 512
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "artifact_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "artifact_index",
          "locator"
        ],
        "additionalProperties": false
      },
      "x-limitId": "max_source_refs"
    },
    "data": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "schema_id",
    "relationship_id",
    "relationship_type",
    "source_object_id",
    "target_object_id",
    "source_refs",
    "data"
  ],
  "additionalProperties": false
}
