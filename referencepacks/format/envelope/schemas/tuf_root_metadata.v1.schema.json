{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.reference_pack_tuf_root_metadata.v1",
  "type": "object",
  "properties": {
    "signed": {
      "type": "object",
      "properties": {
        "_type": {
          "const": "root"
        },
        "spec_version": {
          "const": "1.0.35"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expires": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "consistent_snapshot": {
          "type": "boolean"
        },
        "keys": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "object",
            "properties": {
              "keytype": {
                "type": "string"
              },
              "scheme": {
                "type": "string"
              },
              "keyval": {
                "type": "object",
                "properties": {
                  "public": {
                    "type": "string"
                  }
                },
                "required": [
                  "public"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "keytype",
              "scheme",
              "keyval"
            ],
            "additionalProperties": false
          },
          "x-limitId": "max_root_keys"
        },
        "roles": {
          "type": "object",
          "properties": {
            "root": {
              "type": "object",
              "properties": {
                "keyids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 64
                },
                "threshold": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64
                }
              },
              "required": [
                "keyids",
                "threshold"
              ],
              "additionalProperties": false
            },
            "timestamp": {
              "type": "object",
              "properties": {
                "keyids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 64
                },
                "threshold": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64
                }
              },
              "required": [
                "keyids",
                "threshold"
              ],
              "additionalProperties": false
            },
            "snapshot": {
              "type": "object",
              "properties": {
                "keyids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 64
                },
                "threshold": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64
                }
              },
              "required": [
                "keyids",
                "threshold"
              ],
              "additionalProperties": false
            },
            "targets": {
              "type": "object",
              "properties": {
                "keyids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 64
                },
                "threshold": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64
                }
              },
              "required": [
                "keyids",
                "threshold"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "root",
            "timestamp",
            "snapshot",
            "targets"
          ],
          "additionalProperties": false
        },
        "cartulary": {
          "type": "object",
          "properties": {
            "schema_id": {
              "type": "string"
            },
            "trust_repository_id": {
              "type": "string"
            }
          },
          "required": [
            "schema_id",
            "trust_repository_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "_type",
        "spec_version",
        "version",
        "expires",
        "consistent_snapshot",
        "keys",
        "roles",
        "cartulary"
      ],
      "additionalProperties": true
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "tuf_signature.v1.schema.json"
      },
      "x-limitId": "max_root_update_signatures"
    }
  },
  "required": [
    "signed",
    "signatures"
  ],
  "additionalProperties": false
}
