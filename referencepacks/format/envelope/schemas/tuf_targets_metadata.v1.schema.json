{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.reference_pack_tuf_targets_metadata.v1",
  "type": "object",
  "properties": {
    "signed": {
      "type": "object",
      "properties": {
        "_type": {
          "const": "targets"
        },
        "spec_version": {
          "const": "1.0.35"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expires": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "targets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "tuf_target_descriptor.v1.schema.json"
          }
        },
        "delegations": {
          "not": {}
        },
        "cartulary": {
          "type": "object",
          "properties": {
            "schema_id": {
              "type": "string"
            },
            "trust_repository_id": {
              "type": "string"
            },
            "pack_key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,31}(\\.[a-z][a-z0-9_]{0,31}){1,7}$",
              "minLength": 3,
              "maxLength": 128
            },
            "pack_version": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
            },
            "pack_release_sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "payload_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "_type",
        "spec_version",
        "version",
        "expires",
        "targets"
      ],
      "additionalProperties": true
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "tuf_signature.v1.schema.json"
      },
      "x-limitId": "max_signatures"
    }
  },
  "required": [
    "signed",
    "signatures"
  ],
  "additionalProperties": false
}
