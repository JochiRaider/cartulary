{
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "cartulary.attack.native.relationship.candidate.v1"
    },
    "description": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        {
          "type": "null"
        }
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "artifact_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "artifact_index",
          "locator"
        ],
        "additionalProperties": false
      },
      "x-limitId": "max_source_refs"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false
    },
    "relationship_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 68,
      "pattern": "^rpr_[0-9a-f]{64}$"
    },
    "relationship_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "source_object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    },
    "target_object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    },
    "source": {
      "oneOf": [
        {
          "$ref": "#/$defs/sro"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_kind": {
      "enum": [
        "stix_sro",
        "embedded_reference"
      ]
    }
  },
  "required": [
    "schema_id",
    "description",
    "source_refs",
    "extensions",
    "relationship_id",
    "relationship_type",
    "source_object_id",
    "target_object_id",
    "source",
    "source_kind"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cartulary.invalid/proposals/attack-relationship.candidate.v1",
  "$defs": {
    "sro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "relationship_type",
        "source_ref",
        "target_ref"
      ],
      "properties": {
        "aliases": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 8192
          }
        },
        "created": {
          "type": "string",
          "maxLength": 8192,
          "format": "date-time"
        },
        "created_by_ref": {
          "type": "string",
          "maxLength": 8192,
          "pattern": "^[a-z][a-z0-9-]*--[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "description": {
          "type": "string",
          "maxLength": 8192
        },
        "external_references": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string",
                "maxLength": 8192
              },
              "external_id": {
                "type": "string",
                "maxLength": 8192
              },
              "source_name": {
                "type": "string",
                "maxLength": 8192
              },
              "url": {
                "type": "string",
                "maxLength": 8192
              }
            },
            "required": [
              "source_name"
            ]
          }
        },
        "id": {
          "type": "string",
          "maxLength": 8192,
          "pattern": "^relationship--[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "labels": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 8192
          }
        },
        "modified": {
          "type": "string",
          "maxLength": 8192,
          "format": "date-time"
        },
        "name": {
          "type": "string",
          "maxLength": 8192
        },
        "object_marking_refs": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 8192,
            "pattern": "^[a-z][a-z0-9-]*--[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "relationship_type": {
          "type": "string",
          "maxLength": 8192,
          "enum": [
            "attributed-to",
            "detects",
            "mitigates",
            "revoked-by",
            "subtechnique-of",
            "targets",
            "uses"
          ]
        },
        "revoked": {
          "type": "boolean"
        },
        "source_ref": {
          "type": "string",
          "maxLength": 8192,
          "pattern": "^[a-z][a-z0-9-]*--[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "spec_version": {
          "type": "string",
          "maxLength": 8192
        },
        "target_ref": {
          "type": "string",
          "maxLength": 8192,
          "pattern": "^[a-z][a-z0-9-]*--[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "type": {
          "const": "relationship"
        },
        "x_mitre_aliases": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 8192
          }
        },
        "x_mitre_attack_spec_version": {
          "type": "string",
          "maxLength": 8192
        },
        "x_mitre_contributors": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 8192
          }
        },
        "x_mitre_deprecated": {
          "type": "boolean"
        },
        "x_mitre_domains": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 8192
          }
        },
        "x_mitre_modified_by_ref": {
          "type": "string",
          "maxLength": 8192,
          "pattern": "^[a-z][a-z0-9-]*--[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "x_mitre_version": {
          "type": "string",
          "maxLength": 8192
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_kind": {
            "const": "stix_sro"
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "$ref": "#/$defs/sro"
          }
        }
      },
      "else": {
        "properties": {
          "source": {
            "type": "null"
          }
        }
      }
    }
  ]
}
