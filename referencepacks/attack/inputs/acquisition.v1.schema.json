{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cartulary.invalid/producers/attack-acquisition.v1",
  "$comment": "Producer-only acquisition receipt shape. The typed checker additionally enforces source-lock membership, exact paths, lengths, hashes and release/tag/ref identities. Not a runtime pack or trust attestation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "source_lock_sha256",
    "release_metadata",
    "tag_metadata",
    "tag_reference",
    "sources"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.attack_acquisition.v1"
    },
    "source_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "release_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        }
      }
    },
    "tag_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        }
      }
    },
    "tag_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 134217728
          }
        }
      }
    }
  }
}
