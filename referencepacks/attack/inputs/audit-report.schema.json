{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.attack_source_audit.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "source_lock_sha256",
    "source_profile_sha256",
    "builder",
    "source_profile_id",
    "status",
    "built_at",
    "field_policy_sha256",
    "domains",
    "unique_records",
    "unique_types",
    "cross_domain_duplicate_ids",
    "properties",
    "record_locators",
    "alias_collisions",
    "lookup_aliases",
    "tactic_memberships",
    "alias_occurrences",
    "max_aliases_per_object",
    "max_external_refs_per_record",
    "citations_without_external_id",
    "urls_with_fragments",
    "non_https_urls",
    "source_version_values",
    "lifecycle_flags",
    "embedded_reference_counts",
    "embedded_references",
    "max_canonical_source_record_bytes",
    "issues"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.attack_source_audit.v2"
    },
    "source_lock_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "source_profile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builder_id",
        "builder_version",
        "builder_source_sha256",
        "size_bytes",
        "go_version"
      ],
      "properties": {
        "builder_id": {
          "type": "string",
          "minLength": 1
        },
        "builder_version": {
          "type": "string",
          "minLength": 1
        },
        "builder_source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "go_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "source_audit_passed",
        "source_audit_failed"
      ]
    },
    "built_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "field_policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "domains": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "records",
          "types",
          "sro_types",
          "max_description_scalars",
          "descriptions_over_8192",
          "active_subtechniques",
          "retired_sros",
          "collection_id",
          "collection_modified"
        ],
        "properties": {
          "records": {
            "type": "integer",
            "minimum": 0
          },
          "types": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "sro_types": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "max_description_scalars": {
            "type": "integer",
            "minimum": 0
          },
          "descriptions_over_8192": {
            "type": "integer",
            "minimum": 0
          },
          "active_subtechniques": {
            "type": "integer",
            "minimum": 0
          },
          "retired_sros": {
            "type": "integer",
            "minimum": 0
          },
          "collection_id": {
            "type": "string"
          },
          "collection_modified": {
            "type": "string"
          }
        }
      }
    },
    "unique_records": {
      "type": "integer",
      "minimum": 0
    },
    "unique_types": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "cross_domain_duplicate_ids": {
      "type": "integer",
      "minimum": 0
    },
    "properties": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "count",
          "kinds",
          "max_scalars",
          "max_array_length",
          "non_nfc",
          "outer_whitespace",
          "control_strings",
          "disposition",
          "target",
          "reason",
          "example"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "kinds": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "max_scalars": {
            "type": "integer",
            "minimum": 0
          },
          "max_array_length": {
            "type": "integer",
            "minimum": 0
          },
          "non_nfc": {
            "type": "integer",
            "minimum": 0
          },
          "outer_whitespace": {
            "type": "integer",
            "minimum": 0
          },
          "control_strings": {
            "type": "integer",
            "minimum": 0
          },
          "disposition": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "example": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact",
              "pointer"
            ],
            "properties": {
              "artifact": {
                "type": "string",
                "minLength": 1
              },
              "pointer": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "record_locators": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact",
            "pointer"
          ],
          "properties": {
            "artifact": {
              "type": "string",
              "minLength": 1
            },
            "pointer": {
              "type": "string"
            }
          }
        }
      }
    },
    "alias_collisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "normalized_alias",
          "object_ids",
          "original_aliases"
        ],
        "properties": {
          "normalized_alias": {
            "type": "string"
          },
          "object_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "original_aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "lookup_aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "tactic_memberships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "target_id",
          "property",
          "locator"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "property": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact",
              "pointer"
            ],
            "properties": {
              "artifact": {
                "type": "string",
                "minLength": 1
              },
              "pointer": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "alias_occurrences": {
      "type": "integer",
      "minimum": 0
    },
    "max_aliases_per_object": {
      "type": "integer",
      "minimum": 0
    },
    "max_external_refs_per_record": {
      "type": "integer",
      "minimum": 0
    },
    "citations_without_external_id": {
      "type": "integer",
      "minimum": 0
    },
    "urls_with_fragments": {
      "type": "integer",
      "minimum": 0
    },
    "non_https_urls": {
      "type": "integer",
      "minimum": 0
    },
    "source_version_values": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "lifecycle_flags": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "embedded_reference_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "embedded_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "target_id",
          "property",
          "locator"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "property": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact",
              "pointer"
            ],
            "properties": {
              "artifact": {
                "type": "string",
                "minLength": 1
              },
              "pointer": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "max_canonical_source_record_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
