{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.graph_projection_schemas.v2",
  "title": "Graph Projection v2 schemas",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f-\\u009f\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](?:[^/\\\\\\u0000-\\u001f\\u007f-\\u009f]*[^/\\\\\\u0000-\\u001f\\u007f-\\u009f\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])?(?![\\s\\S])"
    },
    "OutputLabels": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "ObjectSortKey": {"type": "string", "pattern": "^sk_[0-9a-f]{64}(?![\\s\\S])"},
    "SHA256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "PropertyScalar": {
      "type": ["null", "boolean", "integer", "number", "string"]
    },
    "PropertyValue": {
      "oneOf": [
        { "$ref": "#/$defs/PropertyScalar" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/PropertyScalar" },
          "maxItems": 100000
        }
      ]
    },
    "PropertyMap": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/PropertyKey" },
      "additionalProperties": { "$ref": "#/$defs/PropertyValue" }
    },
    "FieldPath": {
      "type": "string", "minLength": 1, "maxLength": 511,
      "description": "One built-in or one literal map terminal. Semantic admission checks scope, decoded identifier and UTF-8 byte bounds.",
      "anyOf": [
        {"enum": ["source_entity_id", "source_entity_kind", "source_relationship_id", "source_relationship_kind", "src_source_entity_id", "dst_source_entity_id", "direction", "projected.vertex_id", "projected.edge_id", "projected.src_vertex_id", "projected.dst_vertex_id", "projected.direction"]},
        {"pattern": "^(?:properties|metadata|source_metadata|projected\\.(?:properties|metadata))\\.(?!\\*(?![\\s\\S]))[^./\\\\\\u0000-\\u001f\\u007f-\\u009f]{1,255}(?![\\s\\S])"},
        {"pattern": "^(?:properties|metadata|source_metadata|projected\\.(?:properties|metadata))\\[\"(?=(?:[^\"\\\\]|\\\\\")*\\.)(?:[^\"/\\\\\\u0000-\\u001f\\u007f-\\u009f]|\\\\\"){1,255}\"\\](?![\\s\\S])"}
      ]
    },
    "Filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_path", "operator", "include_if_missing"],
      "properties": {
        "field_path": { "$ref": "#/$defs/FieldPath" },
        "operator": { "enum": ["exists", "equals", "not_equals", "in"] },
        "value": { "$ref": "#/$defs/PropertyValue" },
        "include_if_missing": { "type": "boolean" }
      }
    },
    "Filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_filters", "relationship_filters", "logic"],
      "properties": {
        "entity_filters": { "type": "array", "items": { "$ref": "#/$defs/Filter" } },
        "relationship_filters": { "type": "array", "items": { "$ref": "#/$defs/Filter" } },
        "logic": { "const": "and" }
      }
    },
    "SourceEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_entity_id", "source_entity_kind", "properties", "metadata", "labels"],
      "properties": {
        "source_entity_id": { "$ref": "#/$defs/Identifier" },
        "source_entity_kind": { "$ref": "#/$defs/Identifier" },
        "properties": { "$ref": "#/$defs/PropertyMap" },
        "metadata": { "type": "object" },
        "labels": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "SourceRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_relationship_id", "source_relationship_kind", "src_source_entity_id", "dst_source_entity_id", "direction", "properties", "metadata", "labels"],
      "properties": {
        "source_relationship_id": { "$ref": "#/$defs/Identifier" },
        "source_relationship_kind": { "$ref": "#/$defs/Identifier" },
        "src_source_entity_id": { "$ref": "#/$defs/Identifier" },
        "dst_source_entity_id": { "$ref": "#/$defs/Identifier" },
        "direction": { "enum": ["forward", "reverse", "undirected", "bidirectional"] },
        "properties": { "$ref": "#/$defs/PropertyMap" },
        "metadata": { "type": "object" },
        "labels": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "EntityMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping_rule_id", "source_entity_kind", "projected_vertex_kind", "inclusion_predicate", "label_policy", "mapping_labels", "required_property_keys", "optional_property_keys"],
      "properties": {
        "mapping_rule_id": { "$ref": "#/$defs/Identifier" },
        "source_entity_kind": { "$ref": "#/$defs/Identifier" },
        "projected_vertex_kind": { "$ref": "#/$defs/Identifier" },
        "inclusion_predicate": { "oneOf": [{ "const": "always" }, { "$ref": "#/$defs/Filter" }] },
        "label_policy": { "enum": ["mapping_only", "preserve_source", "mapping_then_source"] },
        "mapping_labels": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "required_property_keys": { "type": "array", "items": { "$ref": "#/$defs/PropertyKey" }, "uniqueItems": true },
        "optional_property_keys": { "type": "array", "items": { "$ref": "#/$defs/PropertyKey" }, "uniqueItems": true }
      }
    },
    "RelationshipMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping_rule_id", "source_relationship_kind", "projected_edge_kind", "inclusion_predicate", "label_policy", "mapping_labels", "required_property_keys", "optional_property_keys", "direction_policy", "emit_reverse_edge"],
      "properties": {
        "mapping_rule_id": { "$ref": "#/$defs/Identifier" },
        "source_relationship_kind": { "$ref": "#/$defs/Identifier" },
        "projected_edge_kind": { "$ref": "#/$defs/Identifier" },
        "inclusion_predicate": { "oneOf": [{ "const": "always" }, { "$ref": "#/$defs/Filter" }] },
        "label_policy": { "enum": ["mapping_only", "preserve_source", "mapping_then_source"] },
        "mapping_labels": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "required_property_keys": { "type": "array", "items": { "$ref": "#/$defs/PropertyKey" }, "uniqueItems": true },
        "optional_property_keys": { "type": "array", "items": { "$ref": "#/$defs/PropertyKey" }, "uniqueItems": true },
        "direction_policy": { "enum": ["preserve", "normalize_forward", "normalize_reverse", "undirected", "bidirectional"] },
        "emit_reverse_edge": { "type": "boolean" },
        "reverse_edge_kind": { "$ref": "#/$defs/Identifier" }
      },
      "if": {"properties": {"emit_reverse_edge": {"const": true}}},
      "then": {"required": ["reverse_edge_kind"]},
      "else": {"not": {"required": ["reverse_edge_kind"]}}
    },
    "PropertyDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property_definition_id", "target_scope", "target_kind", "source_field_path", "projected_key", "projected_type", "required", "missing_behavior", "source_null_behavior", "null_output_policy", "merge_behavior"],
      "properties": {
        "property_definition_id": { "$ref": "#/$defs/Identifier" },
        "target_scope": {"enum": ["vertex", "edge"]},
        "target_kind": { "$ref": "#/$defs/Identifier" },
        "source_field_path": { "$ref": "#/$defs/FieldPath", "not": { "pattern": "^(metadata|source_metadata|projected[.]metadata)" } },
        "projected_key": { "$ref": "#/$defs/PropertyKey" },
        "projected_type": {"$ref": "#/$defs/ProjectedType"},
        "required": { "type": "boolean" },
        "default_value": { "$ref": "#/$defs/PropertyValue" },
        "missing_behavior": {"$ref": "#/$defs/MissingBehavior"},
        "source_null_behavior": {"$ref": "#/$defs/SourceNullBehavior"},
        "null_output_policy": { "enum": ["omit", "emit_null"] },
        "merge_behavior": { "enum": ["single_value", "first", "last", "min", "max", "sum", "count", "set", "ordered_list"] }
      }
    },
    "MetadataMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata_mapping_id", "target_scope", "target_kind", "source_field_path", "projected_metadata_key", "projected_type", "required", "missing_behavior", "source_null_behavior", "null_output_policy", "merge_behavior"],
      "properties": {
        "metadata_mapping_id": { "$ref": "#/$defs/Identifier" },
        "target_scope": {"$ref": "#/$defs/TargetScope"},
        "target_kind": { "$ref": "#/$defs/Identifier" },
        "source_field_path": { "$ref": "#/$defs/FieldPath" },
        "projected_metadata_key": { "$ref": "#/$defs/MappedMetadataKey" },
        "projected_type": {"$ref": "#/$defs/ProjectedType"},
        "required": { "type": "boolean" },
        "default_value": { "$ref": "#/$defs/PropertyValue" },
        "missing_behavior": {"$ref": "#/$defs/MissingBehavior"},
        "source_null_behavior": {"$ref": "#/$defs/SourceNullBehavior"},
        "null_output_policy": { "enum": ["omit", "emit_null"] },
        "merge_behavior": { "enum": ["single_value", "first", "last", "min", "max", "sum", "count", "set", "ordered_list"] }
      }
    },
    "EndpointGrouping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src_vertex_aggregation_rule_id", "src_grouping_keys", "dst_vertex_aggregation_rule_id", "dst_grouping_keys", "missing_endpoint_behavior"],
      "properties": {
        "src_vertex_aggregation_rule_id": { "$ref": "#/$defs/Identifier" },
        "src_grouping_keys": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/FieldPath" } },
        "dst_vertex_aggregation_rule_id": { "$ref": "#/$defs/Identifier" },
        "dst_grouping_keys": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/FieldPath" } },
        "missing_endpoint_behavior": { "enum": ["error", "exclude"] }
      }
    },
    "AggregationRule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["aggregation_rule_id", "target_scope", "input_scope", "input_kind", "projected_kind", "grouping_keys", "missing_grouping_key_behavior", "property_merge_behavior"],
          "properties": {
            "aggregation_rule_id": { "$ref": "#/$defs/Identifier" },
            "target_scope": { "const": "vertex" },
            "input_scope": { "enum": ["source_entity", "projected_vertex"] },
            "input_kind": { "$ref": "#/$defs/Identifier" },
            "projected_kind": { "$ref": "#/$defs/Identifier" },
            "grouping_keys": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/FieldPath" } },
            "missing_grouping_key_behavior": { "enum": ["error", "exclude", "use_null"] },
            "property_merge_behavior": { "type": "object", "propertyNames": {"$ref": "#/$defs/PropertyKey"}, "additionalProperties": { "enum": ["single_value", "first", "last", "min", "max", "sum", "count", "set", "ordered_list"] } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["aggregation_rule_id", "target_scope", "input_scope", "input_kind", "projected_kind", "grouping_keys", "missing_grouping_key_behavior", "property_merge_behavior", "edge_direction", "endpoint_grouping"],
          "properties": {
            "aggregation_rule_id": { "$ref": "#/$defs/Identifier" },
            "target_scope": { "const": "edge" },
            "input_scope": { "enum": ["source_relationship", "projected_edge"] },
            "input_kind": { "$ref": "#/$defs/Identifier" },
            "projected_kind": { "$ref": "#/$defs/Identifier" },
            "grouping_keys": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/FieldPath" } },
            "missing_grouping_key_behavior": { "enum": ["error", "exclude", "use_null"] },
            "property_merge_behavior": { "type": "object", "propertyNames": {"$ref": "#/$defs/PropertyKey"}, "additionalProperties": { "enum": ["single_value", "first", "last", "min", "max", "sum", "count", "set", "ordered_list"] } },
            "edge_direction": { "enum": ["directed", "undirected", "bidirectional"] },
            "endpoint_grouping": { "$ref": "#/$defs/EndpointGrouping" }
          }
        }
      ]
    },
    "ProjectionConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection_version", "declared_source_entity_kinds", "declared_source_relationship_kinds", "entity_mappings", "relationship_mappings", "metadata_mappings", "aggregation_rules", "default_vertex_labels", "default_edge_labels", "allow_empty_kind_registry"],
      "properties": {
        "projection_version": { "$ref": "#/$defs/Identifier" },
        "declared_source_entity_kinds": { "type": "array", "items": { "$ref": "#/$defs/Identifier" }, "uniqueItems": true },
        "declared_source_relationship_kinds": { "type": "array", "items": { "$ref": "#/$defs/Identifier" }, "uniqueItems": true },
        "entity_mappings": { "type": "array", "items": { "$ref": "#/$defs/EntityMapping" } },
        "relationship_mappings": { "type": "array", "items": { "$ref": "#/$defs/RelationshipMapping" } },
        "metadata_mappings": { "type": "array", "items": { "$ref": "#/$defs/MetadataMapping" } },
        "aggregation_rules": { "type": "array", "items": { "$ref": "#/$defs/AggregationRule" } },
        "default_vertex_labels": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "default_edge_labels": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "allow_empty_kind_registry": { "type": "boolean" }
      }
    },
    "SemanticInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection_schema_id", "source_snapshot_id", "projection_config", "source_entities", "source_relationships", "source_metadata", "filters", "property_definitions"],
      "properties": {
        "projection_schema_id": { "const": "graph_projection.v2" },
        "source_snapshot_id": { "$ref": "#/$defs/Identifier" },
        "projection_config": { "$ref": "#/$defs/ProjectionConfig" },
        "source_entities": { "type": "array", "items": { "$ref": "#/$defs/SourceEntity" }, "maxItems": 100000 },
        "source_relationships": { "type": "array", "items": { "$ref": "#/$defs/SourceRelationship" }, "maxItems": 250000 },
        "source_metadata": { "type": "object" },
        "filters": { "$ref": "#/$defs/Filters" },
        "property_definitions": { "type": "array", "items": { "$ref": "#/$defs/PropertyDefinition" } }
      }
    },
    "SourceEntityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_entity_id", "source_entity_kind", "mapping_rule_id"],
      "properties": {
        "source_entity_id": { "$ref": "#/$defs/Identifier" },
        "source_entity_kind": { "$ref": "#/$defs/Identifier" },
        "mapping_rule_id": { "$ref": "#/$defs/Identifier" }
      }
    },
    "SourceRelationshipRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_relationship_id", "source_relationship_kind", "mapping_rule_id"],
      "properties": {
        "source_relationship_id": { "$ref": "#/$defs/Identifier" },
        "source_relationship_kind": { "$ref": "#/$defs/Identifier" },
        "mapping_rule_id": { "$ref": "#/$defs/Identifier" }
      }
    },
    "RegistryIdentifiers": {
      "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Identifier" }
    },
    "ProjectedType": {
      "enum": ["boolean", "integer", "number", "string", "timestamp", "identifier", "boolean_array", "integer_array", "number_array", "string_array", "timestamp_array", "identifier_array"]
    },
    "MissingBehavior": {
      "enum": ["error", "omit", "default"]
    },
    "SourceNullBehavior": {
      "enum": ["error", "omit", "emit_null", "default"]
    },
    "TargetScope": {
      "enum": ["vertex", "edge", "graph_view"]
    },
    "PropertyKey": {
      "allOf": [{"$ref": "#/$defs/Identifier"}, {"not": {"const": "*"}}]
    },
    "MappedMetadataKey": {
      "allOf": [{"$ref": "#/$defs/PropertyKey"}, {"not": {"enum": ["mapping_rule_id", "aggregation_rule_id", "aggregation_source_refs", "is_reverse_edge", "reverse_of_edge_id", "mapped_metadata", "projection_result_id", "normalized_configuration_sha256", "normalized_source_sha256", "canonical_output_sha256"]}}]
    },
    "MappedMetadata": {
      "allOf": [{"$ref": "#/$defs/PropertyMap"}, {"propertyNames": {"$ref": "#/$defs/MappedMetadataKey"}}]
    },
    "RegistryPropertyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projected_key", "projected_type", "required", "nullable_output"],
      "properties": {
        "projected_key": {"$ref": "#/$defs/PropertyKey"},
        "projected_type": {"$ref": "#/$defs/ProjectedType"},
        "required": {"type": "boolean"},
        "nullable_output": {"type": "boolean"}
      }
    },
    "RegistryVertexKind": {
      "if": {"properties": {"source_entity_kinds": {"maxItems": 0}}},
      "then": {"properties": {"source_labels_preserved": {"const": false}}},
      "anyOf": [
        {"properties": {"source_entity_kinds": {"minItems": 1}}},
        {"properties": {"aggregation_rule_ids": {"minItems": 1}}}
      ],
      "type": "object",
      "additionalProperties": false,
      "required": ["vertex_kind", "source_entity_kinds", "aggregation_rule_ids", "labels", "source_labels_preserved", "properties"],
      "properties": {
        "vertex_kind": {"$ref": "#/$defs/Identifier"},
        "source_entity_kinds": {"$ref": "#/$defs/RegistryIdentifiers"},
        "aggregation_rule_ids": {"$ref": "#/$defs/RegistryIdentifiers"},
        "labels": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}, "uniqueItems": true},
        "source_labels_preserved": {"type": "boolean"},
        "properties": {"type": "array", "items": {"$ref": "#/$defs/RegistryPropertyRef"}}
      }
    },
    "RegistryEdgeKind": {
      "if": {"properties": {"source_relationship_kinds": {"maxItems": 0}}},
      "then": {"properties": {"source_labels_preserved": {"const": false}}},
      "anyOf": [
        {"properties": {"source_relationship_kinds": {"minItems": 1}}},
        {"properties": {"aggregation_rule_ids": {"minItems": 1}}}
      ],
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_kind", "source_relationship_kinds", "aggregation_rule_ids", "labels", "source_labels_preserved", "properties", "directions"],
      "properties": {
        "edge_kind": {"$ref": "#/$defs/Identifier"},
        "source_relationship_kinds": {"$ref": "#/$defs/RegistryIdentifiers"},
        "aggregation_rule_ids": {"$ref": "#/$defs/RegistryIdentifiers"},
        "labels": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}, "uniqueItems": true},
        "source_labels_preserved": {"type": "boolean"},
        "properties": {"type": "array", "items": {"$ref": "#/$defs/RegistryPropertyRef"}},
        "directions": {"type": "array", "minItems": 1, "items": {"enum": ["directed", "undirected", "bidirectional"]}, "uniqueItems": true}
      }
    },
    "RegistryPropertyDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_scope", "target_kind", "projected_key", "projected_type", "required", "nullable_output", "missing_behavior", "source_null_behavior"],
      "properties": {
        "target_scope": {"enum": ["vertex", "edge"]},
        "target_kind": {"$ref": "#/$defs/Identifier"},
        "projected_key": {"$ref": "#/$defs/PropertyKey"},
        "projected_type": {"$ref": "#/$defs/ProjectedType"},
        "required": {"type": "boolean"},
        "nullable_output": {"type": "boolean"},
        "missing_behavior": {"$ref": "#/$defs/MissingBehavior"},
        "source_null_behavior": {"$ref": "#/$defs/SourceNullBehavior"}
      },
      "if": {"properties": {"source_null_behavior": {"const": "emit_null"}}},
      "then": {"properties": {"nullable_output": {"const": true}}}
    },
    "RegistryMetadataDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_scope", "target_kind", "projected_metadata_key", "projected_type", "required", "nullable_output", "missing_behavior", "source_null_behavior"],
      "properties": {
        "target_scope": {"$ref": "#/$defs/TargetScope"},
        "target_kind": {"$ref": "#/$defs/Identifier"},
        "projected_metadata_key": {"$ref": "#/$defs/MappedMetadataKey"},
        "projected_type": {"$ref": "#/$defs/ProjectedType"},
        "required": {"type": "boolean"},
        "nullable_output": {"type": "boolean"},
        "missing_behavior": {"$ref": "#/$defs/MissingBehavior"},
        "source_null_behavior": {"$ref": "#/$defs/SourceNullBehavior"}
      },
      "if": {"properties": {"source_null_behavior": {"const": "emit_null"}}},
      "then": {"properties": {"nullable_output": {"const": true}}}
    },
    "ResultRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vertex_kinds", "edge_kinds", "property_keys", "metadata_keys"],
      "properties": {
        "vertex_kinds": {"type": "array", "items": {"$ref": "#/$defs/RegistryVertexKind"}},
        "edge_kinds": {"type": "array", "items": {"$ref": "#/$defs/RegistryEdgeKind"}},
        "property_keys": {"type": "array", "items": {"$ref": "#/$defs/RegistryPropertyDeclaration"}},
        "metadata_keys": {"type": "array", "items": {"$ref": "#/$defs/RegistryMetadataDeclaration"}}
      }
    },
    "ContributorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_kind", "ref_id", "ref_kind_name", "contributor_sort_key"],
      "properties": {
        "ref_kind": { "enum": ["source_entity", "source_relationship", "projected_vertex", "projected_edge"] },
        "ref_id": { "$ref": "#/$defs/Identifier" },
        "ref_kind_name": { "$ref": "#/$defs/Identifier" },
        "contributor_sort_key": { "type": "string" }
      },
      "if": { "properties": { "ref_kind": { "enum": ["source_entity", "source_relationship"] } } },
      "then": { "properties": { "contributor_sort_key": { "pattern": "^csk_([0-9a-f]{2})+[.]([0-9a-f]{2})+[.][.](?![\\s\\S])" } } },
      "else": { "properties": { "contributor_sort_key": { "pattern": "^csk_(([0-9a-f]{2})+[.]){3}([0-9a-f]{2})+(?![\\s\\S])" } } },
      "allOf": [
        { "if": { "properties": { "ref_kind": { "const": "projected_vertex" } } }, "then": { "properties": { "ref_id": { "pattern": "^vx_[0-9a-f]{64}$" } } } },
        { "if": { "properties": { "ref_kind": { "const": "projected_edge" } } }, "then": { "properties": { "ref_id": { "pattern": "^ed_[0-9a-f]{64}$" } } } }
      ]
    },
    "ProvenanceMetadata": {
      "type": "object",
      "required": ["mapping_rule_id", "aggregation_rule_id", "aggregation_source_refs", "mapped_metadata"],
      "properties": {
        "mapping_rule_id": { "type": ["string", "null"] },
        "aggregation_rule_id": { "type": ["string", "null"] },
        "aggregation_source_refs": { "type": "array", "items": { "$ref": "#/$defs/ContributorRef" } },
        "mapped_metadata": { "$ref": "#/$defs/MappedMetadata" }
      }
    },
    "MappedProvenance": {
      "properties": {
        "mapping_rule_id": { "$ref": "#/$defs/Identifier" },
        "aggregation_rule_id": { "type": "null" },
        "aggregation_source_refs": { "maxItems": 0 }
      }
    },
    "AggregateProvenance": {
      "properties": {
        "mapping_rule_id": { "type": "null" },
        "aggregation_rule_id": { "$ref": "#/$defs/Identifier" },
        "aggregation_source_refs": { "minItems": 1 }
      }
    },
    "Vertex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vertex_id", "vertex_kind", "vertex_family", "labels", "properties", "metadata", "source_entity_ref", "sort_key"],
      "properties": {
        "vertex_id": { "type": "string", "pattern": "^vx_[0-9a-f]{64}$" },
        "vertex_kind": { "$ref": "#/$defs/Identifier" },
        "vertex_family": { "enum": ["direct", "aggregated"] },
        "labels": { "$ref": "#/$defs/OutputLabels" },
        "properties": { "$ref": "#/$defs/PropertyMap" },
        "metadata": { "$ref": "#/$defs/ProvenanceMetadata", "unevaluatedProperties": false },
        "source_entity_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/SourceEntityRef" }] },
        "sort_key": { "$ref": "#/$defs/ObjectSortKey" }
      },
      "if": { "properties": { "vertex_family": { "const": "aggregated" } } },
      "then": { "properties": { "source_entity_ref": { "type": "null" }, "metadata": { "$ref": "#/$defs/AggregateProvenance" } } },
      "else": { "properties": { "source_entity_ref": { "$ref": "#/$defs/SourceEntityRef" }, "metadata": { "$ref": "#/$defs/MappedProvenance" } } }
    },
    "Edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "edge_kind", "edge_family", "src_vertex_id", "dst_vertex_id", "direction", "labels", "properties", "metadata", "source_relationship_ref", "sort_key"],
      "properties": {
        "edge_id": { "type": "string", "pattern": "^ed_[0-9a-f]{64}$" },
        "edge_kind": { "$ref": "#/$defs/Identifier" },
        "edge_family": { "enum": ["direct", "reverse", "aggregated"] },
        "src_vertex_id": { "type": "string", "pattern": "^vx_[0-9a-f]{64}$" },
        "dst_vertex_id": { "type": "string", "pattern": "^vx_[0-9a-f]{64}$" },
        "direction": { "enum": ["directed", "undirected", "bidirectional"] },
        "labels": { "$ref": "#/$defs/OutputLabels" },
        "properties": { "$ref": "#/$defs/PropertyMap" },
        "metadata": {
          "$ref": "#/$defs/ProvenanceMetadata",
          "unevaluatedProperties": false,
          "required": ["is_reverse_edge", "reverse_of_edge_id"],
          "properties": {
            "is_reverse_edge": { "type": "boolean" },
            "reverse_of_edge_id": { "type": ["string", "null"], "pattern": "^ed_[0-9a-f]{64}$" }
          }
        },
        "source_relationship_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/SourceRelationshipRef" }] },
        "sort_key": { "$ref": "#/$defs/ObjectSortKey" }
      },
      "allOf": [{
        "if": { "properties": { "edge_family": { "const": "aggregated" } } },
        "then": { "properties": { "source_relationship_ref": { "type": "null" }, "metadata": { "$ref": "#/$defs/AggregateProvenance" } } },
        "else": { "properties": { "source_relationship_ref": { "$ref": "#/$defs/SourceRelationshipRef" }, "metadata": { "$ref": "#/$defs/MappedProvenance" } } }
      }],
      "if": { "properties": { "edge_family": { "const": "reverse" } } },
      "then": {
        "properties": {
          "direction": { "const": "directed" },
          "metadata": {
            "properties": {
              "is_reverse_edge": { "const": true },
              "reverse_of_edge_id": { "type": "string" }
            }
          }
        }
      },
      "else": {
        "properties": {
          "metadata": {
            "properties": {
              "is_reverse_edge": { "const": false },
              "reverse_of_edge_id": { "type": "null" }
            }
          }
        }
      }
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection_schema_id", "projection_result_id", "graph_view_id", "source_owner_id", "source_snapshot_id", "projection_version", "normalized_configuration_sha256", "normalized_source_sha256", "canonical_output_sha256", "mapped_metadata", "schema_registry", "vertices", "edges", "validation_summary", "consumer_capabilities"],
      "properties": {
        "projection_schema_id": { "const": "graph_projection.v2" },
        "projection_result_id": { "type": "string", "pattern": "^gpres_[0-9a-f]{64}$" },
        "graph_view_id": { "$ref": "#/$defs/Identifier" },
        "source_owner_id": { "$ref": "#/$defs/Identifier" },
        "source_snapshot_id": { "$ref": "#/$defs/Identifier" },
        "projection_version": { "$ref": "#/$defs/Identifier" },
        "normalized_configuration_sha256": { "$ref": "#/$defs/SHA256" },
        "normalized_source_sha256": { "$ref": "#/$defs/SHA256" },
        "canonical_output_sha256": { "$ref": "#/$defs/SHA256" },
        "mapped_metadata": { "$ref": "#/$defs/MappedMetadata" },
        "schema_registry": { "$ref": "#/$defs/ResultRegistry" },
        "vertices": { "type": "array", "items": { "$ref": "#/$defs/Vertex" }, "maxItems": 100000 },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/Edge" }, "maxItems": 250000 },
        "validation_summary": { "type": "object" },
        "consumer_capabilities": { "type": "object" }
      }
    }
  }
}
