      "values": [
        [
          "a\"b"
        ]
      ]
    },
    {
      "id": "cr-records",
      "format": "tsv",
      "text": "a\rb",
      "values": [
        [
          "a"
        ],
        [
          "b"
        ]
      ]
    },
    {
      "id": "ragged",
      "format": "tsv",
      "text": "a\tb\nc",
      "error": "ragged_rows"
    },
    {
      "id": "blank-in-rectangle",
      "format": "tsv",
      "text": "a\tb\n\nc\td",
      "error": "ragged_rows"
    },
    {
      "id": "unclosed",
      "format": "csv",
      "text": "\"a,b",
