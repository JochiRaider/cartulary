{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.entities_identifier_unicode.v1.schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "normalizer_id",
    "unicode_version",
    "source_url",
    "source_sha256",
    "assigned_ranges",
    "combining_classes",
    "lowercase",
    "sid_uppercase",
    "identifier_rejected_ranges",
    "whitespace_ranges"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.entities_identifier_unicode.v1"
    },
    "normalizer_id": {
      "const": "entities.identifier_normalization.v1"
    },
    "unicode_version": {
      "const": "16.0.0"
    },
    "source_url": {
      "const": "https://www.unicode.org/Public/16.0.0/ucd/UnicodeData.txt"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assigned_ranges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1114111
        }
      }
    },
    "combining_classes": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        }
      },
      "additionalProperties": false
    },
    "lowercase": {
      "$ref": "#/$defs/caseMap"
    },
    "sid_uppercase": {
      "$ref": "#/$defs/caseMap"
    },
    "identifier_rejected_ranges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1114111
        }
      }
    },
    "whitespace_ranges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1114111
        }
      }
    }
  },
  "$defs": {
    "caseMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
