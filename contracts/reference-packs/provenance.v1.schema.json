{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.reference_pack_provenance.v1",
  "type": "object",
  "properties": {
    "pack_set_id": {
      "type": "string",
      "pattern": "^rpset_[0-9a-f]{64}$"
    },
    "pack_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}(\\.[a-z][a-z0-9_]{0,31}){1,7}$",
      "minLength": 3,
      "maxLength": 128
    },
    "pack_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pack_contract_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,192}$"
    },
    "content_profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,192}$"
    },
    "content_profile_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,192}$"
    },
    "authority_class": {
      "enum": [
        "registry",
        "framework_reference",
        "advisory_enrichment"
      ]
    },
    "source_profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,192}$"
    },
    "source_profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_as_of": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "source_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "source_ref",
          "source_version",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    },
    "license": {
      "type": "object",
      "properties": {
        "expression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "license_list_version": {
          "const": "3.28.0"
        },
        "redistribution": {
          "enum": [
            "allowed",
            "restricted",
            "prohibited"
          ]
        },
        "notice_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 0,
          "maxItems": 64
        },
        "license_ref_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "license_ref": {
                "type": "string",
                "pattern": "^LicenseRef-[A-Za-z0-9.-]+$"
              },
              "notice_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "license_ref",
              "notice_path"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 64
        }
      },
      "required": [
        "expression",
        "license_list_version",
        "redistribution",
        "notice_paths",
        "license_ref_bindings"
      ],
      "additionalProperties": false
    },
    "verification_method": {
      "enum": [
        "packaged_release_manifest_v1",
        "tuf_1_0_35_offline_bundle_v1"
      ]
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "trust_valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "verified_signer_key_ids": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "required": [
    "pack_set_id",
    "pack_key",
    "pack_version",
    "manifest_sha256",
    "payload_sha256",
    "pack_contract_version",
    "content_profile_id",
    "content_profile_version",
    "authority_class",
    "source_profile_id",
    "source_profile_sha256",
    "source_identifier",
    "source_version",
    "source_as_of",
    "source_artifacts",
    "license",
    "verification_method",
    "last_verified_at",
    "trust_valid_until",
    "verified_signer_key_ids"
  ],
  "additionalProperties": false
}
