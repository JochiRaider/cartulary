{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "case_id",
    "bootstrap",
    "metadata",
    "inventory",
    "verification_time",
    "expected_valid_until",
    "expected_targets_signers",
    "expected_root_version",
    "retained_versions",
