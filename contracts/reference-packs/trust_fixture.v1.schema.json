          "Size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "SHA256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "verification_time": {
      "type": "string",
      "format": "date-time"
