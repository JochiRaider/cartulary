{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.reference_pack_portable_verification_context.v1",
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "cartulary.reference_pack_portable_verification_context.v1"
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "clock_trusted": {
      "type": "boolean"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 86400
    }
  },
  "required": [
    "schema_id",
    "configuration_sha256",
    "clock_trusted",
    "timeout_seconds"
  ],
  "additionalProperties": false
}
