{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.reference_pack_get_pack_entry_request.v1",
  "type": "object",
  "properties": {
    "pack_set_id": {
      "type": "string",
      "pattern": "^rpset_[0-9a-f]{64}$"
    },
    "pack_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}(\\.[a-z][a-z0-9_]{0,31}){1,7}$",
      "maxLength": 128
    },
    "entry_id": {
      "type": "string",
      "minLength": 1,
      "x-maxUtf8Bytes": 512
    }
  },
  "required": [
    "pack_set_id",
    "pack_key",
    "entry_id"
  ],
  "additionalProperties": false
}
