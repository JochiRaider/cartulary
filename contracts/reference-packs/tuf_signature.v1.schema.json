{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.reference_pack_tuf_signature.v1",
  "type": "object",
  "properties": {
    "keyid": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sig": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "required": [
    "keyid",
    "sig"
  ],
  "additionalProperties": false
}
