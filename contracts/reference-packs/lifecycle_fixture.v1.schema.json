{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "steps"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.reference_pack_lifecycle_fixture.v1"
    },
    "steps": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "operation",
          "client_txn_id",
          "input_ref",
          "expected_active",
          "expected_disabled",
          "expected_removed",
          "expected_job_status",
          "expected_replayed"
        ],
        "properties": {
          "fixture_id": {
            "type": "string",
            "pattern": "^rpfx_lifecycle_[a-z_]+$"
          },
          "operation": {
            "enum": [
              "reconcile_claimed",
              "reconcile_unclaimed",
              "import",
              "renew",
              "activate",
              "disable",
              "remove",
              "reverify",
              "refresh",
              "empty_refresh",
              "cancel_reverify"
            ]
          },
          "client_txn_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "input_ref": {
            "enum": [
              null,
              "contracts/reference-packs/fixtures/admission/equivalent_tar.v1.json"
            ]
          },
          "expected_active": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "expected_disabled": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "expected_removed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "expected_job_status": {
            "enum": [
              null,
              "succeeded",
              "canceled"
            ]
          },
          "expected_replayed": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
