{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.reference_pack_tuf_snapshot_metadata.v1",
  "type": "object",
  "properties": {
    "signed": {
      "type": "object",
      "properties": {
        "_type": {
          "const": "snapshot"
        },
        "spec_version": {
          "const": "1.0.35"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expires": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "meta": {
          "type": "object",
          "additionalProperties": {
            "$ref": "tuf_metadata_descriptor.v1.schema.json"
          }
        }
      },
      "required": [
        "_type",
        "spec_version",
        "version",
        "expires",
        "meta"
      ],
      "additionalProperties": true
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "tuf_signature.v1.schema.json"
      },
      "x-limitId": "max_signatures"
    }
  },
  "required": [
    "signed",
    "signatures"
  ],
  "additionalProperties": false
}
