{
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "cartulary.reference_pack.enrichment.cisa_kev.entry.v1"
    },
    "entry_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "display_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        {
          "type": "null"
        }
      ]
    },
    "aliases": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "x-limitId": "max_aliases"
    },
    "deprecated": {
      "type": "boolean"
    },
    "replacement_entry_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "artifact_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "artifact_index",
          "locator"
        ],
        "additionalProperties": false
      },
      "x-limitId": "max_source_refs"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false
    },
    "cve_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
    },
    "vendor_project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "vulnerability_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "date_added": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "short_description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "required_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "due_date": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "known_ransomware_campaign_use": {
      "enum": [
        "known",
        "unknown",
        "not_reported"
      ]
    },
    "notes": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_id",
    "entry_id",
    "display_label",
    "description",
    "aliases",
    "deprecated",
    "replacement_entry_id",
    "source_refs",
    "extensions",
    "cve_id",
    "vendor_project",
    "product",
    "vulnerability_name",
    "date_added",
    "short_description",
    "required_action",
    "due_date",
    "known_ransomware_campaign_use",
    "notes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.reference_pack.enrichment.cisa_kev.entry.v1"
}
