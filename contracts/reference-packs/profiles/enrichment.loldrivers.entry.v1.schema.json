{
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "cartulary.reference_pack.enrichment.loldrivers.entry.v1"
    },
    "entry_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "display_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        {
          "type": "null"
        }
      ]
    },
    "aliases": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "x-limitId": "max_aliases"
    },
    "deprecated": {
      "type": "boolean"
    },
    "replacement_entry_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "artifact_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "artifact_index",
          "locator"
        ],
        "additionalProperties": false
      },
      "x-limitId": "max_source_refs"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false
    },
    "driver_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    },
    "filenames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 260,
        "pattern": "^[\\x20-\\x7e]+$"
      },
      "x-limitId": "max_profile_array"
    },
    "hashes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "algorithm": {
            "enum": [
              "md5",
              "sha1",
              "sha256"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]+$"
          }
        },
        "required": [
          "algorithm",
          "value"
        ],
        "additionalProperties": false
      },
      "x-limitId": "max_profile_array"
    },
    "signer_names": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "x-limitId": "max_profile_array"
    },
    "categories": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "x-limitId": "max_profile_array"
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      },
      "x-limitId": "max_profile_array"
    }
  },
  "required": [
    "schema_id",
    "entry_id",
    "display_label",
    "description",
    "aliases",
    "deprecated",
    "replacement_entry_id",
    "source_refs",
    "extensions",
    "driver_id",
    "filenames",
    "hashes",
    "signer_names",
    "categories",
    "references"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.reference_pack.enrichment.loldrivers.entry.v1"
}
