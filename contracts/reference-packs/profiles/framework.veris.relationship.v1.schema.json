{
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "cartulary.reference_pack.framework.veris.relationship.v1"
    },
    "description": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        {
          "type": "null"
        }
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "artifact_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "artifact_index",
          "locator"
        ],
        "additionalProperties": false
      },
      "x-limitId": "max_source_refs"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false
    },
    "relationship_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 68,
      "pattern": "^rpr_[0-9a-f]{64}$"
    },
    "relationship_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "source_object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    },
    "target_object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    }
  },
  "required": [
    "schema_id",
    "description",
    "source_refs",
    "extensions",
    "relationship_id",
    "relationship_type",
    "source_object_id",
    "target_object_id"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.reference_pack.framework.veris.relationship.v1"
}
