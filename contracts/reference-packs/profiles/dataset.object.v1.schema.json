{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.reference_pack.dataset.object.v1",
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "cartulary.reference_pack.dataset.object.v1"
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "x-maxUtf8Bytes": 512
    },
    "object_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "display_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        {
          "type": "null"
        }
      ]
    },
    "deprecated": {
      "type": "boolean"
    },
    "replacement_object_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "x-maxUtf8Bytes": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "artifact_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "artifact_index",
          "locator"
        ],
        "additionalProperties": false
      },
      "x-limitId": "max_source_refs"
    },
    "data": {
      "type": "object",
      "additionalProperties": true
    },
    "lookup_values": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 4,
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                ]
              }
            }
          ]
        },
        "minItems": 0
      },
      "x-limitId": "max_dataset_lookups"
    }
  },
  "required": [
    "schema_id",
    "object_id",
    "object_type",
    "display_label",
    "description",
    "deprecated",
    "replacement_object_id",
    "source_refs",
    "data",
    "lookup_values"
  ],
  "additionalProperties": false
}
