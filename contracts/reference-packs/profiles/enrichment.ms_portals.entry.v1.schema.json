{
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "cartulary.reference_pack.enrichment.ms_portals.entry.v1"
    },
    "entry_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "display_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        {
          "type": "null"
        }
      ]
    },
    "aliases": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "x-limitId": "max_aliases"
    },
    "deprecated": {
      "type": "boolean"
    },
    "replacement_entry_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "artifact_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "artifact_index",
          "locator"
        ],
        "additionalProperties": false
      },
      "x-limitId": "max_source_refs"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false
    },
    "service_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "portal_urls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      },
      "x-limitId": "max_profile_array"
    },
    "audiences": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
      },
      "x-limitId": "max_profile_array"
    },
    "clouds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
      },
      "x-limitId": "max_profile_array"
    }
