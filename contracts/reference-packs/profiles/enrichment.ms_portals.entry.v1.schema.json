  "required": [
    "schema_id",
    "entry_id",
    "display_label",
    "description",
    "aliases",
    "deprecated",
    "replacement_entry_id",
    "source_refs",
    "extensions",
    "service_id",
    "portal_urls",
    "audiences",
    "clouds"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.reference_pack.enrichment.ms_portals.entry.v1"
