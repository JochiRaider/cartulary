{
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "cartulary.reference_pack.framework.attack.object.v2"
    },
    "description": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        {
          "type": "null"
        }
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "artifact_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "artifact_index",
          "locator"
        ],
        "additionalProperties": false
      },
      "x-limitId": "max_source_refs"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    },
    "object_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "display_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "aliases": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "x-limitId": "max_aliases"
    },
    "deprecated": {
      "type": "boolean"
    },
    "replacement_object_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 192,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "external_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "source_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "external_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "source_name",
          "external_id",
          "url"
        ],
        "additionalProperties": false
      },
      "x-limitId": "max_profile_array"
    },
    "source": {
      "oneOf": [
        {
          "$ref": "profiles/framework.attack.native_source.v2.schema.json#/$defs/attack-pattern"
        },
        {
          "$ref": "profiles/framework.attack.native_source.v2.schema.json#/$defs/campaign"
        },
        {
          "$ref": "profiles/framework.attack.native_source.v2.schema.json#/$defs/course-of-action"
        },
        {
          "$ref": "profiles/framework.attack.native_source.v2.schema.json#/$defs/identity"
        },
        {
          "$ref": "profiles/framework.attack.native_source.v2.schema.json#/$defs/intrusion-set"
        },
        {
          "$ref": "profiles/framework.attack.native_source.v2.schema.json#/$defs/malware"
        },
        {
          "$ref": "profiles/framework.attack.native_source.v2.schema.json#/$defs/marking-definition"
        },
        {
          "$ref": "profiles/framework.attack.native_source.v2.schema.json#/$defs/tool"
        },
        {
          "$ref": "profiles/framework.attack.native_source.v2.schema.json#/$defs/x-mitre-analytic"
        },
        {
          "$ref": "profiles/framework.attack.native_source.v2.schema.json#/$defs/x-mitre-asset"
        },
        {
          "$ref": "profiles/framework.attack.native_source.v2.schema.json#/$defs/x-mitre-collection"
        },
        {
          "$ref": "profiles/framework.attack.native_source.v2.schema.json#/$defs/x-mitre-data-component"
        },
        {
          "$ref": "profiles/framework.attack.native_source.v2.schema.json#/$defs/x-mitre-data-source"
        },
        {
          "$ref": "profiles/framework.attack.native_source.v2.schema.json#/$defs/x-mitre-detection-strategy"
        },
        {
          "$ref": "profiles/framework.attack.native_source.v2.schema.json#/$defs/x-mitre-matrix"
        },
        {
          "$ref": "profiles/framework.attack.native_source.v2.schema.json#/$defs/x-mitre-tactic"
        }
      ]
    },
    "source_domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "enterprise-attack",
          "ics-attack",
          "mobile-attack"
        ]
      }
    }
  },
  "required": [
    "schema_id",
    "description",
    "source_refs",
    "extensions",
    "object_id",
    "object_type",
    "display_label",
    "aliases",
    "deprecated",
    "replacement_object_id",
    "external_refs",
    "source",
    "source_domains"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.reference_pack.framework.attack.object.v2"
}
