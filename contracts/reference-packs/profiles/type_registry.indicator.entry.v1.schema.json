{
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "cartulary.reference_pack.type_registry.indicator.entry.v1"
    },
    "entry_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "display_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        {
          "type": "null"
        }
      ]
    },
    "aliases": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "x-limitId": "max_aliases"
    },
    "deprecated": {
      "type": "boolean"
    },
    "replacement_entry_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "artifact_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "artifact_index",
          "locator"
        ],
        "additionalProperties": false
      },
      "x-limitId": "max_source_refs"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false
    },
    "allowed_value_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "enum": [
          "atomic",
          "pattern",
          "reference"
        ]
      },
      "x-limitId": "max_profile_array"
    },
    "normalization_algorithm_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192
    },
    "validation_algorithm_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192
    },
    "defang_algorithm_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192
    },
    "dedupe_algorithm_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192
    },
    "stix_mapping": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "stix_object_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "pattern_property": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "stix_object_type",
            "pattern_property"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_id",
    "entry_id",
    "display_label",
    "description",
    "aliases",
    "deprecated",
    "replacement_entry_id",
    "source_refs",
    "extensions",
    "allowed_value_kinds",
    "normalization_algorithm_id",
    "validation_algorithm_id",
    "defang_algorithm_id",
    "dedupe_algorithm_id",
    "stix_mapping"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.reference_pack.type_registry.indicator.entry.v1"
}
