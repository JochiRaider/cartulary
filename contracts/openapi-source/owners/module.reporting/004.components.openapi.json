{
  "components": {
    "schemas": {
      "ReleaseCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "snapshot_id": {
            "type": "string",
            "format": "uuid"
          },
          "client_txn_id": {
            "type": "string"
          },
          "template_id": {
            "type": "string"
          },
          "template_version": {
            "type": "string"
          },
          "redaction_profile_id": {
            "type": "string"
          },
          "redaction_profile_version": {
            "type": "string"
          },
          "output_kind": {
            "$ref": "#/components/schemas/ReleaseOutputKind"
          },
          "release_scope": {
            "$ref": "#/components/schemas/ReleaseScope"
          },
          "recipient_partition_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "output_options": {
            "$ref": "#/components/schemas/ReleaseOutputOptions"
          },
          "graph_projection_refs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceProjectionRef"
            },
            "default": []
          },
          "composition_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "composition_version": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CompositionVersion"
              },
              {
                "type": "null"
              }
            ]
          },
          "composition_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "snapshot_id",
          "client_txn_id",
          "template_id",
          "template_version",
          "redaction_profile_id",
          "redaction_profile_version",
          "output_kind"
        ]
      },
      "ReleaseActionRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "client_txn_id": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "client_txn_id"
        ]
      },
      "ReleaseEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ReleaseResource"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "ReleaseResource": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "release_id": {
            "type": "string",
            "format": "uuid"
          },
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "snapshot_id": {
            "type": "string",
            "format": "uuid"
          },
          "snapshot_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_change_set_high_watermark": {
            "type": "string"
          },
          "derivation_version": {
            "type": "string"
          },
          "export_model_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "template_id": {
            "type": "string"
          },
          "template_version": {
            "type": "string"
          },
          "redaction_profile_id": {
            "type": "string"
          },
          "redaction_profile_version": {
            "type": "string"
          },
          "redaction_profile_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "output_kind": {
            "$ref": "#/components/schemas/ReleaseOutputKind"
          },
          "output_media_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "release_scope": {
            "$ref": "#/components/schemas/ReleaseScope"
          },
          "recipient_partition_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output_options": {
            "$ref": "#/components/schemas/ReleaseOutputOptions"
          },
          "graph_projection_refs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceProjectionRef"
            }
          },
          "composition_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "composition_version": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CompositionVersion"
              },
              {
                "type": "null"
              }
            ]
          },
          "composition_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "render_admitted_at": {
            "type": "string",
            "format": "date-time"
          },
          "output_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "redaction_manifest_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "release_state": {
            "type": "string",
            "enum": [
              "pending_approval",
              "approved",
              "invalidated",
              "published",
              "render_failed"
            ]
          },
          "render_failed_reason_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_by_user_id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "approved_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "invalidated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "invalidation_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "release_id",
          "incident_id",
          "snapshot_id",
          "snapshot_at",
          "source_change_set_high_watermark",
          "derivation_version",
          "export_model_sha256",
          "template_id",
          "template_version",
          "redaction_profile_id",
          "redaction_profile_version",
          "redaction_profile_sha256",
          "output_kind",
          "output_media_type",
          "release_scope",
          "recipient_partition_refs",
          "output_options",
          "graph_projection_refs",
          "composition_id",
          "composition_version",
          "composition_sha256",
          "render_admitted_at",
          "output_sha256",
          "redaction_manifest_sha256",
          "release_state",
          "render_failed_reason_code",
          "created_by_user_id",
          "created_at",
          "approved_at",
          "invalidated_at",
          "published_at",
          "invalidation_reason"
        ]
      }
    }
  }
}
