{
  "components": {
    "schemas": {
      "SnapshotCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "client_txn_id": {
            "type": "string"
          },
          "source_change_set_high_watermark": {
            "type": "string"
          }
        },
        "required": [
          "incident_id",
          "client_txn_id"
        ]
      },
      "SnapshotEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SnapshotResource"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "SnapshotResource": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "snapshot_id": {
            "type": "string",
            "format": "uuid"
          },
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "created_by_user_id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "snapshot_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_change_set_high_watermark": {
            "type": "string"
          },
          "derivation_version": {
            "type": "string"
          },
          "export_model_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "snapshot_id",
          "incident_id",
          "created_by_user_id",
          "created_at",
          "snapshot_at",
          "source_change_set_high_watermark",
          "derivation_version",
          "export_model_sha256"
        ]
      }
    }
  }
}
