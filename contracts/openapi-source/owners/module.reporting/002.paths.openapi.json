{
  "paths": {
    "/api/v1/releases": {
      "post": {
        "tags": [
          "snapshot-reporting"
        ],
        "operationId": "createRelease",
        "summary": "Create or replay one rendered release candidate and return the common job resource.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReleaseCreateRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Release render job accepted or replayed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid release request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Render, release-state, or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
    "/api/v1/releases/{release_id}": {
      "get": {
        "tags": [
          "snapshot-reporting"
        ],
        "operationId": "getRelease",
        "summary": "Fetch one durable release resource.",
        "parameters": [
          {
            "name": "release_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Release resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReleaseEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid pagination request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Release is not visible to the caller",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
    "/api/v1/releases/{release_id}/approve": {
      "post": {
        "tags": [
          "snapshot-reporting"
        ],
        "operationId": "approveRelease",
        "summary": "Record an approval for one durable release tuple.",
        "parameters": [
          {
            "name": "release_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReleaseActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Post-approval release resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReleaseEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Malformed release action request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Release not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Approval rejected, state conflict, or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
    "/api/v1/releases/{release_id}/publish": {
      "post": {
        "tags": [
          "snapshot-reporting"
        ],
        "operationId": "publishRelease",
        "summary": "Publish one approved release.",
        "parameters": [
          {
            "name": "release_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReleaseActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Published release resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReleaseEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Malformed release action request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Release not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "State conflict or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
    "/api/v1/releases/{release_id}/invalidate": {
      "post": {
        "tags": [
          "snapshot-reporting"
        ],
        "operationId": "invalidateRelease",
        "summary": "Invalidate one pending, approved, or published release.",
        "parameters": [
          {
            "name": "release_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReleaseActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invalidated release resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReleaseEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Malformed release action request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Release not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "State conflict or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    }
  }
}
