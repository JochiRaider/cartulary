{
  "components": {
    "schemas": {
      "RecordDeleteRestoreRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "base_row_version": {
            "type": "integer",
            "minimum": 1
          },
          "client_txn_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "base_row_version",
          "client_txn_id"
        ]
      },
      "RecordRollbackHistoryEntryTarget": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "history_entry"
          },
          "history_entry_ref": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "history_entry_ref"
        ]
      },
      "RecordRollbackChangeSetTarget": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "change_set"
          },
          "change_set_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "kind",
          "change_set_id"
        ]
      },
      "RecordRollbackRowRestoreTarget": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "row_restore"
          },
          "restore_to_revision_no": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "kind",
          "restore_to_revision_no"
        ]
      },
      "RecordRollbackTarget": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/RecordRollbackHistoryEntryTarget"
          },
          {
            "$ref": "#/components/schemas/RecordRollbackChangeSetTarget"
          },
          {
            "$ref": "#/components/schemas/RecordRollbackRowRestoreTarget"
          }
        ]
      },
      "RecordRollbackRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "base_row_version": {
            "type": "integer",
            "minimum": 1
          },
          "client_txn_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "target": {
            "$ref": "#/components/schemas/RecordRollbackTarget"
          }
        },
        "required": [
          "base_row_version",
          "client_txn_id",
          "target"
        ]
      }
    }
  }
}
