{
  "components": {
    "schemas": {
      "RecordHistoryDiffSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "summary": {
            "type": "string"
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "summary",
          "units"
        ]
      },
      "RecordHistoryItem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actor_user_id": {
            "type": "string",
            "format": "uuid"
          },
          "committed_at": {
            "type": "string",
            "format": "date-time"
          },
          "history_item_ref": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "diff_summary": {
            "$ref": "#/components/schemas/RecordHistoryDiffSummary"
          },
          "change_set_id": {
            "type": "string",
            "format": "uuid"
          },
          "reversible": {
            "type": "boolean"
          },
          "available_rollback_actions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "history_entry",
                "change_set",
                "row_restore"
              ]
            }
          },
          "history_entry_ref": {
            "type": "string"
          },
          "revision_no": {
            "type": "integer"
          }
        },
        "required": [
          "actor_user_id",
          "committed_at",
          "history_item_ref",
          "operation",
          "diff_summary",
          "change_set_id",
          "reversible",
          "available_rollback_actions"
        ]
      },
      "RecordHistoryData": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "record_id": {
            "type": "string",
            "format": "uuid"
          },
          "row_version": {
            "type": "integer"
          },
          "deleted": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecordHistoryItem"
            }
          }
        },
        "required": [
          "incident_id",
          "record_id",
          "row_version",
          "deleted",
          "items"
        ]
      },
      "RecordHistoryEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/RecordHistoryData"
          },
          "meta": {
            "$ref": "#/components/schemas/RecordHistoryEnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "RecordHistoryEnvelopeMeta": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "type": "string"
          },
          "paging": {
            "$ref": "#/components/schemas/PagingMeta"
          }
        },
        "required": [
          "request_id",
          "paging"
        ]
      },
      "RecordDeleteRestoreData": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "record_id": {
            "type": "string",
            "format": "uuid"
          },
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "row_version": {
            "type": "integer"
          },
          "deleted": {
            "type": "boolean"
          },
          "deleted_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "deleted_by_user_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "change_set_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "record_id",
          "incident_id",
          "row_version",
          "deleted",
          "deleted_at",
          "deleted_by_user_id",
          "change_set_id"
        ]
      },
      "RecordDeleteRestoreEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/RecordDeleteRestoreData"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "RecordRollbackData": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "record_id": {
            "type": "string",
            "format": "uuid"
          },
          "row_version": {
            "type": "integer"
          },
          "target": {
            "$ref": "#/components/schemas/RecordRollbackTarget"
          },
          "target_change_set_id": {
            "type": "string",
            "format": "uuid"
          },
          "rollback_change_set_id": {
            "type": "string",
            "format": "uuid"
          },
          "affected_record_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "incident_id",
          "record_id",
          "row_version",
          "target",
          "target_change_set_id",
          "rollback_change_set_id",
          "affected_record_ids"
        ]
      },
      "RecordRollbackEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/RecordRollbackData"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      }
    }
  }
}
