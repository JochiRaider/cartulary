{
  "components": {
    "schemas": {
      "IncidentBundleExportRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "client_txn_id": {
            "type": "string"
          },
          "reference_pack_mode": {
            "type": "string",
            "enum": [
              "refs_only",
              "embedded"
            ]
          },
          "optional_sections": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "reference_packs",
                "snapshots"
              ]
            },
            "uniqueItems": true
          },
          "required_capabilities": {
            "type": "array",
            "description": "Current deployment supports no required optional-section export capabilities; omit this member or send an empty array. Non-empty values fail with invalid_required_capabilities until a later profile revision declares implementation support.",
            "maxItems": 0,
            "items": {
              "type": "string",
              "enum": [
                "reference_packs",
                "snapshots"
              ]
            },
            "uniqueItems": true
          }
        },
        "required": [
          "incident_id",
          "client_txn_id"
        ]
      },
      "IncidentBundleImportUploadRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "client_txn_id": {
                "type": "string"
              }
            },
            "required": [
              "client_txn_id"
            ]
          },
          "file": {
            "type": "string",
            "format": "binary"
          }
        },
        "required": [
          "metadata",
          "file"
        ]
      },
      "IncidentBundleEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/IncidentBundleResource"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "IncidentBundleResource": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "bundle_id": {
            "type": "string",
            "format": "uuid"
          },
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "exported_at": {
            "type": "string",
            "format": "date-time"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reference_pack_mode": {
            "type": "string",
            "enum": [
              "refs_only",
              "embedded"
            ]
          },
          "history_mode": {
            "type": "string",
            "enum": [
              "full"
            ]
          },
          "blob_mode": {
            "type": "string",
            "enum": [
              "full"
            ]
          },
          "optional_sections": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "reference_packs",
                "snapshots"
              ]
            }
          },
          "required_capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "reference_packs",
                "snapshots"
              ]
            }
          }
        },
        "required": [
          "bundle_id",
          "incident_id",
          "exported_at",
          "manifest_sha256",
          "reference_pack_mode",
          "history_mode",
          "blob_mode",
          "optional_sections",
          "required_capabilities"
        ]
      }
    }
  }
}
