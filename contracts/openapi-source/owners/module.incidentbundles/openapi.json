{
  "paths": {
    "/api/v1/incident-bundles/export": {
      "post": {
        "tags": [
          "incident-bundles"
        ],
        "operationId": "exportIncidentBundle",
        "summary": "Queue a whole-incident portability bundle export.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IncidentBundleExportRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Incident bundle export job accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid incident-bundle export request",
            "x-cartulary-error-codes": [
              "invalid_incident_bundle_request"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Export rejected or idempotency conflict",
            "x-cartulary-error-codes": [
              "client_txn_conflict",
              "incident_bundle_export_rejected"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ],
        "x-cartulary-availability": "incident_portability"
      }
    },
    "/api/v1/incident-bundles/{bundle_id}": {
      "get": {
        "tags": [
          "incident-bundles"
        ],
        "operationId": "getIncidentBundleDescriptor",
        "summary": "Read a completed incident-bundle export descriptor.",
        "parameters": [
          {
            "name": "bundle_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Incident bundle descriptor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentBundleEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid singleton read query",
            "x-cartulary-error-codes": [
              "invalid_list_query"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Incident bundle descriptor not found",
            "x-cartulary-error-codes": [
              "incident_bundle_not_found"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerSession": []
          }
        ],
        "x-cartulary-availability": "incident_portability"
      }
    },
    "/api/v1/incident-bundles/import": {
      "post": {
        "tags": [
          "incident-bundles"
        ],
        "operationId": "importIncidentBundle",
        "summary": "Queue a whole-incident portability bundle import.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/IncidentBundleImportUploadRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Incident bundle import job accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid incident-bundle import request",
            "x-cartulary-error-codes": [
              "invalid_incident_bundle_request"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Import rejected or idempotency conflict",
            "x-cartulary-error-codes": [
              "client_txn_conflict",
              "incident_bundle_import_rejected"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ],
        "x-cartulary-availability": "incident_portability"
      }
    }
  },
  "components": {
    "schemas": {
      "IncidentBundleExportRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "client_txn_id": {
            "type": "string"
          },
          "reference_pack_mode": {
            "type": "string",
            "enum": [
              "refs_only",
              "embedded"
            ]
          },
          "optional_sections": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "reference_packs",
                "snapshots"
              ]
            },
            "uniqueItems": true
          },
          "required_capabilities": {
            "type": "array",
            "description": "Current deployment supports no required optional-section export capabilities; omit this member or send an empty array. Non-empty values fail with invalid_required_capabilities until a later profile revision declares implementation support.",
            "maxItems": 0,
            "items": {
              "type": "string",
              "enum": [
                "reference_packs",
                "snapshots"
              ]
            },
            "uniqueItems": true
          }
        },
        "required": [
          "incident_id",
          "client_txn_id"
        ]
      },
      "IncidentBundleImportUploadRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "client_txn_id": {
                "type": "string"
              }
            },
            "required": [
              "client_txn_id"
            ]
          },
          "file": {
            "type": "string",
            "format": "binary"
          }
        },
        "required": [
          "metadata",
          "file"
        ]
      },
      "IncidentBundleEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/IncidentBundleResource"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "IncidentBundleResource": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "bundle_id": {
            "type": "string",
            "format": "uuid"
          },
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "exported_at": {
            "type": "string",
            "format": "date-time"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reference_pack_mode": {
            "type": "string",
            "enum": [
              "refs_only",
              "embedded"
            ]
          },
          "history_mode": {
            "type": "string",
            "enum": [
              "full"
            ]
          },
          "blob_mode": {
            "type": "string",
            "enum": [
              "full"
            ]
          },
          "optional_sections": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "reference_packs",
                "snapshots"
              ]
            }
          },
          "required_capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "reference_packs",
                "snapshots"
              ]
            }
          }
        },
        "required": [
          "bundle_id",
          "incident_id",
          "exported_at",
          "manifest_sha256",
          "reference_pack_mode",
          "history_mode",
          "blob_mode",
          "optional_sections",
          "required_capabilities"
        ]
      }
    }
  }
}
