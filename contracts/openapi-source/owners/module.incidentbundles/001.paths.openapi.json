{
  "paths": {
    "/api/v1/incident-bundles/export": {
      "post": {
        "tags": [
          "incident-bundles"
        ],
        "operationId": "exportIncidentBundle",
        "summary": "Queue a whole-incident portability bundle export.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IncidentBundleExportRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Incident bundle export job accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid incident-bundle export request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Export rejected or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
    "/api/v1/incident-bundles/{bundle_id}": {
      "get": {
        "tags": [
          "incident-bundles"
        ],
        "operationId": "getIncidentBundleDescriptor",
        "summary": "Read a completed incident-bundle export descriptor.",
        "parameters": [
          {
            "name": "bundle_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Incident bundle descriptor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentBundleEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid singleton read query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Incident bundle descriptor not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
    "/api/v1/incident-bundles/import": {
      "post": {
        "tags": [
          "incident-bundles"
        ],
        "operationId": "importIncidentBundle",
        "summary": "Queue a whole-incident portability bundle import.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/IncidentBundleImportUploadRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Incident bundle import job accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid incident-bundle import request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Import rejected or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    }
  }
}
