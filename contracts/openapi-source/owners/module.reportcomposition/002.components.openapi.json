{
  "components": {
    "schemas": {
      "CompositionArray": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "$ref": "#/components/schemas/CompositionOp"
            },
            {
              "$ref": "#/components/schemas/CompositionDiagramDecl"
            },
            {
              "$ref": "#/components/schemas/AuthoredText"
            }
          ]
        }
      },
      "CompositionAnchor": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "anchor_kind": {
            "type": "string",
            "enum": [
              "section_anchor",
              "record_anchor",
              "block_anchor",
              "diagram_anchor"
            ]
          },
          "template_section_decl_id": {
            "type": "string"
          },
          "expansion_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "record_id": {
            "type": "string"
          },
          "section_anchor": {
            "$ref": "#/components/schemas/CompositionAnchor"
          },
          "block_kind": {
            "type": "string"
          },
          "decl_id": {
            "type": "string"
          }
        },
        "required": [
          "anchor_kind"
        ]
      },
      "CompositionOpPayload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "section_anchor": {
            "$ref": "#/components/schemas/CompositionAnchor"
          },
          "section_anchors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompositionAnchor"
            }
          },
          "block_anchor": {
            "$ref": "#/components/schemas/CompositionAnchor"
          },
          "diagram_anchor": {
            "$ref": "#/components/schemas/CompositionAnchor"
          },
          "layout_id": {
            "type": "string"
          },
          "authored_text_ref": {
            "type": "string"
          },
          "position": {
            "type": "string",
            "enum": [
              "before",
              "after"
            ]
          },
          "click_profile": {
            "type": "string",
            "enum": [
              "none",
              "reveal_blocks",
              "reveal_list_items"
            ]
          },
          "label_overrides": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompositionLabelOverride"
            }
          }
        }
      },
      "CompositionOp": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "op_id": {
            "type": "string"
          },
          "op_kind": {
            "type": "string",
            "enum": [
              "exclude_section",
              "reorder_sections",
              "override_slide_layout",
              "override_title",
              "set_speaker_notes",
              "insert_authored_block",
              "exclude_block",
              "override_click_profile",
              "insert_diagram_slide",
              "exclude_diagram",
              "override_diagram_labels"
            ]
          },
          "on_unresolved": {
            "type": "string",
            "enum": [
              "fail",
              "drop"
            ],
            "default": "fail"
          },
          "payload": {
            "$ref": "#/components/schemas/CompositionOpPayload"
          }
        },
        "required": [
          "op_id",
          "op_kind",
          "payload"
        ]
      },
      "AuthoredText": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "authored_text_id": {
            "type": "string"
          },
          "text_role": {
            "type": "string",
            "enum": [
              "title_override",
              "speaker_notes",
              "authored_text"
            ]
          },
          "body": {
            "type": "string"
          },
          "disclosure_partition_ref": {
            "type": "string"
          }
        },
        "required": [
          "authored_text_id",
          "text_role",
          "body",
          "disclosure_partition_ref"
        ]
      },
      "CompositionLabelOverrideTarget": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target_kind": {
            "type": "string",
            "enum": [
              "vertex",
              "edge"
            ]
          },
          "ref": {
            "type": "string"
          }
        },
        "required": [
          "target_kind",
          "ref"
        ]
      },
      "CompositionLabelOverride": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": {
            "$ref": "#/components/schemas/CompositionLabelOverrideTarget"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "target",
          "label"
        ]
      },
      "CompositionDiagramLayout": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_id": {
            "const": "composition_diagram_layout.v1"
          },
          "coordinate_space": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "unit": {
                "const": "css_px"
              },
              "origin": {
                "const": "top_left"
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            },
            "required": [
              "unit",
              "origin",
              "width",
              "height"
            ]
          },
          "node_positions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "target_ref": {
                  "type": "string"
                },
                "x": {
                  "type": "integer",
                  "minimum": 0
                },
                "y": {
                  "type": "integer",
                  "minimum": 0
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "target_ref",
                "x",
                "y",
                "width",
                "height"
              ]
            }
          },
          "edge_routes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "target_ref": {
                  "type": "string"
                },
                "route_kind": {
                  "const": "polyline"
                },
                "waypoints": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "x": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "y": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ]
                  }
                }
              },
              "required": [
                "target_ref",
                "route_kind",
                "waypoints"
              ]
            }
          }
        },
        "required": [
          "schema_id",
          "coordinate_space",
          "node_positions",
          "edge_routes"
        ]
      },
      "CompositionDiagramDecl": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "decl_id": {
            "type": "string"
          },
          "replaces_decl_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "diagram_kind": {
            "type": "string"
          },
          "diagram_source_kind": {
            "type": "string",
            "enum": [
              "graph",
              "timeline"
            ]
          },
          "source_graph_view_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "selection_rule": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rule_kind": {
                "type": "string"
              },
              "explicit_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "timeline_sequence": {
                "type": "object",
                "additionalProperties": false
              },
              "seed_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "max_depth": {
                "type": "integer",
                "minimum": 1
              },
              "direction": {
                "type": "string"
              },
              "bounds": {
                "type": "object",
                "additionalProperties": false
              }
            },
            "required": [
              "rule_kind"
            ]
          },
          "label_overrides": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompositionLabelOverride"
            },
            "default": []
          },
          "layout_mode": {
            "type": "string",
            "enum": [
              "auto",
              "manual"
            ],
            "default": "auto"
          },
          "layout": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CompositionDiagramLayout"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "decl_id",
          "replaces_decl_id",
          "diagram_kind",
          "diagram_source_kind",
          "source_graph_view_id",
          "selection_rule"
        ]
      }
    }
  }
}
