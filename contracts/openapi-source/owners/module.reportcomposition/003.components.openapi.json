{
  "components": {
    "schemas": {
      "ReportCompositionValidationContext": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "release_scope": {
            "$ref": "#/components/schemas/ReleaseScope"
          },
          "snapshot_id": {
            "type": "string"
          },
          "derivation_version": {
            "type": "string"
          },
          "redaction_profile_id": {
            "type": "string"
          },
          "redaction_profile_version": {
            "type": "string"
          },
          "redaction_profile_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "render_environment_profile_id": {
            "type": "string"
          },
          "output_kind": {
            "$ref": "#/components/schemas/ReleaseOutputKind"
          },
          "output_options": {
            "$ref": "#/components/schemas/ReleaseOutputOptions"
          },
          "recipient_partition_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "graph_projection_refs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceProjectionRef"
            }
          }
        }
      },
      "CanonicalComposition": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_id": {
            "const": "cartulary.report_composition.v1"
          },
          "composition_id": {
            "type": "string",
            "format": "uuid"
          },
          "composition_version": {
            "$ref": "#/components/schemas/CompositionVersion"
          },
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "template_id": {
            "type": "string"
          },
          "template_version": {
            "type": "string"
          },
          "composition_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "authored_against_snapshot_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "deck_ops": {
            "$ref": "#/components/schemas/CompositionArray"
          },
          "diagram_decls": {
            "$ref": "#/components/schemas/CompositionArray"
          },
          "authored_texts": {
            "$ref": "#/components/schemas/CompositionArray"
          }
        },
        "required": [
          "schema_id",
          "composition_id",
          "composition_version",
          "incident_id",
          "template_id",
          "template_version",
          "authored_against_snapshot_id",
          "deck_ops",
          "diagram_decls",
          "authored_texts",
          "composition_sha256"
        ]
      },
      "ReportCompositionCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "client_txn_id": {
            "type": "string"
          },
          "template_id": {
            "type": "string"
          },
          "template_version": {
            "type": "string"
          },
          "authored_against_snapshot_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "deck_ops": {
            "$ref": "#/components/schemas/CompositionArray"
          },
          "diagram_decls": {
            "$ref": "#/components/schemas/CompositionArray"
          },
          "authored_texts": {
            "$ref": "#/components/schemas/CompositionArray"
          }
        },
        "required": [
          "client_txn_id",
          "template_id",
          "template_version"
        ]
      },
      "ReportCompositionUpdateRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "client_txn_id": {
            "type": "string"
          },
          "base_draft_version": {
            "type": "integer",
            "minimum": 1
          },
          "authored_against_snapshot_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "deck_ops": {
            "$ref": "#/components/schemas/CompositionArray"
          },
          "diagram_decls": {
            "$ref": "#/components/schemas/CompositionArray"
          },
          "authored_texts": {
            "$ref": "#/components/schemas/CompositionArray"
          }
        },
        "required": [
          "client_txn_id",
          "base_draft_version"
        ]
      },
      "ReportCompositionDraftVersionRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "client_txn_id": {
            "type": "string"
          },
          "base_draft_version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "client_txn_id",
          "base_draft_version"
        ]
      },
      "ReportCompositionValidateRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_kind": {
            "type": "string",
            "enum": [
              "draft",
              "version",
              "inline"
            ],
            "default": "draft"
          },
          "composition_version": {
            "$ref": "#/components/schemas/CompositionVersion"
          },
          "inline_composition": {
            "$ref": "#/components/schemas/CanonicalComposition"
          },
          "validation_context": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ReportCompositionValidationContext"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ReportCompositionPreviewRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "client_txn_id": {
            "type": "string"
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "draft",
              "version"
            ],
            "default": "draft"
          },
          "composition_version": {
            "$ref": "#/components/schemas/CompositionVersion"
          },
          "snapshot_id": {
            "type": "string"
          },
          "derivation_version": {
            "type": "string"
          },
          "template_id": {
            "type": "string"
          },
          "template_version": {
            "type": "string"
          },
          "redaction_profile_id": {
            "type": "string"
          },
          "redaction_profile_version": {
            "type": "string"
          },
          "redaction_profile_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "render_environment_profile_id": {
            "type": "string"
          },
          "output_kind": {
            "$ref": "#/components/schemas/ReleaseOutputKind"
          },
          "output_options": {
            "$ref": "#/components/schemas/ReleaseOutputOptions"
          },
          "recipient_partition_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "graph_projection_refs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceProjectionRef"
            },
            "default": []
          }
        },
        "required": [
          "client_txn_id",
          "snapshot_id",
          "derivation_version",
          "template_id",
          "template_version",
          "redaction_profile_id",
          "redaction_profile_version",
          "redaction_profile_sha256",
          "render_environment_profile_id",
          "output_kind"
        ]
      },
      "ReportCompositionResourceEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ReportCompositionResource"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "ReportCompositionListEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "composition_resources": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ReportCompositionResource"
                }
              }
