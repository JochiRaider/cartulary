{
  "components": {
    "schemas": {
      "ExtensionDiscoveryEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ExtensionDiscoveryData"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "ExtensionDiscoveryData": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "extensions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExtensionProfileResource"
            }
          }
        },
        "required": [
          "extensions"
        ]
      },
      "ExtensionProfileResource": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "profile_id": {
            "$ref": "#/components/schemas/ExtensionProfileID"
          },
          "claimable": {
            "type": "boolean"
          },
          "claimed": {
            "type": "boolean"
          },
          "contract_major": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "route_families": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/ExtensionRouteFamily"
            }
          },
          "workspace_keys": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          }
        },
        "required": [
          "profile_id",
          "claimable",
          "claimed",
          "contract_major",
          "route_families",
          "workspace_keys",
          "capabilities"
        ]
      },
      "ExtensionProfileID": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "ExtensionRouteFamily": {
        "type": "string",
        "pattern": "^/api/v1/[^?#%\\\\]+$"
      }
    }
  }
}
