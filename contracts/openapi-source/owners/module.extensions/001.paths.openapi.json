{
  "paths": {
    "/api/v1/extensions": {
      "get": {
        "tags": [
          "extensions"
        ],
        "operationId": "listDeploymentExtensions",
        "summary": "List the deployment-scoped reserved extension profiles and claimed route-family roots.",
        "responses": {
          "200": {
            "description": "Deployment extension discovery response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionDiscoveryEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid pagination request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Session required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    }
  }
}
