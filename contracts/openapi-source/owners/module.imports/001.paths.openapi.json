                  "$ref": "#/components/schemas/ImportUnitEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Import session or unit is not visible to the caller",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
    "/api/v1/import-sessions/{import_session_id}/units/{import_unit_id}/preview": {
      "get": {
        "tags": [
          "imports"
        ],
        "operationId": "getImportUnitPreview",
        "summary": "Read the first bounded preview rows for one Import unit.",
