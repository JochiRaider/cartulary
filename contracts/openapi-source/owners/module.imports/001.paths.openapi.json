              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportPreviewEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Import session or unit is not visible to the caller",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
