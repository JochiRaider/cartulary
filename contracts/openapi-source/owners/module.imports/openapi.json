  "components": {
    "schemas": {
      "ImportSessionUploadRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/ImportSessionCreateMetadata"
          },
          "file": {
            "type": "string",
            "format": "binary"
          }
        },
        "required": [
          "metadata",
          "file"
        ]
      },
      "ImportSessionCreateMetadata": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "client_txn_id": {
            "type": "string"
          },
          "assistant_profile": {
            "type": "string",
            "enum": [
              "phase2_workbook_import_v1"
            ]
          }
        },
        "required": [
          "incident_id",
          "client_txn_id"
        ]
      },
      "ImportSessionEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ImportSession"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "ImportUnitsEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "import_units": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ImportUnit"
                }
              }
            },
            "required": [
              "import_units"
            ]
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "ImportUnitEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ImportUnit"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "ImportPreviewEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ImportPreview"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "ImportUnitActionEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "import_session_id": {
                "type": "string",
                "format": "uuid"
              },
              "session_status": {
                "type": "string"
              },
              "selected_unit_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "unit": {
                "$ref": "#/components/schemas/ImportUnit"
              }
            },
            "required": [
              "import_session_id",
              "session_status",
              "selected_unit_ids",
              "unit"
            ]
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "ImportSession": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "import_session_id": {
            "type": "string",
            "format": "uuid"
          },
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "created_by_user_id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_file_kind": {
            "type": "string",
            "enum": [
              "csv",
              "xlsx"
            ]
          },
          "original_filename": {
            "type": "string"
          },
          "source_content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "parser_profile_id": {
            "type": "string"
          },
          "parser_version": {
            "type": "string"
          },
          "assistant_profile": {
            "type": "string"
          },
          "session_status": {
            "type": "string",
            "enum": [
              "uploaded",
              "discovering",
              "discovered",
              "ready_to_apply",
              "applying",
              "applied",
              "partially_applied",
              "failed",
              "canceled"
            ]
          },
          "selected_unit_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "blocking_diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "nonblocking_warning_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "import_session_id",
          "incident_id",
          "created_by_user_id",
          "created_at",
          "source_file_kind",
          "original_filename",
          "source_content_sha256",
          "parser_profile_id",
          "parser_version",
          "assistant_profile",
          "session_status",
          "selected_unit_ids",
          "blocking_diagnostics",
          "nonblocking_warning_codes"
        ]
      },
      "ImportUnit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "import_unit_id": {
            "type": "string",
            "format": "uuid"
          },
          "import_session_id": {
            "type": "string",
            "format": "uuid"
          },
          "locator_kind": {
            "type": "string",
            "enum": [
              "csv_file",
              "xlsx_used_range",
              "xlsx_table",
              "xlsx_named_range",
              "xlsx_region"
            ]
          },
          "locator": {
            "type": "object",
            "additionalProperties": true
          },
          "source_rect_a1": {
            "type": "string"
          },
          "header_row_ref": {
            "type": "integer",
            "minimum": 1
          },
          "data_start_row_ref": {
            "type": "integer",
            "minimum": 1
          },
          "inferred_row_count": {
            "type": "integer",
            "minimum": 0
          },
          "inferred_column_count": {
            "type": "integer",
            "minimum": 0
          },
          "warning_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unit_status": {
            "type": "string",
            "enum": [
              "discovered",
              "selected",
              "mapped",
              "ready",
              "skipped",
              "applying",
              "applied",
              "rejected",
              "failed",
              "canceled"
            ]
          },
          "mapping_fingerprint": {
            "type": "string"
          },
          "approved_mapping": {
            "$ref": "#/components/schemas/ApprovedImportMapping"
          }
        },
        "required": [
          "import_unit_id",
          "import_session_id",
          "locator_kind",
          "locator",
          "source_rect_a1",
          "header_row_ref",
          "data_start_row_ref",
          "inferred_row_count",
          "inferred_column_count",
          "warning_codes",
          "unit_status"
        ]
      },
      "ApprovedImportMapping": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target_view_schema_id": {
            "type": "string"
          },
          "unknown_column_policy": {
            "type": "string",
            "enum": [
              "preserve_raw_capture",
              "preserve_custom_attrs",
              "reject_if_unmapped"
            ]
          },
          "source_columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImportSourceColumnMapping"
            }
          },
          "target_kind": {
            "type": "string"
          },
          "extension_profile_id": {
            "type": "string"
          },
          "owner_mapping_schema_id": {
            "type": "string"
          },
          "owner_mapping": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
