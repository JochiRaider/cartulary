{
  "paths": {
    "/api/v1/import-sessions": {
      "post": {
        "tags": [
          "imports"
        ],
        "operationId": "createImportSession",
        "summary": "Upload one bounded CSV or XLSX source and start Import discovery.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ImportSessionUploadRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Discovery job accepted or replayed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid import request or upload envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Unsupported import source or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "Import source exceeds configured limits",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ],
        "x-cartulary-availability": "import"
      }
    },
    "/api/v1/import-sessions/{import_session_id}": {
      "get": {
        "tags": [
          "imports"
        ],
        "operationId": "getImportSession",
        "summary": "Read one visible Import session.",
        "parameters": [
          {
            "name": "import_session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Import session resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportSessionEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Import session is not visible to the caller",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerSession": []
          }
        ],
        "x-cartulary-availability": "import"
      }
    },
    "/api/v1/import-sessions/{import_session_id}/units": {
      "get": {
        "tags": [
          "imports"
        ],
        "operationId": "listImportUnits",
        "summary": "List Import units for one visible Import session.",
