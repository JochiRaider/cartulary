{
  "paths": {
    "/api/v1/view-schemas": {
      "get": {
        "tags": [
          "view-schemas"
        ],
        "operationId": "listViewSchemas",
        "summary": "List standardized current-profile view schema resources.",
        "responses": {
          "200": {
            "description": "View schema list response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewSchemaListEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
    "/api/v1/view-schemas/{view_schema_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ViewSchemaIDPathParameter"
        }
      ],
      "get": {
        "tags": [
          "view-schemas"
        ],
        "operationId": "getViewSchema",
        "summary": "Fetch one standardized current-profile view schema resource.",
        "responses": {
          "200": {
            "description": "View schema singleton response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewSchemaEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    }
