    "/api/v1/administrative-audit-events": {
      "get": {
        "tags": [
          "administrative-audit"
        ],
        "operationId": "listAdministrativeAuditEvents",
        "summary": "List the immutable safe deployment-scoped administrative-audit projection.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "description": "Cursor page size. Omission defaults to 100 without cursor_token and reuses the cursor-bound limit with cursor_token."
          },
          {
            "name": "cursor_token",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Opaque keyset cursor bound to this route, caller, page size, and normalized filter set."
          },
          {
            "name": "actor_user_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Return only events attributed to this user actor."
          },
          {
            "name": "action_code",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "account_preferences_updated",
                "auth_binding_created",
                "auth_binding_retired",
                "auth_binding_rotated",
                "backup_created",
                "bootstrap_admin_created",
                "deployment_admin_granted",
                "deployment_admin_revoked",
                "legacy_administrative_event",
                "password_changed",
                "password_reset",
                "restore_completed",
                "restore_failed",
                "restore_started",
                "restore_verification_completed",
                "sessions_revoked",
                "totp_enrollment_begun",
                "totp_enrollment_completed",
                "totp_reset",
                "user_created",
                "user_profile_updated",
                "user_status_changed"
              ]
            },
            "description": "Return only events with this exact action code."
          },
          {
            "name": "target_kind",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "account_preferences",
                "auth_binding",
                "backup_set",
                "legacy_administrative_event",
                "restore_operation",
                "user"
              ]
            },
            "description": "Return only deployment events with this target kind."
          },
          {
            "name": "target_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Return only events with this exact target identifier. target_kind is required when target_id is present."
          },
          {
            "name": "occurred_at_gte",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Inclusive UTC occurrence-time lower bound."
          },
          {
            "name": "occurred_at_lt",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Exclusive UTC occurrence-time upper bound; it must be later than occurred_at_gte."
          }
        ],
        "responses": {
          "200": {
            "description": "Deployment-scoped administrative-audit page ordered by occurred_at and audit_event_id descending.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdministrativeAuditEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "A filter, range, page size, or cursor is invalid or does not match the normalized query.",
            "x-cartulary-error-codes": [
              "invalid_list_query",
              "invalid_pagination_request"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "A current authenticated session is required.",
            "x-cartulary-error-codes": [
              "session_required"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The authenticated caller is not a deployment administrator.",
            "x-cartulary-error-codes": [
              "authorization_denied"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "A credential-bootstrap bearer was presented to a route that accepts only session credentials.",
            "x-cartulary-error-codes": [
              "credential_bootstrap_rejected"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "An internal dependency or persistence operation failed.",
            "x-cartulary-error-codes": [
              "internal_error"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
