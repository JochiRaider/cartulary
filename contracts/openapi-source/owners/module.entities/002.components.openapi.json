{
  "components": {
    "schemas": {
      "RecordMergeRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "loser_record_id": {
            "type": "string",
            "format": "uuid"
          },
          "survivor_base_row_version": {
            "type": "integer"
          },
          "loser_base_row_version": {
            "type": "integer"
          },
          "client_txn_id": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "loser_record_id",
          "survivor_base_row_version",
          "loser_base_row_version",
          "client_txn_id"
        ]
      },
      "RecordMergeExactMatchClassSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "identifier_class": {
            "type": "string"
          },
          "promoted_count": {
            "type": "integer"
          },
          "carried_count": {
            "type": "integer"
          },
          "duplicate_noop_count": {
            "type": "integer"
          },
          "blocked_conflict_count": {
            "type": "integer"
          },
          "provenance_only_count": {
            "type": "integer"
          },
          "suggestion_only_count": {
            "type": "integer"
          }
        },
        "required": [
          "identifier_class",
          "promoted_count",
          "carried_count",
          "duplicate_noop_count",
          "blocked_conflict_count",
          "provenance_only_count",
          "suggestion_only_count"
        ]
      },
      "RecordMergeSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "record_type": {
            "type": "string"
          },
          "repointed_mention_resolution_count": {
            "type": "integer"
          },
          "repointed_link_count": {
            "type": "integer"
          },
          "deduped_link_count": {
            "type": "integer"
          },
          "repointed_tag_count": {
            "type": "integer"
          },
          "deduped_tag_count": {
            "type": "integer"
          },
          "repointed_assessment_count": {
            "type": "integer"
          },
          "exact_match_classes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecordMergeExactMatchClassSummary"
            }
          },
          "suggestion_aliases_copied_count": {
            "type": "integer"
          },
          "suggestion_alias_duplicate_noop_count": {
            "type": "integer"
          },
          "provenance_only_retained_count": {
            "type": "integer"
          }
        },
        "required": [
          "record_type",
          "repointed_mention_resolution_count",
          "repointed_link_count",
          "deduped_link_count",
          "repointed_tag_count",
          "deduped_tag_count",
          "repointed_assessment_count",
          "exact_match_classes",
          "suggestion_aliases_copied_count",
          "suggestion_alias_duplicate_noop_count",
          "provenance_only_retained_count"
        ]
      },
      "RecordMergeData": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "record_type": {
            "type": "string",
            "enum": [
              "host",
              "identity"
            ]
          },
          "survivor_record_id": {
            "type": "string",
            "format": "uuid"
          },
          "loser_record_id": {
            "type": "string",
            "format": "uuid"
          },
          "survivor_row_version": {
            "type": "integer"
          },
          "loser_row_version": {
            "type": "integer"
          },
          "change_set_id": {
            "type": "string",
            "format": "uuid"
          },
          "merged_into_record_id": {
            "type": "string",
            "format": "uuid"
          },
          "merge_summary": {
            "$ref": "#/components/schemas/RecordMergeSummary"
          }
        },
        "required": [
          "incident_id",
          "record_type",
          "survivor_record_id",
          "loser_record_id",
          "survivor_row_version",
          "loser_row_version",
          "change_set_id",
          "merged_into_record_id",
          "merge_summary"
        ]
      },
      "RecordMergeEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/RecordMergeData"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "MentionActionRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "base_mention_row_version": {
            "type": "integer"
          },
          "client_txn_id": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "resolve_item",
              "dismiss_item",
              "revert_to_unresolved"
            ]
          },
          "resolved_record_id": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "base_mention_row_version",
          "client_txn_id",
          "action"
        ]
      },
      "MentionActionData": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "entity_mention": {
            "$ref": "#/components/schemas/EntityMentionResource"
          },
          "source_record": {
            "$ref": "#/components/schemas/MentionSourceRecordResource"
          },
          "change_set_id": {
            "type": "string",
            "format": "uuid"
          },
          "active_link": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "incident_id",
          "entity_mention",
          "source_record",
          "change_set_id"
        ]
      },
      "EntityMentionResource": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "entity_mention_id": {
            "type": "string",
            "format": "uuid"
          },
          "row_version": {
            "type": "integer"
          },
          "resolution_status": {
            "type": "string"
          },
          "resolved_record_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        },
        "required": [
          "entity_mention_id",
          "row_version",
          "resolution_status",
          "resolved_record_id"
        ]
      },
      "MentionSourceRecordResource": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "record_id": {
            "type": "string",
            "format": "uuid"
          },
          "row_version": {
            "type": "integer"
          }
        },
        "required": [
          "record_id",
          "row_version"
        ]
      },
      "MentionActionEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/MentionActionData"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      }
    }
  }
}
