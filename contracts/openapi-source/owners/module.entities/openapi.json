{
  "paths": {
    "/api/v1/records/{survivor_record_id}/merge": {
      "post": {
        "tags": [
          "entities"
        ],
        "operationId": "mergeEntityRecord",
        "summary": "Explicitly merge one Host or Identity record into a path-scoped survivor with idempotent replay.",
        "parameters": [
          {
            "name": "survivor_record_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordMergeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Entity merge response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordMergeEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid merge request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "CSRF verification or authorization failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Merge records are not visible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Merge conflict, precondition failure, or incident state conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
    "/api/v1/entity-mentions/{entity_mention_id}/resolve": {
      "post": {
        "tags": [
          "entities"
        ],
        "operationId": "resolveEntityMention",
        "summary": "Resolve, dismiss, or restore one entity mention with idempotent replay.",
        "parameters": [
          {
            "name": "entity_mention_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MentionActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Entity mention action response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MentionActionEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid mention action request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "CSRF verification or authorization failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Mention or resolved target is not visible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Mention state, row version, idempotency, or incident conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
    "/api/v1/incidents/{incident_id}/entity-candidates": {
      "get": {
        "tags": [
          "entities"
        ],
        "operationId": "listEntityCandidates",
        "summary": "Search authorized eligible Host or Identity candidates without mutation.",
        "parameters": [
          {
            "name": "incident_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "entity_type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "host",
                "identity"
              ]
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 256
            },
            "description": "list_search_v1 over declared names, aliases and eligible identifiers; normalized-empty browses."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "description": "Defaults to 100, or reuses the cursor-bound limit."
          },
          {
            "name": "cursor_token",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized candidate page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntityCandidateListEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid list query or pagination",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-cartulary-error-codes": [
              "invalid_list_query",
              "invalid_pagination_request"
            ]
          },
          "401": {
            "description": "Session required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-cartulary-error-codes": [
              "session_required"
            ]
          },
          "404": {
            "description": "Incident unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-cartulary-error-codes": [
              "incident_not_found"
            ]
          },
          "409": {
            "description": "Credential bootstrap rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-cartulary-error-codes": [
              "credential_bootstrap_rejected"
            ]
          },
          "500": {
            "description": "Read dependency failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-cartulary-error-codes": [
              "internal_error"
            ]
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "RecordMergeRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "loser_record_id": {
            "type": "string",
            "format": "uuid"
          },
          "survivor_base_row_version": {
            "type": "integer"
          },
          "loser_base_row_version": {
            "type": "integer"
          },
          "client_txn_id": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "loser_record_id",
          "survivor_base_row_version",
          "loser_base_row_version",
          "client_txn_id"
        ]
      },
      "RecordMergeExactMatchClassSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "identifier_class": {
            "type": "string"
          },
          "promoted_count": {
            "type": "integer"
          },
          "carried_count": {
            "type": "integer"
          },
          "duplicate_noop_count": {
            "type": "integer"
          },
          "blocked_conflict_count": {
            "type": "integer"
          },
          "provenance_only_count": {
            "type": "integer"
          },
          "suggestion_only_count": {
            "type": "integer"
          }
        },
        "required": [
          "identifier_class",
          "promoted_count",
          "carried_count",
          "duplicate_noop_count",
          "blocked_conflict_count",
          "provenance_only_count",
          "suggestion_only_count"
        ]
      },
      "RecordMergeSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "record_type": {
            "type": "string"
          },
          "repointed_mention_resolution_count": {
            "type": "integer"
          },
          "repointed_link_count": {
            "type": "integer"
          },
          "deduped_link_count": {
            "type": "integer"
          },
          "repointed_tag_count": {
            "type": "integer"
          },
          "deduped_tag_count": {
            "type": "integer"
          },
          "repointed_assessment_count": {
            "type": "integer"
          },
          "exact_match_classes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecordMergeExactMatchClassSummary"
            }
          },
          "suggestion_aliases_copied_count": {
            "type": "integer"
          },
          "suggestion_alias_duplicate_noop_count": {
            "type": "integer"
          },
          "provenance_only_retained_count": {
            "type": "integer"
          }
        },
        "required": [
          "record_type",
          "repointed_mention_resolution_count",
          "repointed_link_count",
          "deduped_link_count",
          "repointed_tag_count",
          "deduped_tag_count",
          "repointed_assessment_count",
          "exact_match_classes",
          "suggestion_aliases_copied_count",
          "suggestion_alias_duplicate_noop_count",
          "provenance_only_retained_count"
        ]
      },
      "RecordMergeData": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "record_type": {
            "type": "string",
            "enum": [
              "host",
              "identity"
            ]
          },
          "survivor_record_id": {
            "type": "string",
            "format": "uuid"
          },
          "loser_record_id": {
            "type": "string",
            "format": "uuid"
          },
          "survivor_row_version": {
            "type": "integer"
          },
          "loser_row_version": {
            "type": "integer"
          },
          "change_set_id": {
            "type": "string",
            "format": "uuid"
          },
          "merged_into_record_id": {
            "type": "string",
            "format": "uuid"
          },
          "merge_summary": {
            "$ref": "#/components/schemas/RecordMergeSummary"
          }
        },
        "required": [
          "incident_id",
          "record_type",
          "survivor_record_id",
          "loser_record_id",
          "survivor_row_version",
          "loser_row_version",
          "change_set_id",
          "merged_into_record_id",
          "merge_summary"
        ]
      },
      "RecordMergeEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/RecordMergeData"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "MentionActionRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "base_mention_row_version": {
            "type": "integer"
          },
          "client_txn_id": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "resolve_item",
              "dismiss_item",
              "revert_to_unresolved"
            ]
          },
          "resolved_record_id": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "base_mention_row_version",
          "client_txn_id",
          "action"
        ]
      },
      "MentionActionData": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "entity_mention": {
            "$ref": "#/components/schemas/EntityMentionResource"
          },
          "source_record": {
            "$ref": "#/components/schemas/MentionSourceRecordResource"
          },
          "change_set_id": {
            "type": "string",
            "format": "uuid"
          },
          "active_link": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "link_type": {
                "type": "string",
                "enum": [
                  "observed_on_host",
                  "observed_as_identity"
                ]
              },
              "dst_record_id": {
                "type": "string",
                "format": "uuid"
              },
              "record_link_id": {
                "type": "string",
                "format": "uuid"
              },
              "src_record_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "link_type",
              "dst_record_id"
            ]
          }
        },
        "required": [
          "incident_id",
          "entity_mention",
          "source_record",
          "change_set_id"
        ]
      },
      "EntityMentionResource": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "entity_mention_id": {
            "type": "string",
            "format": "uuid"
          },
          "source_record_id": {
            "type": "string",
            "format": "uuid"
          },
          "source_field_key": {
            "type": "string"
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "host",
              "identity"
            ]
          },
          "raw_text": {
            "type": "string"
          },
          "normalized_text": {
            "type": "string"
          },
          "resolution_status": {
            "type": "string",
            "enum": [
              "unresolved",
              "resolved",
              "dismissed"
            ]
          },
          "resolved_record_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "row_version": {
            "type": "integer",
            "minimum": 1
          },
          "resolved_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "resolved_by_user_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "resolution_method": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "entity_mention_id",
          "source_record_id",
          "source_field_key",
          "entity_type",
          "raw_text",
          "normalized_text",
          "resolution_status",
          "resolved_record_id",
          "row_version",
          "resolved_at",
          "resolved_by_user_id",
          "resolution_method"
        ]
      },
      "MentionSourceRecordResource": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "record_id": {
            "type": "string",
            "format": "uuid"
          },
          "row_version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "record_id",
          "row_version"
        ]
      },
      "MentionActionEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/MentionActionData"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "EntityCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "row_version",
          "entity_type",
          "display_name"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "format": "uuid"
          },
          "row_version": {
            "type": "integer",
            "minimum": 1
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "host",
              "identity"
            ]
          },
          "display_name": {
            "type": "string"
          }
        }
      },
      "EntityCandidateListData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "incident_id",
          "entity_type",
          "candidates"
        ],
        "properties": {
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "host",
              "identity"
            ]
          },
          "candidates": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/EntityCandidate"
            }
          }
        }
      },
      "EntityCandidateListEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/EntityCandidateListData"
          },
          "meta": {
            "$ref": "#/components/schemas/PagedEnvelopeMeta"
          }
        }
      }
    }
  }
}
