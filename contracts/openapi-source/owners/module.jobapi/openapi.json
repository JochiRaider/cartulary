{
  "paths": {
    "/api/v1/jobs/{job_id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "operationId": "getJob",
        "summary": "Fetch one current visible background job resource by identifier.",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current job resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Job is not visible to the caller",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
    "/api/v1/jobs/{job_id}/cancel": {
      "post": {
        "tags": [
          "jobs"
        ],
        "operationId": "cancelJob",
        "summary": "Request cancellation of one current visible cancelable background job with route-scoped idempotency.",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobCancelRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current job resource after cancel request or idempotent replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Job is not visible to the caller",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Job is not cancelable or the idempotency key conflicts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "JobCancelRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "client_txn_id": {
            "type": "string"
          }
        },
        "required": [
          "client_txn_id"
        ]
      },
      "JobEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/JobResource"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "JobResource": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid"
          },
          "scope_kind": {
            "type": "string",
            "enum": [
              "deployment",
              "incident"
            ]
          },
          "incident_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "submitted_by_user_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "cancel_requested",
              "succeeded",
              "failed",
              "canceled"
            ]
          },
          "cancelable": {
            "type": "boolean"
          },
          "progress": {
            "$ref": "#/components/schemas/JobProgress"
          },
          "result_summary": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/JobResultSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "error_summary": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "job_id",
          "scope_kind",
          "incident_id",
          "submitted_by_user_id",
          "status",
          "cancelable",
          "progress",
          "result_summary",
          "error_summary",
          "created_at",
          "started_at",
          "finished_at",
          "updated_at"
        ]
      },
      "JobProgress": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "completed": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "completed",
          "total",
          "message"
        ]
      },
      "JobResultSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "resource_refs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobResourceRef"
            }
          }
        },
        "required": [
          "code",
          "message",
          "resource_refs"
        ]
      },
      "JobResourceRef": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "route": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id",
          "route"
        ]
      }
    }
  }
}
