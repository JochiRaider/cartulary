{
  "paths": {
    "/api/v1/incidents": {
      "get": {
        "tags": [
          "incidents"
        ],
        "operationId": "listVisibleIncidents",
        "summary": "List incidents for which the caller currently has membership.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "description": "Cursor page size. Omission defaults to 100 without cursor_token and reuses the cursor-bound limit with cursor_token."
          },
          {
            "name": "cursor_token",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Opaque cursor returned by a prior page for the same normalized incident-list query."
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 256
            },
            "description": "Optional list_search_v1 search text over incident_key, title, severity, tlp, current_phase, and primary_external_case_ref. Omission or normalized-empty means no search predicate."
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "closed"
              ]
            },
            "description": "Optional exact incident status filter. Omission means both active and closed incidents are eligible."
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/IncidentListSuccessResponse"
          },
          "400": {
            "$ref": "#/components/responses/IncidentListInvalidResponse"
          },
          "401": {
            "$ref": "#/components/responses/IncidentSessionRequiredResponse"
          },
          "409": {
            "$ref": "#/components/responses/IncidentBootstrapRejectedResponse"
          },
          "500": {
            "$ref": "#/components/responses/IncidentInternalErrorResponse"
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerSession": []
          }
        ]
      },
      "post": {
        "tags": [
          "incidents"
        ],
        "operationId": "createIncident",
        "summary": "Create an incident, bootstrap the creator admin membership, and bootstrap workbook preferences.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/IncidentReplaySuccessResponse"
          },
          "201": {
            "$ref": "#/components/responses/IncidentCreatedResponse"
          },
          "400": {
            "$ref": "#/components/responses/IncidentCreateInvalidResponse"
          },
          "401": {
            "$ref": "#/components/responses/IncidentSessionRequiredResponse"
          },
          "403": {
            "$ref": "#/components/responses/IncidentCSRFFailedResponse"
          },
          "409": {
            "$ref": "#/components/responses/IncidentCreateConflictResponse"
          },
          "500": {
            "$ref": "#/components/responses/IncidentInternalErrorResponse"
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
