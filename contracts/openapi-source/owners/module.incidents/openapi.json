    "/api/v1/incidents/{incident_id}/close": {
      "parameters": [
        {
          "$ref": "#/components/parameters/IncidentIDPathParameter"
        }
      ],
      "post": {
        "tags": [
          "incidents"
        ],
        "operationId": "closeIncident",
        "summary": "Close an active incident using optimistic concurrency and route-scoped idempotency.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IncidentLifecycleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Incident closed, or the original committed close result replayed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "The lifecycle request is malformed.",
            "x-cartulary-error-codes": [
              "invalid_incident_lifecycle_request"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "A current authenticated session is required.",
            "x-cartulary-error-codes": [
              "session_required"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Cookie CSRF proof failed or the current incident role is not admin.",
            "x-cartulary-error-codes": [
              "authorization_denied",
              "csrf_verification_failed"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "The incident is not visible to the caller.",
            "x-cartulary-error-codes": [
              "incident_not_found"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "The idempotency key, incident version, credential class, or lifecycle transition conflicts.",
            "x-cartulary-error-codes": [
              "client_txn_conflict",
              "credential_bootstrap_rejected",
              "incident_version_conflict",
              "illegal_transition"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "An internal dependency or persistence operation failed.",
            "x-cartulary-error-codes": [
              "internal_error"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
