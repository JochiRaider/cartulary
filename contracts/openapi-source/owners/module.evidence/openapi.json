{
  "paths": {
    "/api/v1/object-blobs": {
      "post": {
        "tags": [
          "evidence"
        ],
        "operationId": "createObjectBlobSlot",
        "summary": "Create one incident-scoped pending object blob upload slot.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ObjectBlobCreateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent object blob create replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectBlobCreateEnvelope"
                }
              }
            }
          },
          "201": {
            "description": "Created object blob slot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectBlobCreateEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
    "/api/v1/object-uploads/{upload_token}": {
      "put": {
        "tags": [
          "evidence"
        ],
        "operationId": "uploadObjectBlobContent",
        "summary": "Upload bytes to one app-owned object blob upload capability.",
        "parameters": [
          {
            "name": "upload_token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Uploaded object blob content"
          },
          "400": {
            "description": "Invalid object upload request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or revoked upload capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Upload capability conflicts with the current blob slot state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "410": {
            "description": "Expired upload capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "411": {
            "description": "Content-Length required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "Declared upload body exceeds the blob slot contract",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Object-store dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/evidence-records/{record_id}/attach-blob": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RecordIDPathParameter"
        }
      ],
      "post": {
        "tags": [
          "evidence"
        ],
        "operationId": "attachBlobToEvidenceRecord",
        "summary": "Finalize and attach one object blob to an existing evidence record.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvidenceAttachBlobRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evidence attach mutation response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceAttachBlobEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
    "/api/v1/evidence-records/{record_id}/preview-handle": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RecordIDPathParameter"
        }
      ],
      "post": {
        "tags": [
          "evidence"
        ],
        "operationId": "issueEvidencePreviewHandle",
        "summary": "Issue a short-lived reusable preview handle for attached evidence.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvidenceHandleIssueRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evidence preview handle response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceHandleEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
    "/api/v1/evidence-records/{record_id}/download-handle": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RecordIDPathParameter"
        }
      ],
      "post": {
        "tags": [
          "evidence"
        ],
        "operationId": "issueEvidenceDownloadHandle",
        "summary": "Issue a short-lived single-use download handle for attached evidence.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvidenceHandleIssueRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evidence download handle response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceHandleEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
    "/api/v1/evidence-handles/{handle_token}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/EvidenceHandleTokenPathParameter"
        }
      ],
      "get": {
        "tags": [
          "evidence"
        ],
        "operationId": "redeemEvidenceHandle",
        "summary": "Redeem an opaque evidence preview or download handle after current authorization checks.",
        "responses": {
          "200": {
            "description": "Evidence bytes"
          },
          "206": {
            "description": "Evidence byte range"
          }
        },
        "security": []
      }
    },
    "/api/v1/incidents/{incident_id}/evidence-metadata": {
      "post": {
        "tags": [
          "evidence"
        ],
        "operationId": "queryEvidenceMetadata",
        "summary": "Read a bounded selected Evidence metadata window without issuing handles.",
        "parameters": [
          {
            "name": "incident_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvidenceMetadataRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ordered current metadata for the selected Evidence records",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceMetadataEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
    "/api/v1/object-blobs/{object_blob_id}/verify": {
      "post": {
        "tags": [
          "evidence"
        ],
        "operationId": "verifyObjectBlob",
        "summary": "Verify one completed upload in a cancelable background Job before atomic finalization.",
        "parameters": [
          {
            "name": "object_blob_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ObjectBlobVerifyRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Verification Job accepted or replayed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Blob state or transaction conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ObjectBlobCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "client_txn_id": {
            "type": "string"
          },
          "byte_size": {
            "type": "integer",
            "minimum": 0
          },
          "filename_hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_type_hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256_hex": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "incident_id",
          "client_txn_id",
          "byte_size"
        ]
      },
      "ObjectBlobAcceptedContract": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "byte_size": {
            "type": "integer",
            "minimum": 0
          },
          "filename_hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_type_hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256_hex": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "incident_id",
          "byte_size",
          "filename_hint",
          "content_type_hint",
          "sha256_hex"
        ]
      },
      "ObjectBlobUploadTarget": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "href": {
            "type": "string",
            "description": "Opaque same-origin app-owned upload capability path in the base profile.",
            "pattern": "^/api/v1/object-uploads/[^/?#]+$"
          },
          "method": {
            "const": "PUT"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "href",
          "method",
          "expires_at",
          "headers"
        ]
      },
      "ObjectBlobCreateData": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "object_blob_id": {
            "type": "string",
            "format": "uuid"
          },
          "upload_state": {
            "const": "pending"
          },
          "target_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "pending_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "upload_target": {
            "$ref": "#/components/schemas/ObjectBlobUploadTarget"
          },
          "accepted_contract": {
            "$ref": "#/components/schemas/ObjectBlobAcceptedContract"
          }
        },
        "required": [
          "incident_id",
          "object_blob_id",
          "upload_state",
          "target_expires_at",
          "pending_expires_at",
          "upload_target",
          "accepted_contract"
        ]
      },
      "ObjectBlobCreateEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ObjectBlobCreateData"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "EvidenceAttachBlobRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_blob_id": {
            "type": "string",
            "format": "uuid"
          },
          "base_row_version": {
            "type": "integer",
            "minimum": 1
          },
          "client_txn_id": {
            "type": "string"
          }
        },
        "required": [
          "object_blob_id",
          "base_row_version",
          "client_txn_id"
        ]
      },
      "EvidenceAttachBlobData": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/ViewMutationDataFields"
          },
          {
            "type": "object",
            "properties": {
              "object_blob_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "object_blob_id"
            ]
          }
        ],
        "unevaluatedProperties": false
      },
      "EvidenceAttachBlobEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/EvidenceAttachBlobData"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "EvidenceHandleIssueRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "EvidenceHandleData": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "record_id": {
            "type": "string",
            "format": "uuid"
          },
          "object_blob_id": {
            "type": "string",
            "format": "uuid"
          },
          "handle_kind": {
            "enum": [
              "preview",
              "download"
            ]
          },
          "href": {
            "type": "string"
          },
          "method": {
            "const": "GET"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "single_use": {
            "type": "boolean"
          },
          "media_class": {
            "type": "string"
          },
          "preview_kind": {
            "type": "string"
          },
          "disposition": {
            "enum": [
              "inline",
              "attachment"
            ]
          },
          "filename": {
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_lifecycle_state": {
            "type": "string"
          },
          "upload_state": {
            "type": "string"
          }
        },
        "required": [
          "incident_id",
          "record_id",
          "object_blob_id",
          "handle_kind",
          "href",
          "method",
          "expires_at",
          "single_use",
          "media_class",
          "disposition",
          "filename",
          "content_type",
          "size_bytes",
          "sha256",
          "evidence_lifecycle_state",
          "upload_state"
        ]
      },
      "EvidenceHandleEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/EvidenceHandleData"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "EvidenceMetadataRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "record_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          }
        },
        "required": [
          "record_ids"
        ]
      },
      "EvidencePreviewEligibility": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eligible": {
            "type": "boolean"
          },
          "reason_code": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "no_visible_blob",
              "blob_pending",
              "blob_failed",
              "blob_missing",
              "evidence_quarantined",
              "evidence_inconsistent",
              "unsupported_preview",
              "preview_payload_too_large"
            ]
          }
        },
        "required": [
          "eligible",
          "reason_code"
        ]
      },
      "EvidenceMetadataItem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "record_id": {
            "type": "string",
            "format": "uuid"
          },
          "row_version": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "lifecycle_state": {
            "type": "string",
            "enum": [
              "requested",
              "pending_receipt",
              "received",
              "available",
              "quarantined",
              "released"
            ]
          },
          "has_blob": {
            "type": "boolean"
          },
          "upload_state": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "pending",
              "available",
              "failed",
              "quarantined"
            ]
          },
          "preview_eligibility": {
            "$ref": "#/components/schemas/EvidencePreviewEligibility"
          }
        },
        "required": [
          "record_id",
          "row_version",
          "title",
          "lifecycle_state",
          "has_blob",
          "upload_state",
          "preview_eligibility"
        ]
      },
      "EvidenceMetadataData": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/EvidenceMetadataItem"
            }
          }
        },
        "required": [
          "incident_id",
          "items"
        ]
      },
      "EvidenceMetadataEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/EvidenceMetadataData"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "ObjectBlobVerifyRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "client_txn_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "client_txn_id"
        ]
      }
    }
  }
}
