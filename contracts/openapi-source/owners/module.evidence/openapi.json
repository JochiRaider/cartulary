{
  "paths": {
    "/api/v1/object-blobs": {
      "post": {
        "tags": [
          "evidence"
        ],
        "operationId": "createObjectBlobSlot",
        "summary": "Create one incident-scoped pending object blob upload slot.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ObjectBlobCreateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent object blob create replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectBlobCreateEnvelope"
                }
              }
            }
          },
          "201": {
            "description": "Created object blob slot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectBlobCreateEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
    "/api/v1/object-uploads/{upload_token}": {
      "put": {
        "tags": [
          "evidence"
        ],
        "operationId": "uploadObjectBlobContent",
        "summary": "Upload bytes to one app-owned object blob upload capability.",
        "parameters": [
          {
            "name": "upload_token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Uploaded object blob content"
          },
          "400": {
            "description": "Invalid object upload request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or revoked upload capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Upload capability conflicts with the current blob slot state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "410": {
            "description": "Expired upload capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "411": {
            "description": "Content-Length required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "Declared upload body exceeds the blob slot contract",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Object-store dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/evidence-records/{record_id}/attach-blob": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RecordIDPathParameter"
        }
      ],
      "post": {
        "tags": [
          "evidence"
        ],
        "operationId": "attachBlobToEvidenceRecord",
        "summary": "Finalize and attach one object blob to an existing evidence record.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvidenceAttachBlobRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evidence attach mutation response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceAttachBlobEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
    "/api/v1/evidence-records/{record_id}/preview-handle": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RecordIDPathParameter"
        }
      ],
      "post": {
        "tags": [
          "evidence"
        ],
        "operationId": "issueEvidencePreviewHandle",
        "summary": "Issue a short-lived reusable preview handle for attached evidence.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvidenceHandleIssueRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evidence preview handle response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceHandleEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
    "/api/v1/evidence-records/{record_id}/download-handle": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RecordIDPathParameter"
        }
      ],
      "post": {
        "tags": [
          "evidence"
        ],
        "operationId": "issueEvidenceDownloadHandle",
        "summary": "Issue a short-lived single-use download handle for attached evidence.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvidenceHandleIssueRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evidence download handle response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceHandleEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
    "/api/v1/evidence-handles/{handle_token}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/EvidenceHandleTokenPathParameter"
        }
      ],
      "get": {
        "tags": [
          "evidence"
        ],
        "operationId": "redeemEvidenceHandle",
        "summary": "Redeem an opaque evidence preview or download handle after current authorization checks.",
        "responses": {
          "200": {
            "description": "Evidence bytes"
          },
          "206": {
            "description": "Evidence byte range"
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "ObjectBlobCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "client_txn_id": {
            "type": "string"
          },
          "byte_size": {
            "type": "integer",
            "minimum": 0
          },
          "filename_hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_type_hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256_hex": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "incident_id",
          "client_txn_id",
          "byte_size"
        ]
      },
      "ObjectBlobAcceptedContract": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "byte_size": {
            "type": "integer",
            "minimum": 0
          },
          "filename_hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_type_hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256_hex": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "incident_id",
          "byte_size",
          "filename_hint",
          "content_type_hint",
          "sha256_hex"
        ]
      },
      "ObjectBlobUploadTarget": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "href": {
            "type": "string",
            "description": "Opaque same-origin app-owned upload capability path in the base profile.",
            "pattern": "^/api/v1/object-uploads/"
          },
          "method": {
            "const": "PUT"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "headers": {
            "type": "object"
          }
        },
        "required": [
          "href",
          "method",
          "expires_at",
          "headers"
        ]
      },
      "ObjectBlobCreateData": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "object_blob_id": {
            "type": "string",
            "format": "uuid"
          },
          "upload_state": {
            "const": "pending"
          },
          "target_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "pending_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "upload_target": {
            "$ref": "#/components/schemas/ObjectBlobUploadTarget"
          },
          "accepted_contract": {
            "$ref": "#/components/schemas/ObjectBlobAcceptedContract"
          }
        },
        "required": [
          "incident_id",
          "object_blob_id",
          "upload_state",
          "target_expires_at",
          "pending_expires_at",
          "upload_target",
          "accepted_contract"
        ]
      },
      "ObjectBlobCreateEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ObjectBlobCreateData"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "EvidenceAttachBlobRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_blob_id": {
            "type": "string",
            "format": "uuid"
          },
          "base_row_version": {
            "type": "integer",
            "minimum": 1
          },
          "client_txn_id": {
            "type": "string"
          }
        },
        "required": [
          "object_blob_id",
          "base_row_version",
          "client_txn_id"
        ]
      },
      "EvidenceAttachBlobData": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/ViewMutationDataFields"
          },
          {
            "type": "object",
            "properties": {
              "object_blob_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "object_blob_id"
            ]
          }
        ],
        "unevaluatedProperties": false
      },
      "EvidenceAttachBlobEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/EvidenceAttachBlobData"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "EvidenceHandleIssueRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "EvidenceHandleData": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "record_id": {
            "type": "string",
            "format": "uuid"
          },
          "object_blob_id": {
            "type": "string",
            "format": "uuid"
          },
          "handle_kind": {
            "enum": [
              "preview",
              "download"
            ]
          },
          "href": {
            "type": "string"
          },
          "method": {
            "const": "GET"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "single_use": {
            "type": "boolean"
          },
          "media_class": {
            "type": "string"
          },
          "preview_kind": {
            "type": "string"
          },
          "disposition": {
            "enum": [
              "inline",
              "attachment"
            ]
          },
          "filename": {
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_lifecycle_state": {
            "type": "string"
          },
          "upload_state": {
            "type": "string"
          }
        },
        "required": [
          "incident_id",
          "record_id",
          "object_blob_id",
          "handle_kind",
          "href",
          "method",
          "expires_at",
          "single_use",
          "media_class",
          "disposition",
          "filename",
          "content_type",
          "size_bytes",
          "sha256",
          "evidence_lifecycle_state",
          "upload_state"
        ]
      },
      "EvidenceHandleEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/EvidenceHandleData"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      }
    }
  }
}
