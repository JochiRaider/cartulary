{
  "components": {
    "schemas": {
      "AssessmentCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "client_txn_id": {
            "type": "string"
          },
          "assessment.subject_ref": {
            "type": "string",
            "format": "uuid"
          },
          "assessment.subject_type": {
            "type": "string",
            "enum": [
              "host",
              "identity"
            ]
          },
          "assessment.assessment_state": {
            "type": "string",
            "enum": [
              "unknown",
              "suspected",
              "confirmed",
              "disproven",
              "cleared"
            ]
          },
          "assessment.confidence_score": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "assessment.rationale": {
            "type": "string"
          },
          "assessment.assessor": {
            "type": "string",
            "format": "uuid"
          },
          "assessment.assessed_at": {
            "type": "string",
            "format": "date-time"
          },
          "assessment.support_refs": {
            "$ref": "#/components/schemas/CollectionActionsV1"
          }
        },
        "required": [
          "client_txn_id",
          "assessment.subject_ref",
          "assessment.subject_type",
          "assessment.assessment_state",
          "assessment.rationale"
        ]
      }
    }
  }
}
