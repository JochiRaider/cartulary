{
  "components": {
    "schemas": {
      "SheetRef": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ViewSchemaSheetRef"
          },
          {
            "$ref": "#/components/schemas/SavedViewSheetRef"
          },
          {
            "$ref": "#/components/schemas/ExtensionWorkspaceSheetRef"
          }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "view_schema": "#/components/schemas/ViewSchemaSheetRef",
            "saved_view": "#/components/schemas/SavedViewSheetRef",
            "extension_workspace": "#/components/schemas/ExtensionWorkspaceSheetRef"
          }
        }
      },
      "ViewSchemaSheetRef": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "view_schema"
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "id"
        ]
      },
      "SavedViewSheetRef": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "saved_view"
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "id"
        ]
      },
      "ExtensionWorkspaceSheetRef": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "extension_workspace"
          },
          "extension_profile_id": {
            "type": "string",
            "minLength": 1
          },
          "workspace_key": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "extension_profile_id",
          "workspace_key"
        ]
      },
      "DefaultWorkbookPreferencesPutRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "default_sheet_ref": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SheetRef"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "default_sheet_ref"
        ]
      },
      "UserWorkbookPreferencesPutRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "home_sheet_ref": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SheetRef"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "home_sheet_ref"
        ]
      },
      "DefaultWorkbookPreferencesResource": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "default_sheet_ref": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SheetRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_by_user_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "incident_id",
          "default_sheet_ref",
          "created_at",
          "updated_at",
          "updated_by_user_id"
        ]
      },
      "UserWorkbookPreferencesResource": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "home_sheet_ref": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SheetRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "incident_id",
          "user_id",
          "home_sheet_ref",
          "created_at",
          "updated_at"
        ]
      },
      "DefaultWorkbookPreferencesEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/DefaultWorkbookPreferencesResource"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "UserWorkbookPreferencesEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/UserWorkbookPreferencesResource"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "WorkbookStartupSource": {
        "type": "string",
        "enum": [
          "explicit",
          "home",
          "default",
          "timeline"
        ]
      },
      "WorkbookStartupClearedPointer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "home",
              "default"
            ]
          },
          "sheet_ref": {
            "$ref": "#/components/schemas/SheetRef"
          },
          "reason_code": {
            "type": "string",
            "description": "Current-profile emitted values are drawn from the workbook-startup cleared-pointer registry: invalid_sheet_ref, unsupported_sheet_ref_kind, unknown_view_schema, invalid_saved_view_id, saved_view_not_found, saved_view_not_visible, required_reference_pack_unavailable, invalid_extension_profile_id, invalid_extension_workspace_key, extension_profile_not_claimed, extension_workspace_unavailable, extension_workspace_not_visible."
          }
        },
        "required": [
          "source",
          "sheet_ref",
          "reason_code"
        ]
      },
      "ExtensionWorkspaceAvailabilityRow": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "extension_profile_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "workspace_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        },
        "required": [
          "extension_profile_id",
          "workspace_key"
        ]
      },
      "ExtensionWorkspaceAvailability": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_id": {
            "type": "string",
            "const": "cartulary.extension_workspace_availability.v1"
          },
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "workspaces": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "#/components/schemas/ExtensionWorkspaceAvailabilityRow"
            }
          }
        },
        "required": [
          "schema_id",
          "incident_id",
          "workspaces"
        ]
      },
      "WorkbookStartupResource": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "type": "string",
            "format": "uuid"
          },
          "selected_sheet_ref": {
            "$ref": "#/components/schemas/SheetRef"
          },
          "selected_view_schema_id": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "selected_saved_view": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SavedViewResource"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "$ref": "#/components/schemas/WorkbookStartupSource"
          },
          "cleared_pointers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkbookStartupClearedPointer"
            }
          },
          "home_sheet_ref": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SheetRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "default_sheet_ref": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SheetRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "extension_workspace_availability": {
            "$ref": "#/components/schemas/ExtensionWorkspaceAvailability"
          }
        },
        "required": [
          "incident_id",
          "selected_sheet_ref",
          "selected_view_schema_id",
          "selected_saved_view",
          "source",
          "cleared_pointers",
          "home_sheet_ref",
          "default_sheet_ref",
          "extension_workspace_availability"
        ]
      },
      "WorkbookStartupEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/WorkbookStartupResource"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "WorkbookQueryRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sort": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SortEntry"
            }
          },
          "filters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ViewQueryFilter"
            }
          },
          "group_by": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "cursor_token": {
            "type": "string"
          }
        }
      }
    }
  }
}
