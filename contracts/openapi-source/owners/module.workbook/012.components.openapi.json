{
  "components": {
    "schemas": {
      "ViewMutationEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ViewMutationData"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "WorkbookClipboardPasteTarget": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "create"
              }
            },
            "required": [
              "kind"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "record"
              },
              "record_id": {
                "type": "string",
                "format": "uuid",
                "description": "Active record in the path incident for the addressed workbook view. Foreign-incident, deleted, wrong-view, or wrong-type records fail before row-version evaluation."
              },
              "base_row_version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "kind",
              "record_id",
              "base_row_version"
            ]
          }
        ]
      },
      "WorkbookClipboardPasteRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "view_schema_id": {
            "type": "string",
            "enum": [
              "cartulary.view.timeline.v2",
              "cartulary.view.hosts.v1",
              "cartulary.view.identities.v1"
            ]
          },
          "client_txn_id": {
            "type": "string",
            "minLength": 1
          },
          "clipboard_text": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "enum": [
              "auto",
              "tsv",
              "csv"
            ]
          },
          "start_field_key": {
            "type": "string"
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string"
            }
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/WorkbookClipboardPasteTarget"
            }
          }
        },
        "required": [
          "view_schema_id",
          "client_txn_id",
          "clipboard_text",
          "start_field_key",
          "columns",
          "targets"
        ]
      },
      "WorkbookBulkMutationTarget": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "record_id": {
            "type": "string",
            "format": "uuid",
            "description": "Active Timeline record in the path incident. Foreign-incident, deleted, wrong-view, or wrong-type records fail before row-version evaluation."
          },
          "base_row_version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "record_id",
          "base_row_version"
        ]
      },
      "WorkbookBulkMutationRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "view_schema_id": {
            "const": "cartulary.view.timeline.v2"
          },
          "client_txn_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "fill_down_v1",
              "multi_row_tag_assignment_v1"
            ]
          },
          "field_key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "tag_name": {
            "type": "string"
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/WorkbookBulkMutationTarget"
            }
          }
        },
        "required": [
          "view_schema_id",
          "client_txn_id",
          "kind",
          "targets"
        ]
      },
      "WorkbookBatchMutationData": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "view_schema_id": {
            "type": "string"
          },
          "change_set_id": {
            "type": "string",
            "format": "uuid"
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ViewRow"
            }
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "view_schema_id",
          "rows"
        ]
      },
      "WorkbookBatchMutationEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/WorkbookBatchMutationData"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "RecordConflictClearData": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "view_schema_id": {
            "type": "string"
          },
          "row": {
            "$ref": "#/components/schemas/ViewRow"
          }
        },
        "required": [
          "view_schema_id",
          "row"
        ]
      },
      "RecordConflictClearEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/RecordConflictClearData"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      }
    }
  }
}
