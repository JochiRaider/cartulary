{
  "paths": {
    "/api/v1/incidents/{incident_id}/views/{view_schema_id}/rows": {
      "parameters": [
        {
          "$ref": "#/components/parameters/IncidentIDPathParameter"
        },
        {
          "$ref": "#/components/parameters/ViewSchemaIDPathParameter"
        }
      ],
      "post": {
        "tags": [
          "workbook"
        ],
        "operationId": "createViewRow",
        "summary": "Create one row through the view-scoped row-create route for writable workbook surfaces.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/TimelineCreateRequest"
                  },
                  {
                    "$ref": "#/components/schemas/HostCreateRequest"
                  },
                  {
                    "$ref": "#/components/schemas/IdentityCreateRequest"
                  },
                  {
                    "$ref": "#/components/schemas/IndicatorCreateRequest"
                  },
                  {
                    "$ref": "#/components/schemas/AssessmentCreateRequest"
                  },
                  {
                    "$ref": "#/components/schemas/EvidenceCreateRequest"
                  },
                  {
                    "$ref": "#/components/schemas/NoteCreateRequest"
                  },
                  {
                    "$ref": "#/components/schemas/TaskRequestCreateRequest"
                  },
                  {
                    "$ref": "#/components/schemas/DecisionCreateRequest"
                  },
                  {
                    "$ref": "#/components/schemas/PartyCreateRequest"
                  },
                  {
                    "$ref": "#/components/schemas/CommLogCreateRequest"
                  },
                  {
                    "$ref": "#/components/schemas/HandoffCreateRequest"
                  },
                  {
                    "$ref": "#/components/schemas/StatusReviewCreateRequest"
                  },
                  {
                    "$ref": "#/components/schemas/LessonCreateRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent view row-create replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewMutationEnvelope"
                }
              }
            }
          },
          "201": {
            "description": "Created view row refresh",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewMutationEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
    "/api/v1/incidents/{incident_id}/views/{view_schema_id}/clipboard-paste": {
      "parameters": [
        {
          "$ref": "#/components/parameters/IncidentIDPathParameter"
        },
        {
          "$ref": "#/components/parameters/ViewSchemaIDPathParameter"
        }
      ],
      "post": {
        "tags": [
          "workbook"
        ],
        "operationId": "pasteWorkbookClipboard",
        "summary": "Apply an ephemeral tabular clipboard paste through the shared tabular-ingest mapping contract.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkbookClipboardPasteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Clipboard paste batch response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkbookBatchMutationEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Entity exact-match conflict, row-version conflict, or idempotency conflict. Paste-time same-field conflicts are returned as 200 batch result conflicts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    },
    "/api/v1/incidents/{incident_id}/views/{view_schema_id}/bulk-mutations": {
      "parameters": [
        {
          "$ref": "#/components/parameters/IncidentIDPathParameter"
        },
        {
          "$ref": "#/components/parameters/ViewSchemaIDPathParameter"
        }
      ],
      "post": {
        "tags": [
          "workbook"
        ],
        "operationId": "applyWorkbookBulkMutation",
        "summary": "Apply an explicit workbook bulk mutation batch such as fill-down or multi-row tag assignment.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkbookBulkMutationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bulk mutation batch response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkbookBatchMutationEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Same-field conflict batch, row-version conflict, or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          },
          {
            "bearerSession": []
          }
        ]
      }
    }
  }
}
