{
  "components": {
    "schemas": {
      "WorkbookQueryMeta": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "type": "string"
          },
          "paging": {
            "$ref": "#/components/schemas/PagingMeta"
          },
          "query": {
            "$ref": "#/components/schemas/WorkbookQueryMetaQuery"
          }
        },
        "required": [
          "request_id",
          "query"
        ]
      },
      "WorkbookQueryMetaQuery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sort": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SortEntry"
            }
          },
          "filters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ViewQueryFilter"
            }
          },
          "group_by": {
            "type": "string"
          }
        },
        "required": [
          "sort",
          "filters"
        ]
      }
    }
  }
}
