            "sessionCookie": []
          },
          {
            "bearerSession": []
          }
        ]
      },
      "put": {
        "tags": [
          "workbook-preferences"
        ],
        "operationId": "putIncidentDefaultWorkbookPreferences",
        "summary": "Set or clear the incident-wide default workbook sheet reference.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DefaultWorkbookPreferencesPutRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Incident default workbook preferences response",
