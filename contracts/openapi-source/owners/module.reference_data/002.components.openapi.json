{
  "components": {
    "schemas": {
      "ReferencePackImportUploadRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/ReferencePackImportMetadata"
          },
          "file": {
            "type": "string",
            "format": "binary"
          }
        },
        "required": [
          "metadata",
          "file"
        ]
      },
      "ReferencePackImportMetadata": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "client_txn_id": {
            "type": "string"
          },
          "activation_policy": {
            "type": "string",
            "enum": [
              "staged_only"
            ]
          }
        },
        "required": [
          "client_txn_id"
        ]
      },
      "ReferencePackActionRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "client_txn_id": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "client_txn_id"
        ]
      },
      "ReferencePackRefreshRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "client_txn_id": {
            "type": "string"
          },
          "pack_keys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "client_txn_id"
        ]
      },
      "ReferencePackVersionState": {
        "type": "string",
        "enum": [
          "staged",
          "verified_available",
          "disabled",
          "failed",
          "missing"
        ]
      },
      "ReferencePackVerificationResult": {
        "type": "string",
        "enum": [
          "pending",
          "passed",
          "failed"
        ]
      },
      "ReferencePackVersionResource": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pack_key": {
            "type": "string"
          },
          "pack_kind": {
            "type": "string"
          },
          "pack_version": {
            "type": "string"
          },
          "pack_version_state": {
            "$ref": "#/components/schemas/ReferencePackVersionState"
          },
          "active": {
            "type": "boolean"
          },
          "source_identifier": {
            "type": [
              "string",
              "null"
            ]
          },
          "manifest_sha256": {
            "type": "string"
          },
          "payload_sha256": {
            "type": "string"
          },
          "pack_contract_version": {
            "type": "string"
          },
          "verification_method": {
            "type": "string"
          },
          "verification_result": {
            "$ref": "#/components/schemas/ReferencePackVerificationResult"
          },
          "signer_key_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "previous_active_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "imported_by_user_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "imported_at": {
            "type": "string",
            "format": "date-time"
          },
          "activated_by_user_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "activated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "pack_key",
          "pack_kind",
          "pack_version",
          "pack_version_state",
          "active",
          "source_identifier",
          "manifest_sha256",
          "payload_sha256",
          "pack_contract_version",
          "verification_method",
          "verification_result",
          "signer_key_id",
          "previous_active_version",
          "imported_by_user_id",
          "imported_at",
          "activated_by_user_id",
          "activated_at"
        ]
      },
      "ReferencePackListEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pack_versions": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ReferencePackVersionResource"
                }
              }
            },
            "required": [
              "pack_versions"
            ]
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "ReferencePackVersionEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ReferencePackVersionResource"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "ReferencePackActionEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pack_version": {
                "$ref": "#/components/schemas/ReferencePackVersionResource"
              }
            },
            "required": [
              "pack_version"
            ]
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      }
    }
  }
}
