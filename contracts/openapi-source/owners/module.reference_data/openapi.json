                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 256
              },
              "actual_token": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 256
              },
              "related_pack_key": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 128
              },
              "related_pack_version": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      },
      "ReferencePackValidationSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_id",
          "result",
          "primary_issue_id",
          "issues_truncated",
          "total_issue_count",
          "retained_issue_count",
          "issues"
        ],
        "properties": {
          "schema_id": {
            "const": "cartulary.reference_pack_validation_summary.v1"
          },
          "result": {
            "enum": [
              "succeeded",
              "failed"
            ]
          },
          "primary_issue_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^rpi_[0-9a-f]{64}$"
          },
          "issues_truncated": {
            "type": "boolean"
          },
          "total_issue_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "retained_issue_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "issues": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/ReferencePackIssue"
            }
          }
        }
      },
      "ReferencePackValidationSummaryEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ReferencePackValidationSummary"
          },
          "meta": {
            "$ref": "#/components/schemas/EnvelopeMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      }
