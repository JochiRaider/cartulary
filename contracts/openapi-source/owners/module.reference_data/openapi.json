      "ReferencePackIssue": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "check_id",
          "severity",
          "phase",
          "code",
          "reason_code",
          "path",
          "entry_id",
          "safe_details"
        ],
        "properties": {
          "issue_id": {
            "type": "string",
            "pattern": "^rpi_[0-9a-f]{64}$"
          },
          "check_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "severity": {
            "const": "error"
          },
          "phase": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "code": {
            "type": "string",
