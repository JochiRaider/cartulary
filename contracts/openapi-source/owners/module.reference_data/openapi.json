  "components": {
    "schemas": {
      "ReferencePackImportUploadRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/ReferencePackImportMetadata"
          },
          "file": {
            "type": "string",
            "format": "binary"
          }
        },
        "required": [
          "metadata",
          "file"
        ]
      },
      "ReferencePackImportMetadata": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "client_txn_id": {
            "type": "string"
          },
          "activation_policy": {
            "type": "string",
            "enum": [
              "staged_only"
            ]
          }
        },
        "required": [
          "client_txn_id"
        ]
      },
      "ReferencePackActionRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "client_txn_id": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096
          }
        },
        "required": [
          "client_txn_id"
        ]
      },
      "ReferencePackRefreshRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "client_txn_id": {
            "type": "string"
          },
          "pack_keys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "client_txn_id"
        ]
      },
      "ReferencePackVersionState": {
        "type": "string",
        "enum": [
          "staged",
          "verified_available",
          "disabled",
          "failed",
          "missing"
        ]
      },
      "ReferencePackVersionResource": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pack_key": {
            "type": "string"
          },
          "pack_kind": {
            "type": "string"
          },
          "pack_version": {
            "type": "string"
          },
          "pack_version_state": {
            "$ref": "#/components/schemas/ReferencePackVersionState"
          },
          "health": {
            "type": "string",
            "enum": [
              "staged",
              "verified_available",
              "failed",
              "missing"
            ]
          },
          "administratively_disabled": {
            "type": "boolean"
          },
          "distribution_kind": {
            "type": "string",
            "enum": [
              "operator_imported",
              "packaged_builtin"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "removed": {
            "type": "boolean"
          },
          "missing_reason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "staging_loss",
              "storage_loss",
              "administrative_removal"
            ]
          },
          "last_failure_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_identifier": {
            "type": [
              "string",
              "null"
            ]
          },
          "manifest_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "payload_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "pack_contract_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_profile_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_profile_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "verification_method": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_verified_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "trust_valid_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "verified_signer_key_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "uniqueItems": true,
            "maxItems": 64
          },
          "imported_by_user_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "imported_at": {
            "type": "string",
            "format": "date-time"
          },
          "previous_active_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "activated_by_user_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "activated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "pack_release_sequence": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "source_profile_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9._:-]{1,192}$"
          },
          "source_profile_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_version": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256,
            "minLength": 1
          },
          "source_as_of": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "license_expression": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024,
            "minLength": 1
          },
          "redistribution": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "allowed",
              "restricted",
              "prohibited"
            ]
          },
          "trust_repository_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "pending_work": {
            "type": "boolean"
          },
          "reproducibility_pinned": {
            "type": "boolean"
          },
          "fallback_from_version": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "dependencies": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "properties": {
                "pack_key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,31}(\\.[a-z][a-z0-9_]{0,31}){1,7}$",
                  "minLength": 3,
                  "maxLength": 128
                },
                "pack_version": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
                },
                "payload_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "pack_key",
