          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "scope": {
            "type": "string",
            "enum": [
              "private",
              "shared"
            ]
          },
          "query_json": {
            "$ref": "#/components/schemas/SavedViewCreateQueryJSON"
          },
          "layout_json": {
            "$ref": "#/components/schemas/SavedViewCreateLayoutJSON"
          }
        },
        "required": [
          "view_schema_id",
          "display_name",
          "query_json"
        ]
      },
      "SavedViewPatchRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "base_saved_view_version": {
            "type": "integer",
            "minimum": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "scope": {
            "type": "string",
            "enum": [
              "private",
              "shared"
            ]
          },
          "query_json": {
            "$ref": "#/components/schemas/SavedViewCreateQueryJSON"
          },
          "layout_json": {
            "$ref": "#/components/schemas/SavedViewCreateLayoutJSON"
          }
        },
        "required": [
          "base_saved_view_version"
        ]
      },
      "SavedViewCreateQueryJSON": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sort": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SortEntry"
            }
          },
          "filters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ViewQueryFilter"
            }
          },
          "group_by": {
            "type": "string"
          }
        }
      }
    }
  }
}
