{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cartulary.invalid/contracts/tasksdecisions/source-catalog.v1.schema.json",
  "title": "Cartulary Tasks and Decisions Source Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "catalog_id", "surfaces"],
  "properties": {
    "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
    "schema_id": { "const": "cartulary.tasksdecisions.source_catalog.v1" },
    "catalog_id": { "const": "cartulary.tasksdecisions.sources.v1" },
    "surfaces": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/surface" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "field_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
    "direct_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_key", "column"],
      "properties": {
        "field_key": { "$ref": "#/$defs/field_key" },
        "column": { "$ref": "#/$defs/identifier" },
        "reference_role": { "enum": ["incident_member_user", "same_incident_record"] },
        "expected_target_record_type": { "enum": ["decision", "party"] },
        "mirror_link_type": { "const": "references_record" }
      }
    },
    "collection_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_key", "collection_family", "allowed_operations", "link_type"],
      "properties": {
        "field_key": { "$ref": "#/$defs/field_key" },
        "collection_family": { "const": "record_ref" },
        "allowed_operations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["add_record_ref", "remove_record_ref"] }
        },
        "link_type": { "enum": ["references_record", "supported_by"] },
        "expected_target_record_type": { "enum": ["decision", "evidence", "party", "task_request"] }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view_schema_id", "record_type", "base_projection", "source_table", "revision_snapshot_schema_id", "direct_fields", "collection_fields"],
      "properties": {
        "view_schema_id": { "enum": ["cartulary.view.decisions.v1", "cartulary.view.task_requests.v1"] },
        "record_type": { "enum": ["decision", "task_request"] },
        "base_projection": { "enum": ["decision_grid_projection", "task_request_grid_projection"] },
        "source_table": { "enum": ["decisions", "task_requests"] },
        "revision_snapshot_schema_id": { "enum": ["cartulary.revisions.snapshot.decision.v1", "cartulary.revisions.snapshot.task_request.v1"] },
        "direct_fields": { "type": "array", "items": { "$ref": "#/$defs/direct_field" } },
        "collection_fields": { "type": "array", "items": { "$ref": "#/$defs/collection_field" } }
      }
    }
  }
}
