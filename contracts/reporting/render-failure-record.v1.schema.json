{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.reporting_render_failure_record.v1",
  "description": "Independent retained Reporting render failure. Closed failed-summary branch; canonical bytes, 2 MiB record limit, ordering, reason-specific safety, equality and independent admission bindings are additionally enforced by the typed owner.",
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "cartulary.reporting_render_failure_record.v1"
    },
    "job_id": {
      "$ref": "#/$defs/uuid"
    },
    "job_kind": {
      "enum": [
        "snapshot_reporting.release_create_v4",
        "snapshot_reporting.composition_preview_v4"
      ]
    },
    "incident_id": {
      "$ref": "#/$defs/uuid"
    },
    "actor_user_id": {
      "$ref": "#/$defs/uuid"
    },
    "admitted_at": {
      "$ref": "#/$defs/timestamp"
    },
    "request_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "input_binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/input_binding"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "required": [
    "schema_id",
    "job_id",
    "job_kind",
    "incident_id",
    "actor_user_id",
    "admitted_at",
    "request_sha256",
    "input_binding",
    "summary"
  ],
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_binding": {
      "type": "object",
      "properties": {
        "admission_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "preparation_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "admission_sha256",
        "preparation_sha256"
      ],
      "additionalProperties": false
    },
    "stage": {
      "enum": [
        "route_admission",
        "composition_validation",
        "export_model_materialization",
        "redaction",
        "token_manifest",
        "diagram_model",
        "mermaid_source",
        "mermaid_render",
        "deck_model",
        "slidev_source",
        "slidev_export",
        "bundle_manifest",
        "determinism",
        "security_sandbox",
        "release_state"
      ]
    },
    "failure_code": {
      "enum": [
        "asset_limit_exceeded",
        "authorization_denied",
        "bundle_manifest_invalid",
        "bundle_resource_limit_exceeded",
        "composition_invalid",
        "content_class_missing",
        "deck_model_invalid",
        "export_model_invalid",
        "export_model_resource_limit_exceeded",
        "graph_projection_unavailable",
        "mermaid_invalid",
        "mermaid_render_failed",
        "nondeterministic_render",
        "redaction_manifest_invalid",
        "remote_asset_reference",
        "render_canceled",
        "render_timeout",
        "retained_input_invalid",
        "security_sandbox_violation",
        "slidev_export_failed",
        "slidev_source_invalid",
        "support_ref_limit_exceeded",
        "token_manifest_invalid",
        "undeclared_asset",
        "validation_summary_truncated"
      ]
    },
    "reason_code": {
      "enum": [
        "array_order_invalid",
        "asset_limit_exceeded",
        "atomic_publish_failed",
        "authored_subject_ref_unresolved",
        "authored_text_limit_exceeded",
        "authored_text_not_permitted",
        "authored_title_limit_exceeded",
        "block_kind_not_allowed",
        "blocked_core_dependency",
        "blocks_count_exceeded",
        "bundle_file_mismatch",
        "bundle_manifest_mismatch",
        "bundle_manifest_self_reference",
        "click_export_page_count_mismatch",
        "click_step_limit_exceeded",
        "composition_anchor_ambiguous",
        "composition_anchor_unresolved",
        "composition_digest_mismatch",
        "composition_drop_invalid_for_external_release",
        "composition_duplicate_diagram_insert",
        "composition_not_found",
        "composition_replacement_target_missing",
        "composition_template_mismatch",
        "composition_tuple_incomplete",
        "composition_version_not_found",
        "content_class_missing",
        "dangling_source_ref",
        "dangling_support_ref",
        "deck_title_invalid",
        "deleted_record_not_releasable",
        "diagram_hard_limit_exceeded",
        "diagram_label_override_invalid",
        "diagram_layout_duplicate_target",
        "diagram_layout_invalid",
        "diagram_layout_missing_node_position",
        "diagram_layout_unknown_target",
        "diagram_selection_duplicate_ref",
        "diagram_selection_missing_ref",
        "diagrams_count_exceeded",
        "disclosure_partition_unresolved",
        "duplicate_active_party_assignment",
        "duplicate_array_item",
        "duplicate_export_model_path",
        "duplicate_object_member",
        "duplicate_stable_id",
        "empty_export_model_sections",
        "export_model_canonical_bytes_exceeded",
        "export_model_mismatch",
        "external_reference_in_rendered_output",
        "fields_count_exceeded",
        "graph_projection_ambiguous",
        "graph_projection_digest_mismatch",
        "graph_projection_not_bound",
        "graph_projection_not_completed",
        "graph_projection_selection_unresolved",
        "graph_projection_stale",
        "initiating_actor_unavailable",
        "invalid_asset_declaration",
        "invalid_asset_media_type",
        "invalid_field_value_for_text",
        "invalid_generated_identifier",
        "invalid_mermaid_construct",
        "invalid_multiline_value",
        "invalid_null",
        "invalid_recipient_partition_ref",
        "invalid_scalar_value",
        "invalid_schema_id",
        "invalid_slidev_construct",
        "invalid_speaker_note_sequence",
        "invalid_support_ref",
        "invalid_template_binding_pattern",
        "invalid_template_timeout_key",
        "invalid_timestamp_value",
        "invalid_type",
        "label_length_exceeded",
        "list_nesting_exceeded",
        "live_query_after_export_model",
        "local_asset_bytes_exceeded",
        "local_asset_count_exceeded",
        "local_assets_total_bytes_exceeded",
        "loopback_not_declared",
        "manual_layout_not_supported_for_output_kind",
        "narrative_slot_unbound",
        "no_diagrams_selected",
        "outbound_request_observed",
        "partial_output_cleanup_failed",
        "recipient_partition_profile_mismatch",
        "records_count_exceeded",
        "redaction_action_unresolved",
        "redaction_manifest_mismatch",
        "redaction_profile_invalid",
        "relationships_count_exceeded",
        "remote_asset_reference_invalid",
        "render_canceled",
        "render_runtime_unavailable",
        "render_timeout",
        "rendered_pdf_bytes_exceeded",
        "renderer_process_failed",
        "required_member_missing",
        "required_output_omitted",
        "required_reference_pack_unavailable",
        "required_section_empty",
        "retained_input_mismatch",
        "retained_input_missing",
        "sandbox_observation_missing",
        "sections_count_exceeded",
        "slide_block_limit_exceeded",
        "slide_count_exceeded",
        "snapshot_ref_mismatch",
        "source_only_conflict",
        "source_only_external_release_invalid",
        "speaker_notes_limit_exceeded",
        "subject_limit_exceeded",
        "support_ref_limit_exceeded",
        "template_limit_exceeds_hard_limit",
        "template_manifest_invalid",
        "template_static_future_only",
        "timeline_overflow_unresolved",
        "timeline_sort_key_missing",
        "token_manifest_mismatch",
        "token_subject_not_stable",
        "token_subject_not_unique",
        "toolchain_snapshot_mismatch",
        "undeclared_asset_ref",
        "unknown_object_member",
        "unknown_recipient_partition",
        "unsupported_derivation_algorithm",
        "unsupported_output_kind",
        "unsupported_output_option",
        "unsupported_source_family",
        "unsupported_template_feature",
        "validation_issue_limit_reached",
        "validation_summary_mismatch"
      ]
    },
    "safe_details": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00]+$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00]+$"
        },
        "limit_key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00]+$"
        },
        "template_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00]+$"
        },
        "template_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00]+$"
        },
        "graph_view_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00]+$"
        },
        "projection_result_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00]+$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00]+$"
        },
        "bundle_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00]+$"
        },
        "blocked_core_dependency": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00]+$"
        },
        "composition_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00]+$"
        },
        "composition_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00]+$"
        },
        "composition_op_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00]+$"
        },
        "diagram_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00]+$"
        },
        "network_policy_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00]+$"
        },
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\x00]+$"
            }
          ]
        },
        "actual": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\x00]+$"
            }
          ]
        },
        "output_kind": {
          "enum": [
            "mermaid",
            "slidev"
          ]
        },
        "release_scope": {
          "enum": [
            "internal_draft",
            "internal_review",
            "external_release"
          ]
        },
        "file_role": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00]+$"
        },
        "pre_release": {
          "type": "boolean"
        },
        "composition_anchor_kind": {
          "enum": [
            "section_anchor",
            "record_anchor",
            "block_anchor",
            "diagram_anchor"
          ]
        },
        "ordering_mode": {
          "enum": [
            "projection_output_order",
            "bytewise_ref_sort"
          ]
        },
        "non_loopback_outbound_attempt_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "first_blocked_destination_class": {
          "enum": [
            "dns",
            "tcp",
            "udp",
            "http",
            "https",
            "file",
            "data",
            "javascript",
            "other"
          ]
        },
        "timeout_kind": {
          "enum": [
            "stage",
            "total"
          ]
        },
        "process_group_signal": {
          "enum": [
            "terminate",
            "kill"
          ]
        }
      },
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "properties": {
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "export_model_path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\x00]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "bundle_path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\x00]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "failure_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/failure_code"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/reason_code"
            },
            {
              "type": "null"
            }
          ]
        },
        "safe_details": {
          "$ref": "#/$defs/safe_details"
        }
      },
      "required": [
        "stage",
        "severity",
        "export_model_path",
        "bundle_path",
        "failure_code",
        "reason_code",
        "safe_details"
      ],
      "additionalProperties": false
    },
    "first_failure": {
      "type": "object",
      "properties": {
        "schema_id": {
          "const": "first_failure.v1"
        },
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "export_model_path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\x00]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "bundle_path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\x00]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "failure_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/failure_code"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/reason_code"
            },
            {
              "type": "null"
            }
          ]
        },
        "safe_details": {
          "$ref": "#/$defs/safe_details"
        }
      },
      "required": [
        "schema_id",
        "stage",
        "severity",
        "export_model_path",
        "bundle_path",
        "failure_code",
        "reason_code",
        "safe_details"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "schema_id": {
          "const": "cartulary.reporting_render_validation_summary.v1"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "release_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "const": "failed"
        },
        "terminal_stage": {
          "$ref": "#/$defs/stage"
        },
        "failure_code": {
          "$ref": "#/$defs/failure_code"
        },
        "reason_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/reason_code"
            },
            {
              "type": "null"
            }
          ]
        },
        "safe_details": {
          "$ref": "#/$defs/safe_details"
        },
        "issue_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "first_failure": {
          "$ref": "#/$defs/first_failure"
        }
      },
      "required": [
        "schema_id",
        "created_at",
        "release_id",
        "snapshot_id",
        "result",
        "terminal_stage",
        "failure_code",
        "reason_code",
        "safe_details",
        "issue_count",
        "issues",
        "first_failure"
      ],
      "additionalProperties": false
    }
  }
}
