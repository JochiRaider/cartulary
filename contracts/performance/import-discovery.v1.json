{
  "schema_id": "cartulary.performance_import_discovery_contract.v1",
  "contract_id": "cartulary.performance.import_discovery.v1",
  "criterion_id": "AC-027",
  "fixture_contract_id": "cartulary.performance.large_grid.v1",
  "fixture_profile_id": "timeline_large_grid_import_snapshot_v1",
  "measurement_policy_id": "cartulary.measurement.single_observation.v1",
  "warmup_passes": 0,
  "measured_samples": 1,
  "product_retries": 0,
  "threshold_ms": 1000,
  "threshold_comparison": "lte",
  "view_schema_id": "cartulary.view.timeline.v2",
  "viewport": {
    "width": 1920,
    "height": 1080,
    "device_scale_factor": 1
