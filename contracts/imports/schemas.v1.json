{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cartulary.local/imports/schemas.v1.json",
  "schema_id": "cartulary.imports_contract_schemas.v1",
  "$defs": {
    "ApprovedViewMapping": {
      "x_schema_id": "cartulary.imports.approved_view_mapping.v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_view_schema_id",
        "unknown_column_policy",
        "source_columns"
      ],
      "properties": {
        "target_view_schema_id": {
          "type": "string",
          "minLength": 1
        },
        "unknown_column_policy": {
          "enum": [
            "preserve_raw_capture",
            "preserve_custom_attrs",
            "reject_if_unmapped"
          ]
        },
        "source_columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/SourceColumnMapping"
          }
        }
      }
    },
    "SourceColumnMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_column_ordinal",
        "source_header_text",
        "field_key",
        "transform_id",
        "transform_options",
        "empty_value_policy",
        "entity_binding_mode"
      ],
      "properties": {
        "source_column_ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "source_header_text": {
          "type": "string"
        },
        "field_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "transform_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "transform_options": {
          "type": "object"
        },
        "empty_value_policy": {
          "enum": [
            "omit_field",
            "write_null"
          ]
        },
        "entity_binding_mode": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "OwnerCreateRequest": {
      "x_schema_id": "cartulary.imports.owner_create_request.v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incident_id",
        "actor_user_id",
        "target_view_schema_id",
        "import_session_id",
        "import_unit_id",
        "mapping_fingerprint",
        "source_file_kind",
        "source_content_sha256",
        "parser_profile_id",
        "parser_version",
        "locator_kind",
        "locator",
        "source_rect_a1",
        "source_row_ref",
        "field_values",
        "unknown_values",
        "source_row_provenance"
      ],
      "properties": {
        "incident_id": true,
        "actor_user_id": true,
        "target_view_schema_id": true,
        "import_session_id": true,
        "import_unit_id": true,
        "mapping_fingerprint": true,
        "source_file_kind": true,
        "source_content_sha256": true,
        "parser_profile_id": true,
        "parser_version": true,
        "locator_kind": true,
        "locator": true,
        "source_rect_a1": true,
        "source_row_ref": true,
        "field_values": true,
        "unknown_values": true,
        "source_row_provenance": true
      }
    },
    "OwnerCreateResult": {
      "x_schema_id": "cartulary.imports.owner_create_result.v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "row_version",
        "change_set_mutation_ref",
        "created_or_reused",
        "owner_result_code",
        "row_refresh"
      ],
      "properties": {
        "record_id": true,
        "row_version": true,
        "change_set_mutation_ref": true,
        "created_or_reused": true,
        "owner_result_code": true,
        "row_refresh": true
      }
    },
    "OwnerCreateError": {
      "x_schema_id": "cartulary.imports.owner_create_error.v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_code",
        "retryable",
        "safe_details"
      ],
      "properties": {
        "owner_code": {
          "const": "owner_create_validation_failed"
        },
        "retryable": {
          "const": false
        },
        "safe_details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason_code"
          ],
          "properties": {
            "reason_code": {
              "enum": [
                "field_not_import_writable",
                "collection_owner_support_required",
                "field_not_nullable",
                "invalid_empty_value_policy",
                "invalid_timestamp",
                "invalid_uuid",
                "invalid_exact_uuid",
                "invalid_integer",
                "invalid_boolean",
                "invalid_text"
              ]
            },
            "field": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "guard": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    },
    "AnalyticalFacadeBinding": {
      "x_schema_id": "cartulary.imports.analytical_facade_binding.v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "target_kind",
        "extension_profile_id",
        "owner_contract_ref",
        "facade_id",
        "contract_major",
        "mapping_schema_id",
        "preview_request_schema_id",
        "preview_result_schema_id",
        "apply_request_schema_id",
        "apply_result_schema_id",
        "error_schema_id",
        "error_translation_id",
        "commit_protocol_id"
      ],
      "properties": {
        "schema_id": {
          "const": "cartulary.imports.analytical_facade_binding.v1"
        },
        "target_kind": {
          "type": "string",
          "minLength": 1
        },
        "extension_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "owner_contract_ref": {
          "type": "string",
          "minLength": 1
        },
        "facade_id": {
          "type": "string",
          "minLength": 1
        },
        "contract_major": {
          "type": "integer",
          "minimum": 1
        },
        "mapping_schema_id": {
          "type": "string",
          "minLength": 1
        },
        "preview_request_schema_id": {
          "type": "string",
          "minLength": 1
        },
        "preview_result_schema_id": {
          "type": "string",
          "minLength": 1
        },
        "apply_request_schema_id": {
          "type": "string",
          "minLength": 1
        },
        "apply_result_schema_id": {
          "type": "string",
          "minLength": 1
        },
        "error_schema_id": {
          "type": "string",
          "minLength": 1
        },
        "error_translation_id": {
          "type": "string",
          "minLength": 1
        },
        "commit_protocol_id": {
          "const": "cartulary.imports.unit_commit.v1"
        }
      }
    },
    "ImportTargetRegistry": {
      "x_schema_id": "cartulary.import_target_registry.v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "source_sha256",
        "rows"
      ],
      "properties": {
        "schema_id": {
          "const": "cartulary.import_target_registry.v1"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ImportTargetRegistryRow"
          }
        }
      }
    },
    "ImportTargetRegistryRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_order",
        "target_id",
        "target_kind",
        "target_view_schema_id",
        "extension_profile_id",
        "owner_contract_ref",
        "source_resource_family",
        "facade_kind",
        "facade_binding_id",
        "facade_id",
        "availability_kind",
        "activation_policy",
        "mapping_contract_schema_id",
        "create_request_schema_id",
        "create_result_schema_id",
        "preview_request_schema_id",
        "preview_result_schema_id",
        "apply_request_schema_id",
        "apply_result_schema_id",
        "error_schema_id",
        "error_translation_id",
        "commit_protocol_id",
        "default_unknown_column_policy",
        "entity_bearing_default",
        "public_projection_disposition",
        "row_sha256"
      ],
      "properties": {
        "registry_order": { "type": "integer", "minimum": 0 },
        "target_id": { "type": "string", "minLength": 1 },
        "target_kind": { "enum": ["view_schema", "network_flow_table"] },
        "target_view_schema_id": { "type": ["string", "null"] },
        "extension_profile_id": { "type": ["string", "null"] },
        "owner_contract_ref": { "type": "string", "minLength": 1 },
        "source_resource_family": { "type": "string", "minLength": 1 },
        "facade_kind": { "enum": ["owner_create", "owner_preview_apply"] },
        "facade_binding_id": { "type": ["string", "null"] },
        "facade_id": { "type": ["string", "null"] },
        "availability_kind": { "enum": ["enabled", "reserved", "claim_gated"] },
        "activation_policy": {
          "enum": ["always", "unavailable_reserved", "extension_claim_required"]
        },
        "mapping_contract_schema_id": { "type": "string", "minLength": 1 },
        "create_request_schema_id": { "type": ["string", "null"] },
        "create_result_schema_id": { "type": ["string", "null"] },
        "preview_request_schema_id": { "type": ["string", "null"] },
        "preview_result_schema_id": { "type": ["string", "null"] },
        "apply_request_schema_id": { "type": ["string", "null"] },
        "apply_result_schema_id": { "type": ["string", "null"] },
        "error_schema_id": { "type": "string", "minLength": 1 },
        "error_translation_id": { "type": ["string", "null"] },
        "commit_protocol_id": { "const": "cartulary.imports.unit_commit.v1" },
        "default_unknown_column_policy": { "type": "string", "minLength": 1 },
        "entity_bearing_default": { "type": "string", "minLength": 1 },
        "public_projection_disposition": {
          "enum": ["selectable", "hidden_reserved", "extension_claim_gated"]
        },
        "row_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "oneOf": [
        {
          "properties": {
            "target_kind": { "const": "view_schema" },
            "target_view_schema_id": { "type": "string", "minLength": 1 },
            "extension_profile_id": { "type": "null" },
            "create_request_schema_id": { "type": "string", "minLength": 1 },
            "create_result_schema_id": { "type": "string", "minLength": 1 },
            "preview_request_schema_id": { "type": "null" },
            "preview_result_schema_id": { "type": "null" },
            "apply_request_schema_id": { "type": "null" },
            "apply_result_schema_id": { "type": "null" },
            "error_translation_id": { "type": "null" }
          }
        },
        {
          "properties": {
            "target_kind": { "const": "network_flow_table" },
            "target_view_schema_id": { "type": "null" },
            "extension_profile_id": { "type": "string", "minLength": 1 },
            "create_request_schema_id": { "type": "null" },
            "create_result_schema_id": { "type": "null" },
            "preview_request_schema_id": { "type": "string", "minLength": 1 },
            "preview_result_schema_id": { "type": "string", "minLength": 1 },
            "apply_request_schema_id": { "type": "string", "minLength": 1 },
            "apply_result_schema_id": { "type": "string", "minLength": 1 },
            "error_translation_id": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
