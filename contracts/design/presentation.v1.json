{
  "schema_id": "cartulary.design_presentation.v1",
  "owner_id": "package.ui",
  "verification_id": "package.ui.verification.machine_owned_presentation",
  "initial_loading": {
    "delay_ms": 2000,
    "message": "Still loading this surface",
    "live": "polite",
    "announce_once_per_generation": true,
    "retry_on_delay": false
  },
  "grid_data_state_presentations": [
    {
      "state": "ready",
      "placement": "none",
      "blocking": false,
      "posture": "neutral",
      "live": "none",
      "role": "none",
      "focus_effect": "preserve_focus",
      "row_retention": "show_current_authorized",
      "draft_retention": "show_owner_draft",
      "message_strategy": "none",
      "message": null,
      "action_rule": "none"
    },
    {
      "state": "initial_loading",
      "placement": "grid_body_blocking",
      "blocking": true,
      "posture": "progress",
      "live": "polite",
      "role": "status",
      "focus_effect": "no_automatic_move",
      "row_retention": "show_none",
      "draft_retention": "hide_owner_draft",
      "message_strategy": "loading_surface",
      "message": "Loading {surface_label}…",
      "action_rule": "none"
    },
    {
      "state": "refreshing",
      "placement": "grid_body_compact",
      "blocking": false,
      "posture": "progress",
      "live": "polite",
      "role": "status",
      "focus_effect": "preserve_selection_scroll_and_focus",
      "row_retention": "retain_previously_authorized",
      "draft_retention": "show_owner_draft",
      "message_strategy": "refreshing_surface",
      "message": "Refreshing {surface_label}…",
      "action_rule": "none"
    },
    {
      "state": "empty",
      "placement": "grid_body_compact",
      "blocking": false,
      "posture": "neutral",
      "live": "polite",
      "role": "status",
      "focus_effect": "no_automatic_move",
      "row_retention": "show_none",
      "draft_retention": "show_owner_draft",
      "message_strategy": "owner_message",
      "message": null,
      "action_rule": "owner_optional_create"
    },
    {
      "state": "filtered_empty",
      "placement": "grid_body_compact",
      "blocking": false,
      "posture": "neutral",
      "live": "polite",
      "role": "status",
      "focus_effect": "return_to_grid_after_action_replacement",
      "row_retention": "show_none",
      "draft_retention": "show_owner_draft",
      "message_strategy": "design_message",
      "message": "No rows match the current filters.",
      "action_rule": "clear_filters"
    },
    {
      "state": "stale_error",
      "placement": "grid_body_compact",
      "blocking": false,
      "posture": "caution",
      "live": "assertive",
      "role": "alert",
      "focus_effect": "preserve_selection_scroll_and_focus",
      "row_retention": "retain_previously_authorized",
      "draft_retention": "show_owner_draft",
      "message_strategy": "owner_message_with_design_suffix",
      "message": "Previously loaded rows may be stale.",
      "action_rule": "owner_optional_retry"
    },
    {
      "state": "unavailable",
      "placement": "grid_body_blocking",
      "blocking": true,
      "posture": "error",
      "live": "assertive",
      "role": "alert",
      "focus_effect": "do_not_focus_action_automatically",
      "row_retention": "show_none",
      "draft_retention": "hide_owner_draft",
      "message_strategy": "owner_message",
      "message": null,
      "action_rule": "owner_optional_retry"
    },
    {
      "state": "permission_denied",
      "placement": "grid_body_blocking",
      "blocking": true,
      "posture": "error",
      "live": "assertive",
      "role": "alert",
      "focus_effect": "authenticated_root_recovery",
      "row_retention": "show_none",
      "draft_retention": "clear_protected_draft",
      "message_strategy": "owner_message_or_design_fallback",
      "message": "You no longer have access to this workbook.",
      "action_rule": "none"
    }
  ],
  "grid_interaction_mode_presentations": [
    {
      "mode": "editable",
      "visible": false,
      "posture": "neutral",
      "live": "none",
      "role": "none",
      "focus_effect": "preserve_focus",
      "message_strategy": "none"
    },
    {
      "mode": "read_only",
      "visible": true,
      "posture": "neutral",
      "live": "polite",
      "role": "status",
      "focus_effect": "preserve_focus",
      "message_strategy": "owner_label"
    }
  ],
  "grid_state_composition": {
    "primary": "data_state",
    "co_display_interaction_mode": "read_only",
    "suppress_interaction_for_data_states": ["permission_denied"],
    "live_region_rule": "single_highest_priority_atomic_message"
  },
  "transient_confirmation": {
    "visible_unpaused_ms": 5000,
    "live": "polite",
    "pause_conditions": [
      "document_hidden",
      "keyboard_focus_within",
      "pointer_hover"
    ],
    "resume_resets_elapsed": false,
    "still_valid_action_prevents_dismissal": true
  },
  "status_secondary_priority": [
    "client_txn_conflict",
    "queue_overflow",
    "same_field_conflict",
    "terminal_replay_failure",
    "authentication_required",
    "refresh_paused",
    "queued_or_in_flight"
  ],
  "error_presentations": [
    {
      "family": "local_validation",
      "locus": "affected_editor_or_cell",
      "retention": "retain_committed_value_and_exact_local_draft",
      "actions": ["correct_value", "cancel_draft"],
      "focus_effect": "no_automatic_move",
      "live": "assertive"
    },
    {
      "family": "same_field_conflict",
      "locus": "cell_marker_and_same_surface_resolver",
      "retention": "retain_saved_and_unsaved_values",
      "actions": ["owner_declared_resolution"],
      "focus_effect": "move_only_after_activation_then_return_to_cell",
      "live": "assertive"
    },
    {
      "family": "client_txn_conflict",
      "locus": "same_surface_non_modal_recovery_panel",
      "retention": "retain_blocker_and_later_fifo_units",
      "actions": ["retry_with_new_request_id", "discard_blocked_edit"],
      "focus_effect": "no_automatic_move",
      "live": "polite"
    },
    {
      "family": "queue_overflow",
      "locus": "status_secondary_and_same_surface_overflow_notice",
      "retention": "retain_64_units_and_refuse_65th",
      "actions": ["enter_recovery"],
      "focus_effect": "no_automatic_move",
      "live": "assertive"
    },
    {
      "family": "stale_refresh",
      "locus": "non_blocking_grid_and_status",
      "retention": "retain_previously_authorized_materialization",
      "actions": ["retry"],
      "focus_effect": "preserve_selection_and_focus",
      "live": "assertive"
    },
    {
      "family": "initial_load_failure",
      "locus": "blocking_grid_state",
      "retention": "retain_no_fabricated_rows",
      "actions": ["retry_after_failure"],
      "focus_effect": "do_not_focus_action_automatically",
      "live": "assertive"
    },
    {
      "family": "authentication_required",
      "locus": "same_surface_session_recovery_notice",
      "retention": "retain_local_unsent_work_and_previously_authorized_materialization",
      "actions": ["reauthenticate"],
      "focus_effect": "no_automatic_move",
      "live": "assertive"
    },
    {
      "family": "permission_or_incident_access_loss",
      "locus": "authenticated_root",
      "retention": "clear_protected_materialization",
      "actions": ["return_to_authenticated_root"],
      "focus_effect": "focus_authenticated_root_heading",
      "live": "assertive"
    },
    {
      "family": "extension_unavailable",
      "locus": "ordinary_base_startup_fallback",
      "retention": "clear_extension_state_preserve_base_state",
      "actions": ["run_base_fallback"],
      "focus_effect": "focus_selected_base_surface_heading",
      "live": "assertive"
    },
    {
      "family": "evidence_preview_blocked",
      "locus": "inspector_local_state",
      "retention": "retain_authorized_metadata_without_preview_bytes",
      "actions": ["download_when_separately_authorized"],
      "focus_effect": "preserve_focus",
      "live": "polite"
    },
    {
      "family": "unknown_future_error",
      "locus": "typed_operation_family_and_authorized_materialization_state",
      "retention": "retain_only_verified_authorized_data",
      "actions": [],
      "focus_effect": "no_automatic_move",
      "live": "assertive"
    }
  ]
}
