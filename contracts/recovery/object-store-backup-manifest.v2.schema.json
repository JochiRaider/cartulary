{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.object_store_backup_manifest.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "backup_set_id",
    "consistency_point_at",
    "recovery_state_catalog_sha256",
    "objects",
    "manifest_sha256"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.object_store_backup_manifest.v2" },
    "backup_set_id": { "$ref": "common.v1.schema.json#/$defs/uuid" },
    "consistency_point_at": {
      "$ref": "common.v1.schema.json#/$defs/timestamp"
    },
    "recovery_state_catalog_sha256": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "objects": {
      "type": "array",
      "maxItems": 10485760,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner_id",
          "object_family_id",
          "logical_object_id",
          "storage_key",
          "content_type",
          "plaintext_bytes",
          "plaintext_sha256",
          "artifact_ref"
        ],
        "properties": {
          "owner_id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "object_family_id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "logical_object_id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "storage_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^\\u0000\\r\\n]+$"
          },
          "content_type": {
            "$ref": "common.v1.schema.json#/$defs/content_type"
          },
          "plaintext_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "plaintext_sha256": {
            "$ref": "common.v1.schema.json#/$defs/sha256"
          },
          "artifact_ref": {
            "$ref": "common.v1.schema.json#/$defs/logical_ref"
          }
        }
      }
    },
    "manifest_sha256": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    }
  }
}
