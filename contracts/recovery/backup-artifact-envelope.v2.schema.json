{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.backup_artifact_envelope.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "logical_ref",
    "content_type",
    "kdf",
    "cipher",
    "salt_base64",
    "nonce_prefix_base64",
    "chunk_plaintext_bytes",
    "chunks"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.backup_artifact_envelope.v2" },
    "logical_ref": { "$ref": "common.v1.schema.json#/$defs/logical_ref" },
    "content_type": { "$ref": "common.v1.schema.json#/$defs/content_type" },
    "kdf": { "const": "hkdf_sha256_v1" },
    "cipher": { "const": "aes_256_gcm_chunked_v1" },
    "salt_base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    },
    "nonce_prefix_base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{11}=$"
    },
    "chunk_plaintext_bytes": { "const": 4194304 },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4294967296,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "plaintext_length",
          "final",
          "ciphertext_base64"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "plaintext_length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4194304
          },
          "final": { "type": "boolean" },
          "ciphertext_base64": {
            "type": "string",
            "minLength": 24,
            "maxLength": 5592428,
            "pattern": "^[A-Za-z0-9+/]*={0,2}$"
          }
        }
      }
    }
  }
}
