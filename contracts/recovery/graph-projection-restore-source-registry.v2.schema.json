{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.graph_projection_restore_source_registry.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "entries"],
  "properties": {
    "schema_id": { "const": "cartulary.graph_projection_restore_source_registry.v2" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_registration_id", "source_owner_id", "authoritative_family_id", "enumerator_binding_id", "validity_binding_id", "projection_input_contract_id", "projection_result_contract_id", "status"],
        "properties": {
          "source_registration_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
          "source_owner_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
          "authoritative_family_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
          "enumerator_binding_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
          "validity_binding_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
          "projection_input_contract_id": { "$ref": "common.v1.schema.json#/$defs/schema_id" },
          "projection_result_contract_id": { "$ref": "common.v1.schema.json#/$defs/schema_id" },
          "status": { "const": "active" }
        }
      }
    }
  }
}
