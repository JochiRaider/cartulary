    },
    "entries": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_registration_id",
          "source_owner_id",
          "enumerator_binding_id",
          "validity_binding_id",
          "projection_input_contract_id",
          "implementation_binding_id",
          "status",
          "introduced_at",
          "retired_at"
