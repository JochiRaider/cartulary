        "properties": {
          "source_registration_id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "source_owner_id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "enumerator_binding_id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "validity_binding_id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "projection_input_contract_id": {
            "$ref": "common.v1.schema.json#/$defs/schema_id"
          },
          "implementation_binding_id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "status": { "enum": ["active", "retired"] },
          "introduced_at": {
            "$ref": "common.v1.schema.json#/$defs/timestamp"
          },
          "retired_at": {
            "$ref": "common.v1.schema.json#/$defs/nullable_timestamp"
          }
        }
      }
    }
  }
}
