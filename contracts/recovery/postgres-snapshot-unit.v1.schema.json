{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.postgres_snapshot_unit.v1",
  "description": "One schema for each canonical NDJSON record in a snapshot unit.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "record_kind", "table_name"],
      "properties": {
        "schema_id": { "const": "cartulary.postgres_snapshot_unit.v1" },
        "record_kind": { "const": "header" },
        "table_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "record_kind", "row"],
      "properties": {
        "schema_id": { "const": "cartulary.postgres_snapshot_unit.v1" },
        "record_kind": { "const": "row" },
        "row": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 4096
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "record_kind",
        "row_count",
        "rows_sha256"
      ],
      "properties": {
        "schema_id": { "const": "cartulary.postgres_snapshot_unit.v1" },
        "record_kind": { "const": "trailer" },
        "row_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "rows_sha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        }
      }
    }
  ]
}
