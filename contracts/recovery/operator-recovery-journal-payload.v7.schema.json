{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.operator_recovery_journal_payload.v7",
  "$defs": {
    "restore_generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_generation_id",
        "recovery_state_catalog_sha256",
        "codec_registry_sha256"
      ],
      "properties": {
        "target_generation_id": {
          "$ref": "common.v2.schema.json#/$defs/uuid"
        },
        "recovery_state_catalog_sha256": {
          "$ref": "common.v2.schema.json#/$defs/sha256"
        },
        "codec_registry_sha256": {
          "$ref": "common.v2.schema.json#/$defs/sha256"
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "record_kind",
        "operation_id",
        "operation",
        "attempt_id",
        "started_at",
        "backup_set_id",
        "consistency_point_at",
        "artifact_kinds"
      ],
      "properties": {
        "schema_id": {
          "const": "cartulary.operator_recovery_journal_payload.v7"
        },
        "record_kind": {
          "const": "admission"
        },
        "operation_id": {
          "$ref": "common.v2.schema.json#/$defs/uuid"
        },
        "operation": {
          "$ref": "common.v2.schema.json#/$defs/operation"
        },
        "attempt_id": {
          "$ref": "common.v2.schema.json#/$defs/nullable_identifier"
        },
        "started_at": {
          "$ref": "common.v2.schema.json#/$defs/timestamp"
        },
        "backup_set_id": {
          "$ref": "common.v2.schema.json#/$defs/nullable_uuid"
        },
        "consistency_point_at": {
          "$ref": "common.v2.schema.json#/$defs/nullable_timestamp"
        },
        "artifact_kinds": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "common.v2.schema.json#/$defs/identifier"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "record_kind",
        "operation_id",
        "operation",
        "attempt_id",
        "started_at",
        "completed_at",
        "result",
        "backup_set_id",
        "consistency_point_at",
        "artifact_counts",
        "error_code",
        "error_reason",
        "restore_generation",
        "target_binding_digests"
      ],
      "properties": {
        "schema_id": {
          "const": "cartulary.operator_recovery_journal_payload.v7"
        },
        "record_kind": {
          "const": "completion"
        },
        "operation_id": {
          "$ref": "common.v2.schema.json#/$defs/uuid"
        },
        "operation": {
          "$ref": "common.v2.schema.json#/$defs/operation"
        },
        "attempt_id": {
          "$ref": "common.v2.schema.json#/$defs/nullable_identifier"
        },
        "started_at": {
          "$ref": "common.v2.schema.json#/$defs/timestamp"
        },
        "completed_at": {
          "$ref": "common.v2.schema.json#/$defs/timestamp"
        },
        "result": {
          "$ref": "common.v2.schema.json#/$defs/result"
        },
        "backup_set_id": {
          "$ref": "common.v2.schema.json#/$defs/nullable_uuid"
        },
        "consistency_point_at": {
          "$ref": "common.v2.schema.json#/$defs/nullable_timestamp"
        },
        "artifact_counts": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "common.v2.schema.json#/$defs/artifact_count"
          }
        },
        "error_code": {
          "$ref": "common.v2.schema.json#/$defs/error_code"
        },
        "error_reason": {
          "$ref": "common.v2.schema.json#/$defs/error_reason"
        },
        "target_binding_digests": {
          "oneOf": [
            {
              "$ref": "common.v2.schema.json#/$defs/binding_digests_v3"
            },
            {
              "type": "null"
            }
          ]
        },
        "restore_generation": {
          "oneOf": [
            {
              "$ref": "#/$defs/restore_generation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "allOf": [
              {
                "anyOf": [
                  {
                    "properties": {
                      "operation": {
                        "enum": [
                          "restore_latest",
                          "restore_bundle",
                          "restore_verify_latest"
                        ]
                      }
                    }
                  },
                  {
                    "properties": {
                      "operation": {
                        "const": "restore_verify_due"
                      },
                      "attempt_id": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              {
                "properties": {
                  "result": {
                    "not": {
                      "const": "no_op"
                    }
                  }
                }
              }
            ]
          },
          "then": {
            "if": {
              "properties": {
                "restore_generation": {
                  "type": "object"
                }
              }
            },
            "then": {
              "properties": {
                "restore_generation": {
                  "$ref": "#/$defs/restore_generation"
                },
                "target_binding_digests": {
                  "$ref": "common.v2.schema.json#/$defs/binding_digests_v3"
                },
                "backup_set_id": {
                  "$ref": "common.v2.schema.json#/$defs/uuid"
                },
                "consistency_point_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "else": {
              "allOf": [
                {
                  "properties": {
                    "restore_generation": {
                      "type": "null"
                    },
                    "target_binding_digests": {
                      "type": "null"
                    }
                  }
                },
                {
                  "properties": {
                    "result": {
                      "not": {
                        "const": "succeeded"
                      }
                    }
                  }
                }
              ]
            }
          },
          "else": {
            "properties": {
              "restore_generation": {
                "type": "null"
              },
              "target_binding_digests": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  ]
}
