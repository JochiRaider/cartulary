{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.graph_projection_restore_implementation_binding.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "algorithm_id",
    "binding_id",
    "graph_projection_contract_id",
    "recovery_state_catalog_sha256",
    "source_registry_sha256",
    "graph_table_ids",
    "graph_engine_algorithm_ids",
    "graph_engine_algorithm_digests",
    "database_schema_lineage",
    "database_schema_head",
    "packaged_subject_sha256",
    "build_provenance_sha256"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.graph_projection_restore_implementation_binding.v1"
    },
    "algorithm_id": { "const": "graphprojection.restore_rebuild.v1" },
    "binding_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "graph_projection_contract_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "recovery_state_catalog_sha256": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "source_registry_sha256": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "graph_table_ids": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "common.v1.schema.json#/$defs/identifier" }
    },
    "graph_engine_algorithm_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "common.v1.schema.json#/$defs/identifier" }
    },
    "graph_engine_algorithm_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "common.v1.schema.json#/$defs/sha256" }
    },
    "database_schema_lineage": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "database_schema_head": {
      "type": "integer",
      "minimum": 22,
      "maximum": 9223372036854775807
    },
    "packaged_subject_sha256": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "build_provenance_sha256": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    }
  }
