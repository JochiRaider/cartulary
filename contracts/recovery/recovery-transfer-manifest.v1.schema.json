{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.recovery_transfer_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "application_crypto_format",
    "release_sha256",
    "generation",
    "selection",
    "artifacts",
    "exported_at"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.recovery_transfer_manifest.v1"
    },
    "application_crypto_format": {
      "const": "cartulary.application_crypto_format.v1"
    },
    "release_sha256": {
      "$ref": "common.v2.schema.json#/$defs/sha256"
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recovery_state_catalog_sha256",
        "codec_registry_sha256",
        "graph_source_registry_sha256",
        "graph_implementation_binding_sha256",
        "graph_algorithm_id"
      ],
      "properties": {
        "recovery_state_catalog_sha256": {
          "$ref": "common.v2.schema.json#/$defs/sha256"
        },
        "codec_registry_sha256": {
          "$ref": "common.v2.schema.json#/$defs/sha256"
        },
        "graph_source_registry_sha256": {
          "$ref": "common.v2.schema.json#/$defs/sha256"
        },
        "graph_implementation_binding_sha256": {
          "$ref": "common.v2.schema.json#/$defs/sha256"
        },
        "graph_algorithm_id": {
          "$ref": "common.v2.schema.json#/$defs/identifier"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backup_set_id",
        "consistency_point_at",
        "created_at",
        "retained_until",
        "postgres",
        "objects",
        "integrity"
      ],
      "properties": {
        "backup_set_id": {
          "$ref": "common.v2.schema.json#/$defs/uuid"
        },
        "consistency_point_at": {
          "$ref": "common.v2.schema.json#/$defs/timestamp"
        },
        "created_at": {
          "$ref": "common.v2.schema.json#/$defs/timestamp"
        },
        "retained_until": {
          "$ref": "common.v2.schema.json#/$defs/timestamp"
        },
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "size_bytes",
            "sha256"
          ],
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "$ref": "common.v2.schema.json#/$defs/sha256"
            }
          }
        },
        "objects": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "size_bytes",
            "sha256"
          ],
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "$ref": "common.v2.schema.json#/$defs/sha256"
            }
          }
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "size_bytes",
            "sha256"
          ],
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "$ref": "common.v2.schema.json#/$defs/sha256"
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "$ref": "common.v2.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "exported_at": {
      "$ref": "common.v2.schema.json#/$defs/timestamp"
    }
  }
}
