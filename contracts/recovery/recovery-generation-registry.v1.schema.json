{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.recovery_generation_registry.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "generations"],
  "properties": {
    "schema_id": { "const": "cartulary.recovery_generation_registry.v1" },
    "generations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/generation" }
    }
  },
  "$defs": {
    "artifact_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "schema_id", "canonical_sha256"],
      "properties": {
        "artifact_path": {
          "type": "string",
          "pattern": "^fixtures/[a-z0-9][a-z0-9.-]*\\.json$"
        },
        "schema_id": { "$ref": "common.v1.schema.json#/$defs/schema_id" },
        "canonical_sha256": { "$ref": "common.v1.schema.json#/$defs/sha256" }
      }
    },
    "catalog_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_path",
        "schema_id",
        "canonical_sha256",
        "catalog_digest_sha256",
        "contribution_count",
        "authored_table_count",
        "required_table_count",
        "object_family_count"
      ],
      "properties": {
        "artifact_path": {
          "type": "string",
          "pattern": "^fixtures/[a-z0-9][a-z0-9.-]*\\.json$"
        },
        "schema_id": { "$ref": "common.v1.schema.json#/$defs/schema_id" },
        "canonical_sha256": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "catalog_digest_sha256": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "contribution_count": { "type": "integer", "minimum": 1, "maximum": 128 },
        "authored_table_count": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "required_table_count": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "object_family_count": { "type": "integer", "minimum": 1, "maximum": 128 }
      }
    },
    "codec_registry_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ids", "digest_sha256"],
      "properties": {
        "schema_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "common.v1.schema.json#/$defs/schema_id" }
        },
        "digest_sha256": { "$ref": "common.v1.schema.json#/$defs/sha256" }
      }
    },
    "graph_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm_id", "source_registry", "implementation_binding"],
      "properties": {
        "algorithm_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "source_registry": { "$ref": "#/$defs/artifact_binding" },
        "implementation_binding": { "$ref": "#/$defs/artifact_binding" }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_id",
        "capture_current",
        "catalog",
        "codec_registry",
        "graph"
      ],
      "properties": {
        "generation_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "capture_current": { "type": "boolean" },
        "catalog": { "$ref": "#/$defs/catalog_binding" },
        "codec_registry": { "$ref": "#/$defs/codec_registry_binding" },
        "graph": { "$ref": "#/$defs/graph_binding" }
      }
    }
  }
}
