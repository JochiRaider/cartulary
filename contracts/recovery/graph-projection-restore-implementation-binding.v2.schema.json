    "algorithm_id": { "const": "graphprojection.restore_rebuild.v2" },
    "binding_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "graph_projection_contract_id": { "const": "cartulary.graph_projection_nlspec.v2.0.0" },
    "recovery_state_catalog_sha256": { "$ref": "common.v1.schema.json#/$defs/sha256" },
