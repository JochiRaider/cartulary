{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.recovery_state_contribution.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "owner_id", "tables", "object_families"],
  "properties": {
    "schema_id": { "const": "cartulary.recovery_state_contribution.v1" },
    "owner_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "tables": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/table" }
    },
    "object_families": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/object_family" }
    }
  },
  "$defs": {
    "state_class": {
      "enum": [
        "authoritative",
        "derived",
        "transient",
        "security_ephemeral",
        "recovery_metadata",
        "migration_metadata"
      ]
    },
    "backup_inclusion": {
      "enum": [
        "authoritative_required",
        "excluded_rebuildable",
        "excluded_transient",
        "excluded_security_state",
        "excluded_recovery_metadata",
        "excluded_schema_metadata"
      ]
    },
    "restore_action": {
      "enum": ["restore", "rebuild", "invalidate", "ignore"]
    },
    "nullable_schema_id": {
      "oneOf": [
        { "$ref": "common.v1.schema.json#/$defs/schema_id" },
        { "type": "null" }
      ]
    },
    "nullable_algorithm_id": {
      "oneOf": [
        { "$ref": "common.v1.schema.json#/$defs/identifier" },
        { "type": "null" }
      ]
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_name",
        "state_class",
        "backup_inclusion",
        "restore_action",
        "codec_id",
        "algorithm_id"
      ],
      "properties": {
        "table_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "state_class": { "$ref": "#/$defs/state_class" },
        "backup_inclusion": { "$ref": "#/$defs/backup_inclusion" },
        "restore_action": { "$ref": "#/$defs/restore_action" },
        "codec_id": { "$ref": "#/$defs/nullable_schema_id" },
        "algorithm_id": { "$ref": "#/$defs/nullable_algorithm_id" }
      }
    },
    "object_family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_family_id",
        "state_class",
        "backup_inclusion",
        "restore_action",
        "inventory_algorithm_id",
        "validation_algorithm_id",
        "restore_algorithm_id"
      ],
      "properties": {
        "object_family_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "state_class": { "$ref": "#/$defs/state_class" },
        "backup_inclusion": { "$ref": "#/$defs/backup_inclusion" },
        "restore_action": { "$ref": "#/$defs/restore_action" },
        "inventory_algorithm_id": {
          "$ref": "#/$defs/nullable_algorithm_id"
        },
        "validation_algorithm_id": {
          "$ref": "#/$defs/nullable_algorithm_id"
        },
        "restore_algorithm_id": {
          "$ref": "#/$defs/nullable_algorithm_id"
        }
      }
    }
  }
}
