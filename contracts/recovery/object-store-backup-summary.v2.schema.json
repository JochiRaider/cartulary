{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.object_store_backup_summary.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "backup_set_id",
    "consistency_point_at",
    "object_count",
    "total_plaintext_bytes",
    "family_counts",
    "manifest_sha256"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.object_store_backup_summary.v2" },
    "backup_set_id": { "$ref": "common.v1.schema.json#/$defs/uuid" },
    "consistency_point_at": {
      "$ref": "common.v1.schema.json#/$defs/timestamp"
    },
    "object_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10485760
    },
    "total_plaintext_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "family_counts": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "common.v1.schema.json#/$defs/artifact_count"
      }
    },
    "manifest_sha256": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    }
  }
}
