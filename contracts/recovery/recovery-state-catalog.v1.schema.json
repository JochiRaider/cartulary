{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.recovery_state_catalog.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "catalog_digest_sha256",
    "contribution_digests",
    "tables",
    "object_families"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.recovery_state_catalog.v1" },
    "catalog_digest_sha256": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "contribution_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner_id", "sha256"],
        "properties": {
          "owner_id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "sha256": { "$ref": "common.v1.schema.json#/$defs/sha256" }
        }
      }
    },
    "tables": {
      "type": "array",
      "minItems": 113,
      "maxItems": 113,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner_id",
          "table_name",
          "state_class",
          "backup_inclusion",
          "restore_action",
          "codec_id",
          "algorithm_id"
        ],
        "properties": {
          "owner_id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "table_name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "state_class": {
            "enum": [
              "authoritative",
              "derived",
              "transient",
              "security_ephemeral",
              "recovery_metadata",
              "migration_metadata"
            ]
          },
          "backup_inclusion": {
            "enum": [
              "authoritative_required",
              "excluded_rebuildable",
              "excluded_transient",
              "excluded_security_state",
              "excluded_recovery_metadata",
              "excluded_schema_metadata"
            ]
          },
          "restore_action": {
            "enum": ["restore", "rebuild", "invalidate", "ignore"]
          },
          "codec_id": {
            "oneOf": [
              { "$ref": "common.v1.schema.json#/$defs/schema_id" },
              { "type": "null" }
            ]
          },
          "algorithm_id": {
            "oneOf": [
              { "$ref": "common.v1.schema.json#/$defs/identifier" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "object_families": {
      "type": "array",
      "minItems": 6,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner_id",
          "object_family_id",
          "state_class",
          "backup_inclusion",
          "restore_action",
          "inventory_algorithm_id",
          "validation_algorithm_id",
          "restore_algorithm_id"
        ],
        "properties": {
          "owner_id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "object_family_id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "state_class": {
            "enum": [
              "authoritative",
              "derived",
              "transient",
              "security_ephemeral",
              "recovery_metadata",
              "migration_metadata"
            ]
          },
          "backup_inclusion": {
            "enum": [
              "authoritative_required",
              "excluded_rebuildable",
              "excluded_transient",
              "excluded_security_state",
              "excluded_recovery_metadata",
              "excluded_schema_metadata"
            ]
          },
          "restore_action": {
            "enum": ["restore", "rebuild", "invalidate", "ignore"]
          },
          "inventory_algorithm_id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "validation_algorithm_id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "restore_algorithm_id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          }
        }
      }
    }
  }
}
