{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.postgres_snapshot_artifact.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "backup_set_id",
    "consistency_point_at",
    "recovery_state_catalog_sha256",
    "transaction_isolation",
    "units",
    "snapshot_sha256"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.postgres_snapshot_artifact.v2" },
    "backup_set_id": { "$ref": "common.v1.schema.json#/$defs/uuid" },
    "consistency_point_at": {
      "$ref": "common.v1.schema.json#/$defs/timestamp"
    },
    "recovery_state_catalog_sha256": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "transaction_isolation": { "const": "repeatable_read_read_only" },
    "units": {
      "type": "array",
      "minItems": 84,
      "maxItems": 84,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "table_name",
          "codec_id",
          "logical_ref",
          "row_count",
          "plaintext_bytes",
          "plaintext_sha256"
        ],
        "properties": {
          "table_name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "codec_id": { "const": "cartulary.postgres_snapshot_unit.v1" },
          "logical_ref": {
            "$ref": "common.v1.schema.json#/$defs/logical_ref"
          },
          "row_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "plaintext_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "plaintext_sha256": {
            "$ref": "common.v1.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "snapshot_sha256": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    }
  }
}
