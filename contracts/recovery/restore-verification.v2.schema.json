{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.restore_verification.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "verification_attempt_id",
    "backup_set_id",
    "consistency_point_at",
    "verification_basis",
    "verification_basis_sha256",
    "recovery_state_catalog_sha256",
    "codec_registry_sha256",
    "manifest_sha256",
    "restored_object_count",
    "selected_incident_id",
    "workbook_probe",
    "result",
    "completed_at"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.restore_verification.v2" },
    "verification_attempt_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "backup_set_id": { "$ref": "common.v1.schema.json#/$defs/uuid" },
    "consistency_point_at": {
      "$ref": "common.v1.schema.json#/$defs/timestamp"
    },
    "verification_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanism_id",
        "database_binding_sha256",
        "object_store_binding_sha256",
        "backup_storage_binding_sha256",
        "recovery_state_catalog_sha256",
        "codec_registry_sha256"
      ],
      "properties": {
        "mechanism_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "database_binding_sha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "object_store_binding_sha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "backup_storage_binding_sha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "recovery_state_catalog_sha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "codec_registry_sha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "verification_basis_sha256": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "recovery_state_catalog_sha256": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "codec_registry_sha256": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "manifest_sha256": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "restored_object_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10485760
    },
    "selected_incident_id": {
      "$ref": "common.v1.schema.json#/$defs/nullable_uuid"
    },
    "workbook_probe": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "skipped" },
            "reason": {
              "enum": [
                "no_incidents",
                "verification_failed_before_probe"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "registration_id",
            "view_schema_id",
            "row_count"
          ],
          "properties": {
            "status": { "const": "executed" },
            "registration_id": {
              "$ref": "common.v1.schema.json#/$defs/identifier"
            },
            "view_schema_id": { "const": "cartulary.view.timeline.v2" },
            "row_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          }
        }
      ]
    },
    "result": { "enum": ["pass", "fail"] },
    "completed_at": { "$ref": "common.v1.schema.json#/$defs/timestamp" }
  }
}
