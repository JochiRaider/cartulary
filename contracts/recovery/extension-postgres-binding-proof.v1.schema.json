{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.extension_postgres_binding_proof.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "profile_id",
    "binding_id",
    "physical_state_binding_sha256",
    "implementation_binding_sha256",
    "backup_codec_id",
    "backup_codec_sha256",
    "storage_kind",
    "item_count",
    "content_bytes",
    "binding_digest"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.extension_postgres_binding_proof.v1"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "binding_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 129,
      "pattern": "^[a-z][a-z0-9_]{0,63}\\.[a-z][a-z0-9_]{0,63}$"
    },
    "physical_state_binding_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "implementation_binding_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "backup_codec_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
    },
    "backup_codec_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "storage_kind": {
      "const": "postgres"
    },
    "item_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "content_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "binding_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
