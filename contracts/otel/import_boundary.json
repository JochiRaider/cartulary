  "observed_module_graph_notes": [
    {
      "package": "go.opentelemetry.io/contrib/instrumentation/net/http/otelhttp",
      "source": "github.com/testcontainers/testcontainers-go -> github.com/moby/moby/client",
      "runtime_boundary_effect": "test support transitive module graph only; no authored Cartulary runtime import"
    },
    {
      "package": "go.opentelemetry.io/auto/sdk",
      "source": "github.com/testcontainers/testcontainers-go -> github.com/moby/moby/client -> otelhttp",
      "runtime_boundary_effect": "test support transitive module graph only; no authored Cartulary runtime import"
