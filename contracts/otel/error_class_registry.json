  "additional_error_classes": [
    { "error_class": "timeout", "scope": "Dependency or exporter timeout." },
    { "error_class": "serialization_conflict", "scope": "Database serialization conflict." },
    { "error_class": "constraint_violation", "scope": "Safe data-integrity constraint class after redaction." },
    { "error_class": "invariant_violation", "scope": "Server-side persisted metadata or internal state violates an owner-defined invariant before a backend dependency call is allowed." },
    { "error_class": "exporter_transient", "scope": "Retryable exporter transport/status class." },
    { "error_class": "exporter_permanent", "scope": "Non-retryable exporter rejection class." },
    { "error_class": "redaction_rejected", "scope": "Telemetry item dropped because safety could not be proven." },
    { "error_class": "queue_full", "scope": "Telemetry processor overflow class when class is needed rather than cartulary.drop_reason." },
    { "error_class": "shutdown_timeout", "scope": "Telemetry flush exceeded shutdown budget." },
    { "error_class": "recursion_guard", "scope": "Telemetry-about-telemetry recursion prevented." },
    { "error_class": "internal_error", "scope": "Safe non-detail class for internal failures." }
