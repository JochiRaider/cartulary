{
  "schema_id": "cartulary.otel_config_hazard_fixture_matrix.v2",
  "source_owner": "platform.telemetry.verification.current_conformance",
  "materialization_kind": "repo_materialized_from_owner_tables",
  "default_error_code": "invalid_deployment_config",
  "default_reason_code": "invalid_telemetry_config",
  "cross_key_rules": [
    { "id": "OTEL-CFG-001", "fixture_id": "config.cross_key.exporter_endpoint_required", "inputs": ["telemetry.exporter.kind", "telemetry.exporter.endpoint"], "forbidden_effect_assertion": "exporter kind otlp_http or otlp_grpc cannot reach readiness without endpoint", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-CFG-002", "fixture_id": "config.cross_key.exporter_endpoint_forbidden_when_none", "inputs": ["telemetry.exporter.kind", "telemetry.exporter.endpoint"], "forbidden_effect_assertion": "endpoint cannot be retained when telemetry.exporter.kind is none", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-CFG-003", "fixture_id": "config.cross_key.protocol_consistency", "inputs": ["telemetry.exporter.kind", "telemetry.exporter.protocol"], "forbidden_effect_assertion": "enabled exporter kind cannot use divergent protocol", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-CFG-004", "fixture_id": "config.cross_key.batch_bound", "inputs": ["telemetry.processor.max_export_batch_size", "telemetry.processor.max_queue_size"], "forbidden_effect_assertion": "batch size cannot exceed queue size", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-CFG-005", "fixture_id": "config.cross_key.retry_interval_order", "inputs": ["telemetry.exporter.retry.initial_interval_ms", "telemetry.exporter.retry.max_interval_ms"], "forbidden_effect_assertion": "retry max interval cannot be lower than initial interval", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-CFG-006", "fixture_id": "config.cross_key.hmac_secret_required", "inputs": ["telemetry.attribute.incident_correlation", "telemetry.attribute.hmac_secret_ref"], "forbidden_effect_assertion": "hmac incident correlation cannot activate without secret_ref_v1", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-CFG-007", "fixture_id": "config.cross_key.remote_context_forbidden", "inputs": ["telemetry.traces.accept_remote_context"], "forbidden_effect_assertion": "remote context acceptance cannot be enabled", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-CFG-008", "fixture_id": "config.cross_key.unsupported_sampler", "inputs": ["telemetry.traces.sampler_profile"], "forbidden_effect_assertion": "unsupported sampler profiles fail before readiness", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-CFG-008A", "fixture_id": "config.cross_key.sampler_ratio_consistency", "inputs": ["telemetry.traces.sampler_profile", "telemetry.traces.sample_ratio"], "forbidden_effect_assertion": "explicit sampler profile cannot contradict sample_ratio", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-CFG-009", "fixture_id": "config.cross_key.unsupported_protocol", "inputs": ["telemetry.exporter.protocol"], "forbidden_effect_assertion": "unsupported protocol values fail before readiness", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-CFG-010", "fixture_id": "config.cross_key.per_signal_endpoint_absent", "inputs": ["telemetry.exporter.traces.endpoint", "telemetry.exporter.metrics.endpoint", "telemetry.exporter.logs.endpoint"], "forbidden_effect_assertion": "per-signal endpoint keys are not accepted into the effective config", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-CFG-011", "fixture_id": "config.cross_key.per_signal_header_protocol_absent", "inputs": ["telemetry.exporter.traces.headers", "telemetry.exporter.metrics.headers", "telemetry.exporter.logs.headers", "telemetry.exporter.traces.protocol", "telemetry.exporter.metrics.protocol", "telemetry.exporter.logs.protocol"], "forbidden_effect_assertion": "per-signal header and protocol keys are not accepted into the effective config", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-CFG-012", "fixture_id": "config.cross_key.exemplars_disabled", "inputs": ["telemetry.metrics.exemplars.enabled"], "forbidden_effect_assertion": "exemplars cannot be enabled", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-CFG-013", "fixture_id": "config.cross_key.log_body_bound", "inputs": ["telemetry.logs.body_max_chars"], "forbidden_effect_assertion": "log body bound outside 0..8192 fails before readiness", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-CFG-014", "fixture_id": "config.cross_key.otel_env_passthrough_forbidden", "inputs": ["telemetry.otel_env_passthrough"], "forbidden_effect_assertion": "OTel environment passthrough cannot be enabled", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-CFG-015", "fixture_id": "config.cross_key.external_otel_authority_contained", "inputs": ["OTEL_CONFIG_FILE", "OTEL_EXPERIMENTAL_CONFIG_FILE", "autoconfig", "resource_detector", "plugin_provider"], "forbidden_effect_assertion": "external OTel config authority cannot create telemetry components", "evidence": ["internal/platform/config/config_otel_test.go", "contracts/otel/import_boundary.json"] },
    { "id": "OTEL-CFG-016", "fixture_id": "config.cross_key.semconv_env_opt_in_contained", "inputs": ["OTEL_SEMCONV_STABILITY_OPT_IN"], "forbidden_effect_assertion": "semantic-convention opt-in environment cannot alter emitted shape", "evidence": ["internal/platform/config/config_otel_test.go", "contracts/otel/otel_source_snapshot.v1.json"] },
    { "id": "OTEL-CFG-017", "fixture_id": "config.cross_key.resource_schema_url_empty", "inputs": ["effective_resource.schema_url"], "forbidden_effect_assertion": "effective resource schema URL remains empty", "evidence": ["internal/platform/telemetry/resource.go", "internal/platform/telemetry/resource_test.go"] },
    { "id": "OTEL-CFG-018", "fixture_id": "config.cross_key.metric_view_stream_registered", "inputs": ["effective_metric_view.stream_name"], "forbidden_effect_assertion": "unregistered metric view stream names cannot be exported", "evidence": ["contracts/otel/otel_source_snapshot.v1.json", "contracts/otel/import_boundary.json"] }
  ],
  "hazard_fixtures": [
    { "id": "OTEL-ENV-001", "environment_family": "SDK disablement", "members_or_pattern": "OTEL_SDK_DISABLED", "representative_inputs": ["OTEL_SDK_DISABLED=true"], "forbidden_effect": "disable Cartulary-selected providers or invert no-SDK tests", "assertion": "telemetry config defaults and accessors remain unchanged", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-ENV-002", "environment_family": "Resource environment merge", "members_or_pattern": "OTEL_RESOURCE_ATTRIBUTES, OTEL_SERVICE_NAME, OTEL_ENTITIES", "representative_inputs": ["OTEL_RESOURCE_ATTRIBUTES=service.name=hostile,host.id=hostile", "OTEL_SERVICE_NAME=hostile", "OTEL_ENTITIES=host.id=hostile"], "forbidden_effect": "add host, process, incident, user, deployment, entity, or service attributes", "assertion": "resource service name, namespace, version, and closed resource defaults remain authoritative", "evidence": ["internal/platform/config/config_otel_test.go", "internal/platform/telemetry/resource_test.go"] },
    { "id": "OTEL-ENV-003", "environment_family": "SDK internal logging", "members_or_pattern": "OTEL_LOG_LEVEL", "representative_inputs": ["OTEL_LOG_LEVEL=debug"], "forbidden_effect": "change product logs, operator diagnostics, or secret exposure", "assertion": "config parsing and diagnostics ignore OTel log-level value", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-ENV-004", "environment_family": "Propagators", "members_or_pattern": "OTEL_PROPAGATORS", "representative_inputs": ["OTEL_PROPAGATORS=baggage,tracecontext"], "forbidden_effect": "enable Baggage, vendor propagators, or remote context propagation", "assertion": "telemetry.traces.accept_remote_context remains false", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-ENV-005", "environment_family": "Trace sampler", "members_or_pattern": "OTEL_TRACES_SAMPLER, OTEL_TRACES_SAMPLER_ARG", "representative_inputs": ["OTEL_TRACES_SAMPLER=always_on", "OTEL_TRACES_SAMPLER_ARG=1.0"], "forbidden_effect": "override sampler profile", "assertion": "sample_ratio and sampler_profile remain Cartulary defaults", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-ENV-006", "environment_family": "Global attribute limits", "members_or_pattern": "OTEL_ATTRIBUTE_COUNT_LIMIT, OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT", "representative_inputs": ["OTEL_ATTRIBUTE_COUNT_LIMIT=1", "OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT=1"], "forbidden_effect": "act as privacy enforcement or alter redaction-before-recording", "assertion": "attribute privacy remains governed by Cartulary SafeAttributes", "evidence": ["internal/platform/config/config_otel_test.go", "internal/platform/telemetry/privacy_test.go"] },
    { "id": "OTEL-ENV-007", "environment_family": "Span limits", "members_or_pattern": "OTEL_SPAN_ATTRIBUTE_COUNT_LIMIT, OTEL_SPAN_ATTRIBUTE_VALUE_LENGTH_LIMIT, OTEL_SPAN_EVENT_COUNT_LIMIT, OTEL_SPAN_LINK_COUNT_LIMIT", "representative_inputs": ["OTEL_SPAN_ATTRIBUTE_COUNT_LIMIT=1", "OTEL_SPAN_ATTRIBUTE_VALUE_LENGTH_LIMIT=1", "OTEL_SPAN_EVENT_COUNT_LIMIT=1", "OTEL_SPAN_LINK_COUNT_LIMIT=1"], "forbidden_effect": "authorize extra attributes, events, links, or privacy bypass", "assertion": "span attributes remain allowlisted before recording", "evidence": ["internal/platform/config/config_otel_test.go", "internal/platform/telemetry/privacy_test.go"] },
    { "id": "OTEL-ENV-008", "environment_family": "LogRecord limits", "members_or_pattern": "OTEL_LOGRECORD_ATTRIBUTE_COUNT_LIMIT, OTEL_LOGRECORD_ATTRIBUTE_VALUE_LENGTH_LIMIT", "representative_inputs": ["OTEL_LOGRECORD_ATTRIBUTE_COUNT_LIMIT=1", "OTEL_LOGRECORD_ATTRIBUTE_VALUE_LENGTH_LIMIT=1"], "forbidden_effect": "authorize raw log fields or privacy bypass", "assertion": "log bridge remains disabled and local log correlation stays closed", "evidence": ["internal/platform/config/config_otel_test.go", "internal/platform/telemetry/logs_test.go"] },
    { "id": "OTEL-ENV-009", "environment_family": "Batch span processor", "members_or_pattern": "OTEL_BSP_*", "representative_inputs": ["OTEL_BSP_MAX_EXPORT_BATCH_SIZE=1", "OTEL_BSP_SCHEDULE_DELAY=1"], "forbidden_effect": "override processor bounds, delay, timeout, or queue policy", "assertion": "processor queue and batch defaults remain Cartulary-owned", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-ENV-010", "environment_family": "Batch LogRecord processor", "members_or_pattern": "OTEL_BLRP_*", "representative_inputs": ["OTEL_BLRP_MAX_EXPORT_BATCH_SIZE=1", "OTEL_BLRP_EXPORT_TIMEOUT=1"], "forbidden_effect": "enable or alter log export outside Cartulary config", "assertion": "telemetry.logs.bridge_enabled remains false", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-ENV-011", "environment_family": "Exporter selection", "members_or_pattern": "OTEL_TRACES_EXPORTER, OTEL_METRICS_EXPORTER, OTEL_LOGS_EXPORTER", "representative_inputs": ["OTEL_TRACES_EXPORTER=otlp", "OTEL_METRICS_EXPORTER=otlp", "OTEL_LOGS_EXPORTER=otlp"], "forbidden_effect": "enable OTLP, stdout, zipkin, prometheus, vendor-native, or other export", "assertion": "telemetry.exporter.kind remains none", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-ENV-012", "environment_family": "Global OTLP", "members_or_pattern": "OTEL_EXPORTER_OTLP_*", "representative_inputs": ["OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.test:4318/otel", "OTEL_EXPORTER_OTLP_HEADERS=authorization=secret", "OTEL_EXPORTER_OTLP_PROTOCOL=grpc"], "forbidden_effect": "set endpoint, headers, protocol, timeout, compression, certificates, mTLS, or per-signal behavior", "assertion": "global exporter endpoint, headers, protocol, and compression remain Cartulary-owned", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-ENV-013", "environment_family": "Per-signal OTLP", "members_or_pattern": "OTEL_EXPORTER_OTLP_TRACES_*, OTEL_EXPORTER_OTLP_METRICS_*, OTEL_EXPORTER_OTLP_LOGS_*", "representative_inputs": ["OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://traces.example.test:4318", "OTEL_EXPORTER_OTLP_METRICS_HEADERS=authorization=metric", "OTEL_EXPORTER_OTLP_LOGS_PROTOCOL=grpc"], "forbidden_effect": "create divergent per-signal endpoints, headers, protocol, or credentials", "assertion": "per-signal endpoint and header environment remains inert", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-ENV-014", "environment_family": "Non-OTLP exporters", "members_or_pattern": "OTEL_EXPORTER_ZIPKIN_*, OTEL_EXPORTER_PROMETHEUS_*, implementation-specific exporter env vars", "representative_inputs": ["OTEL_EXPORTER_ZIPKIN_ENDPOINT=https://zipkin.example.test/api/v2/spans", "OTEL_EXPORTER_PROMETHEUS_HOST=0.0.0.0", "OTEL_EXPORTER_PROMETHEUS_PORT=9464"], "forbidden_effect": "enable unsupported exporters", "assertion": "only telemetry.exporter.kind can enable export and it remains none by default", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-ENV-015", "environment_family": "Metrics exemplar", "members_or_pattern": "OTEL_METRICS_EXEMPLAR_FILTER", "representative_inputs": ["OTEL_METRICS_EXEMPLAR_FILTER=always_on"], "forbidden_effect": "enable exemplars", "assertion": "telemetry.metrics.exemplars.enabled remains false", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-ENV-016", "environment_family": "Metrics periodic reader", "members_or_pattern": "OTEL_METRIC_EXPORT_INTERVAL, OTEL_METRIC_EXPORT_TIMEOUT", "representative_inputs": ["OTEL_METRIC_EXPORT_INTERVAL=1", "OTEL_METRIC_EXPORT_TIMEOUT=1"], "forbidden_effect": "override metric export cadence or timeout", "assertion": "metric processor schedule and export timeout remain Cartulary-owned", "evidence": ["internal/platform/config/config_otel_test.go"] },
    { "id": "OTEL-ENV-017", "environment_family": "Declarative configuration", "members_or_pattern": "OTEL_CONFIG_FILE, OTEL_EXPERIMENTAL_CONFIG_FILE", "representative_inputs": ["OTEL_CONFIG_FILE=/tmp/otel.yaml", "OTEL_EXPERIMENTAL_CONFIG_FILE=/tmp/otel-experimental.yaml"], "forbidden_effect": "instantiate SDK components from file configuration", "assertion": "declarative config file paths are ignored and SDK/declarative packages are absent from authored imports", "evidence": ["internal/platform/config/config_otel_test.go", "contracts/otel/import_boundary.json"] },
    { "id": "OTEL-ENV-018", "environment_family": "Semantic-convention opt-in", "members_or_pattern": "OTEL_SEMCONV_STABILITY_OPT_IN", "representative_inputs": ["OTEL_SEMCONV_STABILITY_OPT_IN=http/dup"], "forbidden_effect": "change emitted attribute names or duplicate conventions", "assertion": "semantic-convention constants remain bound to the source snapshot digest", "evidence": ["internal/platform/config/config_otel_test.go", "contracts/otel/otel_source_snapshot.v1.json"] },
    { "id": "OTEL-ENV-019", "environment_family": "Language-specific OTel env vars", "members_or_pattern": "OTEL_{LANGUAGE}_{FEATURE}", "representative_inputs": ["OTEL_GO_XRAY_CONTEXT_MISSING=LOG_ERROR", "OTEL_PYTHON_DISABLED_INSTRUMENTATIONS=all"], "forbidden_effect": "affect emitted telemetry or runtime behavior", "assertion": "language-specific OTel variables are outside the Cartulary overlay namespace and remain inert", "evidence": ["internal/platform/config/config_otel_test.go"] }
  ]
