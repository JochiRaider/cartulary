{
  "schema_id": "cartulary.otel_telemetry_config_schema.v2",
  "source_owner": "platform.telemetry.verification.current_conformance",
  "materialization_kind": "repo_materialized_from_owner_table",
  "error_code": "invalid_deployment_config",
  "telemetry_reason_code": "invalid_telemetry_config",
  "environment_binding": "Core04 CARTULARY__ overlay only; empty server-side environment values are omitted and use the default",
  "entries": [
    { "key": "telemetry.enabled", "type": "boolean", "default": true, "allowed": ["true", "false"], "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.otel_env_passthrough", "type": "boolean", "default": false, "allowed": ["false"], "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.exporter.kind", "type": "enum", "default": "none", "allowed": ["none", "otlp_http", "otlp_grpc"], "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.exporter.endpoint", "type": "url_or_null", "default": null, "allowed": "closed OTLP HTTP/gRPC endpoint grammar", "omitted": "required_when_exporter_enabled_otherwise_default", "explicit_null": "valid_only_when_exporter_kind_none", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.exporter.headers", "type": "map_string_secret_ref_v1", "default": {}, "allowed": "at_most_16_headers; lowercase_unique_names; non_protocol_owned; resolved_value_bytes_lte_4096; configured_header_block_bytes_lte_8192", "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": true, "failure": "invalid_deployment_config" },
    { "key": "telemetry.exporter.protocol", "type": "enum", "default": "derived", "allowed": ["grpc", "http/protobuf"], "omitted": "derive_from_exporter_kind", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.exporter.compression", "type": "enum", "default": "none", "allowed": ["none", "gzip"], "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.exporter.retry.enabled", "type": "boolean", "default": true, "allowed": ["true", "false"], "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.exporter.retry.max_elapsed_ms", "type": "integer", "default": 30000, "allowed": "0..300000", "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.exporter.retry.initial_interval_ms", "type": "integer", "default": 100, "allowed": "50..30000", "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.exporter.retry.max_interval_ms", "type": "integer", "default": 5000, "allowed": "100..60000 and >= telemetry.exporter.retry.initial_interval_ms", "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.exporter.retry.multiplier", "type": "decimal", "default": 2.0, "allowed": "1.0..5.0", "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.traces.enabled", "type": "boolean", "default": true, "allowed": ["true", "false"], "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.traces.sample_ratio", "type": "decimal", "default": 0.1, "allowed": "0.0..1.0 inclusive", "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.traces.sampler_profile", "type": "enum", "default": "auto", "allowed": ["auto", "cartulary.sampler.always_on.v1", "cartulary.sampler.always_off.v1", "cartulary.sampler.traceidratio_compat.v1"], "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.traces.accept_remote_context", "type": "boolean", "default": false, "allowed": ["false"], "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.metrics.enabled", "type": "boolean", "default": true, "allowed": ["true", "false"], "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.metrics.temporality_profile", "type": "enum", "default": "cartulary.metrics.temporality.cumulative.v1", "allowed": ["cartulary.metrics.temporality.cumulative.v1"], "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.metrics.exemplars.enabled", "type": "boolean", "default": false, "allowed": ["false"], "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.logs.bridge_enabled", "type": "boolean", "default": false, "allowed": ["true", "false"], "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.logs.body_max_chars", "type": "integer", "default": 2048, "allowed": "0..8192", "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.processor.max_queue_size", "type": "integer", "default": 2048, "allowed": "1..65536", "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.processor.max_export_batch_size", "type": "integer", "default": 512, "allowed": "1..telemetry.processor.max_queue_size", "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.processor.traces.schedule_delay_ms", "type": "integer", "default": 5000, "allowed": "100..300000", "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.processor.metrics.schedule_delay_ms", "type": "integer", "default": 60000, "allowed": "100..300000", "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.processor.logs.schedule_delay_ms", "type": "integer", "default": 1000, "allowed": "100..300000", "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.processor.export_timeout_ms", "type": "integer", "default": 2000, "allowed": "100..10000", "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.processor.overflow_policy", "type": "enum", "default": "drop_new", "allowed": ["drop_new"], "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.shutdown.flush_timeout_ms", "type": "integer", "default": 5000, "allowed": "100..30000", "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.self_diagnostics.enabled", "type": "boolean", "default": true, "allowed": ["true", "false"], "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.self_diagnostics.recursion_guard", "type": "enum", "default": "drop_telemetry_about_telemetry", "allowed": ["drop_telemetry_about_telemetry"], "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.resource.service_name", "type": "string", "default": "cartulary.app", "allowed": "1..128 ASCII letters, digits, '.', '_', '-'", "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.resource.service_namespace", "type": "string", "default": "cartulary", "allowed": "1..128 ASCII letters, digits, '.', '_', '-'", "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.resource.service_version", "type": "string", "default": "0.0.0+unknown", "allowed": "SemVer 2.0.0 or exactly 0.0.0+unknown; max 128 ASCII characters", "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.resource.service_instance_id", "type": "string_or_null", "default": "generated_uuid_v4", "allowed": "canonical lowercase UUID v4 and not nil", "omitted": "generate_default", "explicit_null": "generate_default", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.resource.deployment_environment_name", "type": "string_or_null", "default": null, "allowed": "development, test, staging, production, or custom non-empty token <=128 ASCII letters, digits, '.', '_', '-'", "omitted": "omit_attribute", "explicit_null": "omit_attribute", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.attribute.incident_correlation", "type": "enum", "default": "none", "allowed": ["none", "hmac_64bit"], "omitted": "use_default", "explicit_null": "invalid", "empty_env": "omit", "secret": false, "failure": "invalid_deployment_config" },
    { "key": "telemetry.attribute.hmac_secret_ref", "type": "secret_ref_v1_or_null", "default": null, "allowed": "Core04 secret_ref_v1; required when incident_correlation is hmac_64bit", "omitted": "use_default", "explicit_null": "valid_only_when_incident_correlation_none", "empty_env": "omit", "secret": true, "failure": "invalid_deployment_config" }
  ],
  "cross_key_rules": [
    { "id": "OTEL-CFG-001", "keys": ["telemetry.exporter.kind", "telemetry.exporter.endpoint"], "rule": "otlp_http and otlp_grpc require endpoint" },
    { "id": "OTEL-CFG-002", "keys": ["telemetry.exporter.kind", "telemetry.exporter.endpoint"], "rule": "none requires endpoint omitted" },
    { "id": "OTEL-CFG-003", "keys": ["telemetry.exporter.kind", "telemetry.exporter.protocol"], "rule": "otlp_http uses http/protobuf; otlp_grpc uses grpc" },
    { "id": "OTEL-CFG-004", "keys": ["telemetry.processor.max_export_batch_size", "telemetry.processor.max_queue_size"], "rule": "max_export_batch_size <= max_queue_size" },
    { "id": "OTEL-CFG-005", "keys": ["telemetry.exporter.retry.initial_interval_ms", "telemetry.exporter.retry.max_interval_ms"], "rule": "max_interval_ms >= initial_interval_ms" },
    { "id": "OTEL-CFG-006", "keys": ["telemetry.attribute.incident_correlation", "telemetry.attribute.hmac_secret_ref"], "rule": "hmac_64bit requires hmac_secret_ref" },
    { "id": "OTEL-CFG-007", "keys": ["telemetry.traces.accept_remote_context"], "rule": "accept_remote_context must remain false" },
    { "id": "OTEL-CFG-008", "keys": ["telemetry.traces.sampler_profile"], "rule": "sampler_profile must be in the adopted set" },
    { "id": "OTEL-CFG-008A", "keys": ["telemetry.traces.sampler_profile", "telemetry.traces.sample_ratio"], "rule": "explicit sampler_profile must be consistent with sample_ratio" },
    { "id": "OTEL-CFG-009", "keys": ["telemetry.exporter.protocol"], "rule": "exporter protocol must be grpc or http/protobuf" },
    { "id": "OTEL-CFG-010", "keys": ["effective.telemetry.exporter.traces.endpoint", "effective.telemetry.exporter.metrics.endpoint", "effective.telemetry.exporter.logs.endpoint"], "rule": "per-signal endpoints are not adopted" },
    { "id": "OTEL-CFG-011", "keys": ["effective.telemetry.exporter.traces.headers", "effective.telemetry.exporter.metrics.headers", "effective.telemetry.exporter.logs.headers", "effective.telemetry.exporter.traces.protocol", "effective.telemetry.exporter.metrics.protocol", "effective.telemetry.exporter.logs.protocol"], "rule": "per-signal headers and protocols are not adopted" },
    { "id": "OTEL-CFG-012", "keys": ["telemetry.metrics.exemplars.enabled"], "rule": "exemplars must remain false" },
    { "id": "OTEL-CFG-013", "keys": ["telemetry.logs.body_max_chars"], "rule": "body_max_chars must be 0..8192" },
    { "id": "OTEL-CFG-014", "keys": ["telemetry.otel_env_passthrough"], "rule": "OTel environment passthrough must remain false" },
    { "id": "OTEL-CFG-015", "keys": ["external_otel_config_authority"], "rule": "declarative config, autoconfig, plugin providers, ConfigProvider state, and resource detectors cannot alter runtime telemetry components" },
    { "id": "OTEL-CFG-016", "keys": ["OTEL_SEMCONV_STABILITY_OPT_IN"], "rule": "semantic-convention opt-in environment cannot alter emitted telemetry shape" },
    { "id": "OTEL-CFG-017", "keys": ["effective_resource.schema_url"], "rule": "effective provider Resource schema URL must remain empty" },
    { "id": "OTEL-CFG-018", "keys": ["effective_metric_view.stream_name"], "rule": "metric Views cannot export unregistered stream names" }
  ],
  "hostile_environment_families": [
    "OTEL_ATTRIBUTE_COUNT_LIMIT",
    "OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT",
    "OTEL_BLRP_*",
    "OTEL_BSP_*",
    "OTEL_CONFIG_FILE",
    "OTEL_ENTITIES",
    "OTEL_EXPORTER_OTLP_*",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_EXPORTER_OTLP_LOGS_*",
    "OTEL_EXPORTER_OTLP_METRICS_*",
    "OTEL_EXPORTER_OTLP_TRACES_*",
    "OTEL_EXPORTER_PROMETHEUS_*",
    "OTEL_EXPORTER_ZIPKIN_*",
    "OTEL_EXPERIMENTAL_CONFIG_FILE",
    "OTEL_LOGRECORD_ATTRIBUTE_COUNT_LIMIT",
    "OTEL_LOGRECORD_ATTRIBUTE_VALUE_LENGTH_LIMIT",
    "OTEL_LOGS_EXPORTER",
    "OTEL_METRIC_EXPORT_INTERVAL",
    "OTEL_METRIC_EXPORT_TIMEOUT",
    "OTEL_METRICS_EXEMPLAR_FILTER",
    "OTEL_METRICS_EXPORTER",
    "OTEL_PROPAGATORS",
    "OTEL_RESOURCE_ATTRIBUTES",
    "OTEL_SDK_DISABLED",
    "OTEL_SEMCONV_STABILITY_OPT_IN",
    "OTEL_SERVICE_NAME",
    "OTEL_SPAN_ATTRIBUTE_COUNT_LIMIT",
    "OTEL_SPAN_ATTRIBUTE_VALUE_LENGTH_LIMIT",
    "OTEL_SPAN_EVENT_COUNT_LIMIT",
    "OTEL_SPAN_LINK_COUNT_LIMIT",
    "OTEL_TRACES_EXPORTER",
    "OTEL_TRACES_SAMPLER",
    "OTEL_TRACES_SAMPLER_ARG",
    "OTEL_LOG_LEVEL",
    "OTEL_{LANGUAGE}_{FEATURE}"
  ]
}
