{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.ws.incident_stream.index.v1",
  "title": "Cartulary Incident WebSocket Contract Index",
  "description": "Derived repo-local artifact from the owner docs chain. This file is not the behavioral authority.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "route": {
      "const": "GET /ws/v1/incidents/{incident_id}",
      "default": "GET /ws/v1/incidents/{incident_id}"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "hello",
              "resume",
              "hello_ack",
              "resume_ack",
              "presence_snapshot",
              "presence_delta",
              "presence_update",
              "record_changed",
              "job_progress",
              "ping",
              "pong",
              "error",
              "session_revoked"
            ]
          },
          "version": {
            "const": "v1"
          },
          "direction": {
            "enum": [
              "client_to_server",
              "server_to_client"
            ]
          },
          "replayable": {
            "type": "boolean"
          },
          "payload_schema": {
            "type": "object"
          }
        },
        "required": [
          "type",
          "version",
          "direction",
          "replayable",
          "payload_schema"
        ]
      },
      "default": [
        {
          "type": "hello",
          "version": "v1",
          "direction": "client_to_server",
          "replayable": false,
          "payload_schema": {
            "type": "object",
            "required": [
              "client_instance_id",
              "presence"
            ]
          }
        },
        {
          "type": "resume",
          "version": "v1",
          "direction": "client_to_server",
          "replayable": false,
          "payload_schema": {
            "type": "object",
            "required": [
              "client_instance_id",
              "resume_token",
              "last_seen_stream_seq",
              "presence"
            ]
          }
        },
        {
          "type": "pong",
          "version": "v1",
          "direction": "client_to_server",
          "replayable": false,
          "payload_schema": {
            "type": "object"
          }
        },
        {
          "type": "presence_update",
          "version": "v1",
          "direction": "client_to_server",
          "replayable": false,
          "payload_schema": {
            "type": "object",
            "required": [
              "presence"
            ]
          }
        },
        {
          "type": "hello_ack",
          "version": "v1",
          "direction": "server_to_client",
          "replayable": false,
          "payload_schema": {
            "type": "object",
            "required": [
              "connection_id",
              "resume_token",
              "server_time",
              "heartbeat_interval_ms",
              "presence_ttl_ms",
              "resume_window_ms"
            ]
          }
        },
        {
          "type": "resume_ack",
          "version": "v1",
          "direction": "server_to_client",
          "replayable": false,
          "payload_schema": {
            "type": "object",
            "required": [
              "status",
              "resume_token",
              "server_high_water_stream_seq"
            ]
          }
        },
        {
          "type": "presence_snapshot",
          "version": "v1",
          "direction": "server_to_client",
          "replayable": false,
          "payload_schema": {
            "type": "object",
            "required": [
              "presences"
            ]
          }
        },
        {
          "type": "presence_delta",
          "version": "v1",
          "direction": "server_to_client",
          "replayable": false,
          "payload_schema": {
            "type": "object",
            "required": [
              "delta_kind",
              "presence"
            ]
          }
        },
        {
          "type": "record_changed",
          "version": "v1",
          "direction": "server_to_client",
          "replayable": true,
          "payload_schema": {
            "type": "object",
            "required": [
              "record_id",
              "row_version",
              "change_set_id",
              "client_txn_id",
              "actor_user_id",
              "changed_field_keys",
              "affected_views"
            ]
          }
        },
        {
          "type": "job_progress",
          "version": "v1",
          "direction": "server_to_client",
          "replayable": true,
          "payload_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "job_id": {
                "type": "string"
              },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "incident",
                      "deployment"
                    ]
                  },
                  "incident_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "kind"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "incident"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "then": {
                      "required": [
                        "incident_id"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "deployment"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "then": {
                      "not": {
                        "required": [
                          "incident_id"
                        ]
                      }
                    }
                  }
                ]
              },
              "status": {
                "enum": [
                  "queued",
                  "running",
                  "cancel_requested",
                  "succeeded",
                  "failed",
                  "canceled"
                ]
              },
              "progress": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "completed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "total": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "completed",
                  "total"
                ]
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              },
              "cancelable": {
                "type": "boolean"
              },
              "message": {
                "type": "string"
              },
              "result_summary": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "error_summary": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "retained_until": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            },
            "required": [
              "job_id",
              "scope",
              "status",
              "progress",
              "updated_at"
            ]
          }
        },
        {
          "type": "ping",
          "version": "v1",
          "direction": "server_to_client",
          "replayable": false,
          "payload_schema": {
            "type": "object"
          }
        },
        {
          "type": "error",
          "version": "v1",
          "direction": "server_to_client",
          "replayable": false,
          "payload_schema": {
            "type": "object",
            "required": [
              "code",
              "message",
              "retryable"
            ]
          }
        },
        {
          "type": "session_revoked",
          "version": "v1",
          "direction": "server_to_client",
          "replayable": false,
          "payload_schema": {
            "type": "object",
            "required": [
              "reason_code"
            ]
          }
        }
      ]
    }
  },
  "required": [
    "route",
    "messages"
  ]
}
