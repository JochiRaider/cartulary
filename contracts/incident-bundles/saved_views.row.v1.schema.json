{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.incident_bundle.saved_views.row.v1",
  "title": "Saved Views incident bundle row",
  "description": "Exact portable Saved Views row shape shared by Incident Bundle versions 1 and 2. Runtime registry admission, Unicode normalization, cross-field timestamp ordering, and schema-specific query/layout semantics remain owner validations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "saved_view_id",
    "incident_id",
    "view_schema_id",
    "scope",
    "display_name",
    "query_json",
    "layout_json",
    "owner_user_id",
    "created_at",
    "updated_at",
    "saved_view_version"
  ],
  "properties": {
    "saved_view_id": { "$ref": "#/$defs/uuid" },
    "incident_id": { "$ref": "#/$defs/uuid" },
    "view_schema_id": {
      "type": "string",
      "pattern": "^cartulary\\.view\\.[a-z][a-z0-9_]*\\.v[1-9][0-9]*$"
    },
    "scope": { "enum": ["private", "shared", "system"] },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "query_json": { "$ref": "#/$defs/query" },
    "layout_json": { "$ref": "#/$defs/layout" },
    "owner_user_id": {
      "oneOf": [
        { "$ref": "#/$defs/uuid" },
        { "type": "null" }
      ]
    },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "saved_view_version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "scope": { "const": "system" } },
        "required": ["scope"]
      },
      "then": {
        "properties": { "owner_user_id": { "type": "null" } }
      },
      "else": {
        "properties": { "owner_user_id": { "$ref": "#/$defs/uuid" } }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "scalar": {
      "oneOf": [
        { "type": "string" },
        { "type": "boolean" },
        { "type": "number" }
      ]
    },
    "nullable_scalar": {
      "oneOf": [
        { "$ref": "#/$defs/scalar" },
        { "type": "null" }
      ]
    },
    "scalar_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/scalar" }
    },
    "sort_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_key", "direction"],
      "properties": {
        "field_key": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["asc", "desc"] }
      }
    },
    "eq_filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_key", "op", "arg"],
      "properties": {
        "field_key": { "type": "string", "minLength": 1 },
        "op": { "const": "eq" },
        "arg": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value"],
              "properties": {
                "value": { "$ref": "#/$defs/nullable_scalar" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["values"],
              "properties": {
                "values": { "$ref": "#/$defs/scalar_set" }
              }
            }
          ]
        }
      }
    },
    "range_filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_key", "op", "arg"],
      "properties": {
        "field_key": { "type": "string", "minLength": 1 },
        "op": { "const": "range" },
        "arg": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "gt": { "type": "string", "minLength": 1 },
            "gte": { "type": "string", "minLength": 1 },
            "lt": { "type": "string", "minLength": 1 },
            "lte": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "set_filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_key", "op", "arg"],
      "properties": {
        "field_key": { "type": "string", "minLength": 1 },
        "op": { "enum": ["contains_any", "contains_all"] },
        "arg": {
          "type": "object",
          "additionalProperties": false,
          "required": ["values"],
          "properties": {
            "values": { "$ref": "#/$defs/scalar_set" }
          }
        }
      }
    },
    "prefix_filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_key", "op", "arg"],
      "properties": {
        "field_key": { "type": "string", "minLength": 1 },
        "op": { "const": "prefix" },
        "arg": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value"],
          "properties": {
            "value": { "type": "string" }
          }
        }
      }
    },
    "full_text_filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_key", "op", "arg"],
      "properties": {
        "field_key": { "type": "string", "minLength": 1 },
        "op": { "const": "full_text" },
        "arg": {
          "type": "object",
          "additionalProperties": false,
          "required": ["query"],
          "properties": {
            "query": { "type": "string" }
          }
        }
      }
    },
    "filter": {
      "oneOf": [
        { "$ref": "#/$defs/eq_filter" },
        { "$ref": "#/$defs/range_filter" },
        { "$ref": "#/$defs/set_filter" },
        { "$ref": "#/$defs/prefix_filter" },
        { "$ref": "#/$defs/full_text_filter" }
      ]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sort", "filters"],
      "properties": {
        "sort": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/sort_entry" }
        },
        "filters": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/filter" }
        },
        "group_by": { "type": "string", "minLength": 1 }
      }
    },
    "layout_width": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_key", "width_px"],
      "properties": {
        "field_key": { "type": "string", "minLength": 1 },
        "width_px": {
          "type": "integer",
          "minimum": 40,
          "maximum": 4096
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout_schema_id",
        "column_order",
        "hidden_field_keys",
        "column_widths"
      ],
      "properties": {
        "layout_schema_id": { "const": "cartulary.layout.v1" },
        "column_order": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "hidden_field_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "column_widths": {
          "type": "array",
          "items": { "$ref": "#/$defs/layout_width" }
        }
      }
    }
  }
}
