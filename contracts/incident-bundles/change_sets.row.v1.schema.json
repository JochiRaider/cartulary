{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.incident_bundle.change_sets.row.v1",
  "title": "Revisions change-set incident bundle row",
  "description": "Exact portable change-set row shared by Incident Bundle versions 1 and 2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "change_set_id",
    "incident_id",
    "actor_user_id",
    "source",
    "reason",
    "client_txn_id",
    "request_id",
    "created_at"
  ],
  "properties": {
    "change_set_id": { "$ref": "#/$defs/uuid" },
    "incident_id": { "$ref": "#/$defs/uuid" },
    "actor_user_id": { "$ref": "#/$defs/uuid" },
    "source": { "$ref": "#/$defs/nonempty_text" },
    "reason": { "$ref": "#/$defs/nullable_text" },
    "client_txn_id": { "$ref": "#/$defs/nullable_text" },
    "request_id": { "$ref": "#/$defs/nullable_text" },
    "created_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "nonempty_text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "nullable_text": {
      "oneOf": [
        { "type": "string", "pattern": "^[^\\u0000]*$" },
        { "type": "null" }
      ]
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    }
  }
}
