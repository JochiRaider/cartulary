{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.incident_bundle.change_sets.row.v3",
  "title": "Revisions change-set incident bundle row",
  "description": "Exact portable change-set row used by Incident Bundle version 8 with immutable actor import-context provenance. Includes immutable incident-local committed history order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "change_set_id",
    "incident_id",
    "actor_user_id",
    "source",
    "reason",
    "client_txn_id",
    "request_id",
    "created_at",
    "actor_import_contexts",
    "history_order"
  ],
  "properties": {
    "change_set_id": {
      "$ref": "#/$defs/uuid"
    },
    "incident_id": {
      "$ref": "#/$defs/uuid"
    },
    "actor_user_id": {
      "$ref": "#/$defs/uuid"
    },
    "source": {
      "$ref": "#/$defs/nonempty_text"
    },
    "reason": {
      "$ref": "#/$defs/nullable_text"
    },
    "client_txn_id": {
      "$ref": "#/$defs/nullable_text"
    },
    "request_id": {
      "$ref": "#/$defs/nullable_text"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "actor_import_contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "import_id",
          "actor_user_id"
        ],
        "properties": {
          "import_id": {
            "$ref": "#/$defs/uuid"
          },
          "actor_user_id": {
            "$ref": "#/$defs/uuid"
          }
        }
      }
    },
    "history_order": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "nonempty_text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "nullable_text": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[^\\u0000]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    }
  }
}
