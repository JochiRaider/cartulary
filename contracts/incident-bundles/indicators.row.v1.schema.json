{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.incident_bundle.indicators.row.v1",
  "title": "Indicators incident bundle row",
  "description": "Exact canonical Indicator row shared by Incident Bundle versions 1 and 2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "incident_id",
    "indicator_type",
    "value_kind",
    "display_value",
    "normalized_value",
    "dedupe_key",
    "defanged_value",
    "hash_algorithm",
    "hash_value",
    "stix_pattern",
    "row_version",
    "created_at",
    "updated_at",
    "created_by_user_id",
    "updated_by_user_id",
    "deleted_at",
    "deleted_by_user_id"
  ],
  "properties": {
    "record_id": { "$ref": "#/$defs/uuid" },
    "incident_id": { "$ref": "#/$defs/uuid" },
    "indicator_type": {
      "enum": ["ipv4_addr", "ipv6_addr", "domain_name", "url", "sha256", "email_addr", "registry_key", "process_name", "text"]
    },
    "value_kind": { "enum": ["atomic", "pattern", "reference"] },
    "display_value": { "$ref": "#/$defs/nonempty_text" },
    "normalized_value": { "$ref": "#/$defs/nullable_nonempty_text" },
    "dedupe_key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "defanged_value": { "$ref": "#/$defs/nullable_text" },
    "hash_algorithm": { "$ref": "#/$defs/nullable_nonempty_text" },
    "hash_value": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]+$" },
        { "type": "null" }
      ]
    },
    "stix_pattern": { "$ref": "#/$defs/nullable_text" },
    "row_version": { "type": "integer", "minimum": 1 },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "created_by_user_id": { "$ref": "#/$defs/uuid" },
    "updated_by_user_id": { "$ref": "#/$defs/uuid" },
    "deleted_at": { "$ref": "#/$defs/nullable_timestamp" },
    "deleted_by_user_id": { "$ref": "#/$defs/nullable_uuid" }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "deleted_at": { "type": "null" },
            "deleted_by_user_id": { "type": "null" }
          }
        },
        {
          "properties": {
            "deleted_at": { "$ref": "#/$defs/timestamp" },
            "deleted_by_user_id": { "$ref": "#/$defs/uuid" }
          }
        }
      ]
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "nullable_uuid": {
      "oneOf": [
        { "$ref": "#/$defs/uuid" },
        { "type": "null" }
      ]
    },
    "nonempty_text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "nullable_nonempty_text": {
      "oneOf": [
        { "$ref": "#/$defs/nonempty_text" },
        { "type": "null" }
      ]
    },
    "nullable_text": {
      "oneOf": [
        { "type": "string", "pattern": "^[^\\u0000]*$" },
        { "type": "null" }
      ]
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?\\+00:00$"
    },
    "nullable_timestamp": {
      "oneOf": [
        { "$ref": "#/$defs/timestamp" },
        { "type": "null" }
      ]
    }
  }
}
