  "default_visible_fields": [
    "host.display_name",
    "host.hostname",
    "host.aliases",
    "host.host_state",
    "host.linked_event_count",
    "host.evidence_count",
    "host.location",
    "host.os_platform",
    "host.business_owner",
    "host.criticality",
    "host.containment_status",
    "host.edited_at"
