          "no_row_selected",
          "incident_closed",
          "authorization_lost",
          "row_version_changed"
        ]
      },
      {
        "feature_group_key": "workflow.create_related_task",
        "panel_id": "workflow",
        "label": "Create related task",
        "minimum_incident_role": "editor",
        "mutates": true,
        "requires_confirmation": false,
        "route_binding": {
          "kind": "view_row_create",
