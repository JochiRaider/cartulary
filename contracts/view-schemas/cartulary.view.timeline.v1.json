{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "view_schema_id": "cartulary.view.timeline.v1",
  "title": "Timeline",
  "surface_kind": "built_in_sheet",
  "source_record_types": [
    "timeline_event"
  ],
  "technical_fields": [
    "record_id",
    "row_version"
  ],
  "default_visible_fields": [
    "timeline.occurred_at",
    "timeline.summary",
    "timeline.host_refs",
    "timeline.identity_refs",
    "timeline.evidence_count",
    "timeline.tags",
    "timeline.edited_at"
  ],
  "default_hidden_fields": [
    "record_id",
    "row_version",
    "timeline.details",
    "timeline.source_text",
    "timeline.recorded_at",
    "timeline.sort_ts",
    "timeline.capture_state",
    "timeline.replacement_record_id",
    "timeline.occurred_day",
    "timeline.recorded_day",
    "timeline.has_evidence",
    "timeline.has_unresolved_mentions"
  ],
  "default_sort": [
    {
      "field_key": "timeline.sort_ts",
      "direction": "asc"
    },
    {
      "field_key": "record_id",
      "direction": "asc"
    }
  ],
  "sort_fields": [
    "timeline.sort_ts",
    "timeline.summary",
    "timeline.evidence_count",
    "timeline.edited_at",
    "timeline.capture_state",
    "timeline.occurred_day",
    "timeline.recorded_day",
    "timeline.has_evidence",
    "timeline.has_unresolved_mentions"
  ],
  "filter_fields": [
    "timeline.occurred_day",
    "timeline.recorded_day",
    "timeline.capture_state",
    "timeline.has_evidence",
    "timeline.has_unresolved_mentions",
    "timeline.tags"
  ],
  "grouping_fields": [
    "timeline.occurred_day",
    "timeline.recorded_day",
    "timeline.capture_state",
    "timeline.has_evidence",
    "timeline.has_unresolved_mentions"
  ],
  "inline_create": {
    "permits_zero_field_create": true
  },
  "fields": [
    {
      "field_key": "timeline.occurred_at",
      "label": "Time",
      "writable": true,
      "read_model": "occurred_at",
      "write_target": "timeline_events.occurred_at",
      "header_sort_field_key": "timeline.sort_ts",
      "direct_scalar_contract_id": "timestamp_instant_v1",
      "clearable": true,
      "entity_binding_mode": null,
      "conflict_resolution_class": "atomic_replace"
    },
    {
      "field_key": "timeline.summary",
      "label": "Summary",
      "writable": true,
      "read_model": "summary",
      "write_target": "timeline_events.summary",
      "entity_binding_mode": null,
      "conflict_resolution_class": "text_compare_merge"
    },
    {
      "field_key": "timeline.details",
      "label": "Details",
      "writable": true,
      "read_model": "details",
      "write_target": "timeline_events.details",
      "entity_binding_mode": null,
      "conflict_resolution_class": "text_compare_merge"
    },
    {
      "field_key": "timeline.source_text",
      "label": "Source Text",
      "writable": true,
      "read_model": "source_text",
      "write_target": "timeline_events.source_text",
      "entity_binding_mode": null,
      "conflict_resolution_class": "text_compare_merge"
    },
    {
      "field_key": "timeline.host_refs",
      "label": "Hosts",
      "writable": true,
      "read_model": "resolved host chips plus unresolved host mentions",
      "write_action": "mention_origin collection actions",
      "entity_binding_mode": "mention_origin",
      "conflict_resolution_class": "collection_review"
    },
    {
      "field_key": "timeline.identity_refs",
      "label": "Identities",
      "writable": true,
      "read_model": "resolved identity chips plus unresolved identity mentions",
      "write_action": "mention_origin collection actions",
      "entity_binding_mode": "mention_origin",
      "conflict_resolution_class": "collection_review"
    },
    {
      "field_key": "timeline.evidence_count",
      "label": "Evidence",
      "writable": false,
      "read_model": "evidence_count",
      "entity_binding_mode": null
    },
    {
      "field_key": "timeline.tags",
      "label": "Tags",
      "writable": true,
      "read_model": "tag_names",
      "write_action": "record_tags collection actions",
      "entity_binding_mode": null,
      "conflict_resolution_class": "collection_review"
    },
    {
      "field_key": "timeline.edited_at",
      "label": "Edited",
      "writable": false,
      "read_model": "edited_at",
      "entity_binding_mode": null
    },
    {
      "field_key": "timeline.recorded_at",
      "label": "Recorded",
      "writable": false,
      "read_model": "recorded_at",
      "entity_binding_mode": null
    },
    {
      "field_key": "timeline.sort_ts",
      "label": "Sort Time",
      "writable": false,
      "read_model": "sort_ts",
      "entity_binding_mode": null
    },
    {
      "field_key": "timeline.capture_state",
      "label": "Capture State",
      "writable": false,
      "read_model": "capture_state",
      "entity_binding_mode": null
    },
    {
      "field_key": "timeline.replacement_record_id",
      "label": "Replacement",
      "writable": false,
      "read_model": "replacement_record_id",
      "entity_binding_mode": null
    },
    {
      "field_key": "timeline.occurred_day",
      "label": "Occurred Day",
      "writable": false,
      "read_model": "occurred_day",
      "entity_binding_mode": null
    },
    {
      "field_key": "timeline.recorded_day",
      "label": "Recorded Day",
      "writable": false,
      "read_model": "recorded_day",
      "entity_binding_mode": null
    },
    {
      "field_key": "timeline.has_evidence",
      "label": "Has Evidence",
      "writable": false,
      "read_model": "has_evidence",
      "entity_binding_mode": null
    },
    {
      "field_key": "timeline.has_unresolved_mentions",
      "label": "Has Unresolved Mentions",
      "writable": false,
      "read_model": "has_unresolved_mentions",
      "entity_binding_mode": null
    }
  ]
}
