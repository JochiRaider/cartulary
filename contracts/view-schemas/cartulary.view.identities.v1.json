{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "view_schema_id": "cartulary.view.identities.v1",
  "title": "Identities",
  "surface_kind": "built_in_sheet",
  "source_record_types": [
    "identity"
  ],
  "technical_fields": [
    "record_id",
    "row_version"
  ],
  "default_visible_fields": [
    "identity.display_name",
    "identity.upn",
    "identity.email",
    "identity.sam_account_name",
    "identity.aliases",
    "identity.identity_state",
    "identity.linked_event_count",
    "identity.evidence_count",
    "identity.privilege_level",
    "identity.mfa_state",
    "identity.reset_status",
    "identity.edited_at"
  ],
  "default_hidden_fields": [
    "record_id",
    "row_version",
    "identity.aad_object_id",
    "identity.sid"
  ],
  "default_sort": [
    {
      "field_key": "identity.display_name",
      "direction": "asc"
    },
    {
      "field_key": "record_id",
      "direction": "asc"
    }
  ],
  "sort_fields": [
    "identity.display_name",
    "identity.upn",
    "identity.email",
    "identity.sam_account_name",
    "identity.identity_state",
    "identity.linked_event_count",
    "identity.evidence_count",
    "identity.privilege_level",
    "identity.mfa_state",
    "identity.reset_status",
    "identity.edited_at"
  ],
  "filter_fields": [
    "identity.identity_state",
    "identity.privilege_level",
    "identity.mfa_state",
    "identity.reset_status"
  ],
  "grouping_fields": [
    "identity.identity_state",
    "identity.privilege_level",
    "identity.mfa_state",
    "identity.reset_status"
  ],
  "inline_create": {
    "permits_zero_field_create": false
  },
  "fields": [
    {
      "field_key": "identity.display_name",
      "label": "Display Name",
      "writable": true,
      "read_model": "display_name",
      "write_target": "identities.display_name",
      "entity_binding_mode": "entity_origin",
      "conflict_resolution_class": "atomic_replace"
    },
    {
      "field_key": "identity.aad_object_id",
      "label": "AAD Object ID",
      "writable": true,
      "read_model": "aad_object_id",
      "write_target": "identities.aad_object_id",
      "entity_binding_mode": "entity_origin",
      "conflict_resolution_class": "atomic_replace"
    },
    {
      "field_key": "identity.sid",
      "label": "SID",
      "writable": true,
      "read_model": "sid",
      "write_target": "identities.sid",
      "entity_binding_mode": "entity_origin",
      "conflict_resolution_class": "atomic_replace"
    },
    {
      "field_key": "identity.upn",
      "label": "UPN",
      "writable": true,
      "read_model": "upn",
      "write_target": "identities.upn",
      "entity_binding_mode": "entity_origin",
      "conflict_resolution_class": "atomic_replace"
    },
    {
