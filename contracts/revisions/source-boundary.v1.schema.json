{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.revisions.source_boundary.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "incident_version",
    "latest_change_set_id",
    "latest_change_set_created_at"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "incident_version": {
      "type": "integer",
      "minimum": 1
    },
    "latest_change_set_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "latest_change_set_created_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "latest_change_set_id": { "type": "null" }
        },
        "required": ["latest_change_set_id"]
      },
      "then": {
        "properties": {
          "latest_change_set_created_at": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "latest_change_set_created_at": { "type": "string" }
        }
      }
    }
  ]
}
