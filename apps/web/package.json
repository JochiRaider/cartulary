{
  "name": "@cartulary/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@cartulary/grid-adapter": "workspace:*",
    "@cartulary/protocol-ts": "workspace:*",
    "@cartulary/ui-contracts": "workspace:*",
    "@cartulary/view-contracts": "workspace:*",
    "lucide-react": "^1.18.0",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@cartulary/test-utils": "workspace:*",
    "@playwright/test": "1.59.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "26.1.0",
    "typescript": "6.0.2",
    "vite": "8.0.8",
    "vitest": "4.1.4"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "bash ../../tools/harness/static-analysis/frontend-biome.sh write",
    "lint": "bash ../../tools/harness/static-analysis/frontend-biome.sh check",
    "test": "vitest",
    "test:e2e": "pnpm run test:e2e:functional && pnpm run test:e2e:stateful",
    "test:e2e:functional": "make --directory ../.. browser-e2e-functional",
    "test:e2e:stateful": "make --directory ../.. browser-e2e-stateful",
    "test:e2e:a11y": "make --directory ../.. browser-e2e-a11y",
    "test:e2e:visual": "make --directory ../.. browser-e2e-visual",
    "typecheck": "pnpm --workspace-root typecheck"
  }
}
