{
  "name": "@cartulary/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@cartulary/grid-adapter": "workspace:*",
    "@cartulary/test-utils": "workspace:*",
    "@cartulary/view-contracts": "workspace:*",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@playwright/test": "1.59.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "26.1.0",
    "typescript": "6.0.2",
    "vite": "8.0.8",
    "vitest": "4.1.4"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "bash ../../scripts/run-frontend-biome.sh write",
    "lint": "bash ../../scripts/run-frontend-biome.sh check",
    "test": "vitest",
    "test:e2e": "pnpm run test:e2e:functional && pnpm run test:e2e:stateful",
    "test:e2e:functional": "playwright test e2e/phase1.spec.ts e2e/phase2.spec.ts e2e/phase3.spec.ts e2e/phase4.spec.ts",
    "test:e2e:stateful": "PLAYWRIGHT_WORKERS=1 playwright test e2e/phase1.clock.spec.ts",
    "test:e2e:phase1": "PLAYWRIGHT_WORKERS=1 playwright test e2e/phase1.spec.ts e2e/phase1.clock.spec.ts",
    "test:e2e:phase2": "playwright test e2e/phase2.spec.ts",
    "test:e2e:phase3": "playwright test e2e/phase3.spec.ts",
    "test:e2e:phase4": "playwright test e2e/phase4.spec.ts",
    "test:e2e:visual": "playwright test e2e/workbook.visual.spec.ts",
    "typecheck": "tsc --noEmit"
  }
}
