        { "kind": "any", "name_pattern": "^(idx_records|idx_change_sets|idx_change_set_mutations|idx_record_revisions|idx_record_history|records_|change_sets_|change_set_mutations_|record_revisions_|record_history_entry_refs_).*$" }
      ],
      "downstream_surfaces": ["record history", "rollback", "workbook mutation audit"],
      "notes": "Record envelope, revision, and history reference substrate."
    },
    {
      "id": "links-and-coordination",
      "owner": "links",
      "profiles": ["base"],
      "object_patterns": [
        { "kind": "any", "name_pattern": "^(record_links|record_tags|handoff_risk_refs|parties|task_requests|decisions|artifacts)$" },
