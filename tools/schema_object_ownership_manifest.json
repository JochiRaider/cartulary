        { "kind": "any", "name_pattern": "^(idx_record_links|idx_record_tags|idx_handoff|idx_parties|idx_task_requests|idx_decisions|idx_artifacts|idx_artifact_findings|idx_artifact_investigative_queries|idx_artifact_forensic_keywords).*$" },
        { "kind": "any", "name_pattern": "^(record_links_|record_tags_|handoff_risk_refs_|parties_|task_requests_|decisions_|artifacts_|artifact_findings_|artifact_investigative_queries_|artifact_forensic_keywords_).*$" }
      ],
      "downstream_surfaces": ["relationship inspector", "coordination surfaces", "optional artifact surfaces"],
      "notes": "Relationship vocabulary, tags, parties, tasks, decisions, artifacts, and optional artifact-analysis surfaces."
    },
    {
      "id": "entity-source",
      "owner": "entities",
      "profiles": ["base"],
      "object_patterns": [
        { "kind": "any", "name_pattern": "^(entity_mentions|hosts|identities|entity_preserved_identifiers|entity_aliases)$" },
        { "kind": "any", "name_pattern": "^(idx_entity_mentions|idx_hosts|idx_identities|idx_entity_preserved_identifiers|idx_entity_aliases|entity_mentions_|hosts_|identities_|entity_preserved_identifiers_|entity_aliases_).*$" }
