      "owner": "indicators",
      "profiles": ["base"],
      "object_patterns": [
        { "kind": "any", "name_pattern": "^(indicators|indicator_state_intervals|indicator_observations)$" },
        { "kind": "any", "name_pattern": "^(idx_indicators|idx_indicator_state_intervals|idx_indicator_observations|indicators_|indicator_state_intervals_|indicator_observations_).*$" }
      ],
      "downstream_surfaces": ["indicator stores", "indicator workbook surface", "observation resolution"],
      "notes": "Indicator and observation source state."
    },
    {
      "id": "assessment-source",
      "owner": "assessments",
      "profiles": ["base"],
      "object_patterns": [
        { "kind": "any", "name_pattern": "^(compromise_assessments|assessments)$" },
        { "kind": "any", "name_pattern": "^(idx_compromise_assessments|idx_assessments|compromise_assessments_|assessments_).*$" }
