      "notes": "Read-model tables and views used by workbook surfaces."
    },
    {
      "id": "graphprojection",
      "owner": "graphprojection",
      "profiles": ["base"],
      "object_patterns": [
        { "kind": "any", "name_pattern": "^(graph_projection_views|graph_projection_runs|graph_projection_vertices|graph_projection_edges|graph_projection_idempotency)$" },
        { "kind": "any", "name_pattern": "^(graph_projection_views_|graph_projection_runs_|graph_projection_vertices_|graph_projection_edges_|graph_projection_idempotency_|graph_projection_.*_idx).*$" }
      ],
      "downstream_surfaces": ["graph projection internal runtime", "graph projection conformance tests"],
      "notes": "Derived graph projection state for the internal graphprojection subsystem; source ownership stays outside graphprojection."
    },
    {
      "id": "savedviews",
      "owner": "savedviews",
      "profiles": ["base"],
      "object_patterns": [
        { "kind": "any", "name_pattern": "^(saved_views|idx_saved_views|saved_views_).*$" }
      ],
      "downstream_surfaces": ["saved-view routes", "workbook startup", "query layout persistence"],
      "notes": "Saved view persistence and reusable identifier layout schema."
    },
    {
      "id": "imports",
      "owner": "imports",
      "profiles": ["import"],
      "object_patterns": [
        { "kind": "any", "name_pattern": "^(import_sessions|import_units|import_apply_journal|idx_import_sessions|idx_import_units|import_sessions_|import_units_|import_apply_journal_).*$" }
