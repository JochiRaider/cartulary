    },
    {
      "id": "reference-data",
      "owner": "reference_data",
      "profiles": ["reference_pack"],
      "object_patterns": [
        { "kind": "any", "name_pattern": "^(reference_packs|reference_pack_activation_state|reference_pack_attestations|reference_pack_job_payloads)$" },
