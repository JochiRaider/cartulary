{
  "schema_id": "cartulary.schema_object_ownership_manifest.v1",
  "migration_root": "db/migrations",
  "synthetic_objects": [
    {
      "kind": "bookkeeping",
      "name": "goose_db_version",
      "source": "goose runtime",
      "owner": "harness_support",
      "profiles": ["harness"],
      "downstream_surfaces": ["migration runner", "restore preflight", "test fixture identity"],
      "notes": "Created and maintained by goose, not authored migration SQL."
    }
  ],
  "allowed_owners": [
    "assessments",
    "auth",
    "collaboration",
    "deployment_admin",
    "entities",
    "evidence",
    "graphprojection",
    "harness_support",
    "imports",
    "incidentbundles",
    "incidents",
    "indicators",
    "jobapi",
    "links",
    "platform_jobs",
    "projections",
    "recovery",
    "reference_data",
    "reporting",
    "revisions",
    "savedviews",
    "timeline",
    "viewschemas",
    "workbook"
  ],
  "allowed_profiles": [
    "base",
    "enterprise_authentication",
    "harness",
    "import",
    "incident_portability",
    "reference_pack",
    "snapshot_reporting"
  ],
  "entries": [
    {
      "id": "goose-bookkeeping",
      "owner": "harness_support",
      "profiles": ["harness"],
      "object_patterns": [
        { "kind": "bookkeeping", "name_pattern": "^goose_db_version$" }
      ],
      "downstream_surfaces": ["migration runner", "restore preflight", "test fixture identity"],
      "notes": "Runtime migration bookkeeping is external to authored migration SQL."
    },
    {
      "id": "deployment-admin-and-recovery",
      "owner": "deployment_admin",
      "profiles": ["base"],
      "object_patterns": [
        { "kind": "any", "name_pattern": "^(pgcrypto|citext|deployment_bootstrap_state|deployment_admin_audit_events|backup_sets|restore_verification_runs)$" },
        { "kind": "any", "name_pattern": "^(idx_deployment_|idx_backup_|idx_restore_|backup_|restore_|deployment_bootstrap_state_|deployment_admin_audit_events_).*$" }
      ],
      "downstream_surfaces": ["bootstrap", "deployment audit", "backup", "restore verification"],
      "notes": "Deployment-local administrative and recovery schema."
    },
    {
      "id": "operator-recovery-journal",
      "owner": "recovery",
      "profiles": ["base"],
      "object_patterns": [
        { "kind": "any", "name_pattern": "^operator_recovery_journal$" },
        { "kind": "any", "name_pattern": "^operator_recovery_journal_.*$" }
      ],
      "downstream_surfaces": ["operator recovery journal", "backup", "restore verification", "safe administrative audit"],
      "notes": "Encrypted append-only journal for deployment-local recovery operations; not deployment-admin authorization state."
    },
    {
      "id": "auth-and-current-account",
      "owner": "auth",
      "profiles": ["base", "enterprise_authentication"],
      "object_patterns": [
        { "kind": "any", "name_pattern": "^(users|user_sessions|bootstrap_tokens|pending_totp_enrollments|route_idempotency|account_preferences)$" },
        { "kind": "any", "name_pattern": "^(enterprise_auth_providers|enterprise_auth_transactions|enterprise_auth_bindings)$" },
        { "kind": "any", "name_pattern": "^(idx_users|idx_user_sessions|idx_bootstrap_tokens|idx_pending_totp|idx_route_idempotency|idx_account_preferences|idx_enterprise_auth).*$" },
        { "kind": "any", "name_pattern": "^(users_|user_sessions_|bootstrap_tokens_|pending_totp_enrollments_|route_idempotency_|account_preferences_|enterprise_auth_).*$" }
      ],
      "downstream_surfaces": ["auth routes", "sessions", "current account", "enterprise authentication"],
      "notes": "Includes current-account preferences because they are deployment-local user account state."
    },
    {
      "id": "incident-core",
      "owner": "incidents",
      "profiles": ["base"],
      "object_patterns": [
        { "kind": "any", "name_pattern": "^(incidents|incident_memberships|incident_workbook_preferences|user_workbook_preferences)$" },
        { "kind": "any", "name_pattern": "^(idx_incidents|idx_incident_memberships|idx_incident_workbook|idx_user_workbook|incidents_|incident_memberships_|incident_workbook_preferences_|user_workbook_preferences_).*$" }
      ],
      "downstream_surfaces": ["incident routes", "membership authorization", "workbook startup preferences"],
      "notes": "Incident metadata, memberships, and incident-scoped workbook preference anchors."
    },
    {
      "id": "timeline-source",
      "owner": "timeline",
      "profiles": ["base"],
      "object_patterns": [
        { "kind": "any", "name_pattern": "^(timeline_events|timeline_time_conversion_profiles)$" },
        { "kind": "any", "name_pattern": "^(idx_timeline_events|idx_timeline_time_conversion_profiles|timeline_events_|timeline_time_conversion_profiles_).*$" }
      ],
      "downstream_surfaces": ["timeline routes", "timeline workbook surface", "timeline projections"],
      "notes": "Source-state timeline rows and time-conversion profile schema."
