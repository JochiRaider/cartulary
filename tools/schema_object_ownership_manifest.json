      "owner": "evidence",
      "profiles": ["base", "incident_portability"],
      "object_patterns": [
        { "kind": "any", "name_pattern": "^(evidence|object_blobs|evidence_access_handles|evidence_custody_events)$" },
        { "kind": "any", "name_pattern": "^(idx_evidence|idx_object_blobs|idx_evidence_access_handles|idx_evidence_custody_events|evidence_(record_|object_blob_|incident_|collector_|source_).*|object_blobs_|evidence_access_handles_|evidence_custody_events_).*$" }
      ],
      "downstream_surfaces": ["evidence routes", "object storage", "evidence handles", "incident bundle custody"],
      "notes": "Evidence metadata, blob references, access handles, and custody events."
    },
    {
      "id": "workbook-projections",
      "owner": "projections",
      "profiles": ["base"],
      "object_patterns": [
        { "kind": "any", "name_pattern": "^(timeline_grid_projection|host_grid_projection|identity_grid_projection|indicator_grid_projection|assessment_grid_projection|task_request_grid_projection|decision_grid_projection|artifact_grid_projection|evidence_grid_projection|party_grid_projection)$" },
