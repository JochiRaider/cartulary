{
  "schema_id": "cartulary.frontend_import_boundaries.v2",
  "scan_roots": [
    "apps/web/src",
    "apps/web/e2e",
    "apps/web/vite.config.ts",
    "apps/web/playwright.config.ts",
    "apps/web/playwright.shared.config.ts",
    "apps/web/playwright.webserver-backed.config.ts",
    "packages/grid-adapter/src",
    "packages/ui-contracts/src",
    "packages/view-contracts/src",
    "packages/test-utils/src",
    "packages/protocol-ts/src"
  ],
  "scan_excludes": [
    "packages/protocol-ts/src/generated/**",
    "packages/ui-contracts/src/generated/**",
    "apps/web/dist/**",
    "apps/web/test-results/**",
    "apps/web/playwright-report/**",
    "apps/web/coverage/**",
    "node_modules/**",
    "tmp/**",
    ".cache/**",
    ".pnpm-store/**"
  ],
  "singleton_imports": [
    {
      "id": "frontend-rdg-stylesheet-singleton",
      "level": "error",
      "message": "Import the react-data-grid stylesheet exactly once from the grid adapter.",
      "specifier": "react-data-grid/lib/styles.css",
      "required_count": 1,
      "allowed_importers": ["packages/grid-adapter/src/**"]
    }
  ],
  "rules": [
    {
      "id": "frontend-grid-vendor-boundary",
      "level": "error",
      "message": "Import react-data-grid only through @cartulary/grid-adapter.",
      "applies_to": {
        "include": ["**"],
        "exclude": []
      },
      "allowed_importers": [
        "packages/grid-adapter/src/**"
      ],
      "restricted_imports": [
        {
          "kind": "package",
          "name": "react-data-grid",
          "include_subpaths": true
        }
      ]
    },
    {
      "id": "frontend-grid-dom-unit-binding-boundary",
      "level": "error",
      "message": "Import the non-virtualized grid binding only from package-local DOM-unit tests.",
      "applies_to": {
        "include": ["**"],
        "exclude": [
          "packages/grid-adapter/src/*.test.ts",
          "packages/grid-adapter/src/*.test.tsx",
          "packages/grid-adapter/src/**/*.test.ts",
          "packages/grid-adapter/src/**/*.test.tsx"
        ]
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "packages/grid-adapter/src/domUnitBinding"
        }
      ]
    },
    {
      "id": "frontend-generated-protocol-boundary",
      "level": "error",
      "message": "Import generated protocol artifacts only through the @cartulary/protocol-ts facade.",
      "applies_to": {
        "include": ["**"],
        "exclude": []
      },
      "allowed_importers": [
        "packages/protocol-ts/src/index.ts"
      ],
      "restricted_imports": [
        {
          "kind": "package",
          "name": "@cartulary/protocol-ts/generated",
          "include_subpaths": true
        },
        {
          "kind": "path_prefix",
          "path": "packages/protocol-ts/src/generated"
        }
      ]
    },
    {
      "id": "frontend-protocol-facade-layer-boundary",
      "level": "error",
      "message": "Import @cartulary/protocol-ts only from frontend protocol adapter layers.",
      "applies_to": {
        "include": [
          "apps/web/src/**"
        ],
        "exclude": [
          "apps/web/src/*.test.ts",
          "apps/web/src/*.test.tsx",
          "apps/web/src/**/*.test.ts",
          "apps/web/src/**/*.test.tsx",
          "apps/web/src/**/*TestSupport.ts",
          "apps/web/src/**/*TestSupport.tsx",
          "apps/web/src/testing/**"
        ]
      },
      "allowed_importers": [
        "apps/web/src/app/api/**",
        "apps/web/src/collaboration/**",
        "apps/web/src/services/**"
      ],
      "restricted_imports": [
        {
          "kind": "package",
          "name": "@cartulary/protocol-ts",
          "include_subpaths": true
        }
      ]
    },
    {
      "id": "frontend-workbook-policy-transport-boundary",
      "level": "error",
      "message": "Workbook surface policies must remain transport and authorization independent.",
      "applies_to": {
        "include": [
          "apps/web/src/workbook/models/workbookSurfaceRegistration.ts",
          "apps/web/src/workbook/policies/**"
        ],
        "exclude": []
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/src/services"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/src/collaboration"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/runtime"
        }
      ]
    },
    {
      "id": "frontend-workbook-common-runtime-no-timeline",
      "level": "error",
      "message": "Common Workbook runtime must not import Timeline implementation.",
      "applies_to": {
        "include": [
          "apps/web/src/workbook/runtime/**"
        ],
        "exclude": []
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/timeline"
        }
      ]
    },
    {
      "id": "frontend-workbook-shell-feature-facade-boundary",
      "level": "error",
      "message": "Workbook and app composition must consume Network Flow only through its workbook feature facade.",
      "applies_to": {
        "include": [
          "apps/web/src/app/**",
          "apps/web/src/workbook/**"
        ],
        "exclude": []
      },
      "allowed_importers": [
        "apps/web/src/workbook/features/NetworkFlowFeature.tsx"
      ],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/src/networkFlow"
        }
      ]
    },
    {
      "id": "frontend-import-orchestration-consumer-boundary",
      "level": "error",
      "message": "Import orchestration is Imports-owned and may be consumed only by the Workbook Import Assistant and explicit Network Flow Import adapters.",
      "applies_to": {
        "include": [
          "apps/web/src/app/**",
          "apps/web/src/networkFlow/**",
          "apps/web/src/workbook/**"
        ],
        "exclude": [
          "apps/web/src/*.test.ts",
          "apps/web/src/*.test.tsx",
          "apps/web/src/**/*.test.ts",
          "apps/web/src/**/*.test.tsx",
          "apps/web/src/**/*TestSupport.ts",
          "apps/web/src/**/*TestSupport.tsx"
        ]
      },
      "allowed_importers": [
        "apps/web/src/networkFlow/NetworkFlowMappingModal.tsx",
        "apps/web/src/networkFlow/networkFlowImportModel.ts",
        "apps/web/src/networkFlow/useNetworkFlowImportController.ts",
        "apps/web/src/workbook/features/ImportAssistantFeature.tsx"
      ],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/src/imports/importCoordinator"
        }
      ]
    },
    {
      "id": "frontend-extension-projection-no-concrete-feature-imports",
      "level": "error",
      "message": "Extension projection code must not depend on concrete profile feature implementations.",
      "applies_to": {
        "include": [
          "apps/web/src/extensions/**"
        ],
        "exclude": [
          "apps/web/src/*.test.ts",
          "apps/web/src/*.test.tsx",
          "apps/web/src/**/*.test.ts",
          "apps/web/src/**/*.test.tsx",
          "apps/web/src/**/*TestSupport.ts",
          "apps/web/src/**/*TestSupport.tsx"
        ]
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/src/networkFlow"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/src/imports/importCoordinator"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/features"
        }
      ]
    },
    {
      "id": "frontend-timeline-controller-isolation-boundary",
      "level": "error",
      "message": "Timeline controllers must collaborate through model ports instead of importing sibling controllers.",
      "applies_to": {
        "include": ["apps/web/src/workbook/timeline/hooks/**"],
        "exclude": []
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/timeline/hooks"
        }
      ]
    },
    {
      "id": "frontend-generated-design-token-boundary",
      "level": "error",
      "message": "Import generated design token artifacts only through the @cartulary/ui-contracts facade.",
      "applies_to": {
        "include": ["**"],
        "exclude": []
      },
      "allowed_importers": [
        "packages/ui-contracts/src/index.ts"
      ],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "packages/ui-contracts/src/generated"
        }
      ]
    },
    {
      "id": "frontend-runtime-node-boundary",
      "level": "error",
      "message": "Browser runtime code must not import Node builtins.",
      "applies_to": {
        "include": [
          "apps/web/src/**",
          "packages/grid-adapter/src/**",
          "packages/protocol-ts/src/**",
          "packages/ui-contracts/src/**",
          "packages/view-contracts/src/**"
        ],
        "exclude": [
          "apps/web/src/*.test.ts",
          "apps/web/src/*.test.tsx",
          "apps/web/src/**/*.test.ts",
          "apps/web/src/**/*.test.tsx",
          "apps/web/src/**/*TestSupport.ts",
          "apps/web/src/**/*TestSupport.tsx",
          "apps/web/src/testing/fetchMockTestSupport.ts",
          "apps/web/src/testing/testSetup.ts",
          "apps/web/src/testing/testSetup.dom.ts",
          "apps/web/src/testing/timelineWorkbookTestSupport.ts",
          "packages/grid-adapter/src/*.test.ts",
          "packages/grid-adapter/src/*.test.tsx",
          "packages/grid-adapter/src/**/*.test.ts",
          "packages/grid-adapter/src/**/*.test.tsx",
          "packages/grid-adapter/src/test-support.tsx",
          "packages/protocol-ts/src/*.test.ts",
          "packages/protocol-ts/src/*.test.tsx",
          "packages/protocol-ts/src/**/*.test.ts",
          "packages/protocol-ts/src/**/*.test.tsx",
          "packages/ui-contracts/src/*.test.ts",
          "packages/ui-contracts/src/*.test.tsx",
          "packages/ui-contracts/src/**/*.test.ts",
          "packages/ui-contracts/src/**/*.test.tsx",
          "packages/view-contracts/src/*.test.ts",
          "packages/view-contracts/src/*.test.tsx",
          "packages/view-contracts/src/**/*.test.ts",
          "packages/view-contracts/src/**/*.test.tsx"
        ]
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "node_builtin",
          "names": ["*"]
        }
      ]
    },
    {
      "id": "frontend-workspace-package-facade-boundary",
      "level": "error",
      "message": "Import workspace packages only through package names and declared package.json exports.",
      "applies_to": {
        "include": ["**"],
        "exclude": []
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "workspace_package_facade",
          "package_roots": [
            "packages/grid-adapter",
            "packages/protocol-ts",
            "packages/test-utils",
            "packages/ui-contracts",
            "packages/view-contracts"
          ]
        }
      ]
    },
    {
      "id": "frontend-runtime-test-helper-boundary",
      "level": "error",
      "message": "Browser runtime code must not import test, e2e, or harness helper surfaces.",
      "applies_to": {
        "include": [
          "apps/web/src/**",
          "packages/grid-adapter/src/**",
          "packages/protocol-ts/src/**",
          "packages/ui-contracts/src/**",
          "packages/view-contracts/src/**"
        ],
        "exclude": [
          "apps/web/src/*.test.ts",
          "apps/web/src/*.test.tsx",
          "apps/web/src/**/*.test.ts",
          "apps/web/src/**/*.test.tsx",
          "apps/web/src/**/*TestSupport.ts",
          "apps/web/src/**/*TestSupport.tsx",
          "apps/web/src/testing/fetchMockTestSupport.ts",
          "apps/web/src/testing/testSetup.ts",
          "apps/web/src/testing/testSetup.dom.ts",
          "apps/web/src/testing/timelineWorkbookTestSupport.ts",
          "packages/grid-adapter/src/*.test.ts",
          "packages/grid-adapter/src/*.test.tsx",
          "packages/grid-adapter/src/**/*.test.ts",
          "packages/grid-adapter/src/**/*.test.tsx",
          "packages/grid-adapter/src/test-support.tsx",
          "packages/protocol-ts/src/*.test.ts",
          "packages/protocol-ts/src/*.test.tsx",
          "packages/protocol-ts/src/**/*.test.ts",
          "packages/protocol-ts/src/**/*.test.tsx",
          "packages/ui-contracts/src/*.test.ts",
          "packages/ui-contracts/src/*.test.tsx",
          "packages/ui-contracts/src/**/*.test.ts",
          "packages/ui-contracts/src/**/*.test.tsx",
          "packages/view-contracts/src/*.test.ts",
          "packages/view-contracts/src/*.test.tsx",
          "packages/view-contracts/src/**/*.test.ts",
          "packages/view-contracts/src/**/*.test.tsx"
        ]
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "package",
          "name": "@cartulary/test-utils",
          "include_subpaths": true
        },
        {
          "kind": "package",
          "name": "@cartulary/grid-adapter/test-support",
          "include_subpaths": true
        },
        {
          "kind": "package",
          "name": "@playwright/test",
          "include_subpaths": true
        },
        {
          "kind": "package",
          "name": "@testing-library/dom",
          "include_subpaths": true
        },
        {
          "kind": "package",
          "name": "@testing-library/react",
          "include_subpaths": true
        },
        {
          "kind": "package",
          "name": "vitest",
          "include_subpaths": true
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/src/testing/appShellTestSupport"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/src/testing/fetchMockTestSupport"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/src/testing/testSetup"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/src/testing/testSetup.dom"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/src/testing/timelineWorkbookTestSupport"
        }
      ]
    },
    {
      "id": "web-e2e-workbook-contract-boundary",
      "level": "error",
      "message": "E2E workbook support must consume derived surface metadata through support/contracts/workbookSurfaces.",
      "applies_to": {
        "include": ["apps/web/e2e/**"],
        "exclude": []
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/models/workbookSurfaceRegistry"
        }
      ]
    },
    {
      "id": "web-e2e-test-utils-subpath-boundary",
      "level": "error",
      "message": "Import @cartulary/test-utils through its semantic grid, accessibility, or visual subpaths.",
      "applies_to": {
        "include": ["apps/web/e2e/**"],
        "exclude": []
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "package",
          "name": "@cartulary/test-utils",
          "include_subpaths": false
        }
      ]
    },
    {
      "id": "web-e2e-public-control-transport-boundary",
      "level": "error",
      "message": "Public JSON transport must not import privileged test-control transport.",
      "applies_to": {
        "include": ["apps/web/e2e/support/transport/publicJsonClient.ts"],
        "exclude": []
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/e2e/support/transport/testControlClient"
        }
      ]
    },
    {
      "id": "web-e2e-semantic-fixture-direction",
      "level": "error",
      "message": "Semantic fixtures must not depend on accessibility or visual evidence composition.",
      "applies_to": {
        "include": [
          "apps/web/e2e/support/auth/**",
          "apps/web/e2e/support/collaboration/**",
          "apps/web/e2e/support/contracts/**",
          "apps/web/e2e/support/evidence/**",
          "apps/web/e2e/support/extensions/**",
          "apps/web/e2e/support/incidents/**",
          "apps/web/e2e/support/runtime/**",
          "apps/web/e2e/support/transport/**",
          "apps/web/e2e/support/workbook/**"
        ],
        "exclude": []
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/e2e/support/accessibility"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/e2e/support/visual"
        }
      ]
    },
    {
      "id": "web-e2e-core-support-direction",
      "level": "error",
      "message": "Core E2E support must not depend on higher semantic fixture or evidence owners.",
      "applies_to": {
        "include": [
          "apps/web/e2e/support/auth/**",
          "apps/web/e2e/support/contracts/**",
          "apps/web/e2e/support/incidents/**",
          "apps/web/e2e/support/runtime/**",
          "apps/web/e2e/support/transport/**",
          "apps/web/e2e/support/workbook/**"
        ],
        "exclude": ["apps/web/e2e/support/runtime/architecturePolicy.test.ts"]
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/e2e/support/accessibility"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/e2e/support/assessments"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/e2e/support/collaboration"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/e2e/support/entities"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/e2e/support/evidence"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/e2e/support/extensions"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/e2e/support/recovery"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/e2e/support/timeline"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/e2e/support/visual"
        }
      ]
    }
  ],
  "raw_design_token_literal_checks": [
    {
      "id": "frontend-runtime-raw-design-color-literals",
      "level": "error",
      "message": "Runtime UI code must use generated Cartulary design token artifacts instead of raw machine-owned color token literals.",
      "design_document": "contracts/design/tokens.v1.json",
      "token_namespaces": ["colors"],
      "applies_to": {
        "include": [
          "apps/web/src/**",
          "packages/grid-adapter/src/**"
        ],
        "exclude": [
          "apps/web/src/*.test.ts",
          "apps/web/src/*.test.tsx",
          "apps/web/src/**/*.test.ts",
          "apps/web/src/**/*.test.tsx",
          "apps/web/src/**/*TestSupport.ts",
          "apps/web/src/**/*TestSupport.tsx",
          "apps/web/src/testing/fetchMockTestSupport.ts",
          "apps/web/src/testing/testSetup.ts",
          "apps/web/src/testing/testSetup.dom.ts",
          "apps/web/src/testing/timelineWorkbookTestSupport.ts",
          "packages/grid-adapter/src/*.test.ts",
          "packages/grid-adapter/src/*.test.tsx",
          "packages/grid-adapter/src/**/*.test.ts",
          "packages/grid-adapter/src/**/*.test.tsx",
          "packages/grid-adapter/src/test-support.tsx"
        ]
      }
    }
  ]
}
