{
  "schema_id": "cartulary.frontend_import_boundaries.v2",
  "scan_roots": [
    "apps/web/src",
    "apps/web/e2e",
    "apps/web/vite.config.ts",
    "apps/web/playwright.config.ts",
    "apps/web/playwright.shared.config.ts",
    "apps/web/playwright.webserver-backed.config.ts",
    "packages/grid-adapter/src",
    "packages/ui-contracts/src",
    "packages/view-contracts/src",
    "packages/test-utils/src",
    "packages/protocol-ts/src"
  ],
  "scan_excludes": [
    "packages/protocol-ts/src/generated/**",
    "packages/ui-contracts/src/generated/**",
    "apps/web/dist/**",
    "apps/web/test-results/**",
    "apps/web/playwright-report/**",
    "apps/web/coverage/**",
    "node_modules/**",
    "tmp/**",
    ".cache/**",
    ".pnpm-store/**"
  ],
  "acyclic_import_graphs": [
    {
      "id": "frontend-web-production-acyclic-import-graph",
      "level": "error",
      "message": "Production web source imports, type imports, re-exports, and dynamic imports must form an enumerable acyclic graph.",
      "applies_to": {
        "include": [
          "apps/web/src/**"
        ],
        "exclude": [
          "apps/web/src/*.test.ts",
          "apps/web/src/*.test.tsx",
          "apps/web/src/**/*.test.ts",
          "apps/web/src/**/*.test.tsx",
          "apps/web/src/**/*TestSupport.ts",
          "apps/web/src/**/*TestSupport.tsx",
          "apps/web/src/testing/**"
        ]
      }
    }
  ],
  "singleton_imports": [
    {
      "id": "frontend-rdg-stylesheet-singleton",
      "level": "error",
      "message": "Import the react-data-grid stylesheet exactly once from the grid adapter.",
      "specifier": "react-data-grid/lib/styles.css",
      "required_count": 1,
      "allowed_importers": ["packages/grid-adapter/src/**"]
    }
  ],
  "rules": [
    {
      "id": "frontend-grid-vendor-boundary",
      "level": "error",
      "message": "Import react-data-grid only through @cartulary/grid-adapter.",
      "applies_to": {
        "include": ["**"],
        "exclude": []
      },
      "allowed_importers": [
        "packages/grid-adapter/src/**"
      ],
      "restricted_imports": [
        {
          "kind": "package",
          "name": "react-data-grid",
          "include_subpaths": true
        }
      ]
    },
    {
      "id": "frontend-grid-dom-unit-binding-boundary",
      "level": "error",
      "message": "Import the non-virtualized grid binding only from package-local DOM-unit tests.",
      "applies_to": {
        "include": ["**"],
        "exclude": [
          "packages/grid-adapter/src/*.test.ts",
          "packages/grid-adapter/src/*.test.tsx",
          "packages/grid-adapter/src/**/*.test.ts",
          "packages/grid-adapter/src/**/*.test.tsx"
        ]
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "packages/grid-adapter/src/domUnitBinding"
        }
      ]
    },
    {
      "id": "frontend-generated-protocol-boundary",
      "level": "error",
      "message": "Import generated protocol artifacts only through owner-declared Protocol-TS entrypoints.",
      "applies_to": {
        "include": ["**"],
        "exclude": [
          "packages/protocol-ts/src/unsupported-entrypoints.compile.ts"
        ]
      },
      "allowed_importers": [
        "packages/protocol-ts/src/entrypoints/collaboration.ts",
        "packages/protocol-ts/src/entrypoints/errors.ts",
        "packages/protocol-ts/src/entrypoints/extensions.ts",
        "packages/protocol-ts/src/entrypoints/http.ts",
        "packages/protocol-ts/src/entrypoints/import-targets.ts",
        "packages/protocol-ts/src/entrypoints/network-flow.ts",
        "packages/protocol-ts/src/entrypoints/view-schemas.ts"
      ],
      "restricted_imports": [
        {
          "kind": "package",
          "name": "@cartulary/protocol-ts/generated",
          "include_subpaths": true
        },
        {
          "kind": "path_prefix",
          "path": "packages/protocol-ts/src/generated"
        }
      ]
    },
    {
      "id": "frontend-protocol-facade-layer-boundary",
      "level": "error",
      "message": "Import @cartulary/protocol-ts only from frontend protocol adapter layers.",
      "applies_to": {
        "include": [
          "apps/web/src/**"
        ],
        "exclude": [
          "apps/web/src/*.test.ts",
          "apps/web/src/*.test.tsx",
          "apps/web/src/**/*.test.ts",
          "apps/web/src/**/*.test.tsx",
          "apps/web/src/**/*TestSupport.ts",
          "apps/web/src/**/*TestSupport.tsx",
          "apps/web/src/testing/**"
        ]
      },
      "allowed_importers": [
        "apps/web/src/app/api/**",
        "apps/web/src/collaboration/**",
        "apps/web/src/extensions/extensionAvailability.ts",
        "apps/web/src/services/**",
        "apps/web/src/shared/sheetRef.ts",
        "apps/web/src/workbook/mutations/createWorkbookMutationCommandPorts.ts",
        "apps/web/src/workbook/adapters/**",
        "apps/web/src/workbook/timeline/adapters/**"
      ],
      "restricted_imports": [
        {
          "kind": "package",
          "name": "@cartulary/protocol-ts",
          "include_subpaths": true
        }
      ]
    },
    {
      "id": "frontend-workbook-shell-runtime-startup-boundary",
      "level": "error",
      "message": "The aggregate Workbook shell runtime must consume startup admission through its facade.",
      "applies_to": {
        "include": [
          "apps/web/src/workbook/hooks/useWorkbookShellRuntime.ts"
        ],
        "exclude": []
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/src/services"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/models/workbookStartup"
        }
      ]
    },
    {
      "id": "frontend-services-workbook-direction",
      "level": "error",
      "message": "Production service adapters must not depend on Workbook application or presentation modules.",
      "applies_to": {
        "include": [
          "apps/web/src/services/**"
        ],
        "exclude": [
          "apps/web/src/services/*.test.ts",
          "apps/web/src/services/*.test.tsx",
          "apps/web/src/services/**/*.test.ts",
          "apps/web/src/services/**/*.test.tsx"
        ]
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook"
        }
      ]
    },
    {
      "id": "frontend-workbook-policy-transport-boundary",
      "level": "error",
      "message": "Workbook surface policies must remain transport and authorization independent.",
      "applies_to": {
        "include": [
          "apps/web/src/workbook/models/workbookSurfaceRegistration.ts",
          "apps/web/src/workbook/policies/**"
        ],
        "exclude": []
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/src/services"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/src/collaboration"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/runtime"
        }
      ]
    },
    {
      "id": "frontend-workbook-common-runtime-no-timeline",
      "level": "error",
      "message": "Common Workbook runtime must not import Timeline implementation.",
      "applies_to": {
        "include": [
          "apps/web/src/workbook/runtime/**"
        ],
        "exclude": []
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/timeline"
        }
      ]
    },
    {
      "id": "frontend-workbook-continuity-port-semantic-boundary",
      "level": "error",
      "message": "The Workbook continuity port may expose only semantic identities; grid-vendor and presentation translation belongs to private adapters.",
      "applies_to": {
        "include": [
          "apps/web/src/workbook/continuity/workbookContinuityPort.ts"
        ],
        "exclude": []
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "package",
          "name": "@cartulary/grid-adapter",
          "include_subpaths": true
        },
        {
          "kind": "package",
          "name": "@cartulary/ui-contracts",
          "include_subpaths": true
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/components"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/timeline"
        }
      ]
    },
    {
      "id": "frontend-workbook-column-layout-controller-private-to-shell-runtime",
      "level": "error",
      "message": "Workbook column-layout lifecycle is private to the shell runtime; consumers receive semantic layout snapshots and commands.",
      "applies_to": {
        "include": [
          "apps/web/src/**"
        ],
        "exclude": [
          "apps/web/src/*.test.ts",
          "apps/web/src/*.test.tsx",
          "apps/web/src/**/*.test.ts",
          "apps/web/src/**/*.test.tsx",
          "apps/web/src/**/*TestSupport.ts",
          "apps/web/src/**/*TestSupport.tsx",
          "apps/web/src/testing/**"
        ]
      },
      "allowed_importers": [
        "apps/web/src/workbook/hooks/useWorkbookShellRuntime.ts"
      ],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/layout/useWorkbookColumnLayoutController"
        }
      ]
    },
    {
      "id": "frontend-workbook-responsive-layout-private-to-facade",
      "level": "error",
      "message": "Viewport subscription and responsive classification must enter Workbook composition through the layout facade.",
      "applies_to": {
        "include": [
          "apps/web/src/**"
        ],
        "exclude": [
          "apps/web/src/*.test.ts",
          "apps/web/src/*.test.tsx",
          "apps/web/src/**/*.test.ts",
          "apps/web/src/**/*.test.tsx",
          "apps/web/src/**/*TestSupport.ts",
          "apps/web/src/**/*TestSupport.tsx",
          "apps/web/src/testing/**"
        ]
      },
      "allowed_importers": [
        "apps/web/src/workbook/layout/useWorkbookLayoutFacade.ts"
      ],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/layout/useWorkbookResponsiveLayout"
        }
      ]
    },
    {
      "id": "frontend-workbook-surface-renderers-private-to-facade",
      "level": "error",
      "message": "Concrete Workbook surface renderers are private to the surfaces composition facade.",
      "applies_to": {
        "include": [
          "apps/web/src/**"
        ],
        "exclude": [
          "apps/web/src/*.test.ts",
          "apps/web/src/*.test.tsx",
          "apps/web/src/**/*.test.ts",
          "apps/web/src/**/*.test.tsx",
          "apps/web/src/**/*TestSupport.ts",
          "apps/web/src/**/*TestSupport.tsx",
          "apps/web/src/testing/**"
        ]
      },
      "allowed_importers": [
        "apps/web/src/workbook/surfaces/WorkbookSurfacesFacade.tsx"
      ],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/components/AssessmentWorkbookSurface.tsx"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/components/EntityWorkbookSurface.tsx"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/components/GenericWorkbookSurface.tsx"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/timeline/components/TimelineWorkbook.tsx"
        }
      ]
    },
    {
      "id": "frontend-workbook-surfaces-facade-no-shell-back-edge",
      "level": "error",
      "message": "The Workbook surfaces facade must not depend back on its shell composition root.",
      "applies_to": {
        "include": [
          "apps/web/src/workbook/surfaces/WorkbookSurfacesFacade.tsx"
        ],
        "exclude": []
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/WorkbookShell.tsx"
        }
      ]
    },
    {
      "id": "frontend-assessment-owner-no-timeline-imports",
      "level": "error",
      "message": "Assessment models and presentation must not depend on Timeline implementation; only the candidate query adapter may translate Timeline rows.",
      "applies_to": {
        "include": [
          "apps/web/src/workbook/components/AssessmentWorkbookSurface.tsx",
          "apps/web/src/workbook/components/WorkbookRecordCandidatePicker.tsx",
          "apps/web/src/workbook/hooks/useAssessmentSupportCandidates.ts",
          "apps/web/src/workbook/models/assessmentWorkbookModel.ts"
        ],
        "exclude": []
      },
      "allowed_importers": [
        "apps/web/src/workbook/hooks/useAssessmentSupportCandidates.ts"
      ],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/timeline"
        }
      ]
    },
    {
      "id": "frontend-workbook-shell-feature-facade-boundary",
      "level": "error",
      "message": "Workbook and app composition must consume Network Flow only through its workbook feature facade.",
      "applies_to": {
        "include": [
          "apps/web/src/app/**",
          "apps/web/src/workbook/**"
        ],
        "exclude": []
      },
      "allowed_importers": [
        "apps/web/src/workbook/features/NetworkFlowFeature.tsx"
      ],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/src/networkFlow"
        }
      ]
    },
    {
      "id": "frontend-import-orchestration-consumer-boundary",
      "level": "error",
      "message": "Import orchestration is Imports-owned and may be consumed only by the Workbook Import Assistant and explicit Network Flow Import adapters.",
      "applies_to": {
        "include": [
          "apps/web/src/app/**",
          "apps/web/src/networkFlow/**",
          "apps/web/src/workbook/**"
        ],
        "exclude": [
          "apps/web/src/*.test.ts",
          "apps/web/src/*.test.tsx",
          "apps/web/src/**/*.test.ts",
          "apps/web/src/**/*.test.tsx",
          "apps/web/src/**/*TestSupport.ts",
          "apps/web/src/**/*TestSupport.tsx"
        ]
      },
      "allowed_importers": [
        "apps/web/src/networkFlow/NetworkFlowMappingModal.tsx",
        "apps/web/src/networkFlow/networkFlowImportModel.ts",
        "apps/web/src/networkFlow/useNetworkFlowImportController.ts",
        "apps/web/src/workbook/features/ImportAssistantFeature.tsx"
      ],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/src/imports/importCoordinator"
        }
      ]
    },
    {
      "id": "frontend-extension-projection-no-concrete-feature-imports",
      "level": "error",
      "message": "Extension projection code must not depend on concrete profile feature implementations.",
      "applies_to": {
        "include": [
          "apps/web/src/extensions/**"
        ],
        "exclude": [
          "apps/web/src/*.test.ts",
          "apps/web/src/*.test.tsx",
          "apps/web/src/**/*.test.ts",
          "apps/web/src/**/*.test.tsx",
          "apps/web/src/**/*TestSupport.ts",
          "apps/web/src/**/*TestSupport.tsx"
        ]
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/src/networkFlow"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/src/imports/importCoordinator"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/features"
        }
      ]
    },
    {
      "id": "frontend-timeline-controller-isolation-boundary",
      "level": "error",
      "message": "Timeline controllers must collaborate through model ports instead of importing sibling controllers.",
      "applies_to": {
        "include": ["apps/web/src/workbook/timeline/hooks/**"],
        "exclude": []
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/timeline/hooks"
        }
      ]
    },
    {
      "id": "frontend-timeline-workflow-transport-boundary",
      "level": "error",
      "message": "Timeline presentation and workflow owners must consume semantic ports instead of browser services or protocol envelopes.",
      "applies_to": {
        "include": [
          "apps/web/src/workbook/timeline/bulk/**",
          "apps/web/src/workbook/timeline/collaboration/**",
          "apps/web/src/workbook/timeline/components/**",
          "apps/web/src/workbook/timeline/editing/**",
          "apps/web/src/workbook/timeline/hooks/**",
          "apps/web/src/workbook/timeline/mutations/**"
        ],
        "exclude": [
          "apps/web/src/**/*.test.ts",
          "apps/web/src/**/*.test.tsx"
        ]
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "package",
          "name": "@cartulary/protocol-ts",
          "include_subpaths": true
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/src/services"
        }
      ]
    },
    {
      "id": "frontend-timeline-lower-layers-no-components",
      "level": "error",
      "message": "Timeline adapters, workflows, models, mutations, and ports must not depend back on Timeline presentation components.",
      "applies_to": {
        "include": [
          "apps/web/src/workbook/timeline/adapters/**",
          "apps/web/src/workbook/timeline/bulk/**",
          "apps/web/src/workbook/timeline/collaboration/**",
          "apps/web/src/workbook/timeline/editing/**",
          "apps/web/src/workbook/timeline/hooks/**",
          "apps/web/src/workbook/timeline/models/**",
          "apps/web/src/workbook/timeline/mutations/**",
          "apps/web/src/workbook/timeline/ports/**"
        ],
        "exclude": []
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/timeline/components"
        }
      ]
    },
    {
      "id": "frontend-timeline-adapter-no-workflow-back-edge",
      "level": "error",
      "message": "Timeline protocol adapters may depend on semantic models and ports but must not import workflow state or presentation owners.",
      "applies_to": {
        "include": ["apps/web/src/workbook/timeline/adapters/**"],
        "exclude": []
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/timeline/bulk"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/timeline/collaboration"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/timeline/editing"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/timeline/hooks"
        },
        {
          "kind": "path_prefix",
          "path": "apps/web/src/workbook/timeline/mutations"
        }
      ]
    },
    {
      "id": "frontend-generated-protocol-barrel-deny",
      "level": "error",
      "message": "Authored frontend code must not import the broad generated protocol barrel.",
      "applies_to": {
        "include": [
          "**"
        ],
        "exclude": []
      },
      "allowed_importers": [],
      "restricted_imports": [
        {
          "kind": "path_prefix",
          "path": "packages/protocol-ts/src/generated/index"
