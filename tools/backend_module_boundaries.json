{
  "schema_id": "cartulary.backend_module_boundaries.v1",
  "scan_roots": [
    "cmd",
    "db/queries",
    "internal/app",
    "internal/modules",
    "internal/platform"
  ],
  "scan_excludes": [
    "internal/gen"
  ],
  "owner_port_only_imports": [
    {
      "id": "incidentbundles-facade-import",
      "import": "github.com/JochiRaider/cartulary/internal/modules/incidentbundles",
      "allowed_importers": [
        "internal/app/server/runtime.go",
        "internal/modules/incidentbundles/**"
      ]
    },
    {
      "id": "artifact-delete-restore-provider-import",
      "import": "github.com/JochiRaider/cartulary/internal/modules/artifacts/deleterestore",
      "allowed_importers": ["internal/modules/artifacts/**"]
    },
    {
      "id": "artifact-rollback-provider-import",
      "import": "github.com/JochiRaider/cartulary/internal/modules/artifacts/rollbackprovider",
      "allowed_importers": ["internal/modules/artifacts/**"]
    },
    {
      "id": "assessment-delete-restore-provider-import",
      "import": "github.com/JochiRaider/cartulary/internal/modules/assessments/deleterestore",
      "allowed_importers": ["internal/modules/assessments/**"]
    },
    {
      "id": "assessment-rollback-provider-import",
      "import": "github.com/JochiRaider/cartulary/internal/modules/assessments/rollbackprovider",
      "allowed_importers": ["internal/modules/assessments/**"]
    },
    {
      "id": "entity-delete-restore-provider-import",
      "import": "github.com/JochiRaider/cartulary/internal/modules/entities/hostidentity/deleterestore",
      "allowed_importers": ["internal/modules/entities/**"]
    },
    {
      "id": "entity-rollback-provider-import",
      "import": "github.com/JochiRaider/cartulary/internal/modules/entities/hostidentity/rollbackprovider",
      "allowed_importers": ["internal/modules/entities/**"]
    },
    {
      "id": "entity-mention-rollback-provider-import",
      "import": "github.com/JochiRaider/cartulary/internal/modules/entities/mentions/rollbackprovider",
      "allowed_importers": ["internal/modules/entities/**"]
    },
    {
      "id": "evidence-delete-restore-provider-import",
      "import": "github.com/JochiRaider/cartulary/internal/modules/evidence/deleterestore",
      "allowed_importers": ["internal/modules/evidence/**"]
    },
    {
      "id": "evidence-rollback-provider-import",
      "import": "github.com/JochiRaider/cartulary/internal/modules/evidence/rollbackprovider",
      "allowed_importers": ["internal/modules/evidence/**"]
    },
    {
      "id": "indicator-delete-restore-provider-import",
      "import": "github.com/JochiRaider/cartulary/internal/modules/indicators/deleterestore",
      "allowed_importers": ["internal/modules/indicators/**"]
    },
    {
      "id": "indicator-rollback-provider-import",
      "import": "github.com/JochiRaider/cartulary/internal/modules/indicators/rollbackprovider",
      "allowed_importers": ["internal/modules/indicators/**"]
    },
    {
      "id": "link-revision-provider-import",
      "import": "github.com/JochiRaider/cartulary/internal/modules/links/revisionprovider",
      "allowed_importers": ["internal/modules/links/**"]
    },
    {
      "id": "party-delete-restore-provider-import",
      "import": "github.com/JochiRaider/cartulary/internal/modules/parties/deleterestore",
      "allowed_importers": ["internal/modules/parties/**"]
    },
    {
      "id": "party-rollback-provider-import",
      "import": "github.com/JochiRaider/cartulary/internal/modules/parties/rollbackprovider",
      "allowed_importers": ["internal/modules/parties/**"]
    },
    {
      "id": "tasks-decisions-delete-restore-provider-import",
      "import": "github.com/JochiRaider/cartulary/internal/modules/tasksdecisions/deleterestore",
      "allowed_importers": ["internal/modules/tasksdecisions/**"]
    },
    {
      "id": "tasks-decisions-rollback-provider-import",
      "import": "github.com/JochiRaider/cartulary/internal/modules/tasksdecisions/rollbackprovider",
      "allowed_importers": ["internal/modules/tasksdecisions/**"]
    },
    {
      "id": "timeline-delete-restore-provider-import",
      "import": "github.com/JochiRaider/cartulary/internal/modules/timeline/deleterestore",
      "allowed_importers": ["internal/modules/timeline/**"]
    },
    {
      "id": "timeline-rollback-provider-import",
      "import": "github.com/JochiRaider/cartulary/internal/modules/timeline/rollbackprovider",
      "allowed_importers": ["internal/modules/timeline/**"]
    }
  ],
  "raw_ndjson_targets": [
    {
      "id": "incidentportability-raw-target",
      "function": "incidentportability.ImportNDJSON",
      "allowed_paths": [
        "internal/modules/incidentportability/**"
      ]
    }
  ],
  "forbidden_route_dependencies": [
    {
      "id": "backend-route-package-import",
      "import_suffix": "/routes",
      "allowed_importers": []
    }
  ],
  "forbidden_go_imports": [
    {
      "id": "source-owners-no-workbook-mutation-conflict-imports",
      "imports": [
        "github.com/JochiRaider/cartulary/internal/modules/workbook/collectionpolicy",
        "github.com/JochiRaider/cartulary/internal/modules/workbook/conflicts"
      ],
      "scan_paths": ["internal/modules/**"],
      "allowed_paths": ["internal/modules/workbook/**"],
      "production_only": true
    },
    {
      "id": "production-server-no-harness-contributors",
      "imports": [
        "github.com/JochiRaider/cartulary/internal/platform/harnessruntime",
        "github.com/JochiRaider/cartulary/internal/modules/networkflow/harnesscontrol"
      ],
      "scan_paths": ["internal/app/**"],
      "allowed_paths": ["internal/app/server/server_profile_harness.go"],
      "production_only": true
    }
  ],
  "go_import_allowlists": [
    {
      "id": "server-command-production-imports",
      "import_prefix": "github.com/JochiRaider/cartulary/internal/",
      "scan_paths": ["cmd/server/main.go"],
      "production_only": true,
      "allowed_prefixes": [],
      "allowed_imports": ["github.com/JochiRaider/cartulary/internal/app/server"]
    },
    {
      "id": "migrate-command-production-imports",
      "import_prefix": "github.com/JochiRaider/cartulary/internal/",
      "scan_paths": ["cmd/migrate/main.go"],
      "production_only": true,
      "allowed_prefixes": [],
      "allowed_imports": ["github.com/JochiRaider/cartulary/internal/app/migrate"]
    },
    {
      "id": "operator-command-production-imports",
      "import_prefix": "github.com/JochiRaider/cartulary/internal/",
      "scan_paths": ["cmd/operator/main.go"],
      "production_only": true,
      "allowed_prefixes": [],
      "allowed_imports": ["github.com/JochiRaider/cartulary/internal/app/operator"]
    },
    {
      "id": "revision-assembly-exact-imports",
      "import_prefix": "github.com/JochiRaider/cartulary/internal/",
      "scan_paths": ["internal/app/revisionassembly/**"],
      "production_only": true,
      "allowed_prefixes": [],
      "allowed_imports": [
        "github.com/JochiRaider/cartulary/internal/modules/artifacts",
        "github.com/JochiRaider/cartulary/internal/modules/assessments",
        "github.com/JochiRaider/cartulary/internal/modules/entities",
        "github.com/JochiRaider/cartulary/internal/modules/evidence",
        "github.com/JochiRaider/cartulary/internal/modules/indicators",
        "github.com/JochiRaider/cartulary/internal/modules/links",
        "github.com/JochiRaider/cartulary/internal/modules/parties",
        "github.com/JochiRaider/cartulary/internal/modules/projections/adapters",
        "github.com/JochiRaider/cartulary/internal/modules/revisions",
        "github.com/JochiRaider/cartulary/internal/modules/tasksdecisions",
        "github.com/JochiRaider/cartulary/internal/modules/timeline",
        "github.com/JochiRaider/cartulary/internal/platform/postgres"
      ]
    },
    {
      "id": "http-runtime-platform-only-imports",
      "import_prefix": "github.com/JochiRaider/cartulary/internal/",
      "scan_paths": ["internal/platform/httpruntime/**"],
      "production_only": true,
      "allowed_prefixes": [
        "github.com/JochiRaider/cartulary/internal/platform"
      ],
      "allowed_imports": []
    },
    {
      "id": "workbook-approved-owner-imports",
      "import_prefix": "github.com/JochiRaider/cartulary/internal/modules/",
      "scan_paths": ["internal/modules/workbook/**"],
      "production_only": true,
      "allowed_prefixes": [
        "github.com/JochiRaider/cartulary/internal/modules/workbook"
      ],
      "allowed_imports": [
        "github.com/JochiRaider/cartulary/internal/modules/artifacts",
        "github.com/JochiRaider/cartulary/internal/modules/artifacts/linkednotes",
        "github.com/JochiRaider/cartulary/internal/modules/artifacts/riskrefs",
        "github.com/JochiRaider/cartulary/internal/modules/collaboration",
        "github.com/JochiRaider/cartulary/internal/modules/entities/hostidentity",
        "github.com/JochiRaider/cartulary/internal/modules/entities/mentions",
        "github.com/JochiRaider/cartulary/internal/modules/evidence",
        "github.com/JochiRaider/cartulary/internal/modules/evidence/blobref",
        "github.com/JochiRaider/cartulary/internal/modules/tabularingest",
        "github.com/JochiRaider/cartulary/internal/modules/incidents",
        "github.com/JochiRaider/cartulary/internal/modules/indicators",
        "github.com/JochiRaider/cartulary/internal/modules/links",
        "github.com/JochiRaider/cartulary/internal/modules/parties",
        "github.com/JochiRaider/cartulary/internal/modules/projections/adapters",
        "github.com/JochiRaider/cartulary/internal/modules/records",
        "github.com/JochiRaider/cartulary/internal/modules/revisions",
        "github.com/JochiRaider/cartulary/internal/modules/revisions/conflicttokens",
        "github.com/JochiRaider/cartulary/internal/modules/savedviews",
        "github.com/JochiRaider/cartulary/internal/modules/tasksdecisions",
        "github.com/JochiRaider/cartulary/internal/modules/timeline"
      ]
    }
  ],
  "source_table_access": [
    {
      "id": "links-source-tables",
      "tables": ["record_links", "record_tags"],
      "allowed_paths": [
        "internal/modules/links/**"
      ]
    },
    {
      "id": "revisions-owner-source-tables",
      "tables": [
        "artifact_comm_logs",
        "artifact_findings",
        "artifact_forensic_keywords",
        "artifact_handoffs",
        "artifact_investigative_queries",
        "artifact_lessons",
        "artifact_notes",
        "artifact_status_reviews",
        "artifacts",
        "assessments",
        "decisions",
        "entity_aliases",
        "entity_mentions",
        "entity_preserved_identifiers",
        "evidence",
        "hosts",
        "identities",
        "indicator_observations",
        "indicator_state_intervals",
        "indicators",
        "parties",
        "record_links",
        "record_tags",
        "task_requests",
        "timeline_events"
      ],
      "allowed_paths": [],
      "scan_paths": ["internal/modules/revisions/**"]
    }
  ],
  "forbidden_source_mappings": [
    {
      "id": "revisions-owner-field-mappings",
      "prefixes": [
        "assessment.",
        "comm_log.",
        "decision.",
        "evidence.",
        "finding.",
        "forensic_keyword.",
        "handoff.",
        "host.",
        "identity.",
        "indicator.",
        "investigative_query.",
        "lesson.",
        "note.",
        "party.",
        "status_review.",
        "task_request.",
        "timeline."
      ],
      "scan_paths": ["internal/modules/revisions/**"]
    }
  ],
  "sql_table_allowlists": [
    {
      "id": "revisions-history-and-envelope-tables-only",
      "allowed_tables": [
        "change_set_mutations",
        "change_sets",
        "record_history_entry_refs",
        "record_revisions",
        "records"
      ],
      "scan_paths": ["internal/modules/revisions/**"]
    }
  ],
  "forbidden_go_calls": [
    {
      "id": "links-retired-string-mutators",
      "symbols": [
        ".UpsertLinkTx(",
        ".SyncFieldReferenceTx(",
        ".InsertSupersedesTx("
      ],
      "allowed_paths": []
    }
  ],
  "command_root_shape": {
    "root": "cmd",
    "allowed_go_files": [
      "cmd/server/main.go",
      "cmd/migrate/main.go",
      "cmd/operator/main.go"
    ]
  },
  "forbidden_source_tokens": [
    {
      "id": "retired-contextless-cli-wrappers",
      "tokens": [
        "func RunMigrateCLI(",
        "func RunOperatorCLI(",
        "newMigrateRunnerForCLI",
        "newOperatorRunnerForCLI",
        "migrateCommandFlag"
      ],
      "scan_paths": ["internal/**"],
      "allowed_paths": [],
      "production_only": true
    },
    {
      "id": "retired-recovery-top-level-token",
      "tokens": ["backup-metadata"],
      "scan_paths": ["internal/modules/recovery/**", "internal/app/**"],
      "allowed_paths": [],
      "production_only": true
    },
    {
      "id": "retired-browser-runtime-opt-in",
      "tokens": ["CARTULARY_WEB_E2E_USE_REPO_ROOT_BINARIES"],
      "scan_paths": ["internal/**", "cmd/**"],
      "allowed_paths": [],
      "production_only": true
    }
  ],
  "forbidden_test_build_tokens": [
    "go build",
    "go run ./cmd/",
    "make build-server",
    "make build-migrate",
    "make build-operator"
  ],
  "generated_root_writes": {
    "scan_roots": [
      "cmd",
      "internal/app",
      "internal/modules",
      "internal/platform"
    ],
    "generated_roots": [
      "internal/gen/",
      "packages/protocol-ts/src/generated/",
      "packages/ui-contracts/src/generated/"
    ],
    "write_symbols": [
      "os.WriteFile",
      "writeFileSync",
      "WriteFile"
    ],
    "allowed_paths": []
  }
}
