{
  "schema_id": "cartulary.scheduler_resource_registry.v1",
  "resources": [
    {
      "name": "host_cpu",
      "display_name": "host CPU",
      "schedulers": ["check"],
      "display_order": 10,
      "make_variable": "CHECK_HOST_CPU_JOBS"
    },
    {
      "name": "host_io",
      "display_name": "host IO",
      "schedulers": ["check"],
      "display_order": 20,
      "make_variable": "CHECK_HOST_IO_JOBS"
    },
    {
      "name": "service_stack",
      "display_name": "service stack",
      "schedulers": ["check"],
      "display_order": 30
    },
    {
      "name": "go_cpu",
      "display_name": "Go CPU",
      "schedulers": ["service_backed"],
      "display_order": 110,
      "auto_limit": true,
      "env_variable": "CARTULARY_SERVICE_BACKED_GO_CPU_LIMIT"
    },
    {
      "name": "go_io",
      "display_name": "Go IO",
      "schedulers": ["service_backed"],
      "display_order": 120,
      "auto_limit": true,
      "env_variable": "CARTULARY_SERVICE_BACKED_GO_IO_LIMIT"
    },
    {
      "name": "browser_stack",
      "display_name": "browser stack",
      "schedulers": ["service_backed"],
      "display_order": 130,
      "auto_limit": true,
      "env_variable": "CARTULARY_SERVICE_BACKED_BROWSER_STACK_LIMIT"
    },
    {
      "name": "process",
      "display_name": "process slots",
      "schedulers": ["service_backed"],
      "display_order": 160
    },
    {
      "name": "postgres",
      "display_name": "Postgres",
      "schedulers": ["service_backed"],
      "display_order": 150
    },
    {
      "name": "minio",
      "display_name": "MinIO",
      "schedulers": ["service_backed"],
      "display_order": 140
    },
    {
      "name": "postgres_reset",
      "display_name": "Postgres reset",
      "schedulers": ["service_backed"],
      "display_order": 170
    }
  ],
  "templates": [
    {
      "name": "browser_stage",
      "prefix": "browser_stage_",
      "display_name": "browser stage",
      "schedulers": ["service_backed"],
      "display_order": 135
    }
  ],
  "forwarding_profiles": [
    {
      "name": "check_host_to_service_backed_go",
      "mappings": [
        {
          "source_resource": "host_cpu",
          "target_resource": "go_cpu",
          "env_variable": "CARTULARY_SERVICE_BACKED_GO_CPU_LIMIT"
        },
        {
          "source_resource": "host_io",
          "target_resource": "go_io",
          "env_variable": "CARTULARY_SERVICE_BACKED_GO_IO_LIMIT"
        }
      ]
    }
  ],
  "retired_aliases": [
    {
      "name": "cpu",
      "replacement": "host_cpu",
      "reason": "top-level check scheduler CPU capacity is now explicit host_cpu"
    },
    {
      "name": "io",
      "replacement": "host_io",
      "reason": "top-level check scheduler IO capacity is now explicit host_io"
    },
    {
      "name": "backend",
      "replacement": null,
      "reason": "generic backend lanes were replaced by typed Go, process, and service resources"
    },
    {
      "name": "browser",
      "replacement": null,
      "reason": "generic browser lanes were replaced by browser_stack and browser_stage lanes"
    }
  ]
}
