{
  "schema_id": "cartulary.scheduler_resource_registry.v6",
  "capacity_override_schema": "cartulary.harness_capacity_override.v1",
  "capacity_policies": {
    "cpu_tokens": {
      "source": "host_parallelism",
      "minimum": 1
    },
    "io_tokens": {
      "source": "cpu_multiple",
      "cpu_multiplier": 2,
      "minimum": 1
    },
    "memory_bytes": {
      "source": "host_memory_cgroup_bounded",
      "minimum": 1
    },
    "object_store_lanes": {
      "source": "fixed_cpu_bounded",
      "default": 4,
      "minimum": 1,
      "maximum_cpu_multiplier": 1
    },
    "port_lanes": {
      "source": "fixed_cpu_bounded",
      "default": 4,
      "minimum": 1,
      "maximum_cpu_multiplier": 1
    },
    "postgres_lanes": {
      "source": "fixed_cpu_bounded",
      "default": 8,
      "minimum": 1,
      "maximum_cpu_multiplier": 1
    },
    "process_slots": {
      "source": "process_limit_bounded_cpu_multiple",
      "cpu_multiplier": 4,
      "minimum": 1
    },
    "writable_volume": {
      "source": "writable_root"
    }
  },
  "resources": [
    {
      "name": "browser_stack",
      "snapshot_field": "port_lanes",
      "unit": "lease"
    },
    {
      "name": "cpu",
      "snapshot_field": "cpu_tokens",
      "unit": "token"
    },
    {
      "name": "io",
      "snapshot_field": "io_tokens",
      "unit": "token"
    },
    {
      "name": "memory_mb",
      "snapshot_field": "memory_bytes",
      "unit": "mebibyte"
    },
    {
      "name": "object_store",
      "snapshot_field": "object_store_lanes",
      "unit": "capability"
    },
    {
      "name": "port_lane",
      "snapshot_field": "port_lanes",
      "unit": "lane"
    },
    {
      "name": "postgres",
      "snapshot_field": "postgres_lanes",
      "unit": "capability"
    },
    {
      "name": "process",
      "snapshot_field": "process_slots",
      "unit": "slot"
    },
    {
      "name": "service_stack",
      "snapshot_field": "services.service_stack",
      "unit": "capability"
    },
    {
      "name": "volume",
      "snapshot_field": "writable_volume",
      "unit": "capability"
    }
  ],
  "runner_worker_inputs": [
    "PLAYWRIGHT_WORKERS",
    "VITEST_MAX_WORKERS"
  ]
}
