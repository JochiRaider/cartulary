{
  "schema_id": "cartulary.scheduler_resource_registry.v3",
  "resources": [
    {
      "name": "host_cpu",
      "display_name": "host CPU",
      "schedulers": ["check"],
      "display_order": 10,
      "capacity": {
        "auto_policy": "check_host_cpu",
        "override_env": "CHECK_HOST_CPU_JOBS"
      }
    },
    {
      "name": "host_io",
      "display_name": "host IO",
      "schedulers": ["check"],
      "display_order": 20,
      "capacity": {
        "auto_policy": "check_host_io",
        "override_env": "CHECK_HOST_IO_JOBS"
      }
    },
    {
      "name": "suite_service_stack",
      "display_name": "suite service stack",
      "schedulers": ["check"],
      "display_order": 30,
      "capacity": {
        "default_limit": 1
      }
    },
    {
      "name": "migration_scratch_postgres",
      "display_name": "migration scratch Postgres",
      "schedulers": ["check"],
      "display_order": 40,
      "capacity": {
        "default_limit": 1
      }
    },
    {
      "name": "go_cpu",
      "display_name": "Go CPU",
      "schedulers": ["service_backed"],
      "display_order": 110,
      "capacity": {
        "auto_policy": "service_backed_go_cpu",
        "override_env": "CARTULARY_SERVICE_BACKED_GO_CPU_LIMIT"
      }
    },
    {
      "name": "go_io",
      "display_name": "Go IO",
      "schedulers": ["service_backed"],
      "display_order": 120,
      "capacity": {
        "auto_policy": "service_backed_go_io",
        "override_env": "CARTULARY_SERVICE_BACKED_GO_IO_LIMIT"
      }
    },
    {
      "name": "browser_stack",
      "display_name": "browser stack",
      "schedulers": ["check", "service_backed"],
      "display_order": 130,
      "capacity": {
        "auto_policy": "service_backed_browser_stack",
        "override_env": "CARTULARY_SERVICE_BACKED_BROWSER_STACK_LIMIT"
      }
    },
    {
      "name": "process",
      "display_name": "process slots",
      "schedulers": ["check", "service_backed"],
      "display_order": 160,
      "capacity": {
        "default_limit": 4
      }
    },
    {
      "name": "postgres",
      "display_name": "Postgres",
      "schedulers": ["check", "service_backed"],
      "display_order": 150,
      "capacity": {
        "default_limit": 32
      }
    },
    {
      "name": "minio",
      "display_name": "MinIO",
      "schedulers": ["check", "service_backed"],
      "display_order": 140,
      "capacity": {
        "default_limit": 32
      }
    },
    {
      "name": "postgres_reset",
      "display_name": "Postgres reset",
      "schedulers": ["check", "service_backed"],
      "display_order": 170,
      "capacity": {
        "default_limit": 1
      }
    }
  ],
  "templates": [
    {
      "name": "browser_stage",
      "prefix": "browser_stage_",
      "display_name": "browser stage",
      "schedulers": ["check", "service_backed"],
      "display_order": 135
    }
  ],
  "capacity_profiles": [
    {
      "name": "check_default",
      "scheduler": "check",
      "resources": [
        "host_cpu",
        "host_io",
        "suite_service_stack",
        "migration_scratch_postgres"
      ]
    },
    {
      "name": "service_backed_full",
      "scheduler": "service_backed",
      "resources": [
        "postgres",
        "minio",
        "go_cpu",
        "go_io",
        "postgres_reset",
        "process",
        "browser_stack"
      ]
    },
    {
      "name": "service_backed_backend",
      "scheduler": "service_backed",
      "resources": ["postgres", "minio", "go_cpu", "go_io", "postgres_reset", "process"]
    }
  ],
  "forwarding_profiles": []
}
