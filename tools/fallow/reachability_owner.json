{
  "schema_id": "cartulary.fallow_reachability_owner.v1",
  "base_config": {
    "path": ".fallowrc.json"
  },
  "task_surface": {
    "owner_path": "tools/task_surface_owner.json",
    "script_extensions": [".cjs", ".cts", ".js", ".jsx", ".mjs", ".mts", ".ts", ".tsx"],
    "required_node_tool_backing_scripts": true
  },
  "harness_entrypoints": {
    "files": [
      "tools/harness/backend/backend-duration-accounting.mjs",
      "tools/harness/backend/go-shard-plan-cli.mjs",
      "tools/harness/backend/go-target-plan-coverage-cli.mjs",
      "tools/harness/backend/postgres-fixture-budget-cli.mjs",
      "tools/harness/browser/browser-evidence-finalize-cli.mjs",
      "tools/harness/browser/browser-runtime-profile.mjs",
      "tools/harness/browser/browser-session-evidence.mjs",
      "tools/harness/browser/browser-target-finalizer-cli.mjs",
      "tools/harness/contract/harness-contract-cli.mjs",
      "tools/harness/diagnostics/vitest-failure-details.mjs",
      "tools/harness/duration-accounting/index.mjs",
      "tools/harness/generated-artifacts/database-contract-drift/migration-history-cli.mjs",
      "tools/harness/generated-artifacts/design-tokens/design-token-cli.mjs",
      "tools/harness/owner-slice/owner-slice-finalizer-cli.mjs",
      "tools/harness/owner-slice/owner-unit-runner-cli.mjs",
      "tools/harness/output/test-output.mjs",
      "tools/harness/readiness/diagnose-inotify.mjs",
      "tools/harness/static-analysis/font-bundle-check-cli.mjs",
      "tools/harness/static-analysis/govulncheck-findings.mjs",
      "tools/harness/test-support/harness-artifact-assert.mjs",
      "tools/harness/test-support/json-test-helper.mjs"
    ]
  },
  "harness_dynamic_exports": [
    {
      "file": "tools/harness/backend/backend-target-execution.mjs",
      "exports": [
        "acquireSharedReportLock",
        "assignExecutionFamily",
        "captureGoReport",
        "captureNamedSharedReportsParallel",
        "createAggregateReport",
        "prepareSharedArtifactDir",
        "releaseSharedReportLock"
      ],
      "owner": "Backend target execution smoke tests",
      "evidence": "Shell-embedded ESM imports in tools/harness/backend/tests/test-run-go-target.sh exercise shared report capture, locking, reuse, aggregate report accounting, and execution-family assignment.",
      "removal_trigger": "Remove when test-run-go-target.sh stops importing these helpers or the shell-embedded checks move to static JavaScript entry files modeled by Fallow."
    },
    {
      "file": "tools/harness/backend/target-execution/capture.mjs",
      "exports": [
        "acquireSharedReportLock",
        "captureGoReport",
        "releaseSharedReportLock"
      ],
      "owner": "Backend target execution smoke tests",
      "evidence": "The backend-target-execution facade re-exports these capture helpers for shell-embedded ESM smoke tests in tools/harness/backend/tests/test-run-go-target.sh.",
      "removal_trigger": "Remove when the facade no longer exposes these helpers to the shell smoke tests or the tests move to static JavaScript entry files modeled by Fallow."
    },
    {
      "file": "tools/harness/execution/service-backed/schedule-manifest.mjs",
      "exports": ["validateServiceBackedScheduleManifestShape"],
      "owner": "Generated execution-topology smoke tests",
      "evidence": "Shell-embedded ESM imports in tools/harness/generated-artifacts/tests/test-execution-topology.sh validate rendered and malformed service-backed schedule manifests.",
      "removal_trigger": "Remove when test-execution-topology.sh no longer imports this validator or the check moves to a static JavaScript entry file modeled by Fallow."
    },
    {
      "file": "tools/harness/execution/service-backed/schedule-planning.mjs",
      "exports": ["validateServiceBackedScheduleManifestShape"],
      "owner": "Generated execution-topology smoke tests",
      "evidence": "The schedule-planning facade re-exports the validator for shell-embedded ESM checks in tools/harness/generated-artifacts/tests/test-execution-topology.sh.",
      "removal_trigger": "Remove when the facade no longer exposes this validator to the generated-artifact smoke test or the check moves to a static JavaScript entry file modeled by Fallow."
    }
  ],
  "vitest": {
    "config_file": "apps/web/vite.config.ts",
    "setup_files": [
      "apps/web/src/testing/testSetup.ts",
      "apps/web/src/testing/testSetup.dom.ts"
    ],
    "test_entry_globs": [
      "apps/web/src/**/*.test.ts",
      "apps/web/src/**/*.test.tsx",
      "apps/web/src/**/*.spec.ts",
      "apps/web/src/**/*.spec.tsx",
      "packages/*/src/**/*.test.ts",
      "packages/*/src/**/*.test.tsx"
    ]
  },
  "vite_public_assets": {
    "public_root": "apps/web/public",
    "html_entry_files": ["apps/web/index.html"],
    "url_prefixes": ["/assets/"],
    "always_used_files": ["apps/web/public/assets/fonts/fonts.css"]
  },
  "executable_tooling_dependencies": [
    {
      "package_name": "@cyclonedx/cdxgen",
      "owner_script": "tools/release-evidence/generate-sbom-license-evidence.mjs",
      "command": ["pnpm", "exec", "cdxgen"]
    }
  ],
  "static_policy": {
    "runtime_enabled": false,
    "per_file_suppression_growth": false
  },
  "extensions": {}
}
