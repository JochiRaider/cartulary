{
  "schema_id": "cartulary.generated_artifact_policy.v1",
  "ignored_sentinel_filenames": [".gitkeep"],
  "generated_roots": [
    {
      "path": "internal/gen",
      "allowed_extensions": [".go"],
      "required_marker": "^// Code generated .* DO NOT EDIT\\.$"
    },
    {
      "path": "packages/protocol-ts/src/generated",
      "allowed_extensions": [".ts"],
      "required_marker": "^// Code generated .* DO NOT EDIT\\.$"
    },
    {
      "path": "packages/ui-contracts/src/generated",
      "allowed_extensions": [".ts"],
      "required_marker": "^// Code generated .* DO NOT EDIT\\.$"
    }
  ],
  "generated_files": [
    {
      "path": "tools/task_surface.generated.mk",
      "allowed_extensions": [".mk"],
      "required_marker": "^# Code generated .* DO NOT EDIT\\.$"
    }
  ],
  "lint_scope_checks": {
    "shell_sources": [
      {
        "path": "scripts/run-go-format.sh",
        "must_contain": [
          "scripts/lib/generated-artifacts.sh",
          "cartulary_is_authored_go_file"
        ]
      },
      {
        "path": "scripts/run-go-vet.sh",
        "must_contain": [
          "scripts/lib/generated-artifacts.sh",
          "cartulary_filter_authored_go_packages"
        ]
      },
      {
        "path": "scripts/run-go-staticcheck.sh",
        "must_contain": [
          "scripts/lib/generated-artifacts.sh",
          "cartulary_filter_authored_go_packages"
        ]
      },
      {
        "path": "scripts/run-go-govulncheck.sh",
        "must_contain": [
          "scripts/lib/generated-artifacts.sh",
          "cartulary_filter_authored_go_packages"
        ]
      },
      {
        "path": "scripts/run-shellcheck.sh",
        "must_contain": [
          "scripts/lib/generated-artifacts.sh",
          "cartulary_is_generated_artifact_path"
        ],
        "must_not_contain": [
          "*/generated/*",
          "generated/*"
        ]
      }
    ],
    "biome": {
      "path": "biome.json",
      "required_files_includes": [
        "!packages/protocol-ts/src/generated/**",
        "!packages/ui-contracts/src/generated/**"
      ],
      "forbidden_files_includes": [
        "!packages/protocol-ts/src/generated",
        "!packages/ui-contracts/src/generated"
      ],
      "required_override_includes": [
        "!packages/protocol-ts/src/generated/**",
        "!packages/ui-contracts/src/generated/**"
      ]
    },
    "frontend_import_boundaries": {
      "path": "tools/frontend_import_boundaries.json",
      "required_scan_excludes": [
        "packages/protocol-ts/src/generated/**",
        "packages/ui-contracts/src/generated/**"
      ],
      "required_restricted_paths": [
        "packages/protocol-ts/src/generated",
        "packages/ui-contracts/src/generated"
      ]
    },
    "markdownlint": {
      "path": ".markdownlint-cli2.jsonc",
      "required_globs": [
        "*.md",
        "docs/*.md",
        "docs/spec/**/*.md",
        "docs/guides/**/*.md",
        "docs/research/**/*.md",
        "docs/user_guides/**/*.md",
        "apps/web/public/assets/fonts/*.md"
      ],
      "required_ignores": [
        "docs/testing/phase*_coverage_ledger.md",
        "docs/testing/frontend_phase_coverage_ledgers/*_coverage_ledger.md",
        "docs/archive/**",
        "docs/testing-harness-spec-recovery-docs/**",
        "internal/gen/**",
        "packages/protocol-ts/src/generated/**",
        "packages/ui-contracts/src/generated/**"
      ],
      "forbidden_globs": [
        "docs/testing/**/*.md",
        "docs/archive/**/*.md",
        "docs/testing-harness-spec-recovery-docs/**/*.md",
        "internal/gen/**/*.md",
        "packages/protocol-ts/src/generated/**/*.md",
        "packages/ui-contracts/src/generated/**/*.md"
      ],
      "required_rules": [
        "MD001",
        "MD009",
        "MD010",
        "MD011",
        "MD018",
        "MD019",
        "MD020",
        "MD021",
        "MD023",
        "MD024",
        "MD040",
        "MD042",
        "MD047",
        "MD051",
        "MD052",
        "MD053",
        "MD056"
      ],
      "disabled_rules": [
        "MD013"
      ]
    }
  }
}
