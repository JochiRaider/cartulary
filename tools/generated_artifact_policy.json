{
  "schema_id": "cartulary.generated_artifact_policy.v1",
  "ignored_sentinel_filenames": [
    ".gitkeep"
  ],
  "generated_roots": [
    {
      "path": "internal/gen",
      "allowed_extensions": [
        ".go"
      ],
      "required_marker": "^// Code generated .* DO NOT EDIT\\.$"
    },
    {
      "path": "packages/protocol-ts/src/generated",
      "allowed_extensions": [
        ".ts"
      ],
      "required_marker": "^// Code generated .* DO NOT EDIT\\.$"
    },
    {
      "path": "packages/view-contracts/src/generated",
      "allowed_extensions": [
        ".ts"
      ],
      "required_marker": "^// Code generated .* DO NOT EDIT\\.$"
    },
    {
      "path": "packages/ui-contracts/src/generated",
      "allowed_extensions": [
        ".ts"
      ],
      "required_marker": "^// Code generated .* DO NOT EDIT\\.$"
    }
  ],
  "generated_files": [
    {
      "path": "contracts/openapi/cartulary.openapi.yaml",
      "allowed_extensions": [
        ".yaml"
      ],
      "required_marker": "^\\{\\n  \"openapi\": \"3\\.1\\.0\""
    },
    {
      "path": "tools/task_surface.generated.mk",
      "allowed_extensions": [
        ".mk"
      ],
      "required_marker": "^# Code generated .* DO NOT EDIT\\.$"
    },
    {
      "path": "tools/task_surface.runtime.generated.mk",
      "allowed_extensions": [
        ".mk"
      ],
      "required_marker": "^# Code generated .* DO NOT EDIT\\.$"
    }
  ],
  "lint_scope_checks": {
    "shell_sources": [
      {
        "path": "tools/harness/static-analysis/go-format.sh",
        "must_contain": [
          "tools/harness/generated-artifacts/generated-artifacts.sh",
          "cartulary_is_authored_go_file"
        ]
      },
      {
        "path": "tools/harness/static-analysis/go-vet.sh",
        "must_contain": [
          "tools/harness/generated-artifacts/generated-artifacts.sh",
          "cartulary_filter_authored_go_packages"
        ]
      },
      {
        "path": "tools/harness/static-analysis/go-staticcheck.sh",
        "must_contain": [
          "tools/harness/generated-artifacts/generated-artifacts.sh",
          "cartulary_filter_authored_go_packages"
        ]
      },
      {
        "path": "tools/harness/static-analysis/go-govulncheck.sh",
        "must_contain": [
          "tools/harness/generated-artifacts/generated-artifacts.sh",
          "cartulary_filter_authored_go_packages"
        ]
      },
      {
        "path": "tools/harness/static-analysis/shellcheck.sh",
        "must_contain": [
          "tools/harness/generated-artifacts/generated-artifacts.sh",
          "cartulary_is_generated_artifact_path"
        ],
        "must_not_contain": [
          "*/generated/*",
          "generated/*"
        ]
      }
    ],
    "biome": {
      "path": "biome.json",
      "required_files_includes": [
        "!packages/protocol-ts/src/generated/**",
        "!packages/view-contracts/src/generated/**",
        "!packages/ui-contracts/src/generated/**"
      ],
      "forbidden_files_includes": [
        "!packages/protocol-ts/src/generated",
        "!packages/ui-contracts/src/generated"
      ],
      "required_override_includes": [
        "!packages/protocol-ts/src/generated/**",
        "!packages/view-contracts/src/generated/**",
        "!packages/ui-contracts/src/generated/**"
      ]
    },
    "frontend_import_boundaries": {
      "path": "tools/frontend_import_boundaries.json",
      "required_scan_excludes": [
        "packages/protocol-ts/src/generated/**",
        "packages/view-contracts/src/generated/**",
        "packages/ui-contracts/src/generated/**"
      ],
      "required_restricted_paths": [
        "packages/protocol-ts/src/generated",
        "packages/view-contracts/src/generated",
        "packages/ui-contracts/src/generated"
      ]
    }
  }
}
