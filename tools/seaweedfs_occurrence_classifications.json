{
  "schema_id": "cartulary.seaweedfs_occurrence_classifications.v1",
  "rules": [
    {
      "id": "frontend-raw-storage-leakage-guards",
      "path_globs": [
        "apps/web/e2e/evidence-integration.spec.ts",
        "apps/web/src/services/workbookEvidence.test.ts",
        "apps/web/src/services/workbookEvidence.ts",
        "apps/web/src/workbook/WorkbookShell.surfaces.test.tsx",
        "apps/web/src/workbook/WorkbookShell.tsx"
      ],
      "line_regex": "m[i]nio",
      "classification": "legacy_external_endpoint",
      "owner": "Frontend raw-storage leakage guards",
      "rationale": "Legacy endpoint literals are retained only as negative redaction and raw-storage leakage sentinels, not as default runtime service references."
    },
    {
      "id": "go-sdk-module-files",
      "path_globs": [
        "go.mod",
        "go.sum"
      ],
      "classification": "sdk_only",
      "owner": "Release dependency-boundary evidence",
      "rationale": "Retained Go module and checksum rows for the generic S3-compatible client SDK and its transitive implementation dependencies."
    },
    {
      "id": "historical-release-testdata",
      "path_globs": [
        "testdata/history/**"
      ],
      "classification": "historical_changelog",
      "owner": "Release evidence synthetic history fixture",
      "rationale": "Neutral synthetic history paths exercise historical classification without consuming repository documentation."
    },
    {
      "id": "legacy-config-test-values",
      "path_globs": [
        "internal/platform/config/**"
      ],
      "classification": "legacy_external_endpoint",
      "owner": "Configuration fixture tests",
      "rationale": "Legacy service-ref spellings remain only as opaque fixture strings in configuration tests."
    },
    {
      "id": "legacy-negative-guards",
      "path_globs": [
        "tools/release-evidence/generate-sbom-license-evidence.mjs"
      ],
      "classification": "legacy_external_endpoint",
      "owner": "Release and task-surface guard tooling",
      "rationale": "Legacy server-image or target spellings are retained only as negative guards in scanner and task-surface tooling."
    },
    {
      "id": "legacy-redaction-fixtures",
      "path_globs": [
        "internal/platform/harnessredact/**",
        "tools/harness/tests/test-harness-contracts.mjs",
        "tools/harness_redaction_manifest.json"
      ],
      "classification": "legacy_external_endpoint",
      "owner": "Harness redaction compatibility tests",
      "rationale": "Legacy credential-key spellings are retained only as redaction fixtures and policy patterns."
    },
    {
      "id": "object-store-adapter-sdk-imports",
      "path_globs": [
        "internal/platform/objectstore/**"
      ],
      "classification": "sdk_only",
      "owner": "internal/platform/objectstore adapter boundary",
      "rationale": "Generic S3-compatible client SDK usage is confined to the internal object-store adapter boundary."
    },
    {
      "id": "object-store-probe-sdk-imports",
      "path_globs": [
        "tools/objectstoreprobe/**"
      ],
      "classification": "sdk_only",
      "owner": "tools/objectstoreprobe compatibility probe boundary",
      "rationale": "Generic S3-compatible client SDK usage is confined to the deployment-local object-store probe."
    },
    {
      "id": "s3-test-fixture-sdk-imports",
      "path_globs": [
        "internal/testutil/s3test/**"
      ],
      "classification": "sdk_only",
      "owner": "internal/testutil/s3test fixture boundary",
      "rationale": "Generic S3-compatible client SDK usage is confined to the repository test fixture client."
    }
  ]
}
