{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.browser_owner_index.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "target_id", "run_id", "source_snapshot_digest",
    "catalog_semantic_digest", "verification_semantic_digest", "status",
    "selected_rows", "owner_shards"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.browser_owner_index.v1" },
    "target_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "run_id": { "$ref": "cartulary.test_slice_plan.v1#/$defs/nonempty" },
    "source_snapshot_digest": { "$ref": "cartulary.test_slice_plan.v1#/$defs/digest" },
    "catalog_semantic_digest": { "$ref": "cartulary.test_slice_plan.v1#/$defs/digest" },
    "verification_semantic_digest": { "$ref": "cartulary.test_slice_plan.v1#/$defs/digest" },
    "status": { "enum": ["pass", "fail"] },
    "selected_rows": { "$ref": "cartulary.test_slice_plan.v1#/$defs/row_ids" },
    "owner_shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner_id", "status", "selected_rows", "evidence_accounting", "owner_summary"],
        "properties": {
          "owner_id": { "$ref": "cartulary.test_family_manifest.v1#/$defs/owner_id" },
          "status": { "enum": ["pass", "fail"] },
          "selected_rows": { "$ref": "cartulary.test_slice_plan.v1#/$defs/row_ids" },
          "evidence_accounting": { "type": "string", "minLength": 1 },
          "owner_summary": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
