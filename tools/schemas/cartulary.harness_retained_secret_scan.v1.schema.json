{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_retained_secret_scan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "status", "scanned_files", "policy_digest"],
  "properties": {
    "schema_id": { "const": "cartulary.harness_retained_secret_scan.v1" },
    "status": { "const": "pass" },
    "scanned_files": { "type": "integer", "minimum": 0 },
    "policy_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
