{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.test_evidence_root_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "owner_id", "entries"],
  "properties": {
    "schema_id": { "const": "cartulary.test_evidence_root_manifest.v1" },
    "owner_id": { "$ref": "cartulary.test_family_manifest.v2#/$defs/owner_id" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "run_root"],
        "properties": {
          "target_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "run_root": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    }
  }
}
