{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.browser_group_result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "target_id", "stage_id", "group_id", "runtime_profile_id",
    "fixture_profile_ids", "resource_profile_ids", "selected_rows", "started_at",
    "finished_at", "duration_ms", "status", "exit_code", "row_results", "artifacts"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.browser_group_result.v1" },
    "target_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "stage_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "group_id": { "type": "string", "minLength": 1 },
    "runtime_profile_id": { "$ref": "cartulary.test_slice_plan.v3#/$defs/nonempty" },
    "fixture_profile_ids": { "$ref": "cartulary.test_slice_plan.v3#/$defs/unique_strings" },
    "resource_profile_ids": { "$ref": "cartulary.test_slice_plan.v3#/$defs/unique_strings" },
    "selected_rows": { "$ref": "cartulary.test_slice_plan.v3#/$defs/row_ids" },
    "started_at": { "$ref": "cartulary.test_slice_plan.v3#/$defs/timestamp" },
    "finished_at": { "$ref": "cartulary.test_slice_plan.v3#/$defs/timestamp" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["pass", "fail"] },
    "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
    "row_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["row_id", "terminal_state", "duration_ms", "exit_code", "failure_reason"],
        "properties": {
          "row_id": { "$ref": "cartulary.test_family_manifest.v2#/$defs/row_id" },
          "terminal_state": { "$ref": "cartulary.test_evidence_accounting.v2#/$defs/terminal_state" },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
          "failure_reason": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playwright_report", "stdout", "stderr"],
      "properties": {
        "playwright_report": { "type": "string", "minLength": 1 },
        "stdout": { "type": "string", "minLength": 1 },
        "stderr": { "type": "string", "minLength": 1 }
      }
    }
  }
}
