{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.test_owner_explanation.v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "evidence_epoch", "owner_id", "manifest_path",
    "test_catalog_digest", "verification_routing_digest", "row_count",
    "service_backed_row_count", "families", "runner_counts", "evidence_counts",
    "runtime_profile_counts", "resource_profile_counts", "fixture_capability_counts",
    "target_counts", "minimum_tier_counts", "commands"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.test_owner_explanation.v3" },
    "evidence_epoch": { "type": "string", "minLength": 1 },
    "owner_id": { "$ref": "cartulary.test_family_manifest.v3#/$defs/owner_id" },
    "manifest_path": { "$ref": "cartulary.test_family_manifest.v3#/$defs/repo_path" },
    "test_catalog_digest": { "$ref": "#/$defs/digest" },
    "verification_routing_digest": { "$ref": "#/$defs/digest" },
    "row_count": { "type": "integer", "minimum": 1 },
    "service_backed_row_count": { "type": "integer", "minimum": 0 },
    "families": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["family_id", "row_count"],
        "properties": {
          "family_id": { "$ref": "cartulary.test_family_manifest.v3#/$defs/family_id" },
          "row_count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "runner_counts": { "$ref": "#/$defs/counts" },
    "evidence_counts": { "$ref": "#/$defs/counts" },
    "runtime_profile_counts": { "$ref": "#/$defs/counts" },
    "resource_profile_counts": { "$ref": "#/$defs/counts" },
    "fixture_capability_counts": { "$ref": "#/$defs/counts" },
    "target_counts": { "$ref": "#/$defs/target_counts" },
    "minimum_tier_counts": { "$ref": "#/$defs/counts" },
    "commands": {
      "type": "object", "additionalProperties": false,
      "required": ["full_owner", "service_backed", "exact_row_template"],
      "properties": {
        "full_owner": { "type": "string", "pattern": "^make test-slice OWNER=" },
        "service_backed": { "type": ["string", "null"], "pattern": "^make service-backed-test-slice OWNER=" },
        "exact_row_template": { "type": "string", "pattern": "^make test-slice OWNER=.* ROWS=<row-id,\\.\\.\\.>$" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "count": { "type": "integer", "minimum": 0 },
    "counts": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/count" }
    },
    "target_counts": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/count" }
    }
  }
}
