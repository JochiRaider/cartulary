{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.performance_fixture_build_diagnostics.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "fixture_profile_id",
    "snapshot_key",
    "builder_unit_id",
    "state",
    "failure_stage",
    "construction_count",
    "duration_ms",
    "semantic_validation_duration_ms",
    "contributions",
    "redaction_policy_id",
    "created_at"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.performance_fixture_build_diagnostics.v2" },
    "fixture_profile_id": {
      "$ref": "cartulary.performance_fixture_snapshot_key.v2#/properties/fixture_profile_id"
    },
    "snapshot_key": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "builder_unit_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "state": { "enum": ["sealed", "failed"] },
    "failure_stage": {
      "enum": ["none", "setup", "assembly", "contribution", "semantic_validation", "finalization"]
    },
    "construction_count": { "const": 1 },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "semantic_validation_duration_ms": { "type": "integer", "minimum": 0 },
    "contributions": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/contribution" }
    },
    "redaction_policy_id": {
      "type": "string",
      "pattern": "^cartulary\\.[a-z0-9_.]+\\.v[1-9][0-9]*$"
    },
    "created_at": { "$ref": "cartulary.harness.defs.v1#/$defs/timestamp" }
  },
  "$defs": {
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "contribution_id", "owner_id", "state", "duration_ms"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 64 },
        "contribution_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.v[1-9][0-9]*$"
        },
        "owner_id": { "$ref": "cartulary.test_catalog_defs.v1#/$defs/owner_id" },
        "state": { "enum": ["completed", "failed"] },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "batch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "batch_count", "configured_batch_size", "item_count"],
          "properties": {
            "strategy": { "enum": ["owner_application_batch", "owner_set_oriented"] },
            "batch_count": { "type": "integer", "minimum": 1 },
            "configured_batch_size": { "type": "integer", "minimum": 1 },
            "item_count": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "sealed" } }, "required": ["state"] },
      "then": {
        "properties": {
          "failure_stage": { "const": "none" },
          "contributions": {
            "minItems": 1,
            "items": {
              "allOf": [
                { "$ref": "#/$defs/contribution" },
                { "properties": { "state": { "const": "completed" } } }
              ]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "failed" } }, "required": ["state"] },
      "then": { "not": { "properties": { "failure_stage": { "const": "none" } } } }
    }
  ]
}
