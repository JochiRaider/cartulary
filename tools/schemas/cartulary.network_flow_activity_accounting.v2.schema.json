{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.network_flow_activity_accounting.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_id",
    "profile_id",
    "source_spec",
    "contract_registry",
    "dependency_locator_accounting",
    "fixture_accounting",
    "acceptance_accounting",
    "drift_accounting"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "schema_id": {
      "const": "cartulary.network_flow_activity_accounting.v2"
    },
    "profile_id": {
      "const": "network_flow_activity"
    },
    "source_spec": {
      "$ref": "#/$defs/markdown_path"
    },
    "contract_registry": {
      "$ref": "#/$defs/contract_registry"
    },
    "dependency_locator_accounting": {
      "$ref": "#/$defs/dependency_locator_accounting"
    },
    "fixture_accounting": {
      "$ref": "#/$defs/fixture_accounting"
    },
    "acceptance_accounting": {
      "$ref": "#/$defs/acceptance_accounting"
    },
    "drift_accounting": {
      "$ref": "#/$defs/drift_accounting"
    }
  },
  "$defs": {
    "repo_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9._@+-]+(?:/[A-Za-z0-9._@+-]+)*$"
    },
    "markdown_path": {
      "allOf": [
        {
          "$ref": "#/$defs/repo_path"
        },
        {
          "pattern": "\\.md$"
        }
      ]
    },
    "work_item_id": {
      "type": "string",
      "pattern": "^NFA-[A-Z0-9]+-[0-9]{3}$"
    },
    "fixture_id_base": {
      "type": "string",
      "pattern": "^NF-FIX-[0-9]{3}$"
    },
    "acceptance_id": {
      "type": "string",
      "pattern": "^NF-AC-[0-9]{3}$"
    },
    "contract_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "family_id",
        "contract_root",
        "planned_activation_dependency_ids",
        "generated_symbol_markers"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repo_path"
        },
        "family_id": {
          "const": "network-flow"
        },
        "contract_root": {
          "const": "contracts/network-flow"
        },
        "planned_activation_dependency_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/work_item_id"
          }
        },
        "generated_symbol_markers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z][A-Za-z0-9]*$"
          }
        }
      }
    },
    "dependency_locator_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_caption",
        "expected_count",
        "blocked_tokens",
        "required_dependencies",
        "required_locator_fragments"
      ],
      "properties": {
        "table_caption": {
          "const": "Table 1-B. Normative dependency registry"
        },
        "expected_count": {
          "const": 7
        },
        "blocked_tokens": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "required_dependencies": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Core 00",
              "Core 01",
              "Core 02",
              "Core 03",
              "Core 04",
              "Graph Projection NLSpec",
              "Testing Harness NLSpec"
            ]
          }
        },
        "required_locator_fragments": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/dependency_locator_fragment_rule"
          }
        }
      }
    },
    "dependency_locator_fragment_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency",
        "fragments"
      ],
      "properties": {
        "dependency": {
          "enum": [
            "Core 00",
            "Core 01",
            "Core 02",
            "Core 03",
            "Core 04",
            "Graph Projection NLSpec",
            "Testing Harness NLSpec"
          ]
        },
        "fragments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          }
        }
      }
    },
    "fixture_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_count",
        "first_id",
        "last_id",
        "manifest_root"
      ],
      "properties": {
        "expected_count": {
          "const": 28
        },
        "first_id": {
          "const": "NF-FIX-001"
        },
        "last_id": {
          "const": "NF-FIX-028"
        },
        "manifest_root": {
          "const": "fixtures/network-flow"
        }
      }
    },
    "acceptance_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_count",
        "first_id",
        "last_id",
        "selector_prefix",
        "tracker_row_prefix",
        "matrix_source",
        "rows"
      ],
      "properties": {
        "expected_count": {
          "const": 107
        },
        "first_id": {
          "const": "NF-AC-001"
        },
        "last_id": {
          "const": "NF-AC-107"
        },
        "selector_prefix": {
          "const": "phase12/network-flow/"
        },
        "tracker_row_prefix": {
          "const": "NF-AC-"
        },
        "matrix_source": {
          "const": "tools/phase12_test_map.json"
        },
        "rows": {
          "type": "array",
          "minItems": 107,
          "maxItems": 107,
          "items": {
            "$ref": "#/$defs/acceptance_evidence_row"
          }
        }
      }
    },
    "drift_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scratch_manifest",
        "required_copy_paths",
        "required_public_targets"
      ],
      "properties": {
        "scratch_manifest": {
          "$ref": "#/$defs/repo_path"
        },
        "required_copy_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repo_path"
          }
        },
        "required_public_targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          }
        }
      }
    },
    "full_fixture_id": {
      "type": "string",
      "pattern": "^NF-FIX-[0-9]{3}-[a-z0-9][a-z0-9-]*$"
    },
    "evidence_selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "file"
      ],
      "properties": {
        "kind": {
          "enum": [
            "unit",
            "store",
            "process",
            "browser"
          ]
        },
        "file": {
          "$ref": "#/$defs/repo_path"
        },
        "package": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "symbol": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "anyOf": [
        {
          "required": [
            "symbol"
          ]
        },
        {
          "required": [
            "title"
          ]
        }
      ]
    },
    "acceptance_evidence_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptance_id",
        "owner_requirements",
        "behavior_class",
        "required_evidence_kinds",
        "exact_selectors",
        "supplemental_fixture_ids"
      ],
      "properties": {
        "acceptance_id": {
          "$ref": "#/$defs/acceptance_id"
        },
        "owner_requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "behavior_class": {
          "enum": [
            "product_runtime",
            "normative_structure",
            "fixture_integrity",
            "evidence_policy"
          ]
        },
        "required_evidence_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "unit",
              "store",
              "process",
              "browser"
            ]
          }
        },
        "exact_selectors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_selector"
          }
        },
        "supplemental_fixture_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/full_fixture_id"
          }
        }
      }
    }
  }
}
