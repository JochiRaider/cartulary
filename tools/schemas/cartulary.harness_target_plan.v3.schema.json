{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_target_plan.v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "target", "graph_digest", "projections", "units"],
  "properties": {
    "schema_id": { "const": "cartulary.harness_target_plan.v3" },
    "target": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "graph_digest": { "$ref": "cartulary.harness_execution_defs.v1#/$defs/digest" },
    "projections": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "units": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["unit_id", "owner_id", "kind", "needs", "resource_claims", "fixture_capability", "service_dependencies", "cache_policy", "estimated_work_ms", "semantic_digest", "evidence_outputs"],
        "properties": {
          "unit_id": { "type": "string", "minLength": 1 },
          "owner_id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "needs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "resource_claims": { "$ref": "cartulary.harness_execution_defs.v1#/$defs/resource_claims" },
          "fixture_capability": { "enum": ["none", "postgres_transaction", "postgres_group", "postgres_dedicated", "postgres_migration", "object_store_namespace", "managed_process", "browser_stack"] },
          "fixture_profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*_v[1-9][0-9]*$" },
          "snapshot_key": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "service_dependencies": { "$ref": "cartulary.test_catalog_defs.v1#/$defs/service_dependencies" },
          "cache_policy": { "enum": ["none", "same_run", "content_addressed"] },
          "estimated_work_ms": { "type": "integer", "minimum": 1 },
          "semantic_digest": { "$ref": "cartulary.harness_execution_defs.v1#/$defs/digest" },
          "evidence_outputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
