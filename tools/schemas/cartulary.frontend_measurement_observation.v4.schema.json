{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.frontend_measurement_observation.v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "fixture_profile_id",
    "criterion_id",
    "predicate_id",
    "fixture_id",
    "fixture_digest",
    "measurement_policy_id",
    "threshold_ms",
    "warmup_samples",
    "measured_samples",
    "outcome",
    "traffic",
    "samples",
    "statistics",
    "predicate_evidence"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.frontend_measurement_observation.v4"
    },
    "fixture_profile_id": {
      "$ref": "cartulary.performance_fixture_snapshot_key.v2#/properties/fixture_profile_id"
    },
    "criterion_id": {
      "type": "string",
      "pattern": "^AC-[0-9]{3}$"
    },
    "predicate_id": {
      "type": "string",
      "pattern": "^perf\\.[a-z0-9_.]+\\.v[1-9][0-9]*$"
    },
    "fixture_id": {
      "type": "string",
      "pattern": "^cartulary\\.[a-z0-9_.]+\\.v[1-9][0-9]*$"
    },
    "fixture_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "measurement_policy_id": {
      "type": "string",
      "pattern": "^cartulary\\.[a-z0-9_.]+\\.v[1-9][0-9]*$"
    },
    "threshold_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "warmup_samples": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "measured_samples": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "outcome": {
      "enum": [
        "passed",
        "threshold_failed",
        "incomplete",
        "environment_not_qualified",
        "predicate_failed"
      ]
    },
    "traffic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counts",
        "rates",
        "conditions"
      ],
      "properties": {
        "counts": {
          "$ref": "#/$defs/numeric_facts"
        },
        "rates": {
          "$ref": "#/$defs/numeric_facts"
        },
        "conditions": {
          "$ref": "#/$defs/boolean_facts"
        }
      }
    },
    "samples": {
      "type": "array",
      "maxItems": 100001,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_index",
          "warmup",
          "total_ms",
          "stages_ms"
        ],
        "properties": {
          "sample_index": {
            "type": "integer",
            "minimum": 0
          },
          "warmup": {
            "type": "boolean"
          },
          "total_ms": {
            "type": "number",
            "minimum": 0
          },
          "stages_ms": {
            "$ref": "#/$defs/numeric_facts"
          }
        }
      }
    },
    "failure_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "statistics": {
      "$ref": "#/$defs/statistics"
    },
    "predicate_evidence": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "clipboard_format",
            "clipboard_mime",
            "clipboard_delivery",
            "viewport_width",
            "viewport_height",
            "device_scale_factor",
            "row_count",
            "cell_count",
            "consecutive_frames",
            "all_new_ids",
            "geometry_unchanged",
            "target_bindings_stable",
            "created_records"
          ],
          "properties": {
            "kind": {
              "const": "timeline_paste_20x5"
            },
            "clipboard_format": {
              "const": "tsv"
            },
            "clipboard_mime": {
              "const": "text/plain"
            },
            "clipboard_delivery": {
              "enum": [
                "synthesized_event",
                "platform_clipboard"
              ]
            },
            "viewport_width": {
              "const": 1920
            },
            "viewport_height": {
              "const": 1080
            },
            "device_scale_factor": {
              "const": 1
            },
            "row_count": {
              "const": 20
            },
            "cell_count": {
              "const": 100
            },
            "consecutive_frames": {
              "const": 2
            },
            "all_new_ids": {
              "const": true
            },
            "geometry_unchanged": {
              "const": true
            },
            "target_bindings_stable": {
              "const": true
            },
            "created_records": {
              "type": "array",
              "minItems": 20,
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "record_id",
                  "row_version"
                ],
                "properties": {
                  "record_id": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
                  },
                  "row_version": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                }
              }
            }
          }
        },
        {
          "$ref": "cartulary.presence_measurement_proof.v1"
        },
        {
          "$ref": "cartulary.history_measurement_proof.v2"
        },
        {
          "$ref": "cartulary.anchor_trace_proof.v1"
        },
        {
          "$ref": "cartulary.evidence_inspector_measurement_proof.v1"
        },
        {
          "$ref": "cartulary.import_discovery_measurement_proof.v1"
        },
        {
          "$ref": "cartulary.import_apply_measurement_proof.v1"
        },
        {
          "$ref": "cartulary.reporting_progress_measurement_proof.v1"
        },
        {
          "$ref": "cartulary.evidence_verification_measurement_proof.v1"
        },
        {
          "$ref": "cartulary.reference_pack_progress_measurement_proof.v1"
        }
      ]
    }
  },
  "$defs": {
    "numeric_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_id",
          "value"
        ],
        "properties": {
          "fact_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]*$"
          },
          "value": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "boolean_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_id",
          "value"
        ],
        "properties": {
          "fact_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]*$"
          },
          "value": {
            "type": "boolean"
          }
        }
      }
    },
    "statistics": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "percentile",
            "p50_ms",
            "p95_ms"
          ],
          "properties": {
            "kind": {
              "const": "percentile"
            },
            "percentile": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "p50_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "p95_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "elapsed_ms"
          ],
          "properties": {
            "kind": {
              "const": "single"
            },
            "elapsed_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "completed_steps",
            "expected_steps"
          ],
          "properties": {
            "kind": {
              "const": "seeded_trace"
            },
            "completed_steps": {
              "type": "integer",
              "minimum": 0
            },
            "expected_steps": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "statistics": {
            "properties": {
              "kind": {
                "const": "seeded_trace"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "threshold_ms": {
            "type": "null"
          },
          "samples": {
            "maxItems": 0
          },
          "warmup_samples": {
            "const": 0
          },
          "measured_samples": {
            "const": 0
          },
          "outcome": {
            "not": {
              "const": "threshold_failed"
            }
          }
        }
      },
      "else": {
        "properties": {
          "threshold_ms": {
            "type": "number"
          },
          "outcome": {
            "not": {
              "const": "predicate_failed"
            }
          }
        }
      }
    }
  ]
}
