{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.scheduler_resource_registry.v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "capacity_override_schema",
    "resources",
    "runner_worker_inputs"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.scheduler_resource_registry.v5"
    },
    "capacity_override_schema": {
      "const": "cartulary.harness_capacity_override.v1"
    },
    "resources": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "snapshot_field", "unit"],
        "properties": {
          "name": {
            "enum": [
              "browser_stack",
              "cpu",
              "io",
              "memory_mb",
              "object_store",
              "port_lane",
              "postgres",
              "process",
              "service_stack",
              "volume"
            ]
          },
          "snapshot_field": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "runner_worker_inputs": {
      "const": ["PLAYWRIGHT_WORKERS", "VITEST_MAX_WORKERS"]
    }
  }
}
