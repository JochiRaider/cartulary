{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.fallow_reachability_owner.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "base_config",
    "task_surface",
    "vitest",
    "vite_public_assets",
    "executable_tooling_dependencies",
    "static_policy",
    "extensions"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.fallow_reachability_owner.v1" },
    "base_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/repo_path" }
      }
    },
    "task_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_path",
        "script_extensions",
        "required_node_tool_backing_scripts"
      ],
      "properties": {
        "owner_path": { "$ref": "#/$defs/repo_path" },
        "script_extensions": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": [".cjs", ".cts", ".js", ".jsx", ".mjs", ".mts", ".ts", ".tsx"] },
          "uniqueItems": true
        },
        "required_node_tool_backing_scripts": { "const": true }
      }
    },
    "vitest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_file", "setup_files", "test_entry_globs"],
      "properties": {
        "config_file": { "$ref": "#/$defs/repo_path" },
        "setup_files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_path" },
          "uniqueItems": true
        },
        "test_entry_globs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_glob" },
          "uniqueItems": true
        }
      }
    },
    "vite_public_assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_root", "html_entry_files", "url_prefixes", "always_used_files"],
      "properties": {
        "public_root": { "$ref": "#/$defs/repo_path" },
        "html_entry_files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_path" },
          "uniqueItems": true
        },
        "url_prefixes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]+/$" },
          "uniqueItems": true
        },
        "always_used_files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_path" },
          "uniqueItems": true
        }
      }
    },
    "executable_tooling_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package_name", "owner_script", "command"],
        "properties": {
          "package_name": { "type": "string", "minLength": 1 },
          "owner_script": { "$ref": "#/$defs/repo_path" },
          "command": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "static_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_enabled", "per_file_suppression_growth"],
      "properties": {
        "runtime_enabled": { "const": false },
        "per_file_suppression_growth": { "const": false }
      }
    },
    "extensions": { "$ref": "cartulary.harness.defs.v1#/$defs/extensions" }
  },
  "$defs": {
    "repo_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._@+\\[\\]-]+(?:/[A-Za-z0-9._@+\\[\\]-]+)*$"
    },
    "repo_glob": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._@+*?{},\\[\\]-]+(?:/[A-Za-z0-9._@+*?{},\\[\\]-]+)*$"
    }
  }
}
