{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.frontend_row_accounting.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "target",
    "target_status",
    "rows",
    "counts"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.frontend_row_accounting.v1"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "target_status": {
      "$ref": "cartulary.harness.defs.v1#/$defs/status"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "counts": {
      "$ref": "#/$defs/counts"
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_id",
        "phase_status",
        "row_id",
        "layer",
        "evidence_class",
        "claim_status",
        "scenario_titles",
        "target",
        "target_status",
        "scenarios",
        "closure_status"
      ],
      "properties": {
        "phase_id": {
          "type": "string",
          "pattern": "^FE-P(?:0|[1-9][0-9]*)$"
        },
        "phase_status": {
          "enum": ["planned", "active", "retired"]
        },
        "row_id": {
          "type": "string",
          "pattern": "^FE-[A-Z0-9]+-P(?:0|[1-9][0-9]*)-[0-9]{2}$"
        },
        "layer": {
          "enum": [
            "accessibility",
            "browser_integration",
            "e2e",
            "integration",
            "support",
            "unit",
            "visual_regression"
          ]
        },
        "evidence_class": {
          "enum": [
            "claim_publication_boundary",
            "design_direction",
            "implementation_support",
            "product_conformance",
            "TODO_owner_lookup"
          ]
        },
        "claim_status": {
          "enum": ["implemented", "blocked", "not_applicable"]
        },
        "scenario_titles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "target_status": {
          "$ref": "cartulary.harness.defs.v1#/$defs/status"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scenario"
          }
        },
        "closure_status": {
          "enum": [
            "blocked_by_target",
            "closed",
            "failed",
            "missing",
            "not_evaluable"
          ]
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "status", "files"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["failed", "missing", "passed", "skipped", "unknown"]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "scenarios",
        "closed_rows",
        "blocked_by_target_rows",
        "failed_rows",
        "missing_rows",
        "not_evaluable_rows",
        "passed_scenarios",
        "failed_scenarios",
        "missing_scenarios",
        "skipped_scenarios",
        "unknown_scenarios"
      ],
      "properties": {
        "rows": {
          "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer"
        },
        "scenarios": {
          "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer"
        },
        "closed_rows": {
          "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer"
        },
        "blocked_by_target_rows": {
          "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer"
        },
        "failed_rows": {
          "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer"
        },
        "missing_rows": {
          "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer"
        },
        "not_evaluable_rows": {
          "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer"
        },
        "passed_scenarios": {
          "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer"
        },
        "failed_scenarios": {
          "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer"
        },
        "missing_scenarios": {
          "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer"
        },
        "skipped_scenarios": {
          "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer"
        },
        "unknown_scenarios": {
          "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer"
        }
      }
    }
  }
}
