{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.local_object_store_proxy_health.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "instance_id", "emitted_at", "configuration", "process"],
  "properties": {
    "schema_id": { "const": "cartulary.local_object_store_proxy_health.v2" },
    "instance_id": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+$" },
    "emitted_at": { "type": "string", "format": "date-time" },
    "configuration": { "$ref": "cartulary.local_object_store_proxy_start_attempt.v2#/$defs/configuration" },
    "process": { "$ref": "cartulary.local_object_store_proxy_start_attempt.v2#/$defs/process_proof" }
  }
}
