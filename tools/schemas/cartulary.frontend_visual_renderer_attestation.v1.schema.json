{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.frontend_visual_renderer_attestation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "profile",
    "observed"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.frontend_visual_renderer_attestation.v1"
    },
    "profile": {
      "$ref": "cartulary.frontend_visual_renderer_profile.v2"
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container_image",
        "platform",
        "playwright_version",
        "chromium_revision",
        "chromium_version",
        "font_manifest_sha256",
        "core_version",
        "image_id",
        "font_files"
      ],
      "properties": {
        "container_image": {
          "type": "string",
          "pattern": "^mcr\\.microsoft\\.com/playwright@sha256:[a-f0-9]{64}$"
        },
        "platform": {
          "type": "string",
          "pattern": "^[a-z0-9]+/[a-z0-9_]+$"
        },
        "playwright_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "chromium_revision": {
          "type": "string",
          "pattern": "^\\d+$"
        },
        "chromium_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+\\.\\d+$"
        },
        "font_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "core_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "image_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "font_files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[A-Za-z0-9_./,\\[\\]-]+$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
