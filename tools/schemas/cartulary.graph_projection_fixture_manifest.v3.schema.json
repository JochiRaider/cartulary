{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.graph_projection_fixture_manifest.v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "fixture_version",
    "fixture_id",
    "execution_layer",
    "test_symbol",
    "determinism",
    "comparison",
    "state_effects",
    "steps",
    "artifacts",
    "golden"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.graph_projection_fixture_manifest.v3"
    },
    "fixture_version": {
      "type": "integer",
      "const": 3
    },
    "fixture_id": {
      "type": "string",
      "pattern": "^GP-FIX-[0-9]{3}$"
    },
    "execution_layer": {
      "enum": [
        "backend_unit",
        "backend_store"
      ]
    },
    "test_symbol": {
      "type": "string",
      "pattern": "^TestGP(?:FIX|AC)[A-Za-z0-9_]+$"
    },
    "determinism": {
      "$ref": "#/$defs/determinism"
    },
    "comparison": {
      "$ref": "#/$defs/comparison"
    },
    "state_effects": {
      "$ref": "#/$defs/state_effects"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "golden": {
      "$ref": "#/$defs/golden"
    }
  },
  "$defs": {
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._@+-]+(?:/[A-Za-z0-9._@+-]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock",
        "nonce",
        "cursor_key_hex"
      ],
      "properties": {
        "clock": {
          "type": "string",
          "format": "date-time"
        },
        "nonce": {
          "type": "string",
          "minLength": 1
        },
        "cursor_key_hex": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "mode",
        "run_independent_validation"
      ],
      "properties": {
        "scope": {
          "enum": [
            "run_specific",
            "run_independent"
          ]
        },
        "mode": {
          "const": "exact_artifacts"
        },
        "run_independent_validation": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "run_specific"
              }
            }
          },
          "then": {
            "properties": {
              "run_independent_validation": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "state_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "no_retained_state_change",
            "retained_state_change"
          ]
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "operation": {
          "enum": [
            "project_ephemeral",
            "project_ephemeral_with_limits",
            "admit_projection",
            "canonical_json",
            "classify_integers",
            "classify_timestamps",
            "classify_identifiers",
            "classify_field_paths",
            "sort_canonical_values",
            "summarize_validation_issues",
            "evaluate_property_candidates",
            "merge_property_values",
            "create_projection",
            "refresh_projection",
            "invalidate_graph_view",
            "invalidate_projection_run",
            "get_graph_view",
            "get_projection_run",
            "get_vertex",
            "get_edge",
            "list_graph_views",
            "traverse",
            "advance_clock"
          ]
        },
        "input_artifact": {
          "$ref": "#/$defs/relative_path"
        },
        "expected_artifact": {
          "$ref": "#/$defs/relative_path"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "role": {
          "enum": [
            "raw_input",
            "input",
            "expected_error",
            "expected_response",
            "expected_state",
            "normalized",
            "transcript",
            "digest",
            "support"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "golden": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_status"
      ],
      "properties": {
        "review_status": {
          "enum": [
            "reviewed",
            "pending_owner_clarification"
          ]
        }
      }
    }
  }
}
