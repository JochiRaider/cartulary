{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.performance_import_discovery_contract.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "contract_id",
    "criterion_id",
    "fixture_contract_id",
    "fixture_profile_id",
    "measurement_policy_id",
    "warmup_passes",
    "measured_samples",
    "product_retries",
    "threshold_ms",
    "threshold_comparison",
    "view_schema_id",
    "viewport",
    "start_mark",
    "admission_mark",
    "predicates",
    "workload",
    "dispatch_mark"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.performance_import_discovery_contract.v1"
    },
    "contract_id": {
      "const": "cartulary.performance.import_discovery.v1"
    },
    "criterion_id": {
      "const": "AC-027"
    },
    "fixture_contract_id": {
      "const": "cartulary.performance.large_grid.v1"
    },
    "fixture_profile_id": {
      "const": "timeline_large_grid_import_snapshot_v1"
    },
    "measurement_policy_id": {
      "const": "cartulary.measurement.single_observation.v1"
    },
    "warmup_passes": {
      "const": 0
    },
    "measured_samples": {
      "const": 1
    },
    "product_retries": {
      "const": 0
    },
    "threshold_ms": {
      "const": 1000
    },
    "threshold_comparison": {
      "const": "lte"
    },
    "view_schema_id": {
      "const": "cartulary.view.timeline.v2"
    },
    "viewport": {
      "const": {
        "width": 1920,
        "height": 1080,
        "device_scale_factor": 1
      }
    },
    "start_mark": {
      "const": "cartulary.workbook.import_discovery_accepted"
    },
    "admission_mark": {
      "const": "cartulary.workbook.import_discovery_admitted"
    },
    "predicates": {
      "const": [
        {
          "predicate_id": "perf.import_csv_discovery.visible_with_cancel.v1",
          "kind": "csv"
        },
        {
          "predicate_id": "perf.import_xlsx_discovery.visible_with_cancel.v1",
          "kind": "xlsx"
        }
      ]
    },
    "workload": {
      "const": {
        "foreground_role": "editor",
        "data_rows": 20000,
        "columns": 2,
        "headers": [
          "Activity Synopsis",
          "Unmapped source note"
        ],
        "first_column_prefix": "Background import ",
        "second_column_prefix": "Source note ",
        "ordinal_width": 5,
        "worksheet": "Timeline",
        "field_key": "timeline.analyst_text",
        "draft_suffix": "x",
        "action_driver": "keyboard_enter",
        "grid_driver": "pointer_select_keyboard_edit",
        "discovery_only": true
      }
    },
    "dispatch_mark": {
      "const": "cartulary.workbook.import_discovery_dispatched"
    }
  }
}
