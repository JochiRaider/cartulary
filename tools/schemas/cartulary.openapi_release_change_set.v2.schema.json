{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.openapi_release_change_set.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "baseline_version",
    "target_version",
    "changes"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.openapi_release_change_set.v2"
    },
    "baseline_version": {
      "$ref": "#/$defs/version"
    },
    "target_version": {
      "$ref": "#/$defs/version"
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "classification",
        "owner_id",
        "rationale"
      ],
      "properties": {
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "classification": {
          "enum": [
            "additive",
            "breaking",
            "non_behavioral",
            "security_sensitive"
          ]
        },
        "owner_id": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
