{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.backend_module_boundaries.v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "scan_roots",
    "scan_excludes",
    "exact_file_sets",
    "migration_source_boundary",
    "owner_port_only_imports",
    "raw_ndjson_targets",
    "forbidden_route_dependencies",
    "forbidden_go_imports",
    "go_import_allowlists",
    "source_table_access",
    "forbidden_source_mappings",
    "sql_table_allowlists",
    "sql_table_access",
    "forbidden_go_calls",
    "command_root_shape",
    "forbidden_source_tokens",
    "forbidden_test_build_tokens",
    "generated_root_writes"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.backend_module_boundaries.v4"
    },
    "scan_roots": {
      "$ref": "#/$defs/stringArray"
    },
    "scan_excludes": {
      "$ref": "#/$defs/stringArray"
    },
    "exact_file_sets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exactFileSet"
      }
    },
    "migration_source_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scan_roots",
        "restricted_imports",
        "forbidden_declarations",
        "exact_calls"
      ],
      "properties": {
        "scan_roots": {
          "$ref": "#/$defs/stringArray"
        },
        "restricted_imports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/forbiddenGoImport"
          }
        },
        "forbidden_declarations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/forbiddenGoDeclaration"
          }
        },
        "exact_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exactGoCall"
          }
        }
      }
    },
    "owner_port_only_imports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ownerPortImport"
      }
    },
    "raw_ndjson_targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rawNDJSONTarget"
      }
    },
    "forbidden_route_dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/forbiddenRouteDependency"
      }
    },
    "forbidden_go_imports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/forbiddenGoImport"
      }
    },
    "go_import_allowlists": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/goImportAllowlist"
      }
    },
    "source_table_access": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceTableAccess"
      }
    },
    "forbidden_source_mappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/forbiddenSourceMapping"
      }
    },
    "sql_table_allowlists": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sqlTableAllowlist"
      }
    },
    "sql_table_access": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sqlTableAccess"
      }
    },
    "forbidden_go_calls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/forbiddenGoCall"
      }
    },
    "command_root_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "allowed_go_files"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "allowed_go_files": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "forbidden_source_tokens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/forbiddenSourceToken"
      }
    },
    "forbidden_test_build_tokens": {
      "$ref": "#/$defs/stringArray"
    },
    "generated_root_writes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scan_roots",
        "generated_roots",
        "write_symbols",
        "allowed_paths"
      ],
      "properties": {
        "scan_roots": {
          "$ref": "#/$defs/stringArray"
        },
        "generated_roots": {
          "$ref": "#/$defs/stringArray"
        },
        "write_symbols": {
          "$ref": "#/$defs/stringArray"
        },
        "allowed_paths": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "nonemptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "exactFileSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "paths",
        "discovery"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "paths": {
          "$ref": "#/$defs/nonemptyStringArray"
        },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scan_roots",
            "tokens",
            "production_only"
          ],
          "properties": {
            "scan_roots": {
              "$ref": "#/$defs/nonemptyStringArray"
            },
            "tokens": {
              "$ref": "#/$defs/nonemptyStringArray"
            },
            "production_only": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "forbiddenGoImport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "match_kind",
        "imports",
        "scan_paths",
        "allowed_paths",
        "production_only"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "match_kind": {
          "enum": [
            "exact",
            "subtree"
          ]
        },
        "imports": {
          "$ref": "#/$defs/nonemptyStringArray"
        },
        "scan_paths": {
          "$ref": "#/$defs/nonemptyStringArray"
        },
        "allowed_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "production_only": {
          "type": "boolean"
        }
      }
    },
    "forbiddenSourceToken": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tokens",
        "allowed_paths",
        "production_only",
        "match_kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "tokens": {
          "$ref": "#/$defs/nonemptyStringArray"
        },
        "scan_paths": {
          "$ref": "#/$defs/nonemptyStringArray"
        },
        "exact_file_set_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "allowed_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "production_only": {
          "type": "boolean"
        },
        "match_kind": {
          "enum": [
            "source_text",
            "go_identifier"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "scan_paths"
          ],
          "not": {
            "required": [
              "exact_file_set_id"
            ]
          }
        },
        {
          "required": [
            "exact_file_set_id"
          ],
          "not": {
            "required": [
              "scan_paths"
            ]
          }
        }
      ]
    },
    "ownerPortImport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "import",
        "allowed_importers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "import": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "allowed_importers": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "rawNDJSONTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "function",
        "allowed_paths"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "function": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "allowed_paths": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "forbiddenRouteDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "import_suffix",
        "allowed_importers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "import_suffix": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "allowed_importers": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "goImportAllowlist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "import_prefix",
        "allowed_imports",
        "allowed_prefixes",
        "scan_paths",
        "production_only"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "import_prefix": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "allowed_imports": {
          "$ref": "#/$defs/stringArray"
        },
        "allowed_prefixes": {
          "$ref": "#/$defs/stringArray"
        },
        "scan_paths": {
          "$ref": "#/$defs/nonemptyStringArray"
        },
        "production_only": {
          "type": "boolean"
        }
      }
    },
    "sourceTableAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tables",
        "allowed_paths"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "tables": {
          "$ref": "#/$defs/nonemptyStringArray"
        },
        "scan_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "allowed_paths": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "forbiddenSourceMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "prefixes",
        "scan_paths"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "prefixes": {
          "$ref": "#/$defs/nonemptyStringArray"
        },
        "scan_paths": {
          "$ref": "#/$defs/nonemptyStringArray"
        }
      }
    },
    "sqlTableAllowlist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "allowed_tables",
        "scan_paths"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "allowed_tables": {
          "$ref": "#/$defs/stringArray"
        },
        "scan_paths": {
          "$ref": "#/$defs/nonemptyStringArray"
        }
      }
    },
    "sqlTableAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "table",
        "scan_paths",
        "read_allowed_paths",
        "write_allowed_paths"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "table": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "scan_paths": {
          "$ref": "#/$defs/nonemptyStringArray"
        },
        "read_allowed_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "write_allowed_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "test_read_allowed_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "test_write_allowed_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "lock_allowed_paths": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "forbiddenGoCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "symbols",
        "allowed_paths"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "symbols": {
          "$ref": "#/$defs/nonemptyStringArray"
        },
        "allowed_paths": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "forbiddenGoDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "symbols",
        "scan_paths",
        "allowed_paths",
        "production_only"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "symbols": {
          "$ref": "#/$defs/nonemptyStringArray"
        },
        "scan_paths": {
          "$ref": "#/$defs/nonemptyStringArray"
        },
        "allowed_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "production_only": {
          "type": "boolean"
        }
      }
    },
    "exactGoCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "symbol",
        "scan_paths",
        "allowed_paths",
        "required_path",
        "required_count",
        "production_only"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "scan_paths": {
          "$ref": "#/$defs/nonemptyStringArray"
        },
        "allowed_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "required_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "required_count": {
          "type": "integer",
          "minimum": 0
        },
        "production_only": {
          "type": "boolean"
        }
      }
    }
  }
}
