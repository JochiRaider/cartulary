{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.openapi_baseline.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "target_path",
    "canonical_sha256",
    "byte_length",
    "metadata",
    "version_policy",
    "structure",
    "set_hashes",
    "generated_artifacts"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.openapi_baseline.v1" },
    "target_path": { "const": "contracts/openapi/cartulary.openapi.yaml" },
    "canonical_sha256": { "$ref": "#/$defs/sha256" },
    "byte_length": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openapi", "title", "version"],
      "properties": {
        "openapi": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "version_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "breaking_wire_changes",
        "additive_public_behavior",
        "non_behavioral_contract_corrections"
      ],
      "properties": {
        "breaking_wire_changes": { "const": "major" },
        "additive_public_behavior": { "const": "minor" },
        "non_behavioral_contract_corrections": { "const": "patch" }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_count",
        "operation_count",
        "component_schema_count",
        "operation_tag_count",
        "unique_internal_ref_count",
        "response_waiver_operation_count",
        "security_waiver_operation_count"
      ],
      "properties": {
        "path_count": { "type": "integer", "minimum": 0, "maximum": 2048 },
        "operation_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "component_schema_count": { "type": "integer", "minimum": 0, "maximum": 16384 },
        "operation_tag_count": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "unique_internal_ref_count": { "type": "integer", "minimum": 0, "maximum": 65536 },
        "response_waiver_operation_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "security_waiver_operation_count": { "type": "integer", "minimum": 0, "maximum": 4096 }
      }
    },
    "set_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_schema_names_sha256",
        "internal_ref_values_sha256",
        "operation_inventory_sha256",
        "operation_tags_sha256"
      ],
      "properties": {
        "component_schema_names_sha256": { "$ref": "#/$defs/sha256" },
        "internal_ref_values_sha256": { "$ref": "#/$defs/sha256" },
        "operation_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "operation_tags_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "generated_artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._@+-]+(?:/[A-Za-z0-9._@+-]+)*$"
          },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
