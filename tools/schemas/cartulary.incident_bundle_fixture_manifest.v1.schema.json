{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.incident_bundle_fixture_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "fixtures"],
  "properties": {
    "schema_id": { "const": "cartulary.incident_bundle_fixture_manifest.v1" },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture_id", "class", "covers", "test"],
        "properties": {
          "fixture_id": { "pattern": "^IB-FIX-[0-9]{3}$" },
          "class": { "enum": ["valid", "invalid"] },
          "covers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "test": { "type": "string", "pattern": "^Test[A-Za-z0-9_]+$" }
        }
      }
    }
  }
}
