{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.openapi_release_registry.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "latest_released_version",
    "releases"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.openapi_release_registry.v1"
    },
    "latest_released_version": {
      "$ref": "#/$defs/version"
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/release"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "document_path",
        "sha256",
        "byte_length",
        "source_commit",
        "publication_state"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "document_path": {
          "type": "string",
          "pattern": "^contracts/openapi-releases/[0-9]+\\.[0-9]+\\.[0-9]+\\.openapi\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "publication_state": {
          "enum": [
            "historical_baseline",
            "published"
          ]
        }
      }
    }
  }
}
