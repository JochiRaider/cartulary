{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_cache_record.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "profile_id", "policy", "producer_identity", "unit_id", "unit_digest", "input_digest", "semantic_result", "output_digest", "artifacts", "created_at"],
  "properties": {
    "schema_id": { "const": "cartulary.harness_cache_record.v2" },
    "profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
    "policy": { "enum": ["same_run", "content_addressed"] },
    "producer_identity": { "type": "string", "minLength": 1, "maxLength": 255 },
    "unit_id": { "type": "string", "minLength": 1, "maxLength": 255 },
    "unit_digest": { "$ref": "#/$defs/digest" },
    "input_digest": { "$ref": "#/$defs/digest" },
    "semantic_result": {
      "type": "object", "additionalProperties": false, "required": ["status", "rows"],
      "properties": {
        "status": { "const": "passed" },
        "rows": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["row_id", "runner"],
            "properties": {
              "row_id": { "$ref": "cartulary.test_catalog_defs.v1#/$defs/row_id" },
              "runner": { "enum": ["go", "vitest", "playwright", "shell"] }
            }
          }
        }
      }
    },
    "output_digest": { "$ref": "#/$defs/digest" },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "vulnerability_database_revision": { "type": "string", "minLength": 1, "maxLength": 256 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_type", "relative_path", "destination_class", "mode", "digest", "producer_identity", "semantic_input_digest", "members"],
      "properties": {
        "artifact_type": { "enum": ["file", "directory"] },
        "relative_path": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._@+/-]+$" },
        "destination_class": { "enum": ["run_root", "repository_artifact"] },
        "mode": { "type": "string", "pattern": "^0[0-7]{3}$" },
        "digest": { "$ref": "#/$defs/digest" },
        "producer_identity": { "type": "string", "minLength": 1, "maxLength": 255 },
        "semantic_input_digest": { "$ref": "#/$defs/digest" },
        "members": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/artifact_member" } }
      }
    },
    "artifact_member": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_type", "relative_path", "mode", "digest"],
      "properties": {
        "artifact_type": { "enum": ["file", "directory"] },
        "relative_path": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._@+/-]+$" },
        "mode": { "type": "string", "pattern": "^0[0-7]{3}$" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
