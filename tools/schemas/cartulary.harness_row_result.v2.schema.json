{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_row_result.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "row_id", "terminal_state", "duration_ms", "exit_code", "failure_class", "failure_reason", "failure_diagnostic", "runner", "started_at", "finished_at", "wall_duration_ms"],
  "properties": {
    "schema_id": { "const": "cartulary.harness_row_result.v2" },
    "row_id": { "$ref": "cartulary.test_catalog_defs.v1#/$defs/row_id" },
    "terminal_state": { "enum": ["passed", "failed", "infrastructure_failed", "skipped_dependency", "cancelled", "skipped_authorized"] },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
    "failure_class": { "oneOf": [{ "type": "null" }, { "enum": ["harness", "infra", "interrupted", "product"] }] },
    "failure_reason": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }] },
    "failure_diagnostic": { "oneOf": [{ "type": "null" }, { "$ref": "cartulary.harness_test_failure.v1" }] },
    "runner": { "enum": ["go", "vitest", "playwright", "shell"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "wall_duration_ms": { "type": "integer", "minimum": 0 }
  },
  "allOf": [
    {
      "if": { "properties": { "terminal_state": { "const": "passed" } } },
      "then": {
        "properties": {
          "exit_code": { "const": 0 },
          "failure_class": { "type": "null" },
          "failure_reason": { "type": "null" },
          "failure_diagnostic": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "failure_class": { "type": "string" },
          "failure_reason": { "type": "string" }
        }
      }
    }
  ]
}
