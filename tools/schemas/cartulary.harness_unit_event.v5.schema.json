{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_unit_event.v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "seq",
    "monotonic_ms",
    "event",
    "unit_id",
    "status",
    "needs",
    "resource_claims",
    "service_dependencies"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.harness_unit_event.v5"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "monotonic_ms": {
      "type": "integer",
      "minimum": 0
    },
    "event": {
      "enum": [
        "run_started",
        "queued",
        "eligible",
        "wait_started",
        "wait_ended",
        "admitted",
        "started",
        "cache_hit",
        "cache_miss",
        "cache_bypass",
        "fixture_acquired",
        "fixture_released",
        "completed",
        "failed",
        "skipped",
        "cancelled",
        "cleanup_started",
        "cleanup_completed",
        "run_completed",
        "phase_started",
        "phase_finished"
      ]
    },
    "unit_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "passed",
        "failed",
        "skipped",
        "cancelled"
      ]
    },
    "needs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "cartulary.harness_execution_defs.v1#/$defs/id"
      }
    },
    "resource_claims": {
      "$ref": "cartulary.harness_execution_defs.v1#/$defs/resource_claims"
    },
    "service_dependencies": {
      "$ref": "cartulary.test_catalog_defs.v1#/$defs/service_dependencies"
    },
    "wait_reason": {
      "enum": [
        "resources",
        "exclusive_barrier",
        "rank",
        "scheduler_stop"
      ]
    },
    "blocked_resources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource",
          "blocked_ms"
        ],
        "properties": {
          "resource": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "blocked_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "blocking_units": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_id",
          "overlap_ms"
        ],
        "properties": {
          "unit_id": {
            "$ref": "cartulary.harness_execution_defs.v1#/$defs/id"
          },
          "overlap_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "blocking_units_omitted": {
      "type": "integer",
      "minimum": 0
    },
    "cache_profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "cache_reason": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "output_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "fixture_lease_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "failure_class": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "failure_reason": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "unit_kind": {
      "enum": [
        "runner",
        "readiness",
        "lifecycle",
        "finalizer",
        "policy",
        "artifact",
        "fixture_builder"
      ]
    },
    "row_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 255
      }
    },
    "interval_id": {
      "type": "string",
      "pattern": "^phase:[0-9]+$"
    },
    "phase": {
      "$ref": "cartulary.harness_instrumentation_defs.v2#/$defs/phase"
    },
    "phase_outcome": {
      "enum": [
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "service_scope_refs": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^_shared/test-services/[A-Za-z0-9][A-Za-z0-9._-]*/service-scope\\.json$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "enum": [
              "wait_started",
              "wait_ended"
            ]
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "required": [
          "wait_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "wait_ended"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "required": [
          "blocked_resources",
          "blocking_units",
          "blocking_units_omitted"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "blocked_resources"
              ]
            },
            {
              "required": [
                "blocking_units"
              ]
            },
            {
              "required": [
                "blocking_units_omitted"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "queued"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "required": [
          "unit_kind",
          "row_ids"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "enum": [
              "phase_started",
              "phase_finished"
            ]
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "required": [
          "interval_id",
          "phase"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "phase_finished"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "required": [
          "phase_outcome"
        ]
      }
    }
  ]
}
