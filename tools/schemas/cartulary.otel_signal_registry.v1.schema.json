{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.otel_signal_registry.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "attribute_vocabulary", "forbidden_attribute_classes", "scopes", "closed_values", "failure_policy", "cleanup_age_source"],
  "properties": {
    "schema_id": { "const": "cartulary.otel_signal_registry.v1" },
    "attribute_vocabulary": { "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": { "type": "string" } },
    "forbidden_attribute_classes": { "type": "array", "minItems": 9, "uniqueItems": true, "items": { "type": "string" } },
    "scopes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope_name", "metrics"],
        "properties": {
          "scope_name": { "enum": ["cartulary.jobs", "cartulary.network_flow"] },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["metric_name", "instrument_kind", "unit", "attributes"],
              "properties": {
                "metric_name": { "type": "string", "pattern": "^cartulary\\.[a-z0-9_.]+$" },
                "instrument_kind": { "enum": ["counter", "histogram", "observable_gauge"] },
                "unit": { "type": "string", "minLength": 1 },
                "attributes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "closed_values": { "type": "object" },
    "failure_policy": { "const": "telemetry_failure_never_changes_product_behavior" },
    "cleanup_age_source": { "const": "published_at" }
  }
}
