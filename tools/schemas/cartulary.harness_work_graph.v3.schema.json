{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_work_graph.v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "selector", "units", "graph_digest"],
  "properties": {
    "schema_id": { "const": "cartulary.harness_work_graph.v3" },
    "selector": { "$ref": "cartulary.harness_execution_defs.v1#/$defs/nonempty" },
    "units": { "type": "array", "items": { "$ref": "#/$defs/unit" } },
    "graph_digest": { "$ref": "cartulary.harness_execution_defs.v1#/$defs/digest" }
  },
  "$defs": {
    "command": {
      "type": "object", "additionalProperties": false, "required": ["executable", "args", "environment"],
      "properties": {
        "executable": { "$ref": "cartulary.harness_execution_defs.v1#/$defs/nonempty" },
        "args": { "type": "array", "items": { "type": "string", "maxLength": 4096 } },
        "environment": { "type": "object", "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" }, "additionalProperties": { "type": "string", "maxLength": 4096 } }
      }
    },
    "failure_policy": {
      "type": "object", "additionalProperties": false, "required": ["block_descendants", "continue_independent", "aggregate_effect"],
      "properties": { "block_descendants": { "type": "boolean" }, "continue_independent": { "type": "boolean" }, "aggregate_effect": { "enum": ["required", "diagnostic"] } }
    },
    "unit": {
      "type": "object", "additionalProperties": false,
      "required": ["unit_id", "owner_id", "kind", "command", "needs", "resource_claims", "fixture_lease", "service_dependencies", "cache_policy", "timeout_ms", "evidence_outputs", "failure_policy", "estimated_work_ms", "semantic_digest"],
      "properties": {
        "unit_id": { "$ref": "cartulary.harness_execution_defs.v1#/$defs/id" }, "owner_id": { "$ref": "cartulary.harness_execution_defs.v1#/$defs/id" },
        "kind": { "enum": ["runner", "readiness", "lifecycle", "finalizer", "policy", "artifact", "fixture_builder"] },
        "command": { "$ref": "#/$defs/command" },
        "needs": { "type": "array", "uniqueItems": true, "items": { "$ref": "cartulary.harness_execution_defs.v1#/$defs/id" } },
        "resource_claims": { "$ref": "cartulary.harness_execution_defs.v1#/$defs/resource_claims" },
        "shared_locks": { "type": "array", "uniqueItems": true, "items": { "$ref": "cartulary.harness_execution_defs.v1#/$defs/id" } },
        "exclusive_locks": { "type": "array", "uniqueItems": true, "items": { "$ref": "cartulary.harness_execution_defs.v1#/$defs/id" } },
        "affinity_key": { "$ref": "cartulary.harness_execution_defs.v1#/$defs/id" },
        "fixture_lease": { "enum": ["none", "postgres_transaction", "postgres_group", "postgres_dedicated", "postgres_migration", "object_store_namespace", "managed_process", "browser_stack"] },
        "fixture_profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*_v[1-9][0-9]*$" },
        "snapshot_key": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "service_dependencies": { "$ref": "cartulary.test_catalog_defs.v1#/$defs/service_dependencies" },
        "cache_policy": { "enum": ["none", "same_run", "content_addressed"] },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "evidence_outputs": { "type": "array", "uniqueItems": true, "items": { "$ref": "cartulary.harness_execution_defs.v1#/$defs/nonempty" } },
        "failure_policy": { "$ref": "#/$defs/failure_policy" },
        "estimated_work_ms": { "type": "integer", "minimum": 1 },
        "semantic_digest": { "$ref": "cartulary.harness_execution_defs.v1#/$defs/digest" }
      }
    }
  }
}
