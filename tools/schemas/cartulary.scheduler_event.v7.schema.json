{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.scheduler_event.v7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "target",
    "scheduler_kind",
    "seq",
    "event",
    "monotonic_ms",
    "emitted_at",
    "pending",
    "running",
    "total_work_units",
    "blocked",
    "completed",
    "blocked_reason",
    "blocked_resources",
    "waiting_on",
    "blocked_units",
    "active_resource_claims",
    "resource_limits",
    "resource_limit_sources",
    "dependency_edges",
    "work_unit_states"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.scheduler_event.v7" },
    "target": { "type": "string", "minLength": 1 },
    "scheduler_kind": { "enum": ["check", "service_backed", "test_slice", "sequence"] },
    "seq": { "type": "integer", "minimum": 1 },
    "event": { "type": "string", "minLength": 1 },
    "monotonic_ms": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_number" },
    "emitted_at": { "$ref": "cartulary.harness.defs.v1#/$defs/timestamp" },
    "pending": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "running": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "total_work_units": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "blocked": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "completed": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "blocked_reason": { "type": ["string", "null"] },
    "blocked_resources": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "waiting_on": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "blocked_units": { "type": "array", "items": { "type": "object" } },
    "active_resource_claims": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "resource_limits": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "resource_limit_sources": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "dependency_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 }
        }
      }
    },
    "work_unit_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/work_unit_state" }
    },
    "pending_finalizers": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "running_finalizers": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "scheduler_started_monotonic_ms": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_number" },
    "scheduler_started_at": { "$ref": "cartulary.harness.defs.v1#/$defs/timestamp" },
    "clock_skew": { "type": "object" },
    "work_unit": { "type": "string" },
    "work_unit_id": { "type": "string" },
    "work_unit_type": { "type": "string" },
    "work_unit_class": { "type": "string" },
    "aggregate_target": { "type": ["string", "null"] },
    "resource_claims": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "log_file": { "type": "string" },
    "status": { "type": "integer" },
    "duration_ms": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_number" },
    "finalizer": { "type": "string" },
    "finalizer_id": { "type": "string" },
    "shards": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "active_groups": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "blocked_by": { "type": "array", "items": { "type": "string" } },
    "unblocks_after": {
      "anyOf": [
        { "type": "array", "items": { "type": "object" } },
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "slowest_running": {
      "anyOf": [
        { "type": "array", "items": { "type": "object" } },
        { "type": "object" },
        { "type": "null" }
      ]
    },
    "nested_scheduler_progress": { "type": "array", "items": { "type": "object" } },
    "nested_scheduler": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "skip_reason": { "type": "string" },
    "failed_dependency": { "type": "string" },
    "extensions": { "$ref": "cartulary.harness.defs.v1#/$defs/extensions" }
  },
  "$defs": {
    "work_unit_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_unit_id",
        "manifest_ordinal",
        "priority",
        "dependencies",
        "resource_claims",
        "eligibility_monotonic_ms",
        "started_monotonic_ms",
        "terminal_monotonic_ms",
        "terminal_state",
        "wait_reason",
        "blocking_resources",
        "blocking_units"
      ],
      "properties": {
        "work_unit_id": { "type": "string", "minLength": 1 },
        "manifest_ordinal": { "type": "integer", "minimum": 1 },
        "priority": { "type": "integer" },
        "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "resource_claims": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "eligibility_monotonic_ms": { "type": ["number", "null"], "minimum": 0 },
        "started_monotonic_ms": { "type": ["number", "null"], "minimum": 0 },
        "terminal_monotonic_ms": { "type": ["number", "null"], "minimum": 0 },
        "terminal_state": {
          "enum": ["pending", "running", "passed", "failed", "skipped_dependency", "cancelled", "interrupted"]
        },
        "wait_reason": {
          "type": ["string", "null"],
          "enum": [null, "resources", "earlier_overlapping_ready", "capacity", "scheduler_stop"]
        },
        "blocking_resources": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "blocking_units": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  }
}
