{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.task_guide_summary.v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "evidence_epoch",
    "role",
    "owner_id",
    "test_catalog_digest",
    "verification_routing_digest",
    "focused_commands",
    "generated_commands",
    "broader_commands",
    "release_gate"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.task_guide_summary.v3"
    },
    "evidence_epoch": {
      "const": "cartulary.test_evidence.nlspec.v1"
    },
    "role": {
      "const": "module-author"
    },
    "owner_id": {
      "$ref": "cartulary.test_family_manifest.v2#/$defs/owner_id"
    },
    "test_catalog_digest": {
      "$ref": "cartulary.test_slice_plan.v3#/$defs/digest"
    },
    "verification_routing_digest": {
      "$ref": "cartulary.test_slice_plan.v3#/$defs/digest"
    },
    "focused_commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^make (?:service-backed-)?test-slice OWNER="
      }
    },
    "generated_commands": {
      "$ref": "#/$defs/commands"
    },
    "broader_commands": {
      "$ref": "#/$defs/commands"
    },
    "release_gate": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "make release-check",
        null
      ]
    }
  },
  "$defs": {
    "commands": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^make [a-z][a-z0-9-]*$"
      }
    }
  }
}
