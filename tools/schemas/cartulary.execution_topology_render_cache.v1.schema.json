{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.execution_topology_render_cache.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "generator",
    "generator_version",
    "node_version",
    "input_digest",
    "artifacts",
    "written_at"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.execution_topology_render_cache.v1" },
    "generator": { "const": "tools/harness/generated-artifacts/render-execution-topology-artifacts.mjs" },
    "generator_version": { "type": "integer", "minimum": 1 },
    "node_version": { "type": "string", "minLength": 1 },
    "input_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "hash", "content"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "content": { "type": "string" }
        }
      }
    },
    "written_at": { "type": "string", "minLength": 1, "format": "date-time" }
  }
}
