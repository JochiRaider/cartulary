{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.browser_owner_index.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "evidence_epoch",
    "target_id",
    "run_id",
    "source_snapshot_digest",
    "test_catalog_digest",
    "verification_routing_digest",
    "status",
    "selected_rows",
    "owner_shards"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.browser_owner_index.v2"
    },
    "evidence_epoch": {
      "const": "cartulary.test_evidence.nlspec.v1"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "run_id": {
      "$ref": "cartulary.test_slice_plan.v3#/$defs/nonempty"
    },
    "source_snapshot_digest": {
      "$ref": "cartulary.test_slice_plan.v3#/$defs/digest"
    },
    "test_catalog_digest": {
      "$ref": "cartulary.test_slice_plan.v3#/$defs/digest"
    },
    "verification_routing_digest": {
      "$ref": "cartulary.test_slice_plan.v3#/$defs/digest"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "selected_rows": {
      "$ref": "cartulary.test_slice_plan.v3#/$defs/row_ids"
    },
    "owner_shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner_id",
          "status",
          "selected_rows",
          "evidence_accounting",
          "owner_summary"
        ],
        "properties": {
          "owner_id": {
            "$ref": "cartulary.test_family_manifest.v2#/$defs/owner_id"
          },
          "status": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "selected_rows": {
            "$ref": "cartulary.test_slice_plan.v3#/$defs/row_ids"
          },
          "evidence_accounting": {
            "type": "string",
            "minLength": 1
          },
          "owner_summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
