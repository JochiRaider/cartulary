{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.browser_e2e_batch_manifest.v8",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "runtime_profiles", "stages"],
  "properties": {
    "schema_id": { "const": "cartulary.browser_e2e_batch_manifest.v8" },
    "runtime_profiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/record" } },
    "stages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stage" } }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1 } }
    },
    "stage": {
      "type": "object",
      "required": ["name", "target", "groups"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "groups": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
