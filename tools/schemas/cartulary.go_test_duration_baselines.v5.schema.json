{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.go_test_duration_baselines.v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "note",
    "default_shard_target_ms",
    "shard_target_ms_by_target",
    "default_item_weight_ms",
    "default_package_overhead_ms",
    "default_command_overhead_ms",
    "command_overheads_by_target",
    "package_overheads",
    "fixture_overheads_by_package",
    "fixture_overheads_by_test",
    "raw_aggregates",
    "tests"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.go_test_duration_baselines.v5" },
    "note": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "default_shard_target_ms": { "type": "integer", "minimum": 1 },
    "shard_target_ms_by_target": { "$ref": "#/$defs/positiveIntegerMap" },
    "default_item_weight_ms": { "type": "integer", "minimum": 1 },
    "default_package_overhead_ms": { "type": "integer", "minimum": 1 },
    "default_command_overhead_ms": { "type": "integer", "minimum": 1 },
    "command_overheads_by_target": { "$ref": "#/$defs/positiveIntegerMap" },
    "package_overheads": { "$ref": "#/$defs/nonNegativeIntegerMap" },
    "fixture_overheads_by_package": { "$ref": "#/$defs/nonNegativeIntegerMap" },
    "fixture_overheads_by_test": { "$ref": "#/$defs/nonNegativeIntegerMap" },
    "raw_aggregates": { "$ref": "#/$defs/positiveIntegerMap" },
    "tests": { "$ref": "#/$defs/positiveIntegerMap" }
  },
  "$defs": {
    "positiveIntegerMap": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "nonNegativeIntegerMap": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  }
}
