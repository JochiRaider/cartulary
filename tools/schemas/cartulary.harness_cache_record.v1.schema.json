{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_cache_record.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "profile_id", "policy", "unit_id", "unit_digest", "input_digest", "output_digest", "artifacts", "created_at"],
  "properties": {
    "schema_id": { "const": "cartulary.harness_cache_record.v1" }, "profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
    "unit_id": { "type": "string", "minLength": 1, "maxLength": 255 }, "unit_digest": { "$ref": "#/$defs/digest" },
    "policy": { "enum": ["same_run", "content_addressed"] },
    "input_digest": { "$ref": "#/$defs/digest" }, "output_digest": { "$ref": "#/$defs/digest" },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
    "vulnerability_database_revision": { "type": "string", "minLength": 1, "maxLength": 256 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "digest"],
      "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 512 }, "digest": { "$ref": "#/$defs/digest" } }
    }
  }
}
