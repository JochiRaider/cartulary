{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.test.public_error_fault.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "fault_id",
    "method",
    "path",
    "status",
    "code",
    "retryable",
    "consume_once"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.test.public_error_fault.v1" },
    "fault_id": { "type": "string", "minLength": 1 },
    "method": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "path": {
      "type": "string",
      "pattern": "^/api/v1/(?!test/).+"
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "code": { "type": "string", "minLength": 1 },
    "retryable": { "type": "boolean" },
    "consume_once": { "const": true },
    "extensions": { "$ref": "cartulary.harness.defs.v1#/$defs/extensions" }
  }
}
