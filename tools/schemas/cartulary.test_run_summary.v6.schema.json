{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.test_run_summary.v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "label",
    "status",
    "work_units",
    "start_time",
    "end_time",
    "wall_duration_ms",
    "executed_duration_ms",
    "logical_duration_ms",
    "critical_path_wall_duration_ms",
    "teardown_duration_ms",
    "accounting_modes",
    "counts",
    "failure_class",
    "failure_reason",
    "failure_classes",
    "failure_reasons",
    "failures",
    "failure_headline",
    "slowest_target",
    "slowest_lifecycle_bucket",
    "timing_failures",
    "teardown_status",
    "teardown_failures",
    "fixture",
    "artifacts",
    "summary_targets",
    "evidence_targets",
    "helper_units",
    "summary_groups",
    "shared_execution_groups"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.test_run_summary.v6" },
    "label": { "type": "string", "minLength": 1 },
    "status": { "$ref": "cartulary.harness.defs.v1#/$defs/status" },
    "work_units": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "start_time": { "$ref": "cartulary.harness.defs.v1#/$defs/timestamp" },
    "end_time": { "$ref": "cartulary.harness.defs.v1#/$defs/timestamp" },
    "wall_duration_ms": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_number" },
    "executed_duration_ms": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_number" },
    "logical_duration_ms": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_number" },
    "critical_path_wall_duration_ms": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_number" },
    "teardown_duration_ms": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_number" },
    "accounting_modes": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "counts": { "$ref": "cartulary.harness.defs.v1#/$defs/counts" },
    "failure_class": { "$ref": "cartulary.harness.defs.v1#/$defs/failure_class" },
    "failure_reason": { "$ref": "cartulary.harness.defs.v1#/$defs/failure_reason" },
    "failure_classes": { "$ref": "cartulary.harness.defs.v1#/$defs/counts" },
    "failure_reasons": { "$ref": "cartulary.harness.defs.v1#/$defs/counts" },
    "failures": { "type": "array", "items": { "type": "object" } },
    "failure_headline": { "type": "string" },
    "slowest_target": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "slowest_lifecycle_bucket": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "timing_failures": { "type": "array", "items": { "type": "object" } },
    "teardown_status": { "type": "string" },
    "teardown_failures": { "type": "array", "items": { "type": "object" } },
    "fixture": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "artifacts": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "summary_targets": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "evidence_targets": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "helper_units": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "summary_groups": { "type": "array", "items": { "type": "object" } },
    "shared_execution_groups": { "type": "array", "items": { "type": "object" } },
    "scheduler_timing": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "extensions": { "$ref": "cartulary.harness.defs.v1#/$defs/extensions" }
  }
}
