{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.graph_projection_conformance_matrix.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "spec_path",
    "spec_status",
    "matrix_version",
    "authority",
    "acceptance_criteria",
    "fixture_registry"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.graph_projection_conformance_matrix.v1" },
    "spec_path": { "type": "string", "minLength": 1 },
    "spec_status": { "const": "adopted/current" },
    "matrix_version": { "type": "integer", "minimum": 1 },
    "authority": { "const": "adopted_graph_projection_nlspec" },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/acceptance_criterion" }
    },
    "fixture_registry": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fixture" }
    }
  },
  "$defs": {
    "acceptance_criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "coverage_status",
        "areas",
        "evidence_selectors",
        "fixture_ids"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^GP-AC-[0-9]{3}$" },
        "owner": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "coverage_status": { "enum": ["planned", "implemented", "deferred"] },
        "areas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "specification",
              "implementation",
              "tests",
              "documentation",
              "contracts",
              "migration"
            ]
          }
        },
        "evidence_selectors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "fixture_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^GP-FIX-[0-9]{3}$" },
          "uniqueItems": true
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "fixture_path", "coverage"],
      "properties": {
        "fixture_id": { "type": "string", "pattern": "^GP-FIX-[0-9]{3}$" },
        "fixture_path": { "type": "string", "minLength": 1 },
        "coverage": { "type": "string", "minLength": 1 }
      }
    }
  }
}
