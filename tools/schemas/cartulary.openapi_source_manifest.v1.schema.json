{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.openapi_source_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "target",
    "requirements_registry",
    "compatibility_waivers",
    "fragment_root",
    "indent",
    "trailing_newline",
    "limits",
    "fragments"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.openapi_source_manifest.v1"
    },
    "target": {
      "const": "contracts/openapi/cartulary.openapi.yaml"
    },
    "requirements_registry": {
      "const": "contracts/requirements/registry.json"
    },
    "compatibility_waivers": {
      "const": "contracts/openapi-source/compatibility-waivers.json"
    },
    "fragment_root": {
      "const": "contracts/openapi-source/owners"
    },
    "indent": {
      "const": "  "
    },
    "trailing_newline": {
      "const": true
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_fragments",
        "max_fragment_bytes",
        "max_total_input_bytes",
        "max_json_depth",
        "max_paths",
        "max_operations",
        "max_named_components"
      ],
      "properties": {
        "max_fragments": {
          "const": 256
        },
        "max_fragment_bytes": {
          "const": 2097152
        },
        "max_total_input_bytes": {
          "const": 16777216
        },
        "max_json_depth": {
          "const": 128
        },
        "max_paths": {
          "const": 2048
        },
        "max_operations": {
          "const": 4096
        },
        "max_named_components": {
          "const": 16384
        }
      }
    },
    "fragments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner_id",
          "path",
          "role"
        ],
        "properties": {
          "owner_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^contracts/openapi-source/owners/[A-Za-z0-9._-]+/[A-Za-z0-9._/-]+\\.json$"
          },
          "role": {
            "enum": [
              "owner",
              "root"
            ]
          }
        }
      }
    }
  }
}
