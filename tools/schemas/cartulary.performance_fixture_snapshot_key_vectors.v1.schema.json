{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.performance_fixture_snapshot_key_vectors.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "vectors"],
  "properties": {
    "schema_id": { "const": "cartulary.performance_fixture_snapshot_key_vectors.v1" },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "input", "canonical_json", "snapshot_key"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "input": { "$ref": "cartulary.performance_fixture_snapshot_key.v1" },
          "canonical_json": { "type": "string", "minLength": 1 },
          "snapshot_key": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
