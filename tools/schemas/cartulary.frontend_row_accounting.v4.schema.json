{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.frontend_row_accounting.v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "target_name",
    "command_id",
    "phase_namespace",
    "accounting_scope",
    "registry_ref",
    "registry_digest",
    "guide_ref",
    "guide_digest",
    "phase_map_refs",
    "phase_map_digests",
    "run_root",
    "target_status",
    "scenario_results",
    "row_results",
    "rollup"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.frontend_row_accounting.v4"
    },
    "target_name": {
      "type": "string",
      "minLength": 1
    },
    "command_id": {
      "type": "string",
      "pattern": "^cartulary\\.harness\\.command\\.[a-z0-9_]+\\.v1$"
    },
    "phase_namespace": {
      "const": "frontend"
    },
    "accounting_scope": {
      "$ref": "#/$defs/accounting_scope"
    },
    "registry_ref": {
      "const": "tools/frontend_phase_registry.json"
    },
    "registry_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "guide_ref": {
      "const": "docs/guides/cartulary_frontend_implementation_testing_guide.md"
    },
    "guide_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "phase_map_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^tools/frontend_phase_maps/fe_p(?:0|[1-9][0-9]*)_test_map\\.json$"
      },
      "uniqueItems": true
    },
    "phase_map_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "uniqueItems": true
    },
    "run_root": {
      "type": "string",
      "minLength": 1
    },
    "target_status": {
      "$ref": "cartulary.harness.defs.v1#/$defs/status"
    },
    "scenario_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario_result"
      }
    },
    "row_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row_result"
      }
    },
    "rollup": {
      "$ref": "#/$defs/rollup"
    }
  },
  "$defs": {
    "accounting_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "invocation_kind",
        "phase_namespace",
        "phase",
        "selection_policy",
        "selected_row_ids"
      ],
      "properties": {
        "mode": {
          "enum": ["active_target", "selected_rows", "disabled"]
        },
        "invocation_kind": {
          "enum": ["standalone_target", "base_phase_slice", "frontend_phase_slice"]
        },
        "phase_namespace": {
          "enum": ["", "base", "frontend"]
        },
        "phase": {
          "type": "string",
          "pattern": "^(?:|phase(?:0|[1-9][0-9]*)|FE-P(?:0|[1-9][0-9]*))$"
        },
        "selection_policy": {
          "enum": [
            "all_active_rows_for_target",
            "frontend_rows_through_selected_phase",
            "base_phase_no_frontend_rows"
          ]
        },
        "selected_row_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frontend_row_id"
          },
          "uniqueItems": true
        }
      }
    },
    "frontend_row_id": {
      "type": "string",
      "pattern": "^FE-(?:U|I|B|E|V|A11Y|S)-P(?:0|[1-9][0-9]*)-[0-9]{2}$"
    },
    "scenario_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_title", "status", "row_ids", "artifact_refs"],
      "properties": {
        "scenario_title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["failed", "missing", "passed", "skipped", "unknown"]
        },
        "row_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frontend_row_id"
          },
          "uniqueItems": true
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "row_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "phase_id",
        "evidence_class",
        "claim_status_at_run",
        "target_mapping_status",
        "closure_status",
        "closing_scenario_titles",
        "failure_reason"
      ],
      "properties": {
        "row_id": {
          "$ref": "#/$defs/frontend_row_id"
        },
        "phase_id": {
          "type": "string",
          "pattern": "^FE-P(?:0|[1-9][0-9]*)$"
        },
        "evidence_class": {
          "$ref": "#/$defs/evidence_class"
        },
        "claim_status_at_run": {
          "$ref": "#/$defs/claim_status"
        },
        "target_mapping_status": {
          "enum": ["mapped", "not_mapped", "blocked", "not_applicable"]
        },
        "closure_status": {
          "enum": ["closed", "not_closed", "blocked", "stale", "not_applicable"]
        },
        "closing_scenario_titles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "failure_reason": {
          "type": "string"
        }
      }
    },
    "rollup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implemented", "blocked", "missing", "stale", "not_applicable", "closed", "failed"],
      "properties": {
        "implemented": {
          "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer"
        },
        "blocked": {
          "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer"
        },
        "missing": {
          "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer"
        },
        "stale": {
          "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer"
        },
        "not_applicable": {
          "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer"
        },
        "closed": {
          "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer"
        },
        "failed": {
          "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer"
        }
      }
    },
    "evidence_class": {
      "enum": ["claim_publication_boundary", "design_direction", "implementation_support", "product_conformance", "TODO_owner_lookup"]
    },
    "claim_status": {
      "enum": ["not_implemented", "implemented", "blocked", "stale", "retired"]
    }
  }
}
