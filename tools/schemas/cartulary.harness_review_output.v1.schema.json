{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_review_output.v1",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "preparing",
            "ready"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4095,
          "pattern": "^[^\u0000-\u001f]+$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "design_ready"
          ]
        },
        "value": {
          "$ref": "cartulary.harness_review_design_ready.v1"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "terminal"
          ]
        },
        "value": {
          "$ref": "cartulary.ui_review_command_result.v2"
        }
      }
    }
  ]
}
