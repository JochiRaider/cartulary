{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.test_catalog_defs.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id"],
  "properties": {
    "schema_id": { "const": "cartulary.test_catalog_defs.v1" }
  },
  "$defs": {
    "segment": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$", "not": { "pattern": "(?:^|\\.)(?:phase[0-9]+|fe_p[0-9]+)(?:\\.|$)" } },
    "owner_id": { "type": "string", "maxLength": 191, "pattern": "^(?:module|platform|app|web|package|harness)\\.[a-z][a-z0-9_]{0,62}$", "not": { "pattern": "(?:^|\\.)(?:phase[0-9]+|fe_p[0-9]+)(?:\\.|$)" } },
    "family_id": { "type": "string", "maxLength": 191, "pattern": "^(?:module|platform|app|web|package|harness)\\.[a-z][a-z0-9_]{0,62}\\.[a-z][a-z0-9_]{0,62}$", "not": { "pattern": "(?:^|\\.)(?:phase[0-9]+|fe_p[0-9]+)(?:\\.|$)" } },
    "row_id": { "type": "string", "maxLength": 191, "pattern": "^(?:module|platform|app|web|package|harness)\\.[a-z][a-z0-9_]{0,62}\\.[a-z][a-z0-9_]{0,62}\\.[a-z][a-z0-9_]{0,62}$", "not": { "pattern": "(?:^|\\.)(?:phase[0-9]+|fe_p[0-9]+)(?:\\.|$)" } },
    "verification_id": { "type": "string", "maxLength": 191, "pattern": "^(?:module|platform|app|web|package|harness)\\.[a-z][a-z0-9_]{0,62}\\.verification\\.[a-z][a-z0-9_]{0,62}$", "not": { "pattern": "(?:^|\\.)(?:phase[0-9]+|fe_p[0-9]+)(?:\\.|$)" } },
    "repo_path": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9._@+-]+(?:/[A-Za-z0-9._@+-]+)*$", "not": { "pattern": "(?:^|/)\\.\\.(?:/|$)" } },
    "service_dependency": { "enum": ["object_store", "postgres"] },
    "service_dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/service_dependency" }
    }
  }
}
