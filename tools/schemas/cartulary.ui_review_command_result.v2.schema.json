          },
          "subject_id": {
            "enum": [
              null,
              "node",
              "pnpm",
              "frontend_dependencies",
              "chromium",
              "host_lock",
              "go",
              "docker",
              "test_service_images",
              "frontend",
              "embedded_assets",
              "server_harness",
              "migrate",
              "test_services",
              "browser_stack",
              "fixture_seed",
              "preparation_child",
              "source_snapshot",
              "browser"
            ]
