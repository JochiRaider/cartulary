            }
          },
          {
            "if": {
              "properties": {
                "diagnostic_code": {
                  "const": "target_unavailable"
                }
              }
            },
            "then": {
              "properties": {
                "failure_class": {
                  "const": "harness"
                },
                "failure_reason": {
                  "const": "tool_diagnostic_failure"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "diagnostic_code": {
                  "const": "navigation_boundary"
                }
              }
            },
            "then": {
              "properties": {
                "failure_class": {
                  "const": "harness"
                },
                "failure_reason": {
                  "const": "tool_diagnostic_failure"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "diagnostic_code": {
                  "const": "environment_unavailable"
                }
              }
            },
            "then": {
              "properties": {
                "failure_class": {
                  "const": "infra"
                },
                "failure_reason": {
                  "const": "preflight_error"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "diagnostic_code": {
                  "const": "startup_failed"
                }
              }
            },
            "then": {
              "properties": {
                "failure_class": {
                  "const": "infra"
                },
                "failure_reason": {
                  "const": "service_start_error"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "diagnostic_code": {
                  "const": "readiness_expired"
                }
              }
            },
            "then": {
              "properties": {
                "failure_class": {
                  "const": "infra"
                },
                "failure_reason": {
                  "const": "service_readiness_timeout"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "diagnostic_code": {
                  "const": "capacity_exceeded"
                }
              }
            },
            "then": {
              "properties": {
                "failure_class": {
                  "const": "infra"
                },
                "failure_reason": {
                  "const": "resource_conflict"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "diagnostic_code": {
                  "const": "invalid_artifact"
                }
              }
            },
            "then": {
              "properties": {
                "failure_class": {
                  "const": "artifact"
                },
                "failure_reason": {
                  "const": "artifact_error"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "diagnostic_code": {
                  "const": "unstable_capture"
                }
              }
            },
            "then": {
              "properties": {
                "failure_class": {
                  "const": "artifact"
                },
                "failure_reason": {
                  "const": "artifact_error"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "diagnostic_code": {
                  "const": "observation_limit"
                }
              }
            },
            "then": {
              "properties": {
                "failure_class": {
                  "const": "artifact"
                },
                "failure_reason": {
                  "const": "artifact_error"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "diagnostic_code": {
                  "const": "analysis_failed"
                }
              }
            },
            "then": {
              "properties": {
                "failure_class": {
                  "const": "harness"
                },
                "failure_reason": {
                  "const": "tool_diagnostic_failure"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "diagnostic_code": {
                  "const": "operation_expired"
                }
              }
            },
            "then": {
              "properties": {
                "failure_class": {
                  "const": "timing"
                },
                "failure_reason": {
                  "const": "timeout_failure"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "diagnostic_code": {
                  "const": "session_lost"
                }
              }
            },
            "then": {
              "properties": {
                "failure_class": {
                  "const": "infra"
                },
                "failure_reason": {
                  "const": "service_start_error"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "diagnostic_code": {
                  "const": "unsafe_artifact"
                }
              }
            },
            "then": {
              "properties": {
                "failure_class": {
                  "const": "artifact"
                },
                "failure_reason": {
                  "const": "artifact_error"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "diagnostic_code": {
                  "const": "input_boundary"
                }
              }
            },
            "then": {
              "properties": {
                "failure_class": {
                  "const": "artifact"
                },
                "failure_reason": {
                  "const": "artifact_error"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "diagnostic_code": {
                  "const": "cleanup_failed"
                }
              }
            },
            "then": {
              "properties": {
                "failure_class": {
                  "const": "harness"
                },
                "failure_reason": {
                  "const": "cleanup_error"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "diagnostic_code": {
                  "const": "interrupted"
                }
              }
            },
            "then": {
              "properties": {
                "failure_class": {
                  "const": "interrupted"
                },
                "failure_reason": {
                  "const": "cancelled_or_interrupted"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "diagnostic_code": {
                  "const": "build_failed"
                }
              }
            },
            "then": {
              "properties": {
                "failure_class": {
                  "const": "harness"
                },
                "failure_reason": {
                  "const": "tool_diagnostic_failure"
                },
                "phase": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "diagnostic_code": {
                  "const": "fixture_failed"
                }
              }
            },
            "then": {
              "properties": {
                "failure_class": {
                  "const": "harness"
                },
                "failure_reason": {
                  "const": "fixture_error"
                },
                "phase": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "diagnostic_code": {
                  "const": "diagnostic_invalid"
                }
              }
            },
            "then": {
              "properties": {
                "failure_class": {
                  "const": "harness"
                },
                "failure_reason": {
                  "const": "scheduler_accounting_error"
                },
                "phase": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "diagnostic_code": {
                  "const": "preparation_failed"
                }
              }
            },
            "then": {
              "properties": {
                "failure_class": {
                  "const": "unknown"
                },
                "failure_reason": {
                  "const": "unknown_failure"
                },
                "phase": {
                  "type": "string"
                }
              }
            }
          }
        ]
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "receipt": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\\\u0000]).+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "media_type": {
              "enum": [
                "image/png",
                "application/json",
                "text/html",
                "text/plain",
                "application/zip"
              ]
            }
          },
          "required": [
            "path",
            "sha256",
            "bytes",
            "media_type"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "bundle_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^bundle-[1-9][0-9]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "private_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "bundle",
              "image",
              "observations",
              "report"
            ]
          },
          "absolute_path": {
            "type": "string",
            "pattern": "^/",
            "maxLength": 4096
          }
        },
        "required": [
          "kind",
          "absolute_path"
        ]
      },
      "maxItems": 8
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2,
        3,
        4,
        11,
        12,
        13,
        15,
        130,
        143
      ]
    }
  },
  "required": [
    "schema_id",
    "command_id",
    "session_id",
    "operation_id",
    "state",
    "epoch",
    "status",
    "failures",
    "receipt",
    "bundle_id",
    "private_refs",
    "exit_code"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "failures": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "failures": {
            "minItems": 1
          },
          "private_refs": {
            "maxItems": 0
          }
        }
      }
    }
  ]
