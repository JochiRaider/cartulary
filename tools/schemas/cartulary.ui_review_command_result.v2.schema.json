            "ready",
            "busy",
            "stopping",
            "closed",
            "failed"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "epoch": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "failures": {
