            "if": {
              "properties": {
                "phase": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "phase": {
                  "type": "null"
                },
                "subject_id": {
                  "type": "null"
                },
                "condition": {
                  "type": "null"
                },
                "recovery_id": {
                  "type": "null"
                }
              }
