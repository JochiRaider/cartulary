              "tool_configuration",
              "session_mismatch",
              "target_unavailable",
              "navigation_boundary",
              "environment_unavailable",
              "startup_failed",
              "readiness_expired",
              "capacity_exceeded",
              "invalid_artifact",
              "unstable_capture",
              "observation_limit",
              "analysis_failed",
              "operation_expired",
              "session_lost",
              "unsafe_artifact",
              "input_boundary",
              "cleanup_failed",
              "interrupted",
              "build_failed",
              "fixture_failed",
              "diagnostic_invalid",
              "preparation_failed"
