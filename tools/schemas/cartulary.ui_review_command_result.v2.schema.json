        "cartulary.harness.command.ui_review.v1",
        "cartulary.harness.command.ui_review_status.v1",
        "cartulary.harness.command.ui_browser.v1",
        "cartulary.harness.command.ui_capture.v1",
        "cartulary.harness.command.ui_analyze.v1",
        "cartulary.harness.command.ui_review_report.v1",
        "cartulary.harness.command.ui_review_stop.v1"
      ]
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^uireview-[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation_id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "anyOf": [
        {
          "enum": [
