          "condition": {
            "enum": [
              null,
              "missing",
              "incompatible",
              "stale_installation",
              "invalid_artifact",
              "preflight_failed",
              "child_failed",
              "timeout",
              "resource_conflict",
              "invalid_diagnostic",
              "cancelled",
              "unknown"
            ]
