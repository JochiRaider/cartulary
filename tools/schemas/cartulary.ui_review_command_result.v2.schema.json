      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "failure_class": {
            "enum": [
              "config",
              "infra",
              "harness",
              "artifact",
              "timing",
              "interrupted",
              "unknown"
            ]
          },
          "failure_reason": {
            "enum": [
              "usage_error",
              "configuration_error",
              "tool_diagnostic_failure",
              "preflight_error",
              "service_start_error",
              "service_readiness_timeout",
              "resource_conflict",
              "artifact_error",
              "timeout_failure",
              "cleanup_error",
              "cancelled_or_interrupted",
              "fixture_error",
              "scheduler_accounting_error",
              "unknown_failure"
