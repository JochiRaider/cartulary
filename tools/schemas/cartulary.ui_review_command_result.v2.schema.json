                  "type": "string"
                },
                "condition": {
                  "type": "string"
                },
                "recovery_id": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "diagnostic_code": {
                  "const": "invalid_request"
                }
              }
            },
            "then": {
              "properties": {
                "failure_class": {
                  "const": "config"
                },
                "failure_reason": {
                  "const": "usage_error"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "diagnostic_code": {
                  "const": "tool_configuration"
                }
              }
            },
            "then": {
              "properties": {
                "failure_class": {
                  "const": "config"
                },
                "failure_reason": {
                  "const": "configuration_error"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
