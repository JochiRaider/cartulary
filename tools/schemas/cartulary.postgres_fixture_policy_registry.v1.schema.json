{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.postgres_fixture_policy_registry.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "catalog_schema_id",
    "capability_policies",
    "transaction_row_approvals",
    "group_row_approvals"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.postgres_fixture_policy_registry.v1" },
    "catalog_schema_id": { "const": "cartulary.test_family_manifest.v5" },
    "capability_policies": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "isolation_scope", "rationale", "shared_scope"],
        "properties": {
          "capability": {
            "enum": [
              "postgres_dedicated",
              "postgres_group",
              "postgres_migration",
              "postgres_transaction"
            ]
          },
          "isolation_scope": {
            "enum": ["database", "group", "migration_database", "transaction"]
          },
          "rationale": {
            "enum": [
              "committed_or_unproven_work_requires_unique_database",
              "explicit_compatible_group_with_reset_and_contamination_proof",
              "schema_lifecycle_requires_fresh_database",
              "single_connection_rollback_proven"
            ]
          },
          "shared_scope": { "type": "boolean" }
        }
      }
    },
    "transaction_row_approvals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.]*$"
      }
    },
    "group_row_approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_id",
          "compatibility_key",
          "reset_contract_id",
          "success_contamination_test_id",
          "failure_contamination_test_id"
        ],
        "properties": {
          "row_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$" },
          "compatibility_key": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
          "reset_contract_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
          "success_contamination_test_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
          "failure_contamination_test_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" }
        }
      }
    }
  }
}
