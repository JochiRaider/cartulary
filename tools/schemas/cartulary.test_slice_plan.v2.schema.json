{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.test_slice_plan.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "command_id",
    "target",
    "run_id",
    "owner_id",
    "selected_rows",
    "source_snapshot_digest",
    "catalog_semantic_digest",
    "verification_semantic_digest",
    "runtime_profile_digest",
    "resource_profile_digest",
    "fixture_profile_digest",
    "plan_semantic_digest",
    "scheduler_semantic_digest",
    "started_at",
    "finished_at",
    "duration_ms",
    "source_file_count",
    "selection",
    "workers",
    "unused_inputs",
    "rows",
    "work_units",
    "finalizers",
    "expected_artifacts"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.test_slice_plan.v2" },
    "command_id": { "enum": ["cartulary.harness.command.test_slice.v1", "cartulary.harness.command.service_backed_test_slice.v1"] },
    "target": { "enum": ["test-slice", "service-backed-test-slice"] },
    "run_id": { "$ref": "#/$defs/nonempty" },
    "owner_id": { "$ref": "cartulary.test_family_manifest.v1#/$defs/owner_id" },
    "selected_rows": { "$ref": "#/$defs/row_ids" },
    "source_snapshot_digest": { "$ref": "#/$defs/digest" },
    "catalog_semantic_digest": { "$ref": "#/$defs/digest" },
    "verification_semantic_digest": { "$ref": "#/$defs/digest" },
    "runtime_profile_digest": { "$ref": "#/$defs/digest" },
    "resource_profile_digest": { "$ref": "#/$defs/digest" },
    "fixture_profile_digest": { "$ref": "#/$defs/digest" },
    "plan_semantic_digest": { "$ref": "#/$defs/digest" },
    "scheduler_semantic_digest": { "$ref": "#/$defs/digest" },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "finished_at": { "$ref": "#/$defs/timestamp" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "source_file_count": { "type": "integer", "minimum": 1 },
    "selection": { "$ref": "#/$defs/selection" },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vitest", "playwright"],
      "properties": {
        "vitest": { "type": "integer", "minimum": 1, "maximum": 16 },
        "playwright": { "type": "integer", "minimum": 1, "maximum": 16 }
      }
    },
    "unused_inputs": { "$ref": "#/$defs/unique_strings" },
    "rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/row" } },
    "work_units": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/work_unit" } },
    "finalizers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/finalizer" } },
    "expected_artifacts": { "$ref": "#/$defs/unique_strings" }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1, "maxLength": 500 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "unique_strings": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonempty" } },
    "row_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "cartulary.test_family_manifest.v1#/$defs/row_id" } },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_mode", "owner_id", "dependency_scope", "completion_scope", "requested_row_ids", "resolved_row_ids"],
      "properties": {
        "selection_mode": { "enum": ["default_owner", "exact_rows"] },
        "owner_id": { "$ref": "cartulary.test_family_manifest.v1#/$defs/owner_id" },
        "dependency_scope": { "enum": ["all", "service_backed"] },
        "completion_scope": { "enum": ["full_owner", "selected_subset"] },
        "requested_row_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "cartulary.test_family_manifest.v1#/$defs/row_id" } },
        "resolved_row_ids": { "$ref": "#/$defs/row_ids" }
      }
    },
    "selector": {
      "oneOf": [
        { "$ref": "cartulary.test_family_manifest.v1#/$defs/go_selector" },
        { "$ref": "cartulary.test_family_manifest.v1#/$defs/vitest_selector" },
        { "$ref": "cartulary.test_family_manifest.v1#/$defs/playwright_selector" },
        { "$ref": "cartulary.test_family_manifest.v1#/$defs/shell_selector" }
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_id", "owner_id", "family_id", "verification_ids", "runner", "selector_digest", "evidence_class", "runtime_profile_id", "resource_profile_id", "fixture_profile_id", "default_check", "claim_posture", "target_name", "selector"],
      "properties": {
        "row_id": { "$ref": "cartulary.test_family_manifest.v1#/$defs/row_id" },
        "owner_id": { "$ref": "cartulary.test_family_manifest.v1#/$defs/owner_id" },
        "family_id": { "$ref": "cartulary.test_family_manifest.v1#/$defs/family_id" },
        "verification_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "cartulary.test_family_manifest.v1#/$defs/verification_id" } },
        "runner": { "enum": ["go", "vitest", "playwright", "shell"] },
        "selector_digest": { "$ref": "#/$defs/digest" },
        "evidence_class": { "enum": ["unit", "integration", "browser", "accessibility", "visual", "measurement", "static", "security", "release"] },
        "runtime_profile_id": { "$ref": "#/$defs/nonempty" },
        "resource_profile_id": { "$ref": "#/$defs/nonempty" },
        "fixture_profile_id": { "$ref": "#/$defs/nonempty" },
        "default_check": { "type": "boolean" },
        "claim_posture": { "$ref": "#/$defs/nonempty" },
        "target_name": { "$ref": "#/$defs/nonempty" },
        "selector": { "$ref": "#/$defs/selector" }
      }
    },
    "resource_claims": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 256 }
    },
    "work_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_unit_id", "runner", "target_name", "row_ids", "runtime_profile_id", "resource_profile_id", "fixture_profile_id", "managed_service_ids", "runtime_binary_ids", "resource_claims", "dependencies", "expected_artifacts", "timeout_seconds"],
      "properties": {
        "work_unit_id": { "type": "string", "pattern": "^unit\\.[a-z0-9_]+\\.[0-9a-f]{12}$", "maxLength": 96 },
        "runner": { "enum": ["go", "vitest", "playwright", "shell"] },
        "target_name": { "$ref": "#/$defs/nonempty" },
        "row_ids": { "$ref": "#/$defs/row_ids" },
        "runtime_profile_id": { "$ref": "#/$defs/nonempty" },
        "resource_profile_id": { "$ref": "#/$defs/nonempty" },
        "fixture_profile_id": { "$ref": "#/$defs/nonempty" },
        "managed_service_ids": { "$ref": "#/$defs/unique_strings" },
        "runtime_binary_ids": { "$ref": "#/$defs/unique_strings" },
        "resource_claims": { "$ref": "#/$defs/resource_claims" },
        "dependencies": { "$ref": "#/$defs/unique_strings" },
        "expected_artifacts": { "$ref": "#/$defs/unique_strings" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    "finalizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finalizer_id", "kind", "dependencies"],
      "properties": {
        "finalizer_id": { "type": "string", "pattern": "^finalizer\\.[a-z][a-z0-9_]*$" },
        "kind": { "const": "cleanup" },
        "dependencies": { "$ref": "#/$defs/unique_strings" }
      }
    }
  }
}
