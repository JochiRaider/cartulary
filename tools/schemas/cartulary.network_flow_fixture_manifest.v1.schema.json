{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.network_flow_fixture_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "manifest_version",
    "fixture_id",
    "profile_id",
    "freeze",
    "owner_refs",
    "source_files",
    "expected_artifacts",
    "transcript_files",
    "acceptance_ids",
    "execution_selectors",
    "source_bundle_sha256",
    "expected_bundle_sha256"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.network_flow_fixture_manifest.v1" },
    "manifest_version": { "type": "integer", "minimum": 1 },
    "fixture_id": { "$ref": "#/$defs/network_flow_fixture_id" },
    "profile_id": { "const": "network_flow_activity" },
    "freeze": { "$ref": "#/$defs/freeze" },
    "owner_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/owner_ref" }
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source_file" }
    },
    "expected_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/expected_artifact" }
    },
    "transcript_files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/transcript_file" }
    },
    "acceptance_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^NF-AC-[0-9]{3}$" }
    },
    "execution_selectors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[A-Za-z0-9_.:/#-]+$"
      }
    },
    "source_bundle_sha256": { "$ref": "#/$defs/sha256" },
    "expected_bundle_sha256": { "$ref": "#/$defs/sha256" },
    "extensions": { "$ref": "cartulary.harness.defs.v1#/$defs/extensions" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "network_flow_fixture_id": {
      "type": "string",
      "pattern": "^NF-FIX-[0-9]{3}-[a-z0-9][a-z0-9-]*$"
    },
    "manifest_relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._@+-]+(?:/[A-Za-z0-9._@+-]+)*$"
    },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "revision", "change_policy"],
      "properties": {
        "status": { "enum": ["draft", "frozen"] },
        "revision": { "type": "integer", "minimum": 1 },
        "change_policy": { "const": "new_fixture_revision_required" }
      }
    },
    "owner_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "requirement_ids", "acceptance_ids"],
      "properties": {
        "document": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9._@+-]+(?:/[A-Za-z0-9._@+-]+)*\\.md$"
        },
        "requirement_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "acceptance_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    },
    "file_base": {
      "type": "object",
      "required": ["logical_path", "media_type", "size_bytes", "sha256"],
      "properties": {
        "logical_path": { "$ref": "#/$defs/manifest_relative_path" },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 120 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "source_file": {
      "allOf": [
        { "$ref": "#/$defs/file_base" },
        {
          "type": "object",
          "required": ["role", "newline_policy"],
          "properties": {
            "role": {
              "enum": ["input", "mapping", "seed", "config", "support"]
            },
            "newline_policy": {
              "enum": ["byte_exact", "lf_required", "not_text"]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "expected_artifact": {
      "allOf": [
        { "$ref": "#/$defs/file_base" },
        {
          "type": "object",
          "required": ["role"],
          "properties": {
            "role": {
              "enum": [
                "expected_rows",
                "expected_diagnostics",
                "expected_graph",
                "expected_contributors",
                "expected_indicator_links",
                "expected_audit",
                "expected_error",
                "expected_response",
                "mapping",
                "support"
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "transcript_file": {
      "allOf": [
        { "$ref": "#/$defs/file_base" },
        {
          "type": "object",
          "required": ["transcript_kind"],
          "properties": {
            "transcript_kind": {
              "enum": [
                "preview",
                "apply",
                "query",
                "graph",
                "contributors",
                "indicator_link",
                "audit",
                "retention",
                "cursor",
                "error",
                "fixture_validation"
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
