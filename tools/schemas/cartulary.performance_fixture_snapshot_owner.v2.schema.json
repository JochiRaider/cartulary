{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.performance_fixture_snapshot_owner.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "profiles"],
  "properties": {
    "schema_id": { "const": "cartulary.performance_fixture_snapshot_owner.v2" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "schema_id": {
      "type": "string",
      "pattern": "^cartulary\\.[a-z0-9_.]+\\.v[1-9][0-9]*$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*_v[1-9][0-9]*$"
    },
    "stable_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]*$"
    },
    "count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count_id", "exact"],
      "properties": {
        "count_id": { "$ref": "#/$defs/stable_id" },
        "exact": { "type": "integer", "minimum": 0 }
      }
    },
    "semantic_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectation_id", "exact"],
      "properties": {
        "expectation_id": { "$ref": "#/$defs/stable_id" },
        "exact": { "type": "integer", "minimum": 0 }
      }
    },
    "semantic_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectation_id", "required"],
      "properties": {
        "expectation_id": { "$ref": "#/$defs/stable_id" },
        "required": { "type": "boolean" }
      }
    },
    "contract_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema_id", "contract_id"],
      "properties": {
        "path": { "$ref": "cartulary.test_catalog_defs.v1#/$defs/repo_path" },
        "schema_id": { "$ref": "#/$defs/schema_id" },
        "contract_id": { "$ref": "#/$defs/schema_id" }
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contribution_id",
        "owner_id",
        "version",
        "dependencies",
        "source_contract_ids",
        "expected_receipt_counts"
      ],
      "properties": {
        "contribution_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.v[1-9][0-9]*$"
        },
        "owner_id": { "$ref": "cartulary.test_catalog_defs.v1#/$defs/owner_id" },
        "version": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]+\\.v[1-9][0-9]*$"
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.v[1-9][0-9]*$"
          }
        },
        "source_contract_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/schema_id" }
        },
        "expected_receipt_counts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/count" }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification_id", "predicate_id"],
      "properties": {
        "verification_id": { "$ref": "cartulary.test_catalog_defs.v1#/$defs/verification_id" },
        "predicate_id": {
          "type": "string",
          "pattern": "^perf\\.[a-z0-9_.]+\\.v[1-9][0-9]*$"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_profile_id",
        "status",
        "fixture_version",
        "seed",
        "compatibility",
        "verification_bindings",
        "source_contract_refs",
        "contributions",
        "semantic_expectations",
        "runtime_credential_sets",
        "cleanup_policy",
        "artifact_policy",
        "redaction_policy"
      ],
      "properties": {
        "fixture_profile_id": { "$ref": "#/$defs/profile_id" },
        "status": { "enum": ["active", "inactive"] },
        "fixture_version": { "$ref": "#/$defs/schema_id" },
        "seed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runner",
            "evidence_class",
            "selector_stage",
            "runtime_profile_id",
            "resource_profile_id",
            "fixture_capability",
            "service_dependencies"
          ],
          "properties": {
            "runner": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "evidence_class": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "selector_stage": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "runtime_profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "resource_profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "fixture_capability": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "service_dependencies": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
            }
          }
        },
        "verification_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/binding" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/contract_ref" }
        },
        "contributions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/contribution" }
        },
        "semantic_expectations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["counts", "conditions"],
          "properties": {
            "counts": {
              "type": "array",
              "items": { "$ref": "#/$defs/semantic_count" }
            },
            "conditions": {
              "type": "array",
              "items": { "$ref": "#/$defs/semantic_condition" }
            }
          }
        },
        "runtime_credential_sets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["set_id", "credential_kind", "account_count"],
            "properties": {
              "set_id": { "$ref": "#/$defs/stable_id" },
              "credential_kind": { "enum": ["email_password"] },
              "account_count": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "cleanup_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["template_owner", "clone_owner", "bucket_owner", "active_cleanup", "janitor_fallback"],
          "properties": {
            "template_owner": { "enum": ["suite"] },
            "clone_owner": { "enum": ["predicate_lease"] },
            "bucket_owner": { "enum": ["predicate_lease"] },
            "active_cleanup": { "type": "boolean" },
            "janitor_fallback": { "enum": ["lease_scoped_bounded", "none"] }
          }
        },
        "artifact_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "snapshot_key_schema_id",
            "build_schema_id",
            "lease_schema_id",
            "runtime_schema_id",
            "observation_schema_id",
            "summary_schema_id",
            "aggregate_schema_id"
          ],
          "properties": {
            "snapshot_key_schema_id": { "$ref": "#/$defs/schema_id" },
            "build_schema_id": { "$ref": "#/$defs/schema_id" },
            "lease_schema_id": { "$ref": "#/$defs/schema_id" },
            "runtime_schema_id": { "$ref": "#/$defs/schema_id" },
            "observation_schema_id": { "$ref": "#/$defs/schema_id" },
            "summary_schema_id": { "$ref": "#/$defs/schema_id" },
            "aggregate_schema_id": { "$ref": "#/$defs/schema_id" }
          }
        },
        "redaction_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy_id", "forbidden_fields"],
          "properties": {
            "policy_id": { "$ref": "#/$defs/schema_id" },
            "forbidden_fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/stable_id" }
            }
          }
        }
      }
    }
  }
}
