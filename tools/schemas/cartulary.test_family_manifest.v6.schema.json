{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.test_family_manifest.v6",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "owner_id", "rows"],
  "properties": {
    "schema_id": { "const": "cartulary.test_family_manifest.v6" },
    "owner_id": { "$ref": "cartulary.test_catalog_defs.v1#/$defs/owner_id" },
    "rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/row" } }
  },
  "$defs": {
    "go_selector": {
      "type": "object", "additionalProperties": false, "required": ["package", "tests"],
      "properties": { "package": { "type": "string", "pattern": "^(?:\\./(?:internal|cmd)/[A-Za-z0-9._@+/-]+|\\./tools/testservices)$" }, "tests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^Test[A-Za-z0-9_]+$" } } }
    },
    "vitest_selector": {
      "type": "object", "additionalProperties": false, "required": ["file", "titles"],
      "properties": { "file": { "$ref": "cartulary.test_catalog_defs.v1#/$defs/repo_path" }, "titles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } } }
    },
    "playwright_selector": {
      "type": "object", "additionalProperties": false, "required": ["file", "project_id", "stage", "scenario_ids", "titles"],
      "properties": {
        "file": { "$ref": "cartulary.test_catalog_defs.v1#/$defs/repo_path" }, "project_id": { "$ref": "cartulary.test_catalog_defs.v1#/$defs/segment" },
        "stage": { "enum": ["webserver_backed", "stateful", "support", "visual", "accessibility", "measurement"] },
        "scenario_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "cartulary.test_catalog_defs.v1#/$defs/segment" } },
        "titles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      }
    },
    "shell_selector": {
      "type": "object", "additionalProperties": false, "required": ["command_id"],
      "properties": { "command_id": { "type": "string", "pattern": "^cartulary\\.harness\\.command\\.[a-z][a-z0-9_]*\\.v[1-9][0-9]*$" } }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_id", "owner_id", "family_id", "collaborator_ids", "verification_ids", "runner", "selector", "evidence_class", "runtime_profile_id", "resource_profile_id", "fixture_capability", "service_dependencies", "minimum_tier", "claim_posture", "status"],
      "properties": {
        "row_id": { "$ref": "cartulary.test_catalog_defs.v1#/$defs/row_id" }, "owner_id": { "$ref": "cartulary.test_catalog_defs.v1#/$defs/owner_id" }, "family_id": { "$ref": "cartulary.test_catalog_defs.v1#/$defs/family_id" },
        "collaborator_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "cartulary.test_catalog_defs.v1#/$defs/owner_id" } },
        "verification_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "cartulary.test_catalog_defs.v1#/$defs/verification_id" } },
        "runner": { "enum": ["go", "vitest", "playwright", "shell"] },
        "selector": { "oneOf": [{ "$ref": "#/$defs/go_selector" }, { "$ref": "#/$defs/vitest_selector" }, { "$ref": "#/$defs/playwright_selector" }, { "$ref": "#/$defs/shell_selector" }] },
        "evidence_class": { "enum": ["unit", "integration", "browser", "accessibility", "visual", "measurement", "static", "security", "release"] },
        "runtime_profile_id": { "enum": ["none", "default", "network_flow_claimed"] },
        "resource_profile_id": { "enum": ["backend_capacity_isolated", "browser_functional", "browser_isolated", "browser_measurement_quiet", "io_heavy", "managed_process", "performance_fixture_builder", "postgres_catalog_isolated", "standard"] },
        "fixture_capability": { "enum": ["none", "postgres_transaction", "postgres_dedicated", "postgres_migration", "object_store_namespace", "managed_process", "browser_stack"] },
        "fixture_profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*_v[1-9][0-9]*$" },
        "process_isolation": { "const": "exclusive" },
        "service_dependencies": { "$ref": "cartulary.test_catalog_defs.v1#/$defs/service_dependencies" },
        "minimum_tier": { "enum": ["fast", "standard", "full", "release"] },
        "claim_posture": { "type": "string", "pattern": "^(?:implementation|informative|claim\\.[a-z][a-z0-9_]{0,62})$" },
        "status": { "const": "active" }
      }
    }
  }
}
