{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.verification_registry.v2",
  "title": "Cartulary verification registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "owners"],
  "properties": {
    "schema_id": { "const": "cartulary.verification_registry.v2" },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner_id", "contract_path", "status"],
        "properties": {
          "owner_id": { "$ref": "#/$defs/ownerId" },
          "contract_path": { "type": "string", "pattern": "^contracts/verification/owners/[a-z][a-z0-9_.-]*\\.json$" },
          "status": { "const": "active" },
          "display_name": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "ownerId": { "type": "string", "pattern": "^(?:module|platform|app|web|package|harness)\\.(?!phase[0-9]+$|fe_p[0-9]+$)[a-z][a-z0-9_]{0,62}$", "maxLength": 191 }
  }
}
