{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.postgres_readiness_diagnostic.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "stage",
    "outcome",
    "elapsed_ms",
    "sql_window_ms",
    "poll_ms",
    "probe_cap_ms",
    "probe_count",
    "cleanup_outcome",
    "container_state",
    "phases"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.postgres_readiness_diagnostic.v1"
    },
    "stage": {
      "enum": [
        "container_start",
        "endpoint_resolution",
        "sql_connectivity",
        "security_capability",
        "generation_initialization"
      ]
    },
    "outcome": {
      "enum": [
        "unavailable",
        "cancelled",
        "authentication_rejected",
        "capability_rejected",
        "deadline_expired",
        "transport_unreachable",
        "initialization_failed",
        "ready"
      ]
    },
    "elapsed_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600000
    },
    "sql_window_ms": {
      "const": 15000
    },
    "poll_ms": {
      "const": 250
    },
    "probe_cap_ms": {
      "const": 5000
    },
    "probe_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "cleanup_outcome": {
      "enum": [
        "completed",
        "unresolved",
        "not_needed"
      ]
    },
    "container_state": {
      "enum": [
        "unavailable",
        "created",
        "running",
        "exited",
        "dead"
      ]
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "outcome",
          "configured_ms",
          "effective_ms",
          "limiting_deadline",
          "elapsed_ms"
        ],
        "properties": {
          "stage": {
            "enum": [
              "container_start",
              "endpoint_resolution",
              "sql_connectivity",
        "security_capability",
              "generation_initialization"
            ]
          },
          "outcome": {
            "enum": [
              "ready",
              "unavailable",
              "cancelled",
              "authentication_rejected",
              "capability_rejected",
              "deadline_expired",
              "transport_unreachable",
              "initialization_failed"
            ]
          },
          "configured_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 600000
          },
          "effective_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 600000
          },
          "limiting_deadline": {
            "enum": [
              "phase",
              "parent",
              "none"
            ]
          },
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 600000
          }
        }
      }
    }
  }
}
