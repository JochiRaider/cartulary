{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_contract_case_ledger.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "baseline_case_count", "current_case_count", "entries"],
  "properties": {
    "schema_id": { "const": "cartulary.harness_contract_case_ledger.v1" },
    "baseline_case_count": { "const": 104 },
    "current_case_count": { "const": 122 },
    "entries": {
      "type": "array",
      "minItems": 122,
      "maxItems": 122,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["legacy_ordinal", "legacy_name", "current_name", "disposition", "suite"],
        "properties": {
          "legacy_ordinal": { "type": "integer", "minimum": 1, "maximum": 122 },
          "legacy_name": { "type": "string", "minLength": 1 },
          "current_name": { "type": "string", "minLength": 1 },
          "disposition": { "enum": ["retained", "replaced"] },
          "suite": { "enum": ["graph", "evidence", "scheduler", "command_surface", "boundaries"] }
        }
      }
    }
  }
}
