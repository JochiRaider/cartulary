{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.task_surface_owner.v1",
  "title": "Cartulary authored task-surface owner",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "observability_policy",
    "compact_help",
    "help_tiers",
    "sequences",
    "make_recipes",
    "targets",
    "harness_tiers",
    "harness_checks"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.task_surface_owner.v1" },
    "observability_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "required_targets",
        "excluded_targets",
        "out_of_scope_targets",
        "measurement_profiles",
        "target_measurement_profiles"
      ],
      "properties": {
        "scope": { "const": "cartulary.harness.execution" },
        "required_targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" }
        },
        "excluded_targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "owner_section", "reason"],
            "properties": {
              "target": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
              "owner_section": { "type": "string", "pattern": "^Section [0-9]+(?:\\.[0-9]+)?$" },
              "reason": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        },
        "out_of_scope_targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "owner_section", "reason"],
            "properties": {
              "target": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
              "owner_section": { "type": "string", "pattern": "^Section [0-9]+(?:\\.[0-9]+)?$" },
              "reason": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        },
        "measurement_profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profile_id",
              "canonical_inputs",
              "observation_eligibility",
              "warm_up_policy",
              "performance_gates"
            ],
            "properties": {
              "profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "canonical_inputs": {
                "type": "object",
                "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
                "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 256 }
              },
              "observation_eligibility": {
                "enum": ["direct_only", "direct_or_aggregate_exact_once"]
              },
              "warm_up_policy": { "const": "one_discarded_then_two_consecutive" },
              "performance_gates": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "wall_no_regression",
                    "backend_unit_wall_improvement",
                    "backend_finalization_union_improvement",
                    "release_browser_readiness_wall_improvement",
                    "release_check_wall_improvement"
                  ]
                }
              },
              "allowed_policy_transition": {
                "enum": ["backend_grouped_capture_and_parallel_report_emission", "browser_stack_capacity_1_to_2", "serial_to_topology_dag"]
              }
            }
          }
        },
        "target_measurement_profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "profile_id"],
            "properties": {
              "target": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
              "profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "allowed_policy_transition": {
                "enum": ["browser_webserver_stage_capacity_1_to_2"]
              }
            }
          }
        }
      }
    },
    "compact_help": { "type": "object" },
    "help_tiers": { "type": "array" },
    "sequences": { "type": "object" },
    "make_recipes": { "type": "object" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "harness_tiers": { "type": "object" },
    "harness_checks": { "type": "array" }
  }
}
