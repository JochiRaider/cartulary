{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_instrumentation_qualification_plan.v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "seed",
    "reader_counts",
    "modes",
    "reader_cadence_ms",
    "memory_cadence_ms",
    "steady_fraction",
    "cold_observations",
    "warmup_observations",
    "measured_blocks",
    "maximum_measured_blocks",
    "budgets",
    "workloads",
    "preparation"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.harness_instrumentation_qualification_plan.v3"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "reader_counts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          0,
          1,
          4
        ],
        "type": "integer"
      }
    },
    "modes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "off",
          "basic"
        ],
        "type": "string"
      }
    },
    "reader_cadence_ms": {
      "type": "integer",
      "minimum": 1
    },
    "memory_cadence_ms": {
      "type": "integer",
      "minimum": 1
    },
    "steady_fraction": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "cold_observations": {
      "type": "integer",
      "minimum": 1
    },
    "warmup_observations": {
      "type": "integer",
      "minimum": 1
    },
    "measured_blocks": {
      "type": "integer",
      "minimum": 1
    },
    "maximum_measured_blocks": {
      "type": "integer",
      "minimum": 1
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elapsed_median_percent",
        "elapsed_p90_percent",
        "cpu_mean_percent_one_core",
        "steady_rss_bytes",
        "finalization_ms"
      ],
      "properties": {
        "elapsed_median_percent": {
          "type": "number",
          "minimum": 0
        },
        "elapsed_p90_percent": {
          "type": "number",
          "minimum": 0
        },
        "cpu_mean_percent_one_core": {
          "type": "number",
          "minimum": 0
        },
        "steady_rss_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "finalization_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "workloads": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target",
          "owner",
          "rows"
        ],
        "properties": {
          "id": {
            "enum": [
              "go",
              "vitest",
              "shell",
              "service",
              "browser"
            ]
          },
          "target": {
            "enum": [
              "test-slice",
              "service-backed-test-slice"
            ]
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]{0,127}$"
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.]{0,255}$"
            }
          }
        }
      }
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cold_cache_mode",
        "measured_cache_mode",
        "build_cache",
        "service_reuse",
        "reader_start",
        "missed_reader_intervals",
        "treatment_order"
      ],
      "properties": {
        "cold_cache_mode": {
          "const": "cold"
        },
        "measured_cache_mode": {
          "const": "off"
        },
        "build_cache": {
          "const": "warm_after_discarded_warmup"
        },
        "service_reuse": {
          "const": "fresh_managed_session_per_invocation"
        },
        "reader_start": {
          "const": "initial_publication"
        },
        "missed_reader_intervals": {
          "const": "skip"
        },
        "treatment_order": {
          "const": "seeded_shuffle_per_matched_block"
        }
      }
    }
  }
}
