{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.incident_bundle_v1_retirement_attestation.v1",
  "title": "Cartulary Incident Bundle v1 retirement attestation input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "cutoff_date",
    "compatibility_snapshot",
    "releases",
    "telemetry",
    "inventory"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.incident_bundle_v1_retirement_attestation.v1" },
    "cutoff_date": { "$ref": "#/$defs/date" },
    "compatibility_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_digest",
        "adopting_release_identity",
        "deprecation_started_on",
        "minimum_stable_releases",
        "minimum_retention_days"
      ],
      "properties": {
        "snapshot_digest": { "$ref": "#/$defs/digest" },
        "adopting_release_identity": { "$ref": "#/$defs/releaseIdentity" },
        "deprecation_started_on": { "$ref": "#/$defs/date" },
        "minimum_stable_releases": { "const": 3 },
        "minimum_retention_days": { "const": 180 }
      }
    },
    "releases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/releaseEvidence" }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_identity",
        "interval_start",
        "interval_end",
        "interval_days",
        "missing_intervals",
        "successful_v1_imports",
        "complete",
        "evidence_digest"
      ],
      "properties": {
        "metric_identity": { "const": "cartulary.incident_bundle.v1_import" },
        "interval_start": { "$ref": "#/$defs/date" },
        "interval_end": { "$ref": "#/$defs/date" },
        "interval_days": { "const": 30 },
        "missing_intervals": { "const": 0 },
        "successful_v1_imports": { "const": 0 },
        "complete": { "const": true },
        "evidence_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutoff_date",
        "inventory_classes_expected",
        "inventory_classes_covered",
        "supported_archives",
        "v1_required_archives",
        "complete",
        "evidence_digest"
      ],
      "properties": {
        "cutoff_date": { "$ref": "#/$defs/date" },
        "inventory_classes_expected": { "type": "integer", "minimum": 1 },
        "inventory_classes_covered": { "type": "integer", "minimum": 1 },
        "supported_archives": { "type": "integer", "minimum": 0 },
        "v1_required_archives": { "const": 0 },
        "complete": { "const": true },
        "evidence_digest": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "releaseIdentity": {
      "type": "string",
      "pattern": "^v?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "maxLength": 64
    },
    "releaseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "release_identity",
        "published_on",
        "stable",
        "bundle_version",
        "run_manifest_digest",
        "run_summary_digest",
        "target_summary_digest",
        "source_digest",
        "publication_evidence_digest"
      ],
      "properties": {
        "role": { "enum": ["adopting", "subsequent_1", "subsequent_2"] },
        "release_identity": { "$ref": "#/$defs/releaseIdentity" },
        "published_on": { "$ref": "#/$defs/date" },
        "stable": { "const": true },
        "bundle_version": { "const": 2 },
        "run_manifest_digest": { "$ref": "#/$defs/digest" },
        "run_summary_digest": { "$ref": "#/$defs/digest" },
        "target_summary_digest": { "$ref": "#/$defs/digest" },
        "source_digest": { "$ref": "#/$defs/digest" },
        "publication_evidence_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
