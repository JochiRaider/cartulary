{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.agent_finalize_summary.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "target",
    "status",
    "result_root",
    "run_id",
    "run_root",
    "output_mode",
    "results_dir",
    "results_dir_status",
    "started_at",
    "completed_at",
    "duration_ms",
    "generated",
    "duration",
    "run_checks",
    "updated_files",
    "actions",
    "failures",
    "child_artifacts"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.agent_finalize_summary.v2" },
    "target": { "const": "agent-finalize" },
    "status": { "enum": ["pass", "fail"] },
    "result_root": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "run_root": { "type": "string", "minLength": 1 },
    "output_mode": { "enum": ["quiet", "summary", "ci", "verbose", "debug", "machine"] },
    "results_dir": { "type": ["string", "null"] },
    "results_dir_status": { "enum": ["skipped", "valid", "invalid"] },
    "started_at": { "type": "string", "minLength": 1, "format": "date-time" },
    "completed_at": { "type": "string", "minLength": 1, "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "updated_file_count"],
      "properties": {
        "status": { "enum": ["unchanged", "updated", "unknown"] },
        "updated_file_count": { "type": "integer", "minimum": 0 }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "refreshed", "checked"],
      "properties": {
        "status": { "enum": ["skipped", "refreshed", "failed"] },
        "refreshed": { "type": "boolean" },
        "checked": { "type": "boolean" }
      }
    },
    "run_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checked"],
      "properties": {
        "status": { "enum": ["skipped", "pass", "fail"] },
        "checked": { "type": "boolean" }
      }
    },
    "updated_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "failures": {
      "type": "array",
      "items": { "$ref": "#/$defs/failure" }
    },
    "child_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "description",
        "requires_results_dir",
        "mutating",
        "status",
        "started_at",
        "completed_at",
        "duration_ms",
        "skipped_reason",
        "substeps"
      ],
      "properties": {
        "action_id": {
          "enum": [
            "structure_ledger_refresh",
            "schema_shape_validation",
            "duration_baseline_refresh",
            "duration_baseline_coverage",
            "duration_baseline_drift_validation",
            "scheduler_drift_validation"
          ]
        },
        "description": { "type": "string", "minLength": 1 },
        "requires_results_dir": { "type": "boolean" },
        "mutating": { "type": "boolean" },
        "status": { "enum": ["pending", "skipped", "pass", "fail"] },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "skipped_reason": { "type": ["string", "null"] },
        "substeps": {
          "type": "array",
          "items": { "$ref": "#/$defs/substep" }
        }
      }
    },
    "substep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "command_kind",
        "requires_results_dir",
        "mutates_repo",
        "status",
        "started_at",
        "completed_at",
        "duration_ms",
        "exit_code",
        "summary_json",
        "stdout_log",
        "stderr_log",
        "skipped_reason"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "target": { "type": ["string", "null"] },
        "command_kind": { "enum": ["make_target", "retained_run_preflight"] },
        "requires_results_dir": { "type": "boolean" },
        "mutates_repo": { "type": "boolean" },
        "status": { "enum": ["pending", "skipped", "pass", "fail"] },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "exit_code": { "type": ["integer", "null"] },
        "summary_json": { "type": ["string", "null"] },
        "stdout_log": { "type": ["string", "null"] },
        "stderr_log": { "type": ["string", "null"] },
        "skipped_reason": { "type": ["string", "null"] }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "substep_id",
        "target",
        "failure_class",
        "failure_reason",
        "headline",
        "summary_json"
      ],
      "properties": {
        "action_id": {
          "enum": [
            "structure_ledger_refresh",
            "schema_shape_validation",
            "duration_baseline_refresh",
            "duration_baseline_coverage",
            "duration_baseline_drift_validation",
            "scheduler_drift_validation"
          ]
        },
        "substep_id": { "type": ["string", "null"], "minLength": 1 },
        "target": { "type": ["string", "null"] },
        "failure_class": {
          "enum": ["product", "config", "infra", "harness", "artifact", "timing", "interrupted", "unknown"]
        },
        "failure_reason": {
          "enum": [
            "usage_error",
            "configuration_error",
            "preflight_error",
            "service_start_error",
            "service_readiness_timeout",
            "fixture_error",
            "resource_conflict",
            "test_assertion_failure",
            "child_target_failure",
            "scheduler_accounting_error",
            "artifact_error",
            "cleanup_error",
            "duration_baseline_drift",
            "timeout_failure",
            "cancelled_or_interrupted",
            "unknown_failure"
          ]
        },
        "headline": { "type": "string", "minLength": 1 },
        "summary_json": { "type": ["string", "null"] }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "kind", "path"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    }
  }
}
