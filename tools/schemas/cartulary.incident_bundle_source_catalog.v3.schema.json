{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.incident_bundle_source_catalog.v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "contract_major", "families", "special_consumers"],
  "properties": {
    "schema_id": { "const": "cartulary.incident_bundle_source_catalog.v3" },
    "contract_major": { "const": 1 },
    "families": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": { "$ref": "#/$defs/family" }
    },
    "special_consumers": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/special_consumer" }
    }
  },
  "$defs": {
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_path", "content_role", "versions", "stable_identity", "stable_identity_invariant_id"],
      "properties": {
        "logical_path": { "type": "string", "minLength": 1 },
        "content_role": { "enum": ["singleton_json", "source_rows", "validation_rows"] },
        "schema_id": { "type": "string", "pattern": "^cartulary\\.[A-Za-z0-9_.-]+\\.v[1-9][0-9]*$" },
        "versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "const": 2 }
        },
        "stable_identity": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "stable_identity_invariant_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "owner_id", "owner_relation_ids", "dependencies", "paths", "invariant_ids"],
      "properties": {
        "family_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "owner_id": { "type": "string", "minLength": 1 },
        "owner_relation_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "paths": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/path" } },
        "invariant_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" } }
      }
    },
    "special_consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "owner_id", "logical_path", "versions", "invariant_ids"],
      "properties": {
        "family_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "owner_id": { "type": "string", "minLength": 1 },
        "logical_path": { "type": "string", "minLength": 1 },
        "versions": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "const": 2 } },
        "invariant_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" } }
      }
    }
  }
}
