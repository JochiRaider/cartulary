{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.verification_contract.v1",
  "title": "Cartulary verification contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "owner_id", "verifications"],
  "properties": {
    "schema_id": { "const": "cartulary.verification_contract.v1" },
    "owner_id": { "$ref": "#/$defs/ownerId" },
    "verifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["verification_id", "behavior_class", "profile", "requirement", "evidence_kinds", "status"],
        "properties": {
          "verification_id": { "$ref": "#/$defs/verificationId" },
          "behavior_class": { "enum": ["product", "security", "architecture", "build", "harness", "claim_publication"] },
          "profile": { "type": "string", "pattern": "^(?:base|support|extension\\.[a-z][a-z0-9_]{0,62}|claim\\.[a-z][a-z0-9_]{0,62})$" },
          "requirement": { "type": "string", "minLength": 1 },
          "evidence_kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["go_test", "vitest", "playwright", "shell", "static_check", "artifact_audit", "release_check"] }
          },
          "public_target": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "status": { "const": "active" },
          "documentation_refs": { "$ref": "#/$defs/strings" }
        }
      }
    }
  },
  "$defs": {
    "ownerId": { "type": "string", "pattern": "^(?:module|platform|app|web|package|harness)\\.[a-z][a-z0-9_]{0,62}$", "maxLength": 191 },
    "verificationId": { "type": "string", "pattern": "^(?:module|platform|app|web|package|harness)\\.[a-z][a-z0-9_]{0,62}\\.verification\\.[a-z][a-z0-9_]{0,62}$", "maxLength": 191 },
    "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
