{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_cache_registry.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "profiles"],
  "properties": {
    "schema_id": { "const": "cartulary.harness_cache_registry.v1" },
    "profiles": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["profile_id", "policy", "targets", "input_roots", "requires_vulnerability_database_revision"],
        "properties": {
          "profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
          "policy": { "enum": ["same_run", "content_addressed"] },
          "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
          "input_roots": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._@+/-]+$" } },
          "requires_vulnerability_database_revision": { "type": "boolean" }
        }
      }
    }
  }
}
