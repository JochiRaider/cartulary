{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.frontend_visual_fixture_registry.v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "owner_id", "verification_id", "fixtures"],
  "properties": {
    "schema_id": { "const": "cartulary.frontend_visual_fixture_registry.v3" },
    "owner_id": { "const": "harness.visual" },
    "verification_id": { "const": "harness.visual.verification.stable_fixture_identity" },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fixture" }
    }
  },
  "$defs": {
    "capture_scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "full_viewport" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "selector"],
          "properties": {
            "kind": { "const": "selector" },
            "selector": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "x", "y", "width", "height"],
          "properties": {
            "kind": { "const": "region" },
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ]
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "fixture_title",
        "status",
        "owner_phase_ids",
        "owner_row_ids",
        "playwright_scenario_title",
        "golden_filename",
        "golden_artifacts",
        "seed_id",
        "viewport_css_px",
        "device_scale_factor",
        "browser_zoom_percent",
        "theme_id",
        "density_id",
        "scroll_normalization",
        "capture_scope",
        "focus_state",
        "editor_state",
        "inspector_state",
        "dynamic_masks",
        "no_dynamic_regions",
        "blocked_reason",
        "replacement_fixture_id"
      ],
      "properties": {
        "fixture_id": { "pattern": "^FE-VFIX-(?:0[1-9]|[1-9][0-9]+)$", "type": "string" },
        "fixture_title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["current", "missing", "retired"] },
        "owner_phase_ids": {
          "type": "array",
          "items": { "pattern": "^FE-P(?:0|[1-9][0-9]*)$", "type": "string" },
          "uniqueItems": true
        },
        "owner_row_ids": {
          "type": "array",
          "items": { "pattern": "^FE-V-P(?:0|[1-9][0-9]*)-[0-9]{2}$", "type": "string" },
          "uniqueItems": true
        },
        "playwright_scenario_title": { "type": "string" },
        "golden_filename": { "type": "string" },
        "golden_artifacts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "seed_id": { "type": "string" },
        "viewport_css_px": { "type": "string", "pattern": "^[0-9]+x[0-9]+$" },
        "device_scale_factor": { "type": "integer", "minimum": 1 },
        "browser_zoom_percent": { "type": "integer", "minimum": 1 },
        "theme_id": { "type": "string", "minLength": 1 },
        "density_id": { "type": "string", "minLength": 1 },
        "scroll_normalization": { "type": "object" },
        "capture_scope": { "$ref": "#/$defs/capture_scope" },
        "focus_state": { "type": "object" },
        "editor_state": { "type": "object" },
        "inspector_state": { "type": "object" },
        "dynamic_masks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "no_dynamic_regions": { "type": "boolean" },
        "blocked_reason": { "type": "string" },
        "replacement_fixture_id": { "type": "string" }
      }
    }
  }
}
