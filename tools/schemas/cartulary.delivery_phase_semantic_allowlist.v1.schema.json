{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.delivery_phase_semantic_allowlist.v1",
  "title": "Cartulary delivery phase semantic allowlist v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "allowlist"],
  "properties": {
    "schema_id": { "const": "cartulary.delivery_phase_semantic_allowlist.v1" },
    "allowlist": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["location", "locator_kind", "locator", "classification", "owner_id", "reason"],
        "properties": {
          "location": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "locator_kind": { "enum": ["path_component", "filename", "symbol", "title", "selector", "variable", "schema_id", "artifact_name", "target_id"] },
          "locator": { "type": "string", "minLength": 1, "maxLength": 256 },
          "classification": { "enum": ["product_phase", "execution_step"] },
          "owner_id": { "type": "string", "pattern": "^(?:module|platform|app|web|package|harness)\\.[a-z][a-z0-9_]{0,62}$" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
