{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.test_services.scope.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "target",
    "suite_id",
    "run_id",
    "artifact_dir",
    "wrapper",
    "preflight",
    "cleanup",
    "postgres",
    "object_store",
    "browser_e2e",
    "fixture",
    "started_services"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.test_services.scope.v1" },
    "target": { "type": "string", "minLength": 1 },
    "suite_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "artifact_dir": { "type": "string", "minLength": 1 },
    "wrapper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owned_count", "pass_through_count"],
      "properties": {
        "owned_count": { "$ref": "#/$defs/non_negative_integer" },
        "pass_through_count": { "$ref": "#/$defs/non_negative_integer" }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "docker_ok",
        "reaper_ready",
        "stale_containers_scanned",
        "stale_containers_removed",
        "stale_containers_deferred",
        "ryuk_disabled_for_suite_startup"
      ],
      "properties": {
        "status": { "type": "string" },
        "failure_class": { "$ref": "#/$defs/failure_class" },
        "failure_reason": { "$ref": "#/$defs/failure_reason" },
        "docker_ok": { "type": "boolean" },
        "docker_endpoint": { "type": "string" },
        "reaper_ready": { "type": "boolean" },
        "stale_containers_scanned": { "$ref": "#/$defs/non_negative_integer" },
        "stale_containers_removed": { "$ref": "#/$defs/non_negative_integer" },
        "stale_containers_deferred": { "$ref": "#/$defs/non_negative_integer" },
        "ryuk_disabled_for_suite_startup": { "type": "boolean" },
        "message": { "type": "string" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_class",
        "failure_reason",
        "attempts_started",
        "max_attempts",
        "retryable",
        "retry_blocked_by_context"
      ],
      "properties": {
        "failure_class": { "$ref": "#/$defs/failure_class" },
        "failure_reason": { "$ref": "#/$defs/failure_reason" },
        "service": { "type": "string" },
        "stage": { "type": "string" },
        "operation": { "type": "string" },
        "message": { "type": "string" },
        "attempts_started": { "$ref": "#/$defs/non_negative_integer" },
        "max_attempts": { "$ref": "#/$defs/non_negative_integer" },
        "retryable": { "type": "boolean" },
        "retry_blocked_by_context": { "type": "boolean" },
        "docker_endpoint": { "type": "string" }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string" },
        "completed_at": { "$ref": "cartulary.harness.defs.v1#/$defs/timestamp" },
        "child_exit_status": { "type": "integer" }
      }
    },
    "postgres": { "$ref": "#/$defs/service_summary" },
    "object_store": { "$ref": "#/$defs/service_summary" },
    "browser_e2e": { "$ref": "#/$defs/service_summary" },
    "fixture": { "$ref": "#/$defs/service_summary" },
    "started_services": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "names": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "extensions": { "$ref": "cartulary.harness.defs.v1#/$defs/extensions" }
  },
  "$defs": {
    "non_negative_integer": { "type": "integer", "minimum": 0 },
    "failure_class": {
      "enum": ["product", "security", "config", "infra", "harness", "artifact", "timing", "interrupted", "unknown"]
    },
    "failure_reason": {
      "enum": [
        "usage_error",
        "configuration_error",
        "preflight_error",
        "service_start_error",
        "service_readiness_timeout",
        "fixture_error",
        "resource_conflict",
        "test_assertion_failure",
        "security_finding",
        "child_target_failure",
        "tool_diagnostic_failure",
        "scheduler_accounting_error",
        "frontend_row_accounting",
        "test_accounting_unmapped",
        "artifact_error",
        "cleanup_error",
        "duration_baseline_drift",
        "timeout_failure",
        "cancelled_or_interrupted",
        "unknown_failure"
      ]
    },
    "service_summary": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
