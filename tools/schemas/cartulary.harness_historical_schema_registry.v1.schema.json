{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_historical_schema_registry.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "scope", "schemas"],
  "properties": {
    "schema_id": { "const": "cartulary.harness_historical_schema_registry.v1" },
    "scope": { "const": "diagnostic_inspection_only" },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_id", "path", "sha256"],
        "properties": {
          "schema_id": {
            "type": "string",
            "pattern": "^cartulary\\.[a-zA-Z0-9_.-]+\\.v[1-9][0-9]*$"
          },
          "path": {
            "type": "string",
            "pattern": "^tools/historical-schemas/performance/cartulary\\.[a-zA-Z0-9_.-]+\\.v[1-9][0-9]*\\.schema\\.json$"
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
