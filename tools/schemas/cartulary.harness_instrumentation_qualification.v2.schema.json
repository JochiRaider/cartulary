{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_instrumentation_qualification.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "source_commit",
    "source_digest",
    "toolchain_digest",
    "system_digest",
    "policy_digest",
    "plan_digest",
    "seed",
    "environment",
    "accounting",
    "attempts",
    "exclusions",
    "status"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.harness_instrumentation_qualification.v2"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "toolchain_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "system_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "seed": {
      "const": 20261009
    },
    "environment": {
      "const": "wsl2_linux"
    },
    "accounting": {
      "const": "linux_subreaper_wait4_proc"
    },
    "attempts": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result_ref",
          "result_digest",
          "run_ref"
        ],
        "properties": {
          "result_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9_.:/-]+$"
          },
          "result_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "run_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9_.:/-]+$"
          }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt_id",
          "reason"
        ],
        "properties": {
          "attempt_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9_.:/-]+$"
          },
          "reason": {
            "enum": [
              "cold",
              "warmup",
              "command_failed",
              "measurement_lost",
              "cancelled",
              "ineligible"
            ]
          }
        }
      }
    },
    "status": {
      "enum": [
        "complete",
        "incomplete",
        "failed"
      ]
    }
  }
}
