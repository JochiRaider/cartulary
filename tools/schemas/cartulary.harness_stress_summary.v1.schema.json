{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_stress_summary.v1",
  "description": "One stress command: an owner slice repeated beside a declared synthetic host load (TH-HARNESS-REQ-871).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "run_id",
    "owner_id",
    "row_ids",
    "load",
    "load_profile",
    "repeat",
    "repetitions",
    "passed",
    "failed"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.harness_stress_summary.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
    },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "row_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "load": {
      "enum": [
        "none",
        "cpu",
        "io",
        "mixed"
      ]
    },
    "load_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_threads",
        "flush_writers",
        "flush_block_bytes"
      ],
      "properties": {
        "cpu_threads": {
          "type": "integer",
          "minimum": 0
        },
        "flush_writers": {
          "type": "integer",
          "minimum": 0
        },
        "flush_block_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "repeat": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "repetitions": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "run_id",
          "status",
          "exit_code",
          "wall_duration_ms",
          "failed_rows"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "cancelled"
            ]
          },
          "exit_code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "wall_duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "failed_rows": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      }
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    }
  }
}
