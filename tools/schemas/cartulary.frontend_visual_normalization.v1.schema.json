{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.frontend_visual_normalization.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "cartulary.frontend_visual_normalization.v1"
    },
    "captures": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "type": "string",
              "pattern": "^\\[data-generated-metadata=\"[a-z][a-z-]*\"\\]$"
            },
            "replacement": {
              "type": "string",
              "minLength": 1
            },
            "expected_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "id",
            "target",
            "replacement",
            "expected_count"
          ]
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capture_id": {
            "type": "string",
            "pattern": "^visual\\.capture\\.[a-f0-9]{20}$"
          },
          "golden_path": {
            "type": "string",
            "pattern": "^apps/web/e2e/workbook\\.visual\\.spec\\.ts-snapshots/[a-z0-9-]+-linux\\.png$"
          }
        },
        "required": [
          "capture_id",
          "golden_path"
        ]
      }
    }
  },
  "required": [
    "schema_id",
    "captures",
    "bindings"
  ]
}
