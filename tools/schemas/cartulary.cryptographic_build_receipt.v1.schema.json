{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.cryptographic_build_receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "toolchain",
    "selector",
    "service_version",
    "archive_sha256",
    "binary_sha256",
    "build_info"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.cryptographic_build_receipt.v1"
    },
    "toolchain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "selector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "service_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "archive_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "binary_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "build_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "GoVersion",
        "Path",
        "Main",
        "Settings"
      ],
      "properties": {
        "GoVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "Path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "Main": {
          "$ref": "#/$defs/module"
        },
        "Deps": {
          "type": "array",
          "maxItems": 16384,
          "items": {
            "$ref": "#/$defs/module"
          }
        },
        "Settings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16384,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "Key"
            ],
            "properties": {
              "Key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "Value": {
                "type": "string",
                "maxLength": 4096
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Path"
      ],
      "properties": {
        "Path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "Version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "Sum": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "Replace": {
          "$ref": "#/$defs/replacement_module"
        }
      }
    },
    "replacement_module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Path"
      ],
      "properties": {
        "Path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "Version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "Sum": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  }
}
