{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_trace_bundle.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "scope", "invocation_id", "run_id", "command_id", "execution_context_sha256", "trace_id", "root_span_id", "status", "start_time_unix_nano", "end_time_unix_nano", "source_artifacts", "spans"],
  "properties": {
    "schema_id": { "const": "cartulary.harness_trace_bundle.v1" },
    "scope": { "const": "cartulary.harness.execution" },
    "invocation_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
    "command_id": {
      "type": "string",
      "pattern": "^cartulary\\.harness\\.command\\.[a-z][a-z0-9_]*\\.v[1-9][0-9]*$"
    },
    "execution_context_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "trace_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "root_span_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "status": { "enum": ["complete", "partial"] },
    "start_time_unix_nano": { "type": "string", "pattern": "^[0-9]+$" },
    "end_time_unix_nano": { "type": "string", "pattern": "^[0-9]+$" },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["span_id", "parent_span_id", "links", "name", "kind", "phase", "status", "start_time_unix_nano", "end_time_unix_nano", "attributes", "source_occurrence"],
        "properties": {
          "span_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
          "parent_span_id": { "type": ["string", "null"], "pattern": "^[0-9a-f]{16}$" },
          "links": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
          },
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$" },
          "kind": { "enum": ["INTERNAL", "CONSUMER", "PRODUCER"] },
          "phase": { "enum": ["target", "sequence_step", "scheduler_wait", "scheduler_work", "service", "runner", "artifact", "finalizer", "unattributed"] },
          "status": { "enum": ["UNSET", "OK", "ERROR"] },
          "start_time_unix_nano": { "type": "string", "pattern": "^[0-9]+$" },
          "end_time_unix_nano": { "type": "string", "pattern": "^[0-9]+$" },
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "value"],
              "properties": {
                "key": { "enum": ["harness.target", "harness.phase", "harness.status", "harness.work_unit", "harness.resource_class", "harness.wait_reason", "harness.evidence_class"] },
                "value": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{0,128}$" }
              }
            }
          },
          "source_occurrence": { "type": "string", "pattern": "^[A-Za-z0-9_./:-]+$" }
        }
      }
    },
    "diagnostic": { "type": "string", "maxLength": 512 }
  }
}
