        "properties": {
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 600000
          },
          "cause": {
            "enum": [
              "server_starting",
              "connection_limit",
              "authentication_rejected",
              "capability_rejected",
              "server_error",
              "tls_rejected",
              "local_configuration",
              "connection_refused",
              "connection_reset",
              "connection_closed",
              "cancelled",
              "probe_timeout",
              "transport_unreachable",
              "unknown"
            ]
          }
        }
