          "stream": {
            "enum": [
              "stdout",
              "stderr",
              "unknown"
            ]
          },
          "stream_sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          }
        }
      }
    },
    "container_started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "probe_observations": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "elapsed_ms",
          "cause"
