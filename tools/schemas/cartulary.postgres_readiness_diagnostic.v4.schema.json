                    "ipv4",
                    "ipv6",
                    "hostname",
                    "unknown"
                  ]
                },
                "category": {
                  "enum": [
                    "loopback",
                    "unspecified",
                    "private",
                    "link_local",
                    "public",
                    "name",
                    "unknown"
