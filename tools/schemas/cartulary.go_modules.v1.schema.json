{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.go_modules.v1",
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "cartulary.go_modules.v1"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string",
            "pattern": "^referencepacks/[a-z][a-z0-9_-]*$"
          },
          "module_path": {
            "type": "string",
            "pattern": "^github.com/JochiRaider/cartulary/referencepacks/[a-z][a-z0-9_-]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "kind": {
            "enum": [
              "reference_pack_format",
              "reference_pack_producer"
            ]
          }
        },
        "required": [
          "root",
          "module_path",
          "version",
          "kind"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_id",
    "modules"
  ],
  "additionalProperties": false
}
