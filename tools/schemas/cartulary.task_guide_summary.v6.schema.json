{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.task_guide_summary.v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "evidence_epoch",
    "owner_id",
    "test_catalog_digest",
    "verification_routing_digest",
    "focused_commands",
    "generated_commands",
    "broader_commands",
    "release_gate",
    "rows",
    "coverage",
    "explicit_commands"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.task_guide_summary.v6"
    },
    "evidence_epoch": {
      "const": "cartulary.test_evidence.nlspec.v1"
    },
    "owner_id": {
      "$ref": "cartulary.test_catalog_defs.v1#/$defs/owner_id"
    },
    "test_catalog_digest": {
      "$ref": "#/$defs/digest"
    },
    "verification_routing_digest": {
      "$ref": "#/$defs/digest"
    },
    "focused_commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^make (?:service-backed-)?test-slice OWNER="
      }
    },
    "generated_commands": {
      "$ref": "#/$defs/commands"
    },
    "broader_commands": {
      "$ref": "#/$defs/commands"
    },
    "release_gate": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "make release-check",
        null
      ]
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_id",
          "runner",
          "evidence_class",
          "aggregate_placement",
          "fixture_capability",
          "service_dependencies",
          "command",
          "family_id",
          "runtime_profile_id",
          "resource_profile_id",
          "postgres_isolation"
        ],
        "properties": {
          "row_id": {
            "type": "string",
            "minLength": 1
          },
          "runner": {
            "type": "string",
            "minLength": 1
          },
          "evidence_class": {
            "type": "string",
            "minLength": 1
          },
          "aggregate_placement": {
            "type": "string",
            "minLength": 1
          },
          "fixture_capability": {
            "type": "string",
            "minLength": 1
          },
          "service_dependencies": {
            "$ref": "cartulary.test_catalog_defs.v1#/$defs/service_dependencies"
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "family_id": {
            "type": "string",
            "minLength": 1
          },
          "runtime_profile_id": {
            "type": "string",
            "minLength": 1
          },
          "resource_profile_id": {
            "type": "string",
            "minLength": 1
          },
          "postgres_isolation": {
            "enum": [
              "none",
              "shared",
              "exclusive"
            ]
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "service_backed_row_count",
        "runners",
        "evidence_classes",
        "aggregate_placements",
        "fixture_capabilities",
        "families",
        "runtime_profiles",
        "resource_profiles"
      ],
      "properties": {
        "row_count": {
          "type": "integer",
          "minimum": 1
        },
        "service_backed_row_count": {
          "type": "integer",
          "minimum": 0
        },
        "runners": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "evidence_classes": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "aggregate_placements": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "fixture_capabilities": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "families": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "runtime_profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "resource_profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "explicit_commands": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "make browser-e2e SUITE=visual",
          "make harness-contract SUITE=ui-review"
        ]
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "commands": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^make [a-z][a-z0-9-]*(?: [A-Z_]+=[a-z0-9-]+)*$"
      }
    }
  }
}
