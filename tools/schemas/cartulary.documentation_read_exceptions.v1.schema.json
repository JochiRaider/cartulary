{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.documentation_read_exceptions.v1",
  "title": "Cartulary documentation read exceptions v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "exceptions"],
  "properties": {
    "schema_id": { "const": "cartulary.documentation_read_exceptions.v1" },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command_id", "consumer_path", "documentation_pattern", "operations", "purpose", "owner_id"],
        "properties": {
          "command_id": { "type": "string", "pattern": "^cartulary\\.harness\\.command\\.[a-z][a-z0-9_]*\\.v[1-9][0-9]*$" },
          "consumer_path": { "$ref": "#/$defs/path" },
          "documentation_pattern": { "type": "string", "minLength": 3, "maxLength": 256, "pattern": "^\\^docs/.*\\$$" },
          "operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["read_file", "stat_path", "resolve_realpath", "enumerate_directory"] } },
          "purpose": { "enum": ["documentation_lint", "documentation_link_check", "documentation_generation"] },
          "owner_id": { "type": "string", "pattern": "^harness\\.[a-z][a-z0-9_]{0,62}$" }
        }
      }
    }
  },
  "$defs": {
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }
  }
}
