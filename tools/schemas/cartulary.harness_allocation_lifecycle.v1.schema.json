{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "allocation_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_.:/-]+$"
    },
    "borrows": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lease_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9_.:/-]+$"
          },
          "unit_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9_.:/-]+$"
          }
        },
        "required": [
          "lease_ref",
          "unit_id"
        ]
      }
    },
    "clock_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_.:/-]+$"
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_ms": {
          "type": "number",
          "minimum": 0
        },
        "end_ms": {
          "type": "number",
          "minimum": 0
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "start_ms",
        "end_ms",
        "duration_ms"
      ]
    },
    "retirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_ms": {
          "type": "number",
          "minimum": 0
        },
        "end_ms": {
          "type": "number",
          "minimum": 0
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "start_ms",
        "end_ms",
        "duration_ms"
      ]
    },
    "retirement_reason": {
      "enum": [
        "acquisition_failure",
        "unhealthy_borrower",
        "terminal_borrower_release",
        "capacity_pressure",
        "exclusive_admission",
        "invocation_cancellation",
        "run_finalization"
      ]
    },
    "triggering_unit_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_.:/-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "settlement": {
      "enum": [
        "settled",
        "unresolved"
      ]
    },
    "coverage": {
      "const": "complete"
    }
  },
  "required": [
    "allocation_ref",
    "borrows",
    "clock_identity",
    "acquisition",
    "retirement",
    "retirement_reason",
    "triggering_unit_id",
    "settlement",
    "coverage"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_allocation_lifecycle.v1"
}
