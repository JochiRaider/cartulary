{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "cartulary.vitest_invocation.v1",
  "required": [
    "schema_id",
    "project",
    "files",
    "publish_rows"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.vitest_invocation.v1"
    },
    "project": {
      "type": "string"
    },
    "config": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]*$"
    },
    "publish_rows": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "rows"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]*$"
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "row_id",
                "selectors"
              ],
              "properties": {
                "row_id": {
                  "type": "string",
                  "minLength": 1
                },
                "selectors": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
