{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_go_lpt_plan.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "available_parallelism", "worker_count", "gomaxprocs", "shards", "plan_digest"],
  "properties": {
    "schema_id": { "const": "cartulary.harness_go_lpt_plan.v2" },
    "available_parallelism": { "type": "integer", "minimum": 1 },
    "worker_count": { "type": "integer", "minimum": 1, "maximum": 8 },
    "gomaxprocs": { "type": "integer", "minimum": 1 },
    "shards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shard_id", "compatibility_digest", "item_ids", "estimated_work_ms", "isolated", "cpu_tokens"],
        "properties": {
          "shard_id": { "type": "string", "pattern": "^go:[a-f0-9]{16}:[a-f0-9]{12}$" },
          "compatibility_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "item_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "estimated_work_ms": { "type": "integer", "minimum": 1 },
          "isolated": { "type": "boolean" },
          "cpu_tokens": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "plan_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
