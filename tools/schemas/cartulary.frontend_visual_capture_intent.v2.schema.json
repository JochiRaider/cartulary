{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.frontend_visual_capture_intent.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "test_file",
    "capture_profile",
    "capture_id",
    "capture_intent",
    "expected_golden_path",
    "project_id",
    "renderer_profile_id",
    "screenshot_assertion_location",
    "test_title"
  ],
  "properties": {
    "capture_id": {
      "type": "string",
      "pattern": "^visual\\.capture\\.[0-9a-f]{20}$"
    },
    "capture_intent": {
      "type": "string",
      "minLength": 1
    },
    "expected_golden_path": {
      "type": "string",
      "pattern": "^apps/web/e2e/workbook\\.visual\\.spec\\.ts-snapshots/[^/]+\\.png$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "renderer_profile_id": {
      "$ref": "cartulary.frontend_visual_reconciliation.v3#/$defs/profile_id"
    },
    "screenshot_assertion_location": {
      "type": "string",
      "minLength": 1
    },
    "test_title": {
      "type": "string",
      "minLength": 1
    },
    "schema_id": {
      "const": "cartulary.frontend_visual_capture_intent.v2"
    },
    "test_file": {
      "const": "apps/web/e2e/workbook.visual.spec.ts"
    },
    "capture_profile": {
      "$ref": "cartulary.frontend_visual_reconciliation.v3#/$defs/capture_profile"
    }
  }
}
