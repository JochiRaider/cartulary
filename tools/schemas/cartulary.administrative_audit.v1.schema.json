{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.administrative_audit.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "scope_kinds",
    "actor_kinds",
    "sources",
    "value_states",
    "actions",
    "forbidden_visible_field_tokens",
    "legacy_backfill"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.administrative_audit.v1" },
    "scope_kinds": {
      "type": "array",
      "prefixItems": [{ "const": "deployment" }, { "const": "incident" }],
      "items": false
    },
    "actor_kinds": {
      "type": "array",
      "prefixItems": [
        { "const": "operator" },
        { "const": "system" },
        { "const": "user" }
      ],
      "items": false
    },
    "sources": {
      "type": "array",
      "prefixItems": [
        { "const": "api" },
        { "const": "operator" },
        { "const": "startup" },
        { "const": "system" },
        { "const": "ui" }
      ],
      "items": false
    },
    "value_states": {
      "type": "array",
      "prefixItems": [{ "const": "redacted" }, { "const": "visible" }],
      "items": false
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_code", "scope_kind", "target_kind"],
        "properties": {
          "action_code": { "$ref": "#/$defs/token" },
          "scope_kind": { "enum": ["deployment", "incident"] },
          "target_kind": { "$ref": "#/$defs/token" }
        }
      }
    },
    "forbidden_visible_field_tokens": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/token" }
    },
    "legacy_backfill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_event_kinds",
        "incident_membership_event_kinds"
      ],
      "properties": {
        "deployment_event_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/token" }
        },
        "incident_membership_event_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/token" }
        }
      }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 128
    }
  }
}
