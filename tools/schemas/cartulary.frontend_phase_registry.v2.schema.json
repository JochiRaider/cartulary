{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.frontend_phase_registry.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "phase_namespace", "guide_path", "guide_digest", "schema_version", "phases"],
  "properties": {
    "schema_id": { "const": "cartulary.frontend_phase_registry.v2" },
    "phase_namespace": { "const": "frontend" },
    "guide_path": { "const": "docs/guides/cartulary_frontend_implementation_testing_guide.md" },
    "guide_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "schema_version": { "const": 2 },
    "phases": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/phase" }
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_id",
        "status",
        "manifest_path",
        "manifest_digest",
        "ledger_path",
        "ledger_digest",
        "owner_refs",
        "depends_on",
        "row_rollup_state",
        "activation_blockers",
        "evidence_freshness_digest"
      ],
      "properties": {
        "phase_id": { "pattern": "^FE-P(?:0|[1-9][0-9]*)$", "type": "string" },
        "status": { "enum": ["planned", "active", "retired"] },
        "manifest_path": {
          "pattern": "^tools/frontend_phase_maps/fe_p(?:0|[1-9][0-9]*)_test_map\\.json$",
          "type": "string"
        },
        "manifest_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "ledger_path": {
          "pattern": "^docs/testing/frontend_phase_coverage_ledgers/fe_p(?:0|[1-9][0-9]*)_coverage_ledger\\.md$",
          "type": "string"
        },
        "ledger_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "owner_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/owner_ref" }
        },
        "depends_on": {
          "type": "array",
          "items": { "pattern": "^FE-P(?:0|[1-9][0-9]*)$", "type": "string" },
          "uniqueItems": true
        },
        "row_rollup_state": {
          "enum": [
            "no_rows_implemented",
            "partially_implemented",
            "implemented_dependency_blocked",
            "activation_ready",
            "active_green",
            "stale",
            "retired"
          ]
        },
        "activation_blockers": {
          "type": "array",
          "items": { "$ref": "#/$defs/blocker" }
        },
        "evidence_freshness_digest": { "type": "string", "minLength": 1 }
      }
    },
    "owner_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_key", "path", "section_ref", "heading_text", "req_ids", "ac_ids", "role", "resolution_status"],
      "properties": {
        "source_key": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "section_ref": { "type": "string", "minLength": 1 },
        "heading_text": { "type": "string", "minLength": 1 },
        "req_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "ac_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "role": { "type": "string", "minLength": 1 },
        "resolution_status": { "enum": ["resolved", "owner_lookup_required", "contradiction_detected", "suspected_owner_drift"] }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocker_id", "reason_code", "description", "resolution_owner"],
      "properties": {
        "blocker_id": { "type": "string", "minLength": 1 },
        "reason_code": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "resolution_owner": { "type": "string", "minLength": 1 }
      }
    }
  }
}
