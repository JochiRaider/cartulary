{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.performance_fixture_snapshot.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "fixture_profile_id",
    "fixture_version",
    "seed",
    "snapshot_key_schema_id",
    "snapshot_key",
    "migration_digest",
    "source_contract_digest",
    "builder_unit_id",
    "build_ordinal",
    "state",
    "contribution_receipts",
    "semantic_validation_digest",
    "validation",
    "redaction_policy_id",
    "created_at"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.performance_fixture_snapshot.v2" },
    "fixture_profile_id": { "$ref": "cartulary.performance_fixture_snapshot_key.v2#/properties/fixture_profile_id" },
    "fixture_version": { "$ref": "cartulary.performance_fixture_snapshot_key.v2#/properties/fixture_version" },
    "seed": { "$ref": "cartulary.performance_fixture_snapshot_key.v2#/properties/seed" },
    "snapshot_key_schema_id": { "const": "cartulary.performance_fixture_snapshot_key.v2" },
    "snapshot_key": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "migration_digest": { "$ref": "cartulary.performance_fixture_snapshot_key.v2#/properties/migration_digest" },
    "source_contract_digest": { "$ref": "cartulary.performance_fixture_snapshot_key.v2#/properties/source_contract_digest" },
    "builder_unit_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "build_ordinal": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["sealed", "failed"] },
    "contribution_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contribution_id", "version", "owner_id", "counts"],
        "properties": {
          "contribution_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.v[1-9][0-9]*$" },
          "version": { "type": "string", "pattern": "^[a-z][a-z0-9_.]+\\.v[1-9][0-9]*$" },
          "owner_id": { "$ref": "cartulary.test_catalog_defs.v1#/$defs/owner_id" },
          "counts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["count_id", "actual"],
              "properties": {
                "count_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$" },
                "actual": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "semantic_validation_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counts", "conditions", "connections_closed"],
      "properties": {
        "counts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expectation_id", "actual", "passed"],
            "properties": {
              "expectation_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$" },
              "actual": { "type": "integer", "minimum": 0 },
              "passed": { "type": "boolean" }
            }
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expectation_id", "actual", "passed"],
            "properties": {
              "expectation_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$" },
              "actual": { "type": "boolean" },
              "passed": { "type": "boolean" }
            }
          }
        },
        "connections_closed": { "type": "boolean" }
      }
    },
    "failure_code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "redaction_policy_id": { "type": "string", "pattern": "^cartulary\\.[a-z0-9_.]+\\.v[1-9][0-9]*$" },
    "created_at": { "$ref": "cartulary.harness.defs.v1#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "failed" } }, "required": ["state"] },
      "then": { "required": ["failure_code"] }
    },
    {
      "if": { "properties": { "state": { "const": "sealed" } }, "required": ["state"] },
      "then": {
        "properties": {
          "contribution_receipts": { "minItems": 1 },
          "validation": { "properties": { "connections_closed": { "const": true } } }
        },
        "not": { "required": ["failure_code"] }
      }
    }
  ]
}
