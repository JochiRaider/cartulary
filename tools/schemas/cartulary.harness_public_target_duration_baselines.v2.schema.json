{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_public_target_duration_baselines.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "status", "qualification", "targets", "public_entrypoint_portfolio", "rejected_roots"],
  "properties": {
    "schema_id": { "const": "cartulary.harness_public_target_duration_baselines.v2" },
    "status": { "const": "qualified" },
    "qualification": { "enum": ["composite_reference_migration", "strict_current"] },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/target" }
    },
    "public_entrypoint_portfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_count", "targets", "total_median_ms"],
      "properties": {
        "target_count": { "type": "integer", "minimum": 1 },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" }
        },
        "total_median_ms": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "rejected_roots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["root", "reasons"],
        "properties": {
          "root": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "reasons": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target", "gate", "command_id", "measurement_profile_id", "canonical_inputs",
        "timing_source", "evidence_kind", "source_commit", "source_snapshot_sha256",
        "host_profile_sha256", "capacity_profile_sha256", "toolchain_profile_sha256",
        "workload_evidence_profile_sha256", "execution_policy", "execution_policy_sha256",
        "sample_provider_target", "warmup_root", "sample_roots", "samples_ms", "median_ms",
        "mad_ms", "no_regression_limit_ms", "required_improvement_ms"
      ],
      "properties": {
        "target": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "gate": { "enum": ["no_regression", "required_improvement"] },
        "command_id": { "type": "string", "pattern": "^cartulary\\.harness\\.command\\.[a-z][a-z0-9_]*\\.v[1-9][0-9]*$" },
        "measurement_profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "canonical_inputs": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "timing_source": { "enum": ["public_invocation_envelope", "aggregate_scheduler_work_envelope", "backend_report_collation_union"] },
        "evidence_kind": { "enum": ["retained_v1_reference_migration", "strict_current"] },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "source_snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "host_profile_sha256": { "$ref": "#/$defs/sha256" },
        "capacity_profile_sha256": { "$ref": "#/$defs/sha256" },
        "toolchain_profile_sha256": { "$ref": "#/$defs/sha256" },
        "workload_evidence_profile_sha256": { "$ref": "#/$defs/sha256" },
        "execution_policy": { "type": "object" },
        "execution_policy_sha256": { "$ref": "#/$defs/sha256" },
        "allowed_policy_transition": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "sample_provider_target": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "warmup_root": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "sample_roots": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
        "samples_ms": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "exclusiveMinimum": 0 } },
        "median_ms": { "type": "number", "exclusiveMinimum": 0 },
        "mad_ms": { "type": "number", "minimum": 0 },
        "no_regression_limit_ms": { "type": "number", "exclusiveMinimum": 0 },
        "required_improvement_ms": { "type": "number", "minimum": 0 }
      }
    }
  }
}
