{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_suite_runtime_owner.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "lease_id",
    "run_id",
    "owner_uid",
    "created_at",
    "repository",
    "run_root",
    "output_roots"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.harness_suite_runtime_owner.v2"
    },
    "lease_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,96}$"
    },
    "owner_uid": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "run_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "output_roots": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    }
  }
}
