{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.release_qualification.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "required_operations",
    "obligations"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.release_qualification.v1"
    },
    "required_operations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obligation_id",
          "normative_owners",
          "capability",
          "expectation",
          "owner_ids",
          "row_ids"
        ],
        "properties": {
          "obligation_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]+$"
          },
          "normative_owners": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "expectation": {
            "type": "string",
            "minLength": 1
          },
          "owner_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "row_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        }
      }
    }
  }
}
