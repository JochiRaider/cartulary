{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.frontend_measurement_aggregate.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "target_id", "status", "fixture_profile_id", "snapshot_key",
    "builder_count", "clone_count", "scheduler_overlap_count", "build_artifact",
    "source_report_refs", "summaries"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.frontend_measurement_aggregate.v2" },
    "target_id": { "const": "browser-e2e-measurement" },
    "status": { "const": "qualified" },
    "fixture_profile_id": { "const": "ac043_large_grid_snapshot_v1" },
    "snapshot_key": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "builder_count": { "const": 1 },
    "clone_count": { "type": "integer", "minimum": 1 },
    "scheduler_overlap_count": { "const": 0 },
    "build_artifact": { "$ref": "cartulary.harness_artifact_ref.v1#/$defs/digested_artifact_ref" },
    "source_report_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "summaries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "cartulary.frontend_measurement_summary.v2" }
    }
  }
}
