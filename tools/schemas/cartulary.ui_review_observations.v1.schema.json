{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.ui_review_observations.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "cartulary.ui_review_observations.v1"
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": {
            "$ref": "cartulary.ui_review_bundle.v1#/$defs/target"
          },
          "resolved_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "role": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          },
          "text": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          },
          "text_truncated": {
            "type": "boolean"
          },
          "rect": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number",
                "minimum": 0
              },
              "height": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ]
          },
          "visible_rect": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number",
                    "minimum": 0
                  },
                  "height": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "focused": {
            "type": "boolean"
          },
          "disabled": {
            "type": "boolean"
          },
          "scroll": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "left": {
                    "type": "number"
                  },
                  "top": {
                    "type": "number"
                  },
                  "client_width": {
                    "type": "number"
                  },
                  "client_height": {
                    "type": "number"
                  },
                  "scroll_width": {
                    "type": "number"
                  },
                  "scroll_height": {
                    "type": "number"
                  }
                },
                "required": [
                  "left",
                  "top",
                  "client_width",
                  "client_height",
                  "scroll_width",
                  "scroll_height"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "style": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "font_family": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096
              },
              "font_size": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096
              },
              "font_weight": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096
              },
              "line_height": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096
              },
              "color": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096
              },
              "background_color": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096
              },
              "padding": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096
              },
              "gap": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096
              },
              "overflow_x": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096
              },
              "overflow_y": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096
              }
            },
            "required": [
              "font_family",
              "font_size",
              "font_weight",
              "line_height",
              "color",
              "background_color",
              "padding",
              "gap",
              "overflow_x",
              "overflow_y"
            ]
          },
          "overflow_candidate": {
            "type": "boolean"
          }
        },
        "required": [
          "target",
          "resolved_ref",
          "role",
          "name",
          "text",
          "text_truncated",
          "rect",
          "visible_rect",
          "focused",
          "disabled",
          "scroll",
          "style",
          "overflow_candidate"
        ]
      },
      "maxItems": 64
    },
    "accessibility_snapshot": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 1048576
        },
        {
          "type": "null"
        }
      ]
    },
    "axe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "completed",
            "disabled",
            "unavailable"
          ]
        },
        "engine_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "const": "main_document"
        },
        "violations": {
          "type": "array",
          "items": {
            "$ref": "cartulary.ui_review_bundle.v1#/$defs/axe_finding"
          },
          "maxItems": 1000
        },
        "incomplete": {
          "type": "array",
          "items": {
            "$ref": "cartulary.ui_review_bundle.v1#/$defs/axe_finding"
          },
          "maxItems": 1000
        },
        "unassessed_frames": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "engine_version",
        "scope",
        "violations",
        "incomplete",
        "unassessed_frames"
      ]
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "level": {
                "enum": [
                  "error",
                  "warning",
                  "info",
                  "debug"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096
              }
            },
            "required": [
              "sequence",
              "level",
              "text"
            ]
          },
          "maxItems": 200
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "records",
        "truncated"
      ]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "method": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "url": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096
              },
              "status": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 599
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "outcome": {
                "enum": [
                  "response",
                  "failed"
                ]
              }
            },
            "required": [
              "sequence",
              "method",
              "url",
              "status",
              "outcome"
            ]
          },
          "maxItems": 200
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "records",
        "truncated"
      ]
    },
    "fonts": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "style",
          "weight",
          "status"
        ],
        "properties": {
          "family": {
            "type": "string",
            "maxLength": 1024
          },
          "style": {
            "type": "string",
            "maxLength": 1024
          },
          "weight": {
            "type": "string",
            "maxLength": 1024
          },
          "status": {
            "type": "string",
            "maxLength": 1024
          }
        }
      }
    }
  },
  "required": [
    "schema_id",
    "elements",
    "accessibility_snapshot",
    "axe",
    "console",
    "network",
    "fonts"
  ]
}
