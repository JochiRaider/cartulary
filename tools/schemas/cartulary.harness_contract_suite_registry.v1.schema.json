{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_contract_suite_registry.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "baseline_case_count", "suites"],
  "properties": {
    "schema_id": { "const": "cartulary.harness_contract_suite_registry.v1" },
    "baseline_case_count": { "const": 104 },
    "suites": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "patterns"],
        "properties": {
          "id": { "enum": ["graph", "evidence", "scheduler", "command_surface", "boundaries"] },
          "patterns": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 120 } }
        }
      }
    }
  }
}
