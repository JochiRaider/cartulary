{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.network_flow_timezone_ruleset_provenance.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "ruleset_id",
    "profile_id",
    "iana_version",
    "release",
    "source_archive",
    "detached_signature",
    "license",
    "embedded_file_hashes",
    "owner_refs",
    "conformance_policy"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.network_flow_timezone_ruleset_provenance.v1"
    },
    "ruleset_id": { "const": "tzdb-2026c" },
    "profile_id": { "const": "network_flow_activity" },
    "iana_version": { "const": "2026c" },
    "release": { "$ref": "#/$defs/release" },
    "source_archive": { "$ref": "#/$defs/archive" },
    "detached_signature": { "$ref": "#/$defs/signature" },
    "license": { "$ref": "#/$defs/license" },
    "embedded_file_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/embedded_file_hash" }
    },
    "owner_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/owner_ref" }
    },
    "conformance_policy": { "$ref": "#/$defs/conformance_policy" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "date_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "repo_doc_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9._@+-]+(?:/[A-Za-z0-9._@+-]+)*\\.md$"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "released_at",
        "release_date",
        "release_index_url",
        "release_archive_index_url"
      ],
      "properties": {
        "released_at": { "$ref": "#/$defs/date_time" },
        "release_date": { "$ref": "#/$defs/date" },
        "release_index_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 240
        },
        "release_archive_index_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 240
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "file_name",
        "url",
        "media_type",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "distribution": { "const": "data_only" },
        "file_name": { "const": "tzdata2026c.tar.gz" },
        "url": {
          "const": "https://data.iana.org/time-zones/releases/tzdata2026c.tar.gz"
        },
        "media_type": { "const": "application/gzip" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_name",
        "url",
        "media_type",
        "size_bytes",
        "sha256",
        "openpgp_fingerprint",
        "openpgp_key_id",
        "signature_created_at"
      ],
      "properties": {
        "file_name": { "const": "tzdata2026c.tar.gz.asc" },
        "url": {
          "const": "https://data.iana.org/time-zones/releases/tzdata2026c.tar.gz.asc"
        },
        "media_type": { "const": "application/pgp-signature" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "openpgp_fingerprint": {
          "type": "string",
          "pattern": "^[A-F0-9]{40}$"
        },
        "openpgp_key_id": {
          "type": "string",
          "pattern": "^[A-F0-9]{16}$"
        },
        "signature_created_at": { "$ref": "#/$defs/date_time" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "summary",
        "sha256",
        "data_only_distribution_requires_bsd_3_clause_exception"
      ],
      "properties": {
        "source_path": { "const": "LICENSE" },
        "summary": {
          "const": "public_domain_except_optional_bsd_3_clause_code_files"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "data_only_distribution_requires_bsd_3_clause_exception": {
          "type": "boolean"
        }
      }
    },
    "embedded_file_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {
          "enum": ["LICENSE", "NEWS", "version"]
        },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "owner_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "sections",
        "requirement_ids",
        "acceptance_ids",
        "blocker_ids"
      ],
      "properties": {
        "document": { "$ref": "#/$defs/repo_doc_path" },
        "sections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
          }
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^NF-REQ-[0-9]{3}[a-z]?$"
          }
        },
        "acceptance_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^NF-AC-[0-9]{3}$"
          }
        },
        "blocker_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^NF-BLOCK-[0-9]{3}$"
          }
        }
      }
    },
    "conformance_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_timezone_database_authoritative",
        "host_locale_authoritative",
        "latest_url_allowed",
        "verification_required_before_use",
        "allowed_internal_ruleset_substitution"
      ],
      "properties": {
        "host_timezone_database_authoritative": { "const": false },
        "host_locale_authoritative": { "const": false },
        "latest_url_allowed": { "const": false },
        "verification_required_before_use": { "const": true },
        "allowed_internal_ruleset_substitution": {
          "const": "later_ruleset_only_when_all_tzdb_2026c_fixture_transitions_are_byte_identical"
        }
      }
    }
  }
}
