{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.requirement_catalog.v1",
  "title": "Cartulary requirement catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "owner_id", "requirements"],
  "properties": {
    "schema_id": { "const": "cartulary.requirement_catalog.v1" },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 191,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "statement", "status"],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "statement": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "contract_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "status": { "enum": ["active", "planned"] }
        }
      }
    }
  }
}
