{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.contract_family_registry.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_id",
    "registry_id",
    "note",
    "families"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "schema_id": { "const": "cartulary.contract_family_registry.v1" },
    "registry_id": { "const": "cartulary.contract_families.v1" },
    "note": { "type": "string", "minLength": 1, "maxLength": 240 },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/family" }
    }
  },
  "$defs": {
    "repo_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9._@+-]+(?:/[A-Za-z0-9._@+-]+)*$"
    },
    "repo_doc_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9._@+-]+(?:/[A-Za-z0-9._@+-]+)*\\.md$"
    },
    "family_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "go_symbol": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "ts_symbol": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$"
    },
    "owner_section": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[0-9]+(?:\\.[0-9]+)*$"
    },
    "work_item_id": {
      "type": "string",
      "pattern": "^NFA-[A-Z0-9]+-[0-9]{3}$"
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "contract_root",
        "generation_status",
        "go_name",
        "ts_name",
        "output_order",
        "owner_document",
        "owner_sections",
        "generated_outputs",
        "activation_dependency_ids",
        "description"
      ],
      "properties": {
        "family_id": { "$ref": "#/$defs/family_id" },
        "contract_root": {
          "allOf": [
            { "$ref": "#/$defs/repo_path" },
            { "pattern": "^contracts/[A-Za-z0-9._@+-]+(?:/[A-Za-z0-9._@+-]+)*$" }
          ]
        },
        "generation_status": { "enum": ["active", "planned"] },
        "go_name": { "$ref": "#/$defs/go_symbol" },
        "ts_name": { "$ref": "#/$defs/ts_symbol" },
        "output_order": { "type": "integer", "minimum": 0 },
        "owner_document": { "$ref": "#/$defs/repo_doc_path" },
        "owner_sections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/owner_section" }
        },
        "generated_outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repo_path" }
        },
        "activation_dependency_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/work_item_id" }
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        }
      }
    }
  }
}
