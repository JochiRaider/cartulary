{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.openapi_source_manifest.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "target",
    "requirements_registry",
    "policy",
    "unit_root",
    "units"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.openapi_source_manifest.v2"
    },
    "target": {
      "const": "contracts/openapi/cartulary.openapi.yaml"
    },
    "requirements_registry": {
      "const": "contracts/requirements/registry.json"
    },
    "policy": {
      "const": "contracts/openapi-source/assembly-policy.json"
    },
    "unit_root": {
      "const": "contracts/openapi-source/owners"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner_id",
          "path",
          "role"
        ],
        "properties": {
          "owner_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^contracts/openapi-source/owners/[A-Za-z0-9._-]+/openapi\\.json$"
          },
          "role": {
            "enum": [
              "owner",
              "root"
            ]
          }
        }
      }
    }
  }
}
