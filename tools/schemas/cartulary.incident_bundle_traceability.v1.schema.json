{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.incident_bundle_traceability.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "mappings"],
  "properties": {
    "schema_id": { "const": "cartulary.incident_bundle_traceability.v1" },
    "mappings": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acceptance_id", "requirement_ids", "verification_ids"],
        "properties": {
          "acceptance_id": { "pattern": "^AC-(48[7-9]|49[0-9]|50[0-8]|53[01]|56[1-3])$" },
          "requirement_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "pattern": "^REQ-01-(63[5-9]|64[0-6]|653|66[8-9]|670)$|^REQ-02-271$" } },
          "verification_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
