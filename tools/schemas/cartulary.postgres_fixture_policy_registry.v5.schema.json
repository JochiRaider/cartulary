{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.postgres_fixture_policy_registry.v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "catalog_schema_id",
    "capability_policies",
    "transaction_row_approvals"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.postgres_fixture_policy_registry.v5"
    },
    "catalog_schema_id": {
      "const": "cartulary.test_family_manifest.v12"
    },
    "capability_policies": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "isolation_scope",
          "rationale",
          "cluster_scopes"
        ],
        "properties": {
          "capability": {
            "enum": [
              "postgres_dedicated",
              "postgres_migration",
              "postgres_transaction"
            ]
          },
          "isolation_scope": {
            "enum": [
              "database",
              "migration_database",
              "transaction"
            ]
          },
          "rationale": {
            "enum": [
              "committed_or_unproven_work_requires_unique_database",
              "schema_lifecycle_requires_fresh_database",
              "single_connection_rollback_proven"
            ]
          },
          "cluster_scopes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "exclusive",
                "shared"
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "capability": {
                  "enum": [
                    "postgres_dedicated",
                    "postgres_migration"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "cluster_scopes": {
                  "const": [
                    "exclusive"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "transaction_row_approvals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.]*$"
      }
    }
  }
}
