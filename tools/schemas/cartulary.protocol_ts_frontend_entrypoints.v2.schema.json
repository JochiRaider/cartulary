{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.protocol_ts_frontend_entrypoints.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_id",
    "owner_id",
    "network_flow_entrypoints_path",
    "http_operation_selection_path",
    "core_http",
    "collaboration",
    "entrypoints"
  ],
  "properties": {
    "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
    "schema_id": { "const": "cartulary.protocol_ts_frontend_entrypoints.v2" },
    "owner_id": { "const": "package.protocol_ts" },
    "network_flow_entrypoints_path": {
      "const": "contracts/network-flow/frontend-entrypoints.v4.json"
    },
    "http_operation_selection_path": {
      "const": "contracts/protocol-ts/http-operations.v2.json"
    },
    "core_http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openapi_path", "component_schema_names"],
      "properties": {
        "openapi_path": { "const": "contracts/openapi/cartulary.openapi.yaml" },
        "component_schema_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" }
        }
      }
    },
    "collaboration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_index_path", "message_types"],
      "properties": {
        "contract_index_path": { "const": "contracts/ws/index.schema.json" },
        "message_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        }
      }
    },
    "entrypoints": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "specifier",
          "authored_path",
          "generated_module_allowlist"
        ],
        "properties": {
          "specifier": {
            "enum": [
              "@cartulary/protocol-ts/collaboration",
              "@cartulary/protocol-ts/errors",
              "@cartulary/protocol-ts/extensions",
              "@cartulary/protocol-ts/http",
              "@cartulary/protocol-ts/import-targets",
              "@cartulary/protocol-ts/network-flow",
              "@cartulary/protocol-ts/view-schemas"
            ]
          },
          "authored_path": {
            "type": "string",
            "pattern": "^packages/protocol-ts/src/entrypoints/[a-z][a-z0-9-]*\\.ts$"
          },
          "generated_module_allowlist": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^packages/protocol-ts/src/generated/[A-Za-z0-9._@+-]+\\.ts$"
            }
          }
        }
      }
    }
  }
}
