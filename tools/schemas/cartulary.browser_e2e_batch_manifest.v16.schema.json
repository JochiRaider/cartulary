{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.browser_e2e_batch_manifest.v16",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "runtime_profiles",
    "stages",
    "invocation_policy",
    "partitions"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.browser_e2e_batch_manifest.v16"
    },
    "runtime_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "invocation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startup_ms",
        "cleanup_ms"
      ],
      "properties": {
        "startup_ms": {
          "type": "integer",
          "minimum": 0
        },
        "cleanup_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "partitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/group"
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "service_requirement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "service_requirement": {
          "enum": [
            "none",
            "test-services"
          ]
        },
        "key_ring_manifest_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "required": [
        "name",
        "target",
        "kind",
        "runtime_profile_id",
        "resource_profile_id",
        "service_requirement",
        "service_dependencies",
        "selected_row_ids",
        "specs",
        "browser_session_group",
        "fixture_capability",
        "state_scope",
        "project",
        "config",
        "preparation_operations",
        "postgres_isolation",
        "workers",
        "execution_stage",
        "frontend_artifact_id",
        "scheduler_needs"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "runtime_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "resource_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "fixture_profile_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*_v[1-9][0-9]*$"
        },
        "service_requirement": {
          "enum": [
            "none",
            "test-services"
          ]
        },
        "service_dependencies": {
          "$ref": "cartulary.test_catalog_defs.v1#/$defs/service_dependencies"
        },
        "selected_row_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "cartulary.test_catalog_defs.v1#/$defs/row_id"
          }
        },
        "specs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "cartulary.test_catalog_defs.v1#/$defs/repo_path"
          }
        },
        "browser_session_group": {
          "type": "string",
          "minLength": 1
        },
        "state_scope": {
          "enum": [
            "test_owned",
            "isolated",
            "measurement"
          ]
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "const": "playwright.config.ts"
        },
        "preparation_operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^harness\\.[a-z][a-z0-9_]*$"
          }
        },
        "postgres_isolation": {
          "const": "exclusive"
        },
        "fixture_capability": {
          "const": "browser_stack"
        },
        "workers": {
          "const": "1"
        },
        "execution_stage": {
          "type": "string",
          "minLength": 1
        },
        "frontend_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "scheduler_needs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "required": [
        "name",
        "target",
        "groups"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "partition",
              "selected_row_ids"
            ],
            "properties": {
              "partition": {
                "type": "string",
                "minLength": 1
              },
              "selected_row_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "cartulary.test_catalog_defs.v1#/$defs/row_id"
                }
              }
            }
          }
        },
        "schedule_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scheduler_needs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "frontend_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "summary_children": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
