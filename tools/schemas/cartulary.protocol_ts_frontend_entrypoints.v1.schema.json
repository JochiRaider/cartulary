{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.protocol_ts_frontend_entrypoints.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "owner_id", "network_flow_entrypoints_path", "http_operation_selection_path", "core_http", "collaboration"],
  "properties": {
    "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
    "schema_id": { "const": "cartulary.protocol_ts_frontend_entrypoints.v1" },
    "owner_id": { "const": "package.protocol_ts" },
    "network_flow_entrypoints_path": { "const": "contracts/network-flow/frontend-entrypoints.v3.json" },
    "http_operation_selection_path": { "const": "contracts/protocol-ts/http-operations.v1.json" },
    "core_http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openapi_path", "component_schema_names"],
      "properties": {
        "openapi_path": { "const": "contracts/openapi/cartulary.openapi.yaml" },
        "component_schema_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" }
        }
      }
    },
    "collaboration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_index_path", "message_types"],
      "properties": {
        "contract_index_path": { "const": "contracts/ws/index.schema.json" },
        "message_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        }
      }
    }
  }
}
