{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_row_result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "row_id", "terminal_state", "duration_ms", "exit_code", "failure_reason", "runner", "started_at", "finished_at", "wall_duration_ms"],
  "properties": {
    "schema_id": { "const": "cartulary.harness_row_result.v1" },
    "row_id": { "$ref": "cartulary.test_family_manifest.v3#/$defs/row_id" },
    "terminal_state": { "enum": ["passed", "failed", "infrastructure_failed", "skipped_dependency", "cancelled", "skipped_authorized"] },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
    "failure_reason": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
    "runner": { "enum": ["go", "vitest", "playwright", "shell"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "wall_duration_ms": { "type": "integer", "minimum": 0 }
  }
}
