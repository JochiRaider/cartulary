{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_producers.v1",
  "description": "Harness artifact producers (TH-HARNESS build-artifact store, P5-3). Each published producer makes its output available at a binding's path, or at its default file under a workspace layout directory; a web bundle publishes no view, and its root becomes the run's frontend artifact. The artifact store decides whether to build. Installations (the Node runtime, the frontend dependencies, the Playwright browsers and the test service images) install in place under a receipt; the report renderer keeps its own content-addressed installations; the release inventory regenerates each time it is produced. Go tool modules, the ShellCheck, Node and pnpm versions come from the toolchain pins.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "producers"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.harness_producers.v1"
    },
    "producers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "enum": [
              "go_binary",
              "go_tool",
              "shellcheck",
              "web_bundle",
              "embedded_assets",
              "node_runtime",
              "frontend_install",
              "playwright",
              "test_service_images",
              "report_renderer",
              "release_inventory"
            ]
          },
          "binding": {
            "description": "The variable whose value is the published path.",
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "directory": {
            "description": "The workspace layout directory of the default path.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "description": "The run step a build runs as.",
            "type": "string",
            "minLength": 1
          },
          "target": {
            "description": "The step target a build reports under when the caller names none.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "requires": {
            "description": "The producers that must be current first, such as the Node runtime an installation runs with.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "package": {
            "type": "string",
            "pattern": "^\\./[A-Za-z0-9_./-]+$",
            "description": "A go_binary's package, or a go_tool's own command in its module directory, which builds the pinned tool's library."
          },
          "tags": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_,]+$"
          },
          "name": {
            "description": "A Go binary's file name.",
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "tool": {
            "description": "A Go tool's key in the toolchain pins.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "module_dir": {
            "description": "The module directory whose go.mod and go.sum select a Go tool's dependencies and which holds a go_tool's own command.",
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
          },
          "archives": {
            "description": "The committed SHA-256 of each ShellCheck or Node release archive, by file name.",
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^(shellcheck-v[0-9]+\\.[0-9]+\\.[0-9]+\\.linux\\.[a-z0-9_]+|node-v[0-9]+\\.[0-9]+\\.[0-9]+-linux-[a-z0-9]+)\\.tar\\.xz$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "mode": {
            "description": "A web bundle's Vite mode.",
            "enum": [
              "production",
              "measurement"
            ]
          },
          "inputs": {
            "description": "The repository paths a web bundle's build reads.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.][A-Za-z0-9_./-]*$"
            }
          },
          "source": {
            "description": "The frontend artifact target whose bundle embedded assets package.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "client_support": {
            "description": "The authored client support source embedded assets read.",
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "go_binary"
                }
              }
            },
            "then": {
              "required": [
                "binding",
                "directory",
                "package",
                "name"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "tool"
                    ]
                  },
                  {
                    "required": [
                      "module_dir"
                    ]
                  },
                  {
                    "required": [
                      "archives"
                    ]
                  },
                  {
                    "required": [
                      "mode"
                    ]
                  },
                  {
                    "required": [
                      "inputs"
                    ]
                  },
                  {
                    "required": [
                      "source"
                    ]
                  },
                  {
                    "required": [
                      "client_support"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "go_tool"
                }
              }
            },
            "then": {
              "required": [
                "binding",
                "directory",
                "tool"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "tags"
                    ]
                  },
                  {
                    "required": [
                      "name"
                    ]
                  },
                  {
                    "required": [
                      "archives"
                    ]
                  },
                  {
                    "required": [
                      "mode"
                    ]
                  },
                  {
                    "required": [
                      "inputs"
                    ]
                  },
                  {
                    "required": [
                      "source"
                    ]
                  },
                  {
                    "required": [
                      "client_support"
                    ]
                  }
                ]
              },
              "dependentRequired": {
                "package": [
                  "module_dir"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "shellcheck"
                }
              }
            },
            "then": {
              "required": [
                "binding",
                "directory",
                "archives"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "package"
                    ]
                  },
                  {
                    "required": [
                      "tags"
                    ]
                  },
                  {
                    "required": [
                      "name"
                    ]
                  },
                  {
                    "required": [
                      "tool"
                    ]
                  },
                  {
                    "required": [
                      "module_dir"
                    ]
                  },
                  {
                    "required": [
                      "mode"
                    ]
                  },
                  {
                    "required": [
                      "inputs"
                    ]
                  },
                  {
                    "required": [
                      "source"
                    ]
                  },
                  {
                    "required": [
                      "client_support"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "web_bundle"
                }
              }
            },
            "then": {
              "required": [
                "mode",
                "inputs",
                "target"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "package"
                    ]
                  },
                  {
                    "required": [
                      "tags"
                    ]
                  },
                  {
                    "required": [
                      "name"
                    ]
                  },
                  {
                    "required": [
                      "tool"
                    ]
                  },
                  {
                    "required": [
                      "module_dir"
                    ]
                  },
                  {
                    "required": [
                      "archives"
                    ]
                  },
                  {
                    "required": [
                      "source"
                    ]
                  },
                  {
                    "required": [
                      "client_support"
                    ]
                  },
                  {
                    "required": [
                      "binding"
                    ]
                  },
                  {
                    "required": [
                      "directory"
                    ]
                  },
                  {
                    "required": [
                      "label"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "embedded_assets"
                }
              }
            },
            "then": {
              "required": [
                "binding",
                "directory",
                "source",
                "client_support"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "package"
                    ]
                  },
                  {
                    "required": [
                      "tags"
                    ]
                  },
                  {
                    "required": [
                      "name"
                    ]
                  },
                  {
                    "required": [
                      "tool"
                    ]
                  },
                  {
                    "required": [
                      "module_dir"
                    ]
                  },
                  {
                    "required": [
                      "archives"
                    ]
                  },
                  {
                    "required": [
                      "mode"
                    ]
                  },
                  {
                    "required": [
                      "inputs"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "required": [
                "target"
              ],
              "not": {
                "properties": {
                  "kind": {
                    "const": "web_bundle"
                  }
                }
              }
            },
            "then": {
              "required": [
                "label"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "node_runtime"
                }
              }
            },
            "then": {
              "required": [
                "binding",
                "directory",
                "archives"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "package"
                    ]
                  },
                  {
                    "required": [
                      "tags"
                    ]
                  },
                  {
                    "required": [
                      "name"
                    ]
                  },
                  {
                    "required": [
                      "tool"
                    ]
                  },
                  {
                    "required": [
                      "module_dir"
                    ]
                  },
                  {
                    "required": [
                      "mode"
                    ]
                  },
                  {
                    "required": [
                      "inputs"
                    ]
                  },
                  {
                    "required": [
                      "source"
                    ]
                  },
                  {
                    "required": [
                      "client_support"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "frontend_install"
                }
              }
            },
            "then": {
              "required": [
                "binding",
                "directory"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "package"
                    ]
                  },
                  {
                    "required": [
                      "tags"
                    ]
                  },
                  {
                    "required": [
                      "name"
                    ]
                  },
                  {
                    "required": [
                      "tool"
                    ]
                  },
                  {
                    "required": [
                      "module_dir"
                    ]
                  },
                  {
                    "required": [
                      "archives"
                    ]
                  },
                  {
                    "required": [
                      "mode"
                    ]
                  },
                  {
                    "required": [
                      "inputs"
                    ]
                  },
                  {
                    "required": [
                      "source"
                    ]
                  },
                  {
                    "required": [
                      "client_support"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "playwright"
                }
              }
            },
            "then": {
              "required": [
                "binding",
                "directory"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "package"
                    ]
                  },
                  {
                    "required": [
                      "tags"
                    ]
                  },
                  {
                    "required": [
                      "name"
                    ]
                  },
                  {
                    "required": [
                      "tool"
                    ]
                  },
                  {
                    "required": [
                      "module_dir"
                    ]
                  },
                  {
                    "required": [
                      "archives"
                    ]
                  },
                  {
                    "required": [
                      "mode"
                    ]
                  },
                  {
                    "required": [
                      "inputs"
                    ]
                  },
                  {
                    "required": [
                      "source"
                    ]
                  },
                  {
                    "required": [
                      "client_support"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "test_service_images"
                }
              }
            },
            "then": {
              "required": [
                "binding",
                "directory"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "package"
                    ]
                  },
                  {
                    "required": [
                      "tags"
                    ]
                  },
                  {
                    "required": [
                      "name"
                    ]
                  },
                  {
                    "required": [
                      "tool"
                    ]
                  },
                  {
                    "required": [
                      "module_dir"
                    ]
                  },
                  {
                    "required": [
                      "archives"
                    ]
                  },
                  {
                    "required": [
                      "mode"
                    ]
                  },
                  {
                    "required": [
                      "inputs"
                    ]
                  },
                  {
                    "required": [
                      "source"
                    ]
                  },
                  {
                    "required": [
                      "client_support"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "report_renderer"
                }
              }
            },
            "then": {
              "required": [
                "binding",
                "directory"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "package"
                    ]
                  },
                  {
                    "required": [
                      "tags"
                    ]
                  },
                  {
                    "required": [
                      "name"
                    ]
                  },
                  {
                    "required": [
                      "tool"
                    ]
                  },
                  {
                    "required": [
                      "module_dir"
                    ]
                  },
                  {
                    "required": [
                      "archives"
                    ]
                  },
                  {
                    "required": [
                      "mode"
                    ]
                  },
                  {
                    "required": [
                      "inputs"
                    ]
                  },
                  {
                    "required": [
                      "source"
                    ]
                  },
                  {
                    "required": [
                      "client_support"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "release_inventory"
                }
              }
            },
            "then": {
              "required": [
                "binding",
                "directory"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "package"
                    ]
                  },
                  {
                    "required": [
                      "tags"
                    ]
                  },
                  {
                    "required": [
                      "name"
                    ]
                  },
                  {
                    "required": [
                      "tool"
                    ]
                  },
                  {
                    "required": [
                      "module_dir"
                    ]
                  },
                  {
                    "required": [
                      "archives"
                    ]
                  },
                  {
                    "required": [
                      "mode"
                    ]
                  },
                  {
                    "required": [
                      "inputs"
                    ]
                  },
                  {
                    "required": [
                      "source"
                    ]
                  },
                  {
                    "required": [
                      "client_support"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  }
