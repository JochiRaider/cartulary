{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.workspace_layout.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "directories"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.workspace_layout.v1"
    },
    "directories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "tier",
          "state",
          "producers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "path": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_./*-]+$"
          },
          "tier": {
            "enum": [
              "clean",
              "distclean"
            ]
          },
          "state": {
            "enum": [
              "current",
              "legacy"
            ]
          },
          "producers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "parent": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    }
  }
}
