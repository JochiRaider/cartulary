{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.graph_projection_conformance_matrix.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "matrix_version",
    "acceptance_criteria",
    "fixture_registry"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.graph_projection_conformance_matrix.v2"
    },
    "matrix_version": {
      "type": "integer",
      "minimum": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/acceptance_criterion"
      }
    },
    "fixture_registry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    }
  },
  "$defs": {
    "acceptance_criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "coverage_status",
        "areas",
        "fixture_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^GP-AC-[0-9]{3}$"
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "coverage_status": {
          "enum": [
            "planned",
            "implemented",
            "deferred"
          ]
        },
        "areas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "implementation",
              "tests",
              "contracts",
              "migration"
            ]
          }
        },
        "fixture_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^GP-FIX-[0-9]{3}$"
          },
          "uniqueItems": true
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "fixture_path",
        "coverage"
      ],
      "properties": {
        "fixture_id": {
          "type": "string",
          "pattern": "^GP-FIX-[0-9]{3}$"
        },
        "fixture_path": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
