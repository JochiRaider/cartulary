{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.projection_provider_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "manifest_version",
    "authority",
    "source_registry",
    "approved_production_facade_imports",
    "providers"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.projection_provider_manifest.v1" },
    "manifest_version": { "type": "integer", "minimum": 1 },
    "authority": {
      "const": "validation_only_code_backed_registry_authoritative"
    },
    "source_registry": {
      "type": "string",
      "minLength": 1
    },
    "approved_production_facade_imports": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/repo_relative_path" },
      "uniqueItems": true
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/provider" }
    }
  },
  "$defs": {
    "repo_relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "provider_status": {
      "enum": ["active", "deprecated", "experimental"]
    },
    "restore_rebuild": {
      "enum": ["required", "nonparticipating", "unsupported"]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "refresh_row",
        "restore_rebuild",
        "incident_rebuild"
      ],
      "properties": {
        "query": { "type": "boolean" },
        "refresh_row": { "type": "boolean" },
        "restore_rebuild": { "type": "boolean" },
        "incident_rebuild": { "type": "boolean" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "schema_version",
        "owner_module",
        "view_schema_ids",
        "projection_table_ids",
        "source_authorities",
        "capabilities",
        "restore_rebuild",
        "status",
        "facade_packages",
        "rebuild_after",
        "characterization_refs"
      ],
      "properties": {
        "provider_id": { "$ref": "#/$defs/identifier" },
        "schema_version": {
          "const": "projection_provider_descriptor.v1"
        },
        "owner_module": { "$ref": "#/$defs/identifier" },
        "view_schema_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^cartulary\\.view\\.[a-z0-9_]+\\.v[0-9]+$"
          },
          "uniqueItems": true
        },
        "projection_table_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "source_authorities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "restore_rebuild": { "$ref": "#/$defs/restore_rebuild" },
        "status": { "$ref": "#/$defs/provider_status" },
        "facade_packages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_relative_path" },
          "uniqueItems": true
        },
        "rebuild_after": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "characterization_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/repo_relative_path" },
          "uniqueItems": true
        }
      }
    }
  }
}
