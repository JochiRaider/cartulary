{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.openapi_compatibility_waivers.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "baseline_sha256",
    "response_waivers",
    "security_classification_waivers",
    "security_scheme_waivers",
    "component_waivers",
    "path_parameter_waivers"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.openapi_compatibility_waivers.v1" },
    "baseline_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "response_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/operationWaiver" }
    },
    "security_classification_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/operationWaiver" }
    },
    "security_scheme_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/namedWaiver" }
    },
    "component_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/namedWaiver" }
    },
    "path_parameter_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/pathParameterWaiver" }
    }
  },
  "$defs": {
    "ownerId": {
      "type": "string",
      "pattern": "^(?:module|platform|app|web|package|harness)\\.[a-z][a-z0-9_]{0,62}$"
    },
    "correctionId": {
      "type": "string",
      "pattern": "^OAPI-CORR-[0-9]{2}[A-Z]?$"
    },
    "operationWaiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "owner_id", "correction_id", "reason", "removal_condition", "operation_ids"],
      "properties": {
        "waiver_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
        "owner_id": { "$ref": "#/$defs/ownerId" },
        "correction_id": { "$ref": "#/$defs/correctionId" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "removal_condition": { "type": "string", "minLength": 1, "maxLength": 500 },
        "operation_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" }
        }
      }
    },
    "namedWaiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "owner_id", "correction_id", "reason", "removal_condition", "name"],
      "properties": {
        "waiver_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
        "owner_id": { "$ref": "#/$defs/ownerId" },
        "correction_id": { "$ref": "#/$defs/correctionId" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "removal_condition": { "type": "string", "minLength": 1, "maxLength": 500 },
        "name": { "type": "string", "minLength": 1, "maxLength": 191 }
      }
    },
    "pathParameterWaiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "owner_id", "correction_id", "reason", "removal_condition", "operations"],
      "properties": {
        "waiver_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
        "owner_id": { "$ref": "#/$defs/ownerId" },
        "correction_id": { "$ref": "#/$defs/correctionId" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "removal_condition": { "type": "string", "minLength": 1, "maxLength": 500 },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "path", "operation_id", "missing_parameters"],
            "properties": {
              "method": {
                "enum": ["DELETE", "GET", "HEAD", "OPTIONS", "PATCH", "POST", "PUT", "TRACE"]
              },
              "path": {
                "type": "string",
                "pattern": "^/api/v1/"
              },
              "operation_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9]*$"
              },
              "missing_parameters": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              }
            }
          }
        }
      }
    }
  }
}
