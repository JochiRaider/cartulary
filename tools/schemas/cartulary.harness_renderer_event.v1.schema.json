{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_renderer_event.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "run_id",
    "allocation_id",
    "generation",
    "slot_id",
    "runtime_profile_id",
    "state",
    "unit_id",
    "borrow_id"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.harness_renderer_event.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "allocation_id": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "generation": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "slot_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "runtime_profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "state": {
      "enum": [
        "provisioning",
        "borrowed",
        "settling",
        "ready",
        "quarantine",
        "retired"
      ]
    },
    "unit_id": {
      "type": "string",
      "maxLength": 4096
    },
    "borrow_id": {
      "type": "string",
      "maxLength": 36
    }
  }
}
