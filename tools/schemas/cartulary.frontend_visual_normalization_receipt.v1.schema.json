{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.frontend_visual_normalization_receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "cartulary.frontend_visual_normalization_receipt.v1"
    },
    "capture": {
      "type": "string",
      "minLength": 1
    },
    "inventory": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "expected_count": {
            "type": "integer",
            "minimum": 0
          },
          "applied_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "target",
          "expected_count",
          "applied_count"
        ]
      }
    },
    "capture_id": {
      "type": "string",
      "pattern": "^visual\\.capture\\.[a-f0-9]{20}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_id",
    "capture",
    "inventory",
    "rules",
    "capture_id",
    "policy_sha256"
  ]
}
