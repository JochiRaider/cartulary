{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.browser_startup_event.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "suite_id",
    "browser_session_id",
    "runtime_profile_id",
    "sequence",
    "emitted_at",
    "state",
    "message"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.browser_startup_event.v1" },
    "suite_id": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+$" },
    "browser_session_id": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+$" },
    "runtime_profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "sequence": { "type": "integer", "minimum": 1 },
    "emitted_at": { "type": "string", "format": "date-time" },
    "monotonic_ms": { "type": "integer", "minimum": 0 },
    "state": {
      "enum": [
        "initializing",
        "service_attached",
        "fixture_ready",
        "backend_ready",
        "frontend_ready",
        "ready",
        "failed"
      ]
    },
    "failure_class": { "enum": ["config", "infra"] },
    "failure_reason": {
      "enum": [
        "configuration_error",
        "resource_conflict",
        "service_readiness_timeout",
        "service_start_error"
      ]
    },
    "message": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "artifact_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "failed" } } },
      "then": { "required": ["failure_class", "failure_reason"] },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["failure_class"] },
            { "required": ["failure_reason"] }
          ]
        }
      }
    }
  ]
}
