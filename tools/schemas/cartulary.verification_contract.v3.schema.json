{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.verification_contract.v3",
  "title": "Cartulary verification contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "owner_id",
    "verifications"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.verification_contract.v3"
    },
    "owner_id": {
      "$ref": "#/$defs/ownerId"
    },
    "verifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "verification_id",
          "behavior_class",
          "profile",
          "evidence_kinds"
        ],
        "properties": {
          "verification_id": {
            "$ref": "#/$defs/verificationId"
          },
          "behavior_class": {
            "enum": [
              "product",
              "security",
              "architecture",
              "build",
              "harness",
              "claim_publication"
            ]
          },
          "profile": {
            "type": "string",
            "pattern": "^(?:base|support|extension\\.[a-z][a-z0-9_]{0,62}|claim\\.[a-z][a-z0-9_]{0,62})$"
          },
          "evidence_kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "go_test",
                "vitest",
                "playwright",
                "shell",
                "static_check",
                "artifact_audit",
                "release_check"
              ]
            }
          },
          "public_target": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "skip_policy": {
            "$ref": "#/$defs/skipPolicy"
          }
        }
      }
    }
  },
  "$defs": {
    "ownerId": {
      "type": "string",
      "pattern": "^(?:module|platform|app|web|package|harness)\\.(?!phase[0-9]+$|fe_p[0-9]+$)[a-z][a-z0-9_]{0,62}$",
      "maxLength": 191
    },
    "verificationId": {
      "type": "string",
      "pattern": "^(?:module|platform|app|web|package|harness)\\.(?!phase[0-9]+\\.|fe_p[0-9]+\\.)[a-z][a-z0-9_]{0,62}\\.verification\\.(?!phase[0-9]+$|fe_p[0-9]+$)[a-z][a-z0-9_]{0,62}$",
      "maxLength": 191
    },
    "skipPolicy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "forbid"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "reason_code",
            "owner_id",
            "approval_ref",
            "expires_at"
          ],
          "properties": {
            "mode": {
              "const": "authorize"
            },
            "reason_code": {
              "enum": [
                "known_product_defect",
                "external_dependency_unavailable",
                "platform_compatibility_exception",
                "temporary_quarantine"
              ]
            },
            "owner_id": {
              "$ref": "#/$defs/ownerId"
            },
            "approval_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "expires_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            }
          }
        }
      ]
    }
  }
}
