{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.otel_conformance_summary.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "target",
    "status",
    "checked_at",
    "source_snapshot_path",
    "checks"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.otel_conformance_summary.v1" },
    "target": { "const": "otel-conformance" },
    "status": { "enum": ["pass", "fail"] },
    "checked_at": { "type": "string", "format": "date-time" },
    "source_snapshot_path": { "const": "contracts/otel/otel_source_snapshot.v1.json" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "message"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+$"
          },
          "status": { "enum": ["pass", "fail"] },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
