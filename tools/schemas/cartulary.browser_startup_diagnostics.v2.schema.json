{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.browser_startup_diagnostics.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "suite_id",
    "browser_session_id",
    "runtime_profile_id",
    "generated_at",
    "status",
    "startup_phase",
    "message",
    "events_ref",
    "events_sha256",
    "frontend_mode",
    "frontend_command_kind"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.browser_startup_diagnostics.v2" },
    "suite_id": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+$" },
    "browser_session_id": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+$" },
    "runtime_profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["ready", "failed"] },
    "startup_phase": {
      "enum": [
        "initializing",
        "service_attached",
        "fixture_ready",
        "backend_ready",
        "frontend_ready",
        "ready",
        "failed"
      ]
    },
    "failure_class": { "enum": ["config", "infra"] },
    "failure_reason": {
      "enum": [
        "configuration_error",
        "resource_conflict",
        "service_readiness_timeout",
        "service_start_error"
      ]
    },
    "message": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "events_ref": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "events_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "frontend_mode": { "const": "preview" },
    "frontend_command_kind": { "const": "vite-preview" },
    "api_origin": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+$" },
    "public_origin": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+$" },
    "artifact_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "failed" } } },
      "then": {
        "required": ["failure_class", "failure_reason"],
        "properties": { "startup_phase": { "const": "failed" } }
      },
      "else": {
        "properties": { "startup_phase": { "const": "ready" } },
        "not": {
          "anyOf": [
            { "required": ["failure_class"] },
            { "required": ["failure_reason"] }
          ]
        }
      }
    }
  ]
}
