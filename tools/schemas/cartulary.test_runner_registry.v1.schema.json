{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.test_runner_registry.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "runners"],
  "properties": {
    "schema_id": { "const": "cartulary.test_runner_registry.v1" },
    "runners": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runner", "selector_kind", "adapter_path", "approved_roots"],
        "properties": {
          "runner": { "enum": ["go", "vitest", "playwright", "shell"] },
          "selector_kind": { "enum": ["go_exact_tests", "vitest_exact_titles", "playwright_exact_scenarios", "shell_registered_command"] },
          "adapter_path": { "type": "string", "pattern": "^tools/harness/execution/runners/[a-z]+\\.mjs$" },
          "approved_roots": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:internal|cmd|apps|packages|tools)(?:/[A-Za-z0-9._@+-]+)*$" } },
          "project_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" } },
          "stages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["webserver_backed", "stateful", "support", "visual", "accessibility", "measurement"] } }
        }
      }
    }
  }
}
