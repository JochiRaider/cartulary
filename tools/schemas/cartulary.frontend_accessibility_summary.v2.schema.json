{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.frontend_accessibility_summary.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "status",
    "phase_rows",
    "scenarios",
    "keyboard_matrix",
    "state_communication_checks",
    "contrast_checks",
    "violations",
    "artifact_refs"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.frontend_accessibility_summary.v2"
    },
    "status": {
      "enum": ["pass", "fail"]
    },
    "phase_rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/phase_row"
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "keyboard_matrix": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "state_communication_checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "contrast_checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contrast_check"
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/violation"
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_ref"
      }
    }
  },
  "$defs": {
    "phase_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "phase_id",
        "evidence_class",
        "claim_status",
        "targets"
      ],
      "properties": {
        "row_id": {
          "type": "string",
          "pattern": "^FE-A11Y-P(?:0|[1-9][0-9]*)-[0-9]{2}$"
        },
        "phase_id": {
          "type": "string",
          "pattern": "^FE-P(?:0|[1-9][0-9]*)$"
        },
        "evidence_class": {
          "enum": ["design_direction"]
        },
        "claim_status": {
          "const": "implemented"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/target_ref"
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_id", "title", "status"],
      "properties": {
        "row_id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["pass", "fail", "missing", "skipped"]
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_id", "title", "result", "coverage"],
      "properties": {
        "row_id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": ["pass", "fail"]
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "contrast_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "title",
        "result",
        "coverage",
        "target",
        "ratio",
        "threshold",
        "foreground",
        "background"
      ],
      "properties": {
        "row_id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": ["pass", "fail"]
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "ratio": {
          "type": "number",
          "minimum": 0
        },
        "threshold": {
          "type": "number",
          "minimum": 0
        },
        "foreground": {
          "type": "string",
          "minLength": 1
        },
        "background": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "row_id", "title", "message"],
      "properties": {
        "severity": {
          "enum": ["blocking"]
        },
        "row_id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_name",
        "command_id",
        "evidence_role",
        "required_for_closure",
        "frontend_row_accounting_required",
        "scenario_title_required"
      ],
      "properties": {
        "target_name": {
          "type": "string",
          "minLength": 1
        },
        "command_id": {
          "type": "string",
          "pattern": "^cartulary\\.harness\\.command\\.[a-z0-9_]+\\.v1$"
        },
        "evidence_role": {
          "enum": ["primary", "supporting", "drift", "diagnostic_only"]
        },
        "required_for_closure": {
          "type": "boolean"
        },
        "frontend_row_accounting_required": {
          "type": "boolean"
        },
        "scenario_title_required": {
          "type": "boolean"
        }
      }
    }
  }
}
