{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.protocol_ts_http_operations.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "owner_id", "operation_ids", "forward_tolerant_response_operation_ids"],
  "properties": {
    "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
    "schema_id": { "const": "cartulary.protocol_ts_http_operations.v1" },
    "owner_id": { "const": "package.protocol_ts" },
    "operation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" }
    },
    "forward_tolerant_response_operation_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" }
    }
  }
}
