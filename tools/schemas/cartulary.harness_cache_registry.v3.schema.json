{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_cache_registry.v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "profiles"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.harness_cache_registry.v3"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "policy",
          "dependency_strategy",
          "input_roots",
          "requires_vulnerability_database_revision",
          "operation_ids",
          "runner_types"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "policy": {
            "enum": [
              "same_run",
              "content_addressed"
            ]
          },
          "dependency_strategy": {
            "enum": [
              "broad",
              "unit_aware"
            ]
          },
          "input_roots": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._@+-][A-Za-z0-9._@+/-]*$",
              "not": {
                "pattern": "(?:^|/)\\.\\.(?:/|$)"
              }
            }
          },
          "unit_inputs": {
            "description": "Inputs every unit-aware closure includes beside its selected packages or workspaces: paths (each with everything beneath it) and path prefixes (every path that starts with the prefix).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "paths",
              "prefixes"
            ],
            "properties": {
              "paths": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._@+-][A-Za-z0-9._@+/-]*$",
                  "not": {
                    "pattern": "(?:^|/)\\.\\.(?:/|$)"
                  }
                }
              },
              "prefixes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._@+-][A-Za-z0-9._@+/-]*$",
                  "not": {
                    "pattern": "(?:^|/)\\.\\.(?:/|$)"
                  }
                }
              }
            }
          },
          "requires_vulnerability_database_revision": {
            "type": "boolean"
          },
          "operation_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^harness\\.[a-z][a-z0-9_]*$"
            }
          },
          "runner_types": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "go",
                "vitest"
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "dependency_strategy": {
                  "const": "unit_aware"
                }
              },
              "required": [
                "dependency_strategy"
              ]
            },
            "then": {
              "required": [
                "unit_inputs"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "unit_inputs"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
