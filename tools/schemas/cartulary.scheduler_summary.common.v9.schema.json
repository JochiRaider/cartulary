{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.scheduler_summary.common.v9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "target",
    "status",
    "failure_class",
    "failure_reason",
    "failure_classes",
    "failure_reasons",
    "failures",
    "failure_headline",
    "scheduler_kind",
    "total_work_units",
    "completed_work_units",
    "scheduler_started_monotonic_ms",
    "scheduler_completed_monotonic_ms",
    "scheduler_total_duration_ms",
    "scheduler_started_at",
    "scheduler_completed_at",
    "critical_path_wall_duration_ms",
    "critical_path_units",
    "critical_path_blockers",
    "critical_path_terminal_unit",
    "skipped_work_units",
    "failed_work_unit",
    "failed_work_unit_detail",
    "resource_limits",
    "resource_limit_sources",
    "max_running_work_units",
    "max_running_groups",
    "max_active_resource_claims",
    "blocked_reasons_seen",
    "blocked_resources_seen",
    "blocked_explanations_seen",
    "waiting_on_seen",
    "top_blockers",
    "slowest_work_units",
    "nested_scheduler_limits",
    "nested_scheduler_observations",
    "finalizer_count",
    "finalizer_failures",
    "finalizer_timings",
    "artifacts"
  ],
  "properties": {
    "schema_id": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "status": { "$ref": "cartulary.harness.defs.v1#/$defs/status" },
    "failure_class": { "$ref": "cartulary.harness.defs.v1#/$defs/failure_class" },
    "failure_reason": { "$ref": "cartulary.harness.defs.v1#/$defs/failure_reason" },
    "failure_classes": { "$ref": "cartulary.harness.defs.v1#/$defs/counts" },
    "failure_reasons": { "$ref": "cartulary.harness.defs.v1#/$defs/counts" },
    "failures": { "type": "array", "items": { "type": "object" } },
    "failure_headline": { "type": "string" },
    "scheduler_kind": { "type": "string" },
    "total_work_units": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "completed_work_units": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "scheduler_started_monotonic_ms": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_number" },
    "scheduler_completed_monotonic_ms": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_number" },
    "scheduler_total_duration_ms": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_number" },
    "scheduler_started_at": { "$ref": "cartulary.harness.defs.v1#/$defs/timestamp" },
    "scheduler_completed_at": { "$ref": "cartulary.harness.defs.v1#/$defs/timestamp" },
    "critical_path_wall_duration_ms": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_number" },
    "critical_path_units": { "type": "array", "items": { "type": "object" } },
    "critical_path_blockers": { "type": "array", "items": { "type": "object" } },
    "critical_path_terminal_unit": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "skipped_work_units": { "type": "array", "items": { "type": "object" } },
    "failed_work_unit": { "type": ["string", "null"] },
    "failed_work_unit_detail": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "resource_limits": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "resource_limit_sources": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "max_running_work_units": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "max_running_groups": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "max_active_resource_claims": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "blocked_reasons_seen": { "type": "array", "items": { "type": "string" } },
    "blocked_resources_seen": { "type": "array", "items": { "type": "string" } },
    "blocked_explanations_seen": { "type": "array", "items": { "type": "string" } },
    "waiting_on_seen": { "type": "array", "items": { "type": "string" } },
    "top_blockers": { "type": "array", "items": { "type": "object" } },
    "slowest_work_units": { "type": "array", "items": { "type": "object" } },
    "nested_scheduler_limits": { "type": "array", "items": { "type": "object" } },
    "nested_scheduler_observations": { "type": "array", "items": { "type": "object" } },
    "finalizer_count": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "finalizer_failures": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "finalizer_timings": { "type": "array", "items": { "type": "object" } },
    "progress_snapshots": { "type": "array", "items": { "type": "object" } },
    "slowest_running_observations": { "type": "array", "items": { "type": "object" } },
    "phase": { "type": "string" },
    "mode": { "type": "string" },
    "child_targets": { "type": "array", "items": { "type": "string" } },
    "started_count": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "service_sessions": { "type": "array", "items": { "$ref": "#/$defs/service_session" } },
    "browser_stage_sessions": { "type": "array", "items": { "type": "object" } },
    "artifacts": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "extensions": { "$ref": "cartulary.harness.defs.v1#/$defs/extensions" }
  },
  "$defs": {
    "nullable_non_negative_number": {
      "oneOf": [
        { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_number" },
        { "type": "null" }
      ]
    },
    "service_session": {
      "type": "object",
      "required": [
        "target",
        "env_file",
        "lease_file",
        "metadata_dir",
        "cleanup_status",
        "setup_duration_ms",
        "ready_at_monotonic_ms",
        "child_work_started_at_monotonic_ms",
        "cleanup_duration_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "env_file": { "type": "string", "minLength": 1 },
        "lease_file": { "type": "string", "minLength": 1 },
        "metadata_dir": { "type": "string", "minLength": 1 },
        "cleanup_status": { "type": "string", "minLength": 1 },
        "setup_duration_ms": { "$ref": "#/$defs/nullable_non_negative_number" },
        "ready_at_monotonic_ms": { "$ref": "#/$defs/nullable_non_negative_number" },
        "child_work_started_at_monotonic_ms": { "$ref": "#/$defs/nullable_non_negative_number" },
        "cleanup_duration_ms": { "$ref": "#/$defs/nullable_non_negative_number" }
      }
    }
  }
}
