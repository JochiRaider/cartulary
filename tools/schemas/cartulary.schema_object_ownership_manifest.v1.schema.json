{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.schema_object_ownership_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "migration_root",
    "synthetic_objects",
    "allowed_owners",
    "allowed_profiles",
    "entries"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.schema_object_ownership_manifest.v1" },
    "migration_root": { "type": "string", "minLength": 1 },
    "synthetic_objects": {
      "type": "array",
      "items": { "$ref": "#/$defs/synthetic_object" },
      "uniqueItems": true
    },
    "allowed_owners": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "uniqueItems": true
    },
    "allowed_profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "uniqueItems": true
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ownership_entry" }
    }
  },
  "$defs": {
    "kind": {
      "enum": [
        "any",
        "bookkeeping",
        "constraint",
        "data_backfill",
        "extension",
        "function",
        "generated_column",
        "index",
        "table",
        "trigger",
        "type",
        "view"
      ]
    },
    "profile_list": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "uniqueItems": true
    },
    "surface_list": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "synthetic_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "source",
        "owner",
        "profiles",
        "downstream_surfaces",
        "notes"
      ],
      "properties": {
        "kind": { "$ref": "#/$defs/kind" },
        "name": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "profiles": { "$ref": "#/$defs/profile_list" },
        "downstream_surfaces": { "$ref": "#/$defs/surface_list" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "object_pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name_pattern"],
      "properties": {
        "kind": { "$ref": "#/$defs/kind" },
        "name_pattern": { "type": "string", "minLength": 1 }
      }
    },
    "ownership_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "profiles",
        "object_patterns",
        "downstream_surfaces",
        "notes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "owner": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "profiles": { "$ref": "#/$defs/profile_list" },
        "object_patterns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/object_pattern" }
        },
        "downstream_surfaces": { "$ref": "#/$defs/surface_list" },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
