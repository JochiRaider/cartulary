{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.scheduler_event.v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "target",
    "scheduler_kind",
    "seq",
    "event",
    "monotonic_ms",
    "emitted_at",
    "pending",
    "running",
    "total_work_units",
    "blocked",
    "completed",
    "blocked_reason",
    "blocked_resources",
    "waiting_on",
    "blocked_units",
    "active_resource_claims",
    "resource_limits",
    "resource_limit_sources"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.scheduler_event.v6" },
    "target": { "type": "string", "minLength": 1 },
    "scheduler_kind": { "type": "string" },
    "seq": { "type": "integer", "minimum": 1 },
    "event": { "type": "string", "minLength": 1 },
    "monotonic_ms": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_number" },
    "emitted_at": { "$ref": "cartulary.harness.defs.v1#/$defs/timestamp" },
    "pending": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "running": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "total_work_units": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "blocked": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "completed": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "blocked_reason": { "type": ["string", "null"] },
    "blocked_resources": { "type": "array", "items": { "type": "string" } },
    "waiting_on": { "type": "array", "items": { "type": "string" } },
    "blocked_units": { "type": "array", "items": { "type": "object" } },
    "active_resource_claims": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "resource_limits": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "resource_limit_sources": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "pending_finalizers": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "running_finalizers": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "scheduler_started_monotonic_ms": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_number" },
    "scheduler_started_at": { "$ref": "cartulary.harness.defs.v1#/$defs/timestamp" },
    "clock_skew": { "type": "object" },
    "work_unit": { "type": "string" },
    "work_unit_id": { "type": "string" },
    "work_unit_type": { "type": "string" },
    "work_unit_class": { "type": "string" },
    "aggregate_target": { "type": ["string", "null"] },
    "resource_claims": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "log_file": { "type": "string" },
    "status": { "type": "integer" },
    "duration_ms": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_number" },
    "finalizer": { "type": "string" },
    "finalizer_id": { "type": "string" },
    "shards": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "active_groups": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "blocked_by": { "type": "array", "items": { "type": "string" } },
    "unblocks_after": {
      "anyOf": [
        { "type": "array", "items": { "type": "object" } },
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "slowest_running": {
      "anyOf": [
        { "type": "array", "items": { "type": "object" } },
        { "type": "object" },
        { "type": "null" }
      ]
    },
    "nested_scheduler_progress": { "type": "array", "items": { "type": "object" } },
    "nested_scheduler": { "$ref": "cartulary.harness.defs.v1#/$defs/free_object" },
    "skip_reason": { "type": "string" },
    "failed_dependency": { "type": "string" },
    "extensions": { "$ref": "cartulary.harness.defs.v1#/$defs/extensions" }
  }
}
