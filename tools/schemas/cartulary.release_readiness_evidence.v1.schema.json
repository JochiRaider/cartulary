{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.release_readiness_evidence.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "status",
    "generated_at",
    "run_root",
    "evidence_records",
    "rollup",
    "failures"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.release_readiness_evidence.v1"
    },
    "status": {
      "enum": ["pass", "fail"]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_root": {
      "type": "string",
      "minLength": 1
    },
    "evidence_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence_record"
      }
    },
    "rollup": {
      "$ref": "#/$defs/rollup"
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_target",
        "schema_id",
        "owner_refs",
        "evidence_class",
        "conformance_effect",
        "claim_publication_effect",
        "release_gate_effect",
        "run_root",
        "artifact_refs",
        "status"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "source_target": {
          "type": "string",
          "minLength": 1
        },
        "schema_id": {
          "type": "string",
          "minLength": 1
        },
        "owner_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidence_class": {
          "enum": [
            "claim_publication_boundary",
            "design_direction",
            "diagnostic",
            "harness",
            "implementation_support",
            "product_conformance",
            "release_readiness",
            "support",
            "TODO_owner_lookup"
          ]
        },
        "conformance_effect": {
          "enum": [
            "no_product_conformance",
            "not_applicable",
            "owner_unresolved",
            "product_conformance"
          ]
        },
        "claim_publication_effect": {
          "enum": [
            "claim_boundary_only",
            "claim_publication_evidence",
            "not_applicable",
            "not_claim_bearing",
            "requires_core05_review"
          ]
        },
        "release_gate_effect": {
          "enum": ["blocked", "diagnostic_only", "required", "supporting"]
        },
        "run_root": {
          "type": "string",
          "minLength": 1
        },
        "artifact_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        },
        "status": {
          "enum": [
            "blocked",
            "diagnostic_only",
            "failed",
            "missing",
            "passed",
            "stale"
          ]
        }
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "kind", "path"],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rollup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "passed",
        "failed",
        "missing",
        "blocked",
        "stale",
        "diagnostic_only",
        "required_total",
        "required_passed",
        "required_failed"
      ],
      "properties": {
        "total": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "passed": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "failed": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "missing": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "blocked": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "stale": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "diagnostic_only": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "required_total": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "required_passed": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "required_failed": {
          "$ref": "#/$defs/non_negative_integer"
        }
      }
    },
    "non_negative_integer": {
      "type": "integer",
      "minimum": 0
    }
  }
}
