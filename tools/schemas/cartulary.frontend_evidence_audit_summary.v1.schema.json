{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.frontend_evidence_audit_summary.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "status",
    "phase_namespace",
    "phase_id",
    "roots",
    "digests",
    "targets",
    "rows",
    "failures"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.frontend_evidence_audit_summary.v1"
    },
    "status": {
      "enum": ["pass", "fail"]
    },
    "phase_namespace": {
      "type": "string"
    },
    "phase_id": {
      "type": "string"
    },
    "roots": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_name", "root", "target_dir", "accounting"],
      "properties": {
        "target_name": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "target_dir": {
          "type": "string",
          "minLength": 1
        },
        "accounting": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_id", "target_name", "status"],
      "properties": {
        "row_id": {
          "type": "string",
          "pattern": "^FE-(?:U|I|B|E|V|A11Y|S)-P(?:0|[1-9][0-9]*)-[0-9]{2}$"
        },
        "target_name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "blocked",
            "closed",
            "missing",
            "missing_accounting",
            "not_applicable",
            "not_closed",
            "stale"
          ]
        },
        "evidence_class": {
          "enum": [
            "claim_publication_boundary",
            "design_direction",
            "implementation_support",
            "product_conformance",
            "TODO_owner_lookup"
          ]
        },
        "accounting": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
