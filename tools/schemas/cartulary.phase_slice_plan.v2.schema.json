{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.phase_slice_plan.v2",
  "type": "object",
  "required": [
    "schema_id",
    "phase_namespace",
    "target",
    "phase",
    "selection",
    "mode",
    "no_op",
    "phase_claim_status",
    "claim_status_counts",
    "row_groups",
    "service_requirements",
    "child_targets",
    "resource_limits",
    "work_units"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_id": { "const": "cartulary.phase_slice_plan.v2" },
    "phase_namespace": { "enum": ["base", "frontend"] },
    "target": { "enum": ["phase-slice", "service-backed-slice"] },
    "phase": { "type": "string", "minLength": 1 },
    "selection": {
      "type": "object",
      "required": [
        "mode",
        "phase_span",
        "dependency_scope",
        "completion_scope",
        "requested_row_ids",
        "resolved_row_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["default", "exact_rows"] },
        "phase_span": { "enum": ["exact_phase", "through_phase"] },
        "dependency_scope": { "enum": ["all", "service_backed"] },
        "completion_scope": { "enum": ["full_phase", "selected_subset"] },
        "requested_row_ids": { "$ref": "#/$defs/unique_string_array" },
        "resolved_row_ids": { "$ref": "#/$defs/unique_string_array" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "exact_rows" } }, "required": ["mode"] },
          "then": {
            "properties": {
              "completion_scope": { "const": "selected_subset" },
              "requested_row_ids": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "default" } }, "required": ["mode"] },
          "then": { "properties": { "requested_row_ids": { "maxItems": 0 } } }
        }
      ]
    },
    "mode": { "enum": ["phase", "service_backed"] },
    "service_backed_only": { "type": "boolean" },
    "no_op": { "type": "boolean" },
    "phase_claim_status": {
      "enum": ["complete", "incomplete", "not_applicable"]
    },
    "claim_status_counts": {
      "type": "object",
      "required": ["implemented", "blocked", "not_applicable", "unspecified"],
      "additionalProperties": false,
      "properties": {
        "implemented": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "not_applicable": { "type": "integer", "minimum": 0 },
        "unspecified": { "type": "integer", "minimum": 0 }
      }
    },
    "row_groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/open_object" }
    },
    "service_requirements": { "$ref": "#/$defs/string_array" },
    "child_targets": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "$ref": "#/$defs/open_object" }
        ]
      }
    },
    "child_target_names": { "$ref": "#/$defs/string_array" },
    "runtime_binaries": { "$ref": "#/$defs/string_array" },
    "resource_limits": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/resource_amount" }
    },
    "work_units": {
      "type": "array",
      "items": { "$ref": "#/$defs/work_unit" }
    },
    "total_work_units": { "type": "integer", "minimum": 0 },
    "finalizer_count": { "type": "integer", "minimum": 0 }
  },
  "allOf": [
    {
      "if": { "properties": { "target": { "const": "service-backed-slice" } }, "required": ["target"] },
      "then": {
        "properties": {
          "mode": { "const": "service_backed" },
          "selection": {
            "properties": {
              "dependency_scope": { "const": "service_backed" },
              "completion_scope": { "const": "selected_subset" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "target": { "const": "phase-slice" } }, "required": ["target"] },
      "then": {
        "properties": {
          "mode": { "const": "phase" },
          "selection": { "properties": { "dependency_scope": { "const": "all" } } }
        }
      }
    },
    {
      "if": { "properties": { "phase_namespace": { "const": "base" } }, "required": ["phase_namespace"] },
      "then": { "properties": { "selection": { "properties": { "phase_span": { "const": "exact_phase" } } } } }
    }
  ],
  "$defs": {
    "string_array": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "unique_string_array": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "resource_amount": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "const": "auto" },
        { "const": "limit" }
      ]
    },
    "open_object": { "type": "object" },
    "work_unit": {
      "type": "object",
      "required": ["id", "label", "kind", "target", "needs", "resource_claims"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "needs": { "$ref": "#/$defs/string_array" },
        "resource_claims": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/resource_amount" }
        }
      }
    }
  }
}
