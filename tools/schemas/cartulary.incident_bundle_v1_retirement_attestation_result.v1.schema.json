{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.incident_bundle_v1_retirement_attestation_result.v1",
  "title": "Cartulary Incident Bundle v1 retirement attestation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "eligible",
    "cutoff_date",
    "input_digest",
    "compatibility_snapshot_digest",
    "stable_release_count",
    "minimum_stable_releases",
    "eligibility_date",
    "elapsed_days",
    "minimum_retention_days",
    "telemetry_interval_days",
    "successful_v1_imports",
    "inventory_classes_expected",
    "inventory_classes_covered",
    "v1_required_archives",
    "release_evidence",
    "telemetry_evidence_digest",
    "inventory_evidence_digest",
    "gates"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.incident_bundle_v1_retirement_attestation_result.v1" },
    "eligible": { "const": true },
    "cutoff_date": { "$ref": "#/$defs/date" },
    "input_digest": { "$ref": "#/$defs/digest" },
    "compatibility_snapshot_digest": { "$ref": "#/$defs/digest" },
    "stable_release_count": { "const": 3 },
    "minimum_stable_releases": { "const": 3 },
    "eligibility_date": { "$ref": "#/$defs/date" },
    "elapsed_days": { "type": "integer", "minimum": 180 },
    "minimum_retention_days": { "const": 180 },
    "telemetry_interval_days": { "const": 30 },
    "successful_v1_imports": { "const": 0 },
    "inventory_classes_expected": { "type": "integer", "minimum": 1 },
    "inventory_classes_covered": { "type": "integer", "minimum": 1 },
    "v1_required_archives": { "const": 0 },
    "release_evidence": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "release_identity",
          "published_on",
          "run_manifest_digest",
          "run_summary_digest",
          "target_summary_digest",
          "source_digest",
          "publication_evidence_digest"
        ],
        "properties": {
          "role": { "enum": ["adopting", "subsequent_1", "subsequent_2"] },
          "release_identity": { "$ref": "#/$defs/releaseIdentity" },
          "published_on": { "$ref": "#/$defs/date" },
          "run_manifest_digest": { "$ref": "#/$defs/digest" },
          "run_summary_digest": { "$ref": "#/$defs/digest" },
          "target_summary_digest": { "$ref": "#/$defs/digest" },
          "source_digest": { "$ref": "#/$defs/digest" },
          "publication_evidence_digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "telemetry_evidence_digest": { "$ref": "#/$defs/digest" },
    "inventory_evidence_digest": { "$ref": "#/$defs/digest" },
    "gates": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "state"],
        "properties": {
          "gate_id": {
            "enum": [
              "IB-R3-GATE-001",
              "IB-R3-GATE-002",
              "IB-R3-GATE-003",
              "IB-R3-GATE-004",
              "IB-R3-GATE-005"
            ]
          },
          "state": { "const": "pass" }
        }
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "releaseIdentity": {
      "type": "string",
      "pattern": "^v?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "maxLength": 64
    }
  }
}
