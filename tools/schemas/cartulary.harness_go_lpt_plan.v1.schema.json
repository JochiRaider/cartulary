{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_go_lpt_plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "available_go_lanes", "target_shard_count", "shards", "plan_digest"],
  "properties": {
    "schema_id": { "const": "cartulary.harness_go_lpt_plan.v1" },
    "available_go_lanes": { "type": "integer", "minimum": 1 },
    "target_shard_count": { "type": "integer", "minimum": 2 },
    "shards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shard_id", "compatibility_digest", "item_ids", "estimated_work_ms", "isolated"],
        "properties": {
          "shard_id": { "type": "string", "pattern": "^go:[a-f0-9]{16}:[a-f0-9]{12}:[0-9]{3}$" },
          "compatibility_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "item_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "estimated_work_ms": { "type": "integer", "minimum": 1 },
          "isolated": { "type": "boolean" }
        }
      }
    },
    "plan_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
