{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_review_registry.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "session_id",
    "locator",
    "repository",
    "process",
    "started_tick_ns",
    "token",
    "socket",
    "socket_device",
    "socket_inode",
    "runtime",
    "resources_released",
    "presentation",
    "profile",
    "review",
    "outcome",
    "publication"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.harness_review_registry.v2"
    },
    "session_id": {
      "type": "string",
      "pattern": "^uireview-[a-f0-9]{32}$"
    },
    "locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boot",
        "pid",
        "start"
      ],
      "properties": {
        "boot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "pid": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2147483647
        },
        "start": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 32
        }
      }
    },
    "started_tick_ns": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "maxLength": 32
    },
    "token": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "socket": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "socket_device": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "socket_inode": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "lease_id",
        "run_id"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "lease_id": {
          "type": "string",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "maxLength": 96
        }
      }
    },
    "resources_released": {
      "type": "boolean"
    },
    "presentation": {
      "enum": [
        "ui",
        "design"
      ]
    },
    "profile": {
      "enum": [
        "",
        "default",
        "network_flow_claimed"
      ]
    },
    "review": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "cartulary.harness_review_design_ready.v1"
        }
      ]
    },
    "outcome": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "cartulary.ui_review_receipt.v2"
        }
      ]
    },
    "publication": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "locator",
            "detail_purged",
            "terminal_published",
            "locator_published",
            "scanned",
            "runtime_removed",
            "extras"
          ],
          "properties": {
            "locator": {
              "$ref": "cartulary.ui_review_session.v1"
            },
            "detail_purged": {
              "type": "boolean"
            },
            "terminal_published": {
              "type": "boolean"
            },
            "locator_published": {
              "type": "boolean"
            },
            "scanned": {
              "type": "boolean"
            },
            "runtime_removed": {
              "type": "boolean"
            },
            "extras": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "content"
                ],
                "properties": {
                  "path": {
                    "enum": [
                      "review-session.json",
                      "cleanup-results.json"
                    ]
                  },
                  "content": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 262144
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
