{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.execution_topology.v9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "runtime_profiles",
    "resource_profiles",
    "browser_reset_policy",
    "service_resource_minimums",
    "generated_outputs",
    "runtime_binaries",
    "execution_dependencies",
    "go_targets",
    "browser_e2e_batch",
    "task_surface_owner"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.execution_topology.v9" },
    "runtime_profiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/record" } },
    "resource_profiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/record" } },
    "browser_reset_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "backend_drain_timeout_ms", "database_reset_timeout_ms", "backend_readiness_timeout_ms", "evidence_overhead_timeout_ms"],
      "properties": {
        "max_attempts": { "const": 1 },
        "backend_drain_timeout_ms": { "const": 30000 },
        "database_reset_timeout_ms": { "const": 30000 },
        "backend_readiness_timeout_ms": { "const": 120000 },
        "evidence_overhead_timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 60000 }
      }
    },
    "service_resource_minimums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_store", "postgres"],
      "properties": {
        "object_store": {
          "allOf": [{ "$ref": "cartulary.harness_execution_defs.v1#/$defs/resource_claims" }],
          "minProperties": 1
        },
        "postgres": {
          "allOf": [{ "$ref": "cartulary.harness_execution_defs.v1#/$defs/resource_claims" }],
          "minProperties": 1
        }
      }
    },
    "generated_outputs": { "type": "object", "minProperties": 1 },
    "runtime_binaries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/record" } },
    "execution_dependencies": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/record" } },
    "go_targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "family_runtime_binaries", "raw_go_aggregates"],
      "properties": {
        "targets": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "family_runtime_binaries": { "type": "array", "items": { "type": "object" } },
        "raw_go_aggregates": { "type": "array", "items": { "$ref": "#/$defs/raw_go_aggregate" } }
      }
    },
    "browser_e2e_batch": { "type": "object", "minProperties": 1 },
    "task_surface_owner": { "type": "string", "const": "tools/task_surface_owner.json" }
  },
  "$defs": {
    "raw_go_aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "section", "packages", "selection_pattern", "execution_family", "execution_label", "fixture_capability", "runtime_profile_id", "resource_profile_id", "service_dependencies", "estimated_work_ms", "minimum_tier"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "target": { "type": "string", "pattern": "^backend-[a-z][a-z0-9-]*$" },
        "section": { "enum": ["unit", "store", "integration", "process"] },
        "packages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "$ref": "cartulary.test_catalog_defs.v1#/$defs/repo_path" } },
        "selection_pattern": { "type": "string", "minLength": 1 },
        "execution_family": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "execution_label": { "type": "string", "minLength": 1 },
        "fixture_capability": { "enum": ["none", "postgres_transaction", "postgres_dedicated", "postgres_migration", "object_store_namespace", "managed_process", "browser_stack"] },
        "runtime_profile_id": { "enum": ["default", "network_flow_claimed", "none"] },
        "resource_profile_id": { "type": "string", "minLength": 1 },
        "service_dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "$ref": "cartulary.test_catalog_defs.v1#/$defs/service_dependency" } },
        "estimated_work_ms": { "type": "integer", "minimum": 1 },
        "minimum_tier": { "enum": ["fast", "standard", "full", "release"] }
      }
    },
    "record": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1 } }
    }
  }
}
