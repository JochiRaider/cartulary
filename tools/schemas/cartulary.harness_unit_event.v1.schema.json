{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_unit_event.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "seq", "monotonic_ms", "event", "unit_id", "status", "resource_claims", "service_dependencies"],
  "properties": {
    "schema_id": { "const": "cartulary.harness_unit_event.v1" }, "seq": { "type": "integer", "minimum": 1 }, "monotonic_ms": { "type": "integer", "minimum": 0 },
    "event": { "enum": ["run_started", "queued", "admitted", "started", "cache_hit", "cache_miss", "cache_bypass", "fixture_acquired", "fixture_released", "resource_wait", "completed", "failed", "skipped", "cancelled", "cleanup_started", "cleanup_completed", "run_completed"] },
    "unit_id": { "type": "string", "minLength": 1, "maxLength": 255 }, "status": { "enum": ["pending", "running", "passed", "failed", "skipped", "cancelled"] },
    "resource_claims": { "$ref": "cartulary.harness_execution_defs.v1#/$defs/resource_claims" },
    "service_dependencies": { "$ref": "cartulary.test_catalog_defs.v1#/$defs/service_dependencies" },
    "cache_profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
    "cache_reason": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "output_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "blocking_resources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
    "resource_holders": { "type": "array", "uniqueItems": true, "items": { "$ref": "cartulary.harness_execution_defs.v1#/$defs/id" } },
    "fixture_lease_id": { "type": "string", "minLength": 1, "maxLength": 255 }, "failure_class": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "failure_reason": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
  }
}
