{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.executable_input_policy.v1",
  "title": "Cartulary executable input policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "restricted_roots", "documentation_only_sources", "machine_evidence_roots"],
  "properties": {
    "schema_id": { "const": "cartulary.executable_input_policy.v1" },
    "restricted_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "documentation_only_sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "machine_evidence_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._@+-]+(?:/[A-Za-z0-9._@+-]+)*$"
    }
  }
}
