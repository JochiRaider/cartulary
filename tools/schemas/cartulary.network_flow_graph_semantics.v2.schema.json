{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.network_flow_graph_semantics.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "profile_id", "graph_projection_schema_id", "semantic_query_schema_id", "graph_query_digest_algorithm", "bucket_edge_identity", "time_bucket", "arithmetic_fixtures", "row_assignment_fixtures"],
  "properties": {
    "schema_id": { "const": "cartulary.network_flow_graph_semantics.v2" },
    "profile_id": { "const": "network_flow_activity" },
    "graph_projection_schema_id": { "const": "graph_projection.v2" },
    "semantic_query_schema_id": { "const": "cartulary.network_flow.graph_semantic_query.v2" },
    "graph_query_digest_algorithm": { "$ref": "#/$defs/algorithm" },
    "bucket_edge_identity": { "$ref": "#/$defs/algorithm" },
    "time_bucket": { "type": "object" },
    "arithmetic_fixtures": { "type": "array", "minItems": 4, "items": { "type": "object" } },
    "row_assignment_fixtures": { "type": "array", "minItems": 3, "items": { "type": "object" } }
  },
  "$defs": {
    "algorithm": {
      "type": "object",
      "required": ["algorithm_id", "domain", "framing", "ordered_fields"],
      "properties": {
        "algorithm_id": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "framing": { "const": "uint64_be_byte_length_then_utf8_bytes_v1" },
        "ordered_fields": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
