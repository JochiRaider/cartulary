{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_invocation_start.v1",
  "title": "Cartulary retained harness invocation start",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "run_id",
    "target",
    "started_at",
    "invocation_edges"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.harness_invocation_start.v1" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
    "target": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
    "started_at": { "type": "string", "format": "date-time" },
    "invocation_edges": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parent_target", "child_target"],
        "properties": {
          "parent_target": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
          "child_target": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" }
        }
      }
    }
  }
}
