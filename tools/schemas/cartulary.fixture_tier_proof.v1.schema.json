{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.fixture_tier_proof.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "target",
    "phase",
    "row_id",
    "execution_family",
    "effective_fixture_policy",
    "proof_kind",
    "proof_status",
    "reason",
    "execution_boundary",
    "observed_surfaces",
    "reset_surface",
    "final_verdict"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.fixture_tier_proof.v1" },
    "target": { "type": "string", "minLength": 1 },
    "phase": { "type": "string", "minLength": 1 },
    "row_id": { "type": "string", "minLength": 1 },
    "execution_family": { "type": "string", "minLength": 1 },
    "symbol": { "type": "string", "minLength": 1 },
    "effective_fixture_policy": { "$ref": "#/$defs/fixture_policy" },
    "proof_kind": { "$ref": "#/$defs/fixture_policy" },
    "proof_status": { "$ref": "#/$defs/proof_status" },
    "proof_ref": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "execution_boundary": {
      "enum": [
        "rollback_transaction",
        "committed_package_reset",
        "shared_group_database",
        "isolated_template_clone",
        "migration_scratch_database"
      ]
    },
    "observed_surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "postgres",
        "auth_session_bootstrap",
        "route_idempotency",
        "jobs",
        "object_store",
        "websocket_observer",
        "cross_connection_observer",
        "process_lifecycle",
        "schema_migration"
      ],
      "properties": {
        "postgres": { "$ref": "#/$defs/surface_observation" },
        "auth_session_bootstrap": { "$ref": "#/$defs/surface_observation" },
        "route_idempotency": { "$ref": "#/$defs/surface_observation" },
        "jobs": { "$ref": "#/$defs/surface_observation" },
        "object_store": { "$ref": "#/$defs/surface_observation" },
        "websocket_observer": { "$ref": "#/$defs/surface_observation" },
        "cross_connection_observer": { "$ref": "#/$defs/surface_observation" },
        "process_lifecycle": { "$ref": "#/$defs/surface_observation" },
        "schema_migration": { "$ref": "#/$defs/surface_observation" }
      }
    },
    "reset_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "postgres_reset",
        "postgres_dirty_tables",
        "postgres_fk_closure",
        "goose_metadata",
        "route_idempotency",
        "jobs",
        "object_store"
      ],
      "properties": {
        "postgres_reset": {
          "enum": [
            "not_applicable",
            "rollback",
            "targeted_reset",
            "broad_reset",
            "shared_seeded_state",
            "clone_isolation",
            "scratch_database"
          ]
        },
        "postgres_dirty_tables": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "uniqueItems": true
        },
        "postgres_fk_closure": { "enum": ["not_applicable", "declared", "proven", "unproven"] },
        "goose_metadata": { "enum": ["not_applicable", "preserved", "unproven"] },
        "route_idempotency": { "enum": ["not_applicable", "included", "unproven"] },
        "jobs": { "enum": ["not_applicable", "included", "unproven"] },
        "object_store": { "enum": ["none", "cleanup_proven", "clone_isolation", "unproven"] }
      }
    },
    "final_verdict": { "$ref": "#/$defs/proof_status" }
  },
  "$defs": {
    "fixture_policy": {
      "enum": [
        "template_clone",
        "package_reset",
        "migration_scratch",
        "transaction",
        "group_clone"
      ]
    },
    "proof_status": { "enum": ["accepted", "retained", "blocked"] },
    "surface_observation": { "enum": ["not_observed", "observed"] }
  }
}
