{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.ui_review_command_result.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "cartulary.ui_review_command_result.v1"
    },
    "command_id": {
      "enum": [
        "cartulary.harness.command.ui_review.v1",
        "cartulary.harness.command.ui_review_status.v1",
        "cartulary.harness.command.ui_browser.v1",
        "cartulary.harness.command.ui_capture.v1",
        "cartulary.harness.command.ui_analyze.v1",
        "cartulary.harness.command.ui_review_report.v1",
        "cartulary.harness.command.ui_review_stop.v1"
      ]
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^uireview-[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation_id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "anyOf": [
        {
          "enum": [
            "preparing",
            "ready",
            "busy",
            "stopping",
            "closed",
            "failed"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "epoch": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "failure_class": {
            "enum": [
              "config",
              "infra",
              "harness",
              "artifact",
              "timing",
              "interrupted"
            ]
          },
          "failure_reason": {
            "enum": [
              "usage_error",
              "configuration_error",
              "tool_diagnostic_failure",
              "preflight_error",
              "service_start_error",
              "service_readiness_timeout",
              "resource_conflict",
              "artifact_error",
              "timeout_failure",
              "cleanup_error",
              "cancelled_or_interrupted"
            ]
          },
          "diagnostic_code": {
            "enum": [
              "invalid_request",
              "tool_configuration",
              "session_mismatch",
              "target_unavailable",
              "navigation_boundary",
              "environment_unavailable",
              "startup_failed",
              "readiness_expired",
              "capacity_exceeded",
              "invalid_artifact",
              "unstable_capture",
              "observation_limit",
              "analysis_failed",
              "operation_expired",
              "session_lost",
              "unsafe_artifact",
              "input_boundary",
              "cleanup_failed",
              "interrupted"
            ]
          }
        },
        "required": [
          "failure_class",
          "failure_reason",
          "diagnostic_code"
        ]
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "receipt": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\\\u0000]).+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "media_type": {
              "enum": [
                "image/png",
                "application/json",
                "text/html",
                "text/plain",
                "application/zip"
              ]
            }
          },
          "required": [
            "path",
            "sha256",
            "bytes",
            "media_type"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "bundle_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^bundle-[1-9][0-9]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "private_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "bundle",
              "image",
              "observations",
              "report"
            ]
          },
          "absolute_path": {
            "type": "string",
            "pattern": "^/",
            "maxLength": 4096
          }
        },
        "required": [
          "kind",
          "absolute_path"
        ]
      },
      "maxItems": 8
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2,
        3,
        4,
        11,
        12,
        13,
        15,
        130,
        143
      ]
    }
  },
  "required": [
    "schema_id",
    "command_id",
    "session_id",
    "operation_id",
    "state",
    "epoch",
    "status",
    "failures",
    "receipt",
    "bundle_id",
    "private_refs",
    "exit_code"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "failures": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "failures": {
            "minItems": 1
          },
          "private_refs": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
