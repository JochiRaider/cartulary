{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_evidence_root_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "owner_id", "entries"],
  "properties": {
    "schema_id": { "const": "cartulary.harness_evidence_root_manifest.v1" },
    "owner_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "run_root"],
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "run_root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    }
  }
}
