{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.test_accounting_classification.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "vitest", "go_packages", "go_tests", "playwright"],
  "properties": {
    "schema_id": { "const": "cartulary.test_accounting_classification.v2" },
    "vitest": {
      "type": "array",
      "items": { "$ref": "#/$defs/file_rule" }
    },
    "playwright": {
      "type": "array",
      "items": { "$ref": "#/$defs/file_rule" }
    },
    "go_packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/package_rule" }
    },
    "go_tests": {
      "type": "array",
      "items": { "$ref": "#/$defs/package_test_rule" }
    }
  },
  "$defs": {
    "target": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "coverage": {
      "enum": [
        "authoritative",
        "support",
        "raw",
        "tooling_support"
      ]
    },
    "phase": {
      "type": "string",
      "pattern": "^(?:|phase(?:0|[1-9][0-9]*))$"
    },
    "reason": {
      "type": "string",
      "minLength": 20
    },
    "title_fields": {
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "title_pattern": { "type": "string", "minLength": 1 }
      },
      "not": {
        "required": ["title", "title_pattern"]
      }
    },
    "file_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "coverage", "reason"],
      "properties": {
        "target": { "$ref": "#/$defs/target" },
        "file": { "type": "string", "minLength": 1 },
        "file_pattern": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "title_pattern": { "type": "string", "minLength": 1 },
        "coverage": { "$ref": "#/$defs/coverage" },
        "phase": { "$ref": "#/$defs/phase" },
        "reason": { "$ref": "#/$defs/reason" }
      },
      "oneOf": [
        { "required": ["file"] },
        { "required": ["file_pattern"] }
      ],
      "not": {
        "required": ["title", "title_pattern"]
      }
    },
    "package_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "coverage", "reason"],
      "properties": {
        "target": { "$ref": "#/$defs/target" },
        "package": { "type": "string", "minLength": 1 },
        "package_pattern": { "type": "string", "minLength": 1 },
        "coverage": { "$ref": "#/$defs/coverage" },
        "phase": { "$ref": "#/$defs/phase" },
        "reason": { "$ref": "#/$defs/reason" }
      },
      "oneOf": [
        { "required": ["package"] },
        { "required": ["package_pattern"] }
      ]
    },
    "package_test_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "coverage", "reason"],
      "properties": {
        "target": { "$ref": "#/$defs/target" },
        "package": { "type": "string", "minLength": 1 },
        "package_pattern": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "title_pattern": { "type": "string", "minLength": 1 },
        "coverage": { "$ref": "#/$defs/coverage" },
        "phase": { "$ref": "#/$defs/phase" },
        "reason": { "$ref": "#/$defs/reason" }
      },
      "oneOf": [
        { "required": ["package"] },
        { "required": ["package_pattern"] }
      ],
      "not": {
        "required": ["title", "title_pattern"]
      }
    }
  }
}
