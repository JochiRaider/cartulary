{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_runtime_resource.v1",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "state",
        "run_id",
        "lease_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "managed_suite",
            "borrowed_suite",
            "browser_stack",
            "object_store_proxy"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "state": {
          "enum": [
            "pending",
            "acquired",
            "released"
          ]
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "lease_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-f-]{36}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "state",
        "run_id",
        "lease_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "preparation_process",
            "browser_process",
            "helper_process"
          ]
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "boot",
            "pid",
            "start",
            "group"
          ],
          "properties": {
            "boot": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "pid": {
              "type": "integer",
              "minimum": 2,
              "maximum": 2147483647
            },
            "start": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[0-9]+$"
            },
            "group": {
              "type": "boolean"
            }
          }
        },
        "state": {
          "enum": [
            "pending",
            "acquired",
            "released"
          ]
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "lease_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-f-]{36}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "state",
        "run_id",
        "lease_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "diagnostic_scope"
          ]
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "boot",
            "start",
            "token",
            "uid"
          ],
          "properties": {
            "boot": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "start": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[0-9]+$"
            },
            "token": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "uid": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "state": {
          "enum": [
            "pending",
            "acquired",
            "released"
          ]
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "lease_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-f-]{36}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "state",
        "run_id",
        "lease_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "browser_renderer"
          ]
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "daemon_id",
            "image_id",
            "name",
            "token"
          ],
          "properties": {
            "daemon_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9:._-]{1,128}$"
            },
            "image_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 71,
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^cartulary-visual-[1-9][0-9]*-[a-f0-9]{12}$"
            },
            "token": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[a-f0-9]{32}$"
            }
          }
        },
        "state": {
          "enum": [
            "pending",
            "acquired",
            "released"
          ]
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "lease_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-f-]{36}$"
        }
      }
    }
  ]
}
