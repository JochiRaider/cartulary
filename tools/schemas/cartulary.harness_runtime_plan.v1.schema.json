{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_runtime_plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "graph",
    "manifest",
    "projections",
    "capacities",
    "aging_quantum_ms",
    "bindings",
    "cache",
    "helper_digest",
    "preparation",
    "source_inputs",
    "cache_inputs"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.harness_runtime_plan.v1"
    },
    "graph": {
      "$ref": "cartulary.harness_work_graph.v5"
    },
    "manifest": {
      "$ref": "cartulary.harness_run_manifest.v2"
    },
    "projections": {
      "type": "object",
      "maxProperties": 16384,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command_id",
          "unit_ids"
        ],
        "properties": {
          "command_id": {
            "$ref": "cartulary.harness_execution_defs.v1#/$defs/id"
          },
          "unit_ids": {
            "type": "array",
            "maxItems": 16384,
            "items": {
              "$ref": "cartulary.harness_execution_defs.v1#/$defs/id"
            }
          }
        }
      }
    },
    "capacities": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "aging_quantum_ms": {
      "type": "integer",
      "minimum": 1
    },
    "bindings": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "cache": {
      "type": "array",
      "maxItems": 16384,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_id",
          "eligible",
          "reason",
          "profile_id",
          "policy",
          "input_digest",
          "dependency_strategy",
          "vulnerability_database_revision",
          "dependency_digest"
        ],
        "properties": {
          "unit_id": {
            "$ref": "cartulary.harness_execution_defs.v1#/$defs/id"
          },
          "eligible": {
            "type": "boolean"
          },
          "reason": {
            "anyOf": [
              {
                "enum": [
                  "policy_none",
                  "reusable_outputs_incomplete",
                  "fresh_outputs_incomplete",
                  "artifact_producer_incomplete",
                  "profile_missing",
                  "freshness_unknown",
                  "mode_off"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "profile_id": {
            "anyOf": [
              {
                "$ref": "cartulary.harness_execution_defs.v1#/$defs/id"
              },
              {
                "type": "null"
              }
            ]
          },
          "policy": {
            "anyOf": [
              {
                "enum": [
                  "same_run",
                  "content_addressed"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "input_digest": {
            "anyOf": [
              {
                "$ref": "cartulary.harness_execution_defs.v1#/$defs/digest"
              },
              {
                "type": "null"
              }
            ]
          },
          "dependency_strategy": {
            "anyOf": [
              {
                "enum": [
                  "broad",
                  "broad_fallback",
                  "go_packages",
                  "typescript_workspaces",
                  "filesystem_broad"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "vulnerability_database_revision": {
            "anyOf": [
              {
                "$ref": "cartulary.harness_execution_defs.v1#/$defs/digest"
              },
              {
                "type": "null"
              }
            ]
          },
          "dependency_digest": {
            "anyOf": [
              {
                "$ref": "cartulary.harness_execution_defs.v1#/$defs/digest"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "helper_digest": {
      "$ref": "cartulary.harness_execution_defs.v1#/$defs/digest"
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock",
        "intervals"
      ],
      "properties": {
        "clock": {
          "$ref": "cartulary.harness_execution_index.v2#/properties/graph_clock"
        },
        "intervals": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "phase",
              "start_ms",
              "end_ms"
            ],
            "properties": {
              "phase": {
                "enum": [
                  "configuration_catalog",
                  "capability_capture",
                  "graph_construction",
                  "source_hashing",
                  "provenance",
                  "cache_preparation",
                  "launch_bindings"
                ]
              },
              "start_ms": {
                "type": "number",
                "minimum": 0
              },
              "end_ms": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "source_inputs": {
      "type": "array",
      "maxItems": 131072,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "mode",
          "byte_digest"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "kind": {
            "enum": [
              "file",
              "symlink"
            ]
          },
          "mode": {
            "type": "string",
            "pattern": "^[0-7]{4}$"
          },
          "byte_digest": {
            "$ref": "cartulary.harness_execution_defs.v1#/$defs/digest"
          }
        }
      }
    },
    "cache_inputs": {
      "type": "object",
      "maxProperties": 16384,
      "propertyNames": {
        "$ref": "cartulary.harness_execution_defs.v1#/$defs/digest"
      },
      "additionalProperties": {
        "type": "array",
        "maxItems": 131072,
        "uniqueItems": true,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 131071
        }
      }
    }
  }
}
