{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_test_failure.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "failure_class",
    "failure_reason",
    "setup_source",
    "service",
    "readiness_stage",
    "attempt_count",
    "cleanup_outcome",
    "phase",
    "prior_failure"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.harness_test_failure.v2"
    },
    "failure_class": {
      "enum": [
        "harness",
        "infra",
        "interrupted"
      ]
    },
    "failure_reason": {
      "enum": [
        "cancelled_or_interrupted",
        "fixture_error",
        "service_readiness_timeout",
        "cleanup_error"
      ]
    },
    "setup_source": {
      "enum": [
        "appsupport",
        "pgtest",
        "s3test"
      ]
    },
    "service": {
      "enum": [
        "object_store",
        "postgres"
      ]
    },
    "readiness_stage": {
      "enum": [
        "attach",
        "capability",
        "create_bucket",
        "delete",
        "dependency_guard",
        "head",
        "not_found",
        "put",
        "start"
      ]
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "cleanup_outcome": {
      "enum": [
        "completed",
        "failed",
        "not_required"
      ]
    },
    "phase": {
      "enum": [
        "setup",
        "cleanup"
      ]
    },
    "prior_failure": {
      "type": "boolean"
    },
    "cleanup_diagnostics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "cause"
        ],
        "properties": {
          "stage": {
            "enum": [
              "unknown",
              "catalog_open",
              "catalog_connection",
              "catalog_lock",
              "catalog_unlock",
              "catalog_close",
              "normal_drop",
              "forced_drop"
            ]
          },
          "cause": {
            "enum": [
              "unknown",
              "cancelled",
              "deadline_exceeded",
              "connection_closed",
              "database_in_use",
              "connection_failure",
              "lock_unavailable",
              "query_cancelled",
              "permission_denied",
              "server_shutdown",
              "diagnostic_limit"
            ]
          },
          "wait": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "first",
                  "last"
                ],
                "properties": {
                  "status": {
                    "const": "sampled"
                  },
                  "first": {
                    "$ref": "#/$defs/drop_wait_snapshot"
                  },
                  "last": {
                    "$ref": "#/$defs/drop_wait_snapshot"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "first",
                  "last"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "unavailable",
                      "not_observed"
                    ]
                  },
                  "first": {
                    "type": "null"
                  },
                  "last": {
                    "type": "null"
                  }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "wait"
              ]
            },
            "then": {
              "properties": {
                "stage": {
                  "enum": [
                    "normal_drop",
                    "forced_drop"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "cleanup"
          }
        }
      },
      "then": {
        "properties": {
          "failure_class": {
            "const": "harness"
          },
          "failure_reason": {
            "const": "cleanup_error"
          },
          "cleanup_outcome": {
            "const": "failed"
          }
        }
      },
      "else": {
        "properties": {
          "prior_failure": {
            "const": false
          },
          "failure_reason": {
            "enum": [
              "cancelled_or_interrupted",
              "fixture_error",
              "service_readiness_timeout"
            ]
          },
          "cleanup_diagnostics": false
        }
      }
    }
  ],
  "$defs": {
    "drop_wait_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "event",
        "blockers",
        "checkpointer_type",
        "checkpointer_event",
        "checkpointer_blockers",
        "requested",
        "done",
        "buffers"
      ],
      "properties": {
        "type": {
          "enum": [
            "",
            "unknown",
            "Activity",
            "BufferPin",
            "Client",
            "Extension",
            "IO",
            "IPC",
            "Lock",
            "LWLock",
            "Timeout"
          ]
        },
        "event": {
          "enum": [
            "",
            "other",
            "ProcSignalBarrier",
            "DataFileRead",
            "DataFileWrite",
            "DataFileSync",
            "WALWrite",
            "WALSync",
            "SyncRep",
            "CheckpointDone",
            "CheckpointStart",
            "CheckpointWriteDelay",
            "CheckpointDelayStart",
            "CheckpointDelayComplete",
            "CheckpointerMain",
            "BufferIO",
            "relation",
            "transactionid",
            "virtualxid",
            "object",
            "advisory",
            "extend",
            "frozenid",
            "ClientRead",
            "ClientWrite"
          ]
        },
        "blockers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "checkpointer_type": {
          "enum": [
            "",
            "unknown",
            "Activity",
            "BufferPin",
            "Client",
            "Extension",
            "IO",
            "IPC",
            "Lock",
            "LWLock",
            "Timeout"
          ]
        },
        "checkpointer_event": {
          "enum": [
            "",
            "other",
            "ProcSignalBarrier",
            "DataFileRead",
            "DataFileWrite",
            "DataFileSync",
            "WALWrite",
            "WALSync",
            "SyncRep",
            "CheckpointDone",
            "CheckpointStart",
            "CheckpointWriteDelay",
            "CheckpointDelayStart",
            "CheckpointDelayComplete",
            "CheckpointerMain",
            "BufferIO",
            "relation",
            "transactionid",
            "virtualxid",
            "object",
            "advisory",
            "extend",
            "frozenid",
            "ClientRead",
            "ClientWrite"
          ]
        },
        "checkpointer_blockers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "requested": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "done": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "buffers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "barrier": {
          "$ref": "#/$defs/barrier_wait_snapshot"
        }
      }
    },
    "barrier_wait_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "backend",
        "state",
        "type",
        "event",
        "blockers",
        "operation",
        "database_scope",
        "operation_age_ms"
      ],
      "properties": {
        "status": {
          "enum": [
            "sampled",
            "unavailable",
            "not_observed"
          ]
        },
        "backend": {
          "enum": [
            "",
            "other",
            "client backend",
            "autovacuum worker",
            "autovacuum launcher",
            "background writer",
            "checkpointer",
            "walwriter",
            "walsender",
            "walreceiver",
            "startup",
            "archiver",
            "parallel worker",
            "logical replication launcher",
            "logical replication worker",
            "io worker"
          ]
        },
        "state": {
          "enum": [
            "",
            "other",
            "active",
            "idle",
            "idle in transaction",
            "idle in transaction (aborted)",
            "fastpath function call",
            "disabled"
          ]
        },
        "type": {
          "enum": [
            "",
            "unknown",
            "Activity",
            "BufferPin",
            "Client",
            "Extension",
            "IO",
            "IPC",
            "Lock",
            "LWLock",
            "Timeout"
          ]
        },
        "event": {
          "enum": [
            "",
            "other",
            "ProcSignalBarrier",
            "DataFileRead",
            "DataFileWrite",
            "DataFileSync",
            "WALWrite",
            "WALSync",
            "SyncRep",
            "CheckpointDone",
            "CheckpointStart",
            "CheckpointWriteDelay",
            "CheckpointDelayStart",
            "CheckpointDelayComplete",
            "CheckpointerMain",
            "BufferIO",
            "relation",
            "transactionid",
            "virtualxid",
            "object",
            "advisory",
            "extend",
            "frozenid",
            "ClientRead",
            "ClientWrite"
          ]
        },
        "blockers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "operation": {
          "enum": [
            "",
            "none",
            "other",
            "create_database",
            "alter_database",
            "drop_database",
            "select",
            "with",
            "insert",
            "update",
            "delete",
            "copy",
            "create",
            "alter",
            "drop",
            "do",
            "begin",
            "commit",
            "rollback",
            "vacuum",
            "analyze",
            "checkpoint",
            "discard",
            "show",
            "set"
          ]
        },
        "database_scope": {
          "enum": [
            "",
            "none",
            "admin",
            "target",
            "other"
          ]
        },
        "operation_age_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "sampled"
              }
            }
          },
          "then": {
            "properties": {
              "backend": {
                "not": {
                  "const": ""
                }
              },
              "operation": {
                "not": {
                  "const": ""
                }
              },
              "database_scope": {
                "not": {
                  "const": ""
                }
              }
            }
          },
          "else": {
            "properties": {
              "backend": {
                "const": ""
              },
              "state": {
                "const": ""
              },
              "type": {
                "const": ""
              },
              "event": {
                "const": ""
              },
              "blockers": {
                "const": 0
              },
              "operation": {
                "const": ""
              },
              "database_scope": {
                "const": ""
              },
              "operation_age_ms": {
                "const": 0
              }
            }
          }
        }
      ]
    }
  }
}
