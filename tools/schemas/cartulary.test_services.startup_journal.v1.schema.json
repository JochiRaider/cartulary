{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.test_services.startup_journal.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "binding",
    "state",
    "helper",
    "attempts"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.test_services.startup_journal.v1"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_root",
        "runtime_lease",
        "run_root",
        "run_id",
        "suite_id",
        "services",
        "dependencies"
      ],
      "properties": {
        "runtime_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "runtime_lease": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "run_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "suite_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "postgres",
              "object_store"
            ]
          }
        },
        "dependencies": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "state": {
      "enum": [
        "prepared",
        "registered",
        "published",
        "settled",
        "unresolved"
      ]
    },
    "helper": {
      "type": "string",
      "maxLength": 4096
    },
    "attempts": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "service",
          "labels",
          "cleanup_files",
          "container_id",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "service": {
            "enum": [
              "postgres",
              "object_store"
            ]
          },
          "labels": {
            "type": "object",
            "maxProperties": 16,
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "cleanup_files": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "container_id": {
            "type": "string",
            "maxLength": 256
          },
          "state": {
            "enum": [
              "acquiring",
              "acquired",
              "settled"
            ]
          }
        }
      }
    }
  }
}
