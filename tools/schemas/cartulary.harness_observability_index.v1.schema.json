{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_observability_index.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "run_id", "status", "scope", "execution_context", "policy", "invocations"],
  "properties": {
    "schema_id": { "const": "cartulary.harness_observability_index.v1" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
    "status": { "enum": ["complete", "partial"] },
    "scope": { "const": "cartulary.harness.execution" },
    "execution_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "_shared/harness-observability/execution-context.json" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_targets", "exclusions", "out_of_scope", "measurement_profile_sha256"],
      "properties": {
        "required_targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "owner_section", "reason"],
            "properties": {
              "target": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
              "owner_section": { "type": "string", "pattern": "^Section [0-9]+(?:\\.[0-9]+)?$" },
              "reason": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "owner_section", "reason"],
            "properties": {
              "target": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
              "owner_section": { "type": "string", "pattern": "^Section [0-9]+(?:\\.[0-9]+)?$" },
              "reason": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        },
        "measurement_profile_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "invocations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invocation_id", "target", "command_id", "status", "trace_id", "artifacts", "source_digests"],
        "properties": {
          "invocation_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$" },
          "target": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
          "command_id": {
            "type": "string",
            "pattern": "^cartulary\\.harness\\.command\\.[a-z][a-z0-9_]*\\.v[1-9][0-9]*$"
          },
          "status": { "enum": ["complete", "partial"] },
          "trace_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
          "artifacts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["trace_bundle", "trace_otlp", "metrics_otlp", "hotspot_summary"],
            "properties": {
              "trace_bundle": { "$ref": "#/$defs/artifact_ref" },
              "trace_otlp": { "$ref": "#/$defs/artifact_ref" },
              "metrics_otlp": { "$ref": "#/$defs/artifact_ref" },
              "hotspot_summary": { "$ref": "#/$defs/artifact_ref" }
            }
          },
          "source_digests": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+$" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          },
          "diagnostic": { "type": "string", "maxLength": 512 }
        }
      }
    },
    "diagnostic": { "type": "string", "maxLength": 512 }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
