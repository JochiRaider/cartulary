{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.local_release_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "platform",
    "binaries",
    "images",
    "assets"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.local_release_manifest.v1"
    },
    "platform": {
      "const": "linux/amd64"
    },
    "binaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migrate",
        "operator",
        "server"
      ],
      "properties": {
        "migrate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "receipt"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "receipt": {
              "const": "receipts/migrate.crypto.json"
            }
          }
        },
        "operator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "receipt"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "receipt": {
              "const": "receipts/operator.crypto.json"
            }
          }
        },
        "server": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "receipt"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "receipt": {
              "const": "receipts/server.crypto.json"
            }
          }
        }
      }
    },
    "images": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "id",
          "reference",
          "archive",
          "inventory",
          "config_sha256"
        ],
        "properties": {
          "role": {
            "enum": [
              "application",
              "postgres",
              "seaweedfs"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "reference": {
            "type": "string",
            "pattern": "^[a-z0-9./:_@-]+$"
          },
          "archive": {
            "type": "string",
            "pattern": "^images/(application|postgres|seaweedfs)\\.tar$"
          },
          "inventory": {
            "type": "string",
            "pattern": "^inventories/(application|postgres|seaweedfs)\\.syft\\.json$"
          },
          "config_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes",
          "mode"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "mode": {
            "enum": [
              "644",
              "755"
            ]
          }
        }
      }
    }
  }
}
