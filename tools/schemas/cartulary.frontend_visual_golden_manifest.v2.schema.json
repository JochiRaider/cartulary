{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.frontend_visual_golden_manifest.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "renderer_profile_id", "goldens"],
  "properties": {
    "schema_id": { "const": "cartulary.frontend_visual_golden_manifest.v2" },
    "renderer_profile_id": {
      "type": "string",
      "pattern": "^visual\\.renderer\\.[a-z0-9_]+$"
    },
    "goldens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^apps/web/e2e/visual-goldens/[^/]+\\.png$"
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
