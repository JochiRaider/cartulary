{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.harness_cache_registry.v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "profiles"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.harness_cache_registry.v4"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "policy",
          "dependency_strategy",
          "input_roots",
          "requires_vulnerability_database_revision",
          "operation_ids",
          "runner_types"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "policy": {
            "enum": [
              "same_run",
              "content_addressed"
            ]
          },
          "dependency_strategy": {
            "enum": [
              "broad",
              "unit_aware"
            ]
          },
          "input_roots": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._@+-][A-Za-z0-9._@+/-]*$",
              "not": {
                "pattern": "(?:^|/)\\.\\.(?:/|$)"
              }
            }
          },
          "unit_inputs": {
            "description": "Inputs every unit-aware closure includes beside its selected packages or workspaces: paths (each with everything beneath it), path prefixes, the runner that executes the rows (the static module closure of its JavaScript entries or the import closure of its Go packages), and for a service-backed unit its service paths.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "paths",
              "prefixes",
              "runner_entries",
              "runner_external_imports",
              "runner_packages",
              "service_paths"
            ],
            "properties": {
              "paths": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._@+-][A-Za-z0-9._@+/-]*$",
                  "not": {
                    "pattern": "(?:^|/)\\.\\.(?:/|$)"
                  }
                }
              },
              "prefixes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._@+-][A-Za-z0-9._@+/-]*$",
                  "not": {
                    "pattern": "(?:^|/)\\.\\.(?:/|$)"
                  }
                }
              },
              "runner_entries": {
                "description": "Row runner entry modules. The planner adds their relative static, literal dynamic and literal require closure; an unresolvable specifier, or a computed import outside runner_external_imports, makes the closure broad.",
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._@+-][A-Za-z0-9._@+/-]*$",
                  "not": {
                    "pattern": "(?:^|/)\\.\\.(?:/|$)"
                  }
                }
              },
              "runner_external_imports": {
                "description": "Node modules, of the runner closure or of a module a Go closure names, whose computed imports load only installed packages outside the repository source, which the lockfile already binds.",
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._@+-][A-Za-z0-9._@+/-]*$",
                  "not": {
                    "pattern": "(?:^|/)\\.\\.(?:/|$)"
                  }
                }
              },
              "runner_packages": {
                "description": "Go packages of the row runner. The planner adds their repository-local import closure without test files.",
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._@+-][A-Za-z0-9._@+/-]*$",
                  "not": {
                    "pattern": "(?:^|/)\\.\\.(?:/|$)"
                  }
                }
              },
              "service_paths": {
                "description": "Paths added to the closure of a unit whose rows depend on services.",
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._@+-][A-Za-z0-9._@+/-]*$",
                  "not": {
                    "pattern": "(?:^|/)\\.\\.(?:/|$)"
                  }
                }
              }
            }
          },
          "requires_vulnerability_database_revision": {
            "type": "boolean"
          },
          "operation_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^harness\\.[a-z][a-z0-9_]*$"
            }
          },
          "runner_types": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "go",
                "vitest"
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "dependency_strategy": {
                  "const": "unit_aware"
                }
              },
              "required": [
                "dependency_strategy"
              ]
            },
            "then": {
              "required": [
                "unit_inputs"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "unit_inputs"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
