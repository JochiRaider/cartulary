{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.scheduler_pressure_summary.v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "target",
    "scheduler_kind",
    "status",
    "total_work_units",
    "completed_work_units",
    "scheduler_total_duration_ms",
    "target_counts",
    "lane_duration_ms",
    "resource_claim_counts",
    "fixture_class_counts",
    "row_fixture_pressure",
    "execution_family_fixture_pressure",
    "fixture_proof_records",
    "fixture_tier_proofs",
    "slowest_work_units",
    "reused_accounting_counts",
    "readiness_attribution_counts",
    "readiness_attribution_duration_ms",
    "readiness_attribution_units",
    "generated_at"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.scheduler_pressure_summary.v4" },
    "target": { "type": "string", "minLength": 1 },
    "scheduler_kind": { "enum": ["check", "service_backed", "phase_slice"] },
    "status": { "$ref": "cartulary.harness.defs.v1#/$defs/status" },
    "total_work_units": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "completed_work_units": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
    "scheduler_total_duration_ms": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_number" },
    "target_counts": { "$ref": "#/$defs/count_map" },
    "lane_duration_ms": { "$ref": "#/$defs/duration_map" },
    "resource_claim_counts": { "$ref": "#/$defs/count_map" },
    "fixture_class_counts": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "migration_scratch",
          "template_clone",
          "package_reset",
          "transaction_or_shared_postgres",
          "none"
        ]
      },
      "additionalProperties": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" }
    },
    "row_fixture_pressure": {
      "type": "array",
      "items": { "$ref": "#/$defs/fixture_pressure_row" }
    },
    "execution_family_fixture_pressure": {
      "type": "array",
      "items": { "$ref": "#/$defs/fixture_pressure_family" }
    },
    "fixture_proof_records": {
      "type": "array",
      "items": { "$ref": "#/$defs/fixture_proof_record" }
    },
    "fixture_tier_proofs": {
      "type": "array",
      "items": { "$ref": "cartulary.fixture_tier_proof.v1" }
    },
    "slowest_work_units": {
      "type": "array",
      "items": { "$ref": "#/$defs/slowest_work_unit" }
    },
    "reused_accounting_counts": {
      "type": "object",
      "required": ["executed", "reused", "skipped"],
      "propertyNames": { "enum": ["executed", "reused", "skipped"] },
      "additionalProperties": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" }
    },
    "readiness_attribution_counts": { "$ref": "#/$defs/count_map" },
    "readiness_attribution_duration_ms": { "$ref": "#/$defs/duration_map" },
    "readiness_attribution_units": {
      "type": "array",
      "items": { "$ref": "#/$defs/readiness_attribution_unit" }
    },
    "generated_at": { "$ref": "cartulary.harness.defs.v1#/$defs/timestamp" }
  },
  "$defs": {
    "count_map": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" }
    },
    "duration_map": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_number" }
    },
    "readiness_attribution_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "timing_role",
        "readiness_class",
        "duration_ms",
        "warm_threshold_ms",
        "warm_status"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "timing_role": {
          "enum": [
            "readiness",
            "provisioning",
            "build_artifact",
            "service_setup"
          ]
        },
        "readiness_class": {
          "enum": [
            "frontend_install",
            "toolchain",
            "build_artifact",
            "embedded_web_assets",
            "test_service_binary",
            "service_image",
            "browser_readiness",
            "service_readiness"
          ]
        },
        "duration_ms": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_number" },
        "warm_threshold_ms": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
        "warm_status": {
          "enum": ["within_threshold", "over_threshold", "not_evaluated"]
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "fixture_class": {
      "enum": [
        "migration_scratch",
        "template_clone",
        "package_reset",
        "transaction_or_shared_postgres",
        "none"
      ]
    },
    "fixture_policy": {
      "enum": [
        "template_clone",
        "package_reset",
        "migration_scratch",
        "transaction",
        "group_clone",
        "none"
      ]
    },
    "fixture_pressure_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "row_id",
        "execution_family",
        "fixture_class",
        "work_unit_count",
        "duration_ms"
      ],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "execution_family": { "type": "string", "minLength": 1 },
        "fixture_class": { "$ref": "#/$defs/fixture_class" },
        "work_unit_count": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
        "duration_ms": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_number" }
      }
    },
    "fixture_pressure_family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "execution_family",
        "fixture_class",
        "work_unit_count",
        "duration_ms"
      ],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "execution_family": { "type": "string", "minLength": 1 },
        "fixture_class": { "$ref": "#/$defs/fixture_class" },
        "work_unit_count": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_integer" },
        "duration_ms": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_number" }
      }
    },
    "fixture_proof_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "row_id",
        "execution_family",
        "fixture_policy",
        "proof_kind",
        "proof_status",
        "reason"
      ],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "execution_family": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "minLength": 1 },
        "fixture_policy": { "$ref": "#/$defs/fixture_policy" },
        "proof_kind": { "$ref": "#/$defs/fixture_policy" },
        "proof_status": { "enum": ["accepted", "retained", "blocked"] },
        "proof_ref": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "dirty_tables": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "uniqueItems": true
        }
      }
    },
    "slowest_work_unit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "label", "status", "duration_ms"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "status": {
          "oneOf": [
            { "type": "integer" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "duration_ms": { "$ref": "cartulary.harness.defs.v1#/$defs/non_negative_number" }
      }
    }
  }
}
