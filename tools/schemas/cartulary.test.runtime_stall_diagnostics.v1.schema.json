{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.test.runtime_stall_diagnostics.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "captured_at",
    "database_pool",
    "lock_waits",
    "goroutines"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.test.runtime_stall_diagnostics.v1" },
    "captured_at": { "type": "string", "format": "date-time" },
    "database_pool": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_conns",
            "total_conns",
            "acquired_conns",
            "idle_conns",
            "constructing_conns",
            "acquire_count",
            "empty_acquire_count",
            "canceled_acquire_count",
            "empty_acquire_wait_time_ms"
          ],
          "properties": {
            "max_conns": { "type": "integer", "minimum": 0 },
            "total_conns": { "type": "integer", "minimum": 0 },
            "acquired_conns": { "type": "integer", "minimum": 0 },
            "idle_conns": { "type": "integer", "minimum": 0 },
            "constructing_conns": { "type": "integer", "minimum": 0 },
            "acquire_count": { "type": "integer", "minimum": 0 },
            "empty_acquire_count": { "type": "integer", "minimum": 0 },
            "canceled_acquire_count": { "type": "integer", "minimum": 0 },
            "empty_acquire_wait_time_ms": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "lock_waits": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason", "snapshot"],
          "properties": {
            "status": { "const": "observed" },
            "reason": { "type": "null" },
            "snapshot": { "$ref": "#/$defs/lock_wait_snapshot" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason", "snapshot"],
          "properties": {
            "status": { "const": "unavailable" },
            "reason": {
              "enum": [
                "no_database",
                "pool_acquire_timeout",
                "pool_acquire_failed",
                "query_failed"
              ]
            },
            "snapshot": { "type": "null" }
          }
        }
      ]
    },
    "goroutines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "profile", "truncated"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "profile": { "type": "string", "maxLength": 262144 },
        "truncated": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "lock_wait_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captured_at", "sessions", "omitted_session_count"],
      "properties": {
        "captured_at": { "type": "string", "format": "date-time" },
        "sessions": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/lock_wait_session" }
        },
        "omitted_session_count": { "type": "integer", "minimum": 0 }
      }
    },
    "lock_wait_session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "backend_type",
        "state",
        "wait_event_type",
        "wait_event",
        "statement_kind",
        "blocking_pids",
        "query_age_ms"
      ],
      "properties": {
        "pid": { "type": "integer", "minimum": 0 },
        "backend_type": { "type": "string", "maxLength": 64 },
        "state": { "type": "string", "maxLength": 64 },
        "wait_event_type": { "type": "string", "maxLength": 64 },
        "wait_event": { "type": "string", "maxLength": 64 },
        "statement_kind": { "type": "string", "maxLength": 16 },
        "blocking_pids": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "query_age_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 }
      }
    }
  }
}
