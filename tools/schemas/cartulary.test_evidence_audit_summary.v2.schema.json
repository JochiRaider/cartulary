{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.test_evidence_audit_summary.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "evidence_epoch",
    "command_id",
    "owner_id",
    "status",
    "started_at",
    "finished_at",
    "duration_ms",
    "compatibility",
    "required_targets",
    "unused_inputs",
    "accepted_artifacts",
    "rejected_artifacts",
    "counts"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.test_evidence_audit_summary.v2"
    },
    "evidence_epoch": {
      "const": "cartulary.test_evidence.nlspec.v1"
    },
    "command_id": {
      "const": "cartulary.harness.command.test_evidence_audit.v1"
    },
    "owner_id": {
      "$ref": "cartulary.test_family_manifest.v2#/$defs/owner_id"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "started_at": {
      "$ref": "cartulary.test_slice_plan.v3#/$defs/timestamp"
    },
    "finished_at": {
      "$ref": "cartulary.test_slice_plan.v3#/$defs/timestamp"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "required_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/target_partition"
      }
    },
    "unused_inputs": {
      "type": "array",
      "items": {
        "$ref": "cartulary.test_evidence_root_manifest.v1#/properties/entries/items"
      }
    },
    "accepted_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/accepted"
      }
    },
    "rejected_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rejected"
      }
    },
    "counts": {
      "$ref": "#/$defs/counts"
    }
  },
  "$defs": {
    "digest": {
      "$ref": "cartulary.test_slice_plan.v3#/$defs/digest"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_snapshot_digest",
        "test_catalog_digest",
        "verification_routing_digest"
      ],
      "properties": {
        "source_snapshot_digest": {
          "$ref": "#/$defs/digest"
        },
        "test_catalog_digest": {
          "$ref": "#/$defs/digest"
        },
        "verification_routing_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "target_partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "run_root",
        "row_ids"
      ],
      "properties": {
        "target_id": {
          "$ref": "#/$defs/target_id"
        },
        "run_root": {
          "type": "string",
          "minLength": 1
        },
        "row_ids": {
          "$ref": "cartulary.test_slice_plan.v3#/$defs/row_ids"
        }
      }
    },
    "accepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "run_root",
        "artifact_path",
        "row_ids"
      ],
      "properties": {
        "target_id": {
          "$ref": "#/$defs/target_id"
        },
        "run_root": {
          "type": "string",
          "minLength": 1
        },
        "artifact_path": {
          "type": "string",
          "minLength": 1
        },
        "row_ids": {
          "$ref": "cartulary.test_slice_plan.v3#/$defs/row_ids"
        }
      }
    },
    "rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "run_root",
        "artifact_path",
        "reasons"
      ],
      "properties": {
        "target_id": {
          "$ref": "#/$defs/target_id"
        },
        "run_root": {
          "type": "string",
          "minLength": 1
        },
        "artifact_path": {
          "type": "string"
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_rows",
        "required_target_partitions",
        "accepted_target_partitions",
        "rejected_target_partitions"
      ],
      "properties": {
        "active_rows": {
          "type": "integer",
          "minimum": 1
        },
        "required_target_partitions": {
          "type": "integer",
          "minimum": 1
        },
        "accepted_target_partitions": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_target_partitions": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
