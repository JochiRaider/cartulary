{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.scheduler_manifest.v1",
  "type": "object",
  "required": ["schema_id", "generated", "schedules"],
  "additionalProperties": false,
  "properties": {
    "schema_id": { "const": "cartulary.scheduler_manifest.v1" },
    "generated": { "type": "object" },
    "schedules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/schedule" }
    }
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "claims": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "integer", "minimum": 1 },
          { "const": "limit" },
          { "const": "auto" }
        ]
      }
    },
    "schedule": {
      "type": "object",
      "required": [
        "target",
        "scheduler_kind",
        "capacity_profile",
        "resource_limits",
        "stop_on_first_failure",
        "progress_tick_seconds",
        "validate_timing",
        "work_units",
        "finalizers"
      ],
      "additionalProperties": false,
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "scheduler_kind": { "enum": ["check", "service_backed", "phase_slice"] },
        "capacity_profile": { "type": "string", "minLength": 1 },
        "resource_limits": { "$ref": "#/$defs/claims" },
        "stop_on_first_failure": { "type": "boolean" },
        "progress_tick_seconds": { "type": "integer", "minimum": 5, "maximum": 300 },
        "validate_timing": { "type": "boolean" },
        "summary_groups": { "type": "array" },
        "work_units": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/work_unit" }
        },
        "finalizers": {
          "type": "array",
          "items": { "$ref": "#/$defs/work_unit" }
        }
      }
    },
    "work_unit": {
      "type": "object",
      "required": ["target", "weight_ms", "resource_claims", "command"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "class": { "type": "string" },
        "target": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "aggregate_target": { "type": "string", "minLength": 1 },
        "priority": { "type": "integer", "minimum": 0 },
        "weight_ms": { "type": "integer", "minimum": 1 },
        "needs": { "$ref": "#/$defs/string_array" },
        "completion_keys": { "$ref": "#/$defs/string_array" },
        "failure_keys": { "$ref": "#/$defs/string_array" },
        "running_dependency_keys": { "$ref": "#/$defs/string_array" },
        "produces_summary_targets": { "$ref": "#/$defs/string_array" },
        "resource_claims": { "$ref": "#/$defs/claims" },
        "retained_resource_claims": { "$ref": "#/$defs/claims" },
        "release_retained_resource_claims": { "$ref": "#/$defs/claims" },
        "make_jobs": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "string", "minLength": 1 }
          ]
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "command": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "enum": [
                "make_target",
                "service_session_start",
                "browser_stage_session_start",
                "browser_group",
                "browser_stage_complete",
                "go_shard",
                "go_shard_finalize",
                "service_complete"
              ]
            }
          },
          "additionalProperties": true
        }
      }
    }
  }
}
