{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.projection_provider_manifest.v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "manifest_version",
    "authority",
    "source_registry",
    "import_policy",
    "providers"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.projection_provider_manifest.v4" },
    "manifest_version": { "type": "integer", "const": 4 },
    "authority": {
      "const": "validation_only_code_backed_registry_authoritative"
    },
    "source_registry": {
      "type": "string",
      "minLength": 1
    },
    "import_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_root_importers",
        "approved_adapter_packages",
        "approved_contract_packages"
      ],
      "properties": {
        "approved_root_importers": {
          "type": "array",
          "items": { "$ref": "#/$defs/repo_relative_go_file" },
          "uniqueItems": true
        },
        "approved_adapter_packages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_relative_package" },
          "uniqueItems": true
        },
        "approved_contract_packages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_relative_package" },
          "uniqueItems": true
        }
      }
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/provider" }
    }
  },
  "$defs": {
    "repo_relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "repo_relative_go_file": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.go$"
    },
    "repo_relative_package": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "source_authority_module": {
      "enum": [
        "assessments",
        "artifacts",
        "auth",
        "collaboration",
        "database_migrations",
        "deployment_admin",
        "entities",
        "evidence",
        "graphprojection",
        "harness_support",
        "imports",
        "incidentbundles",
        "incidents",
        "indicators",
        "jobapi",
        "links",
        "networkflow",
        "parties",
        "platform_jobs",
        "projections",
        "recovery",
        "reference_data",
        "reportcomposition",
        "reporting",
        "revisions",
        "savedviews",
        "tasksdecisions",
        "timeline",
        "viewschemas",
        "workbook"
      ]
    },
    "provider_status": {
      "enum": ["active", "deprecated", "experimental"]
    },
    "restore_rebuild": {
      "enum": ["required", "nonparticipating", "unsupported"]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "refresh_row",
        "restore_rebuild",
        "incident_rebuild"
      ],
      "properties": {
        "query": { "type": "boolean" },
        "refresh_row": { "type": "boolean" },
        "restore_rebuild": { "type": "boolean" },
        "incident_rebuild": { "type": "boolean" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "schema_version",
        "source_owner_module",
        "projection_storage_owner_module",
        "view_schema_ids",
        "projection_table_ids",
        "source_record_types",
        "source_authority_modules",
        "capabilities",
        "restore_rebuild",
        "status",
        "facade_packages",
        "rebuild_after",
        "characterization_refs"
      ],
      "properties": {
        "provider_id": { "$ref": "#/$defs/identifier" },
        "schema_version": {
          "const": "projection_provider_descriptor.v3"
        },
        "source_owner_module": { "$ref": "#/$defs/source_authority_module" },
        "projection_storage_owner_module": { "$ref": "#/$defs/identifier" },
        "view_schema_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^cartulary\\.view\\.[a-z0-9_]+\\.v[0-9]+$"
          },
          "uniqueItems": true
        },
        "projection_table_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "source_record_types": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "source_authority_modules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source_authority_module" },
          "uniqueItems": true
        },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "restore_rebuild": { "$ref": "#/$defs/restore_rebuild" },
        "status": { "$ref": "#/$defs/provider_status" },
        "facade_packages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_relative_package" },
          "uniqueItems": true
        },
        "rebuild_after": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "characterization_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/repo_relative_go_file" },
          "uniqueItems": true
        }
      }
    }
  }
}
