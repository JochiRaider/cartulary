{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.browser_e2e_batch_manifest.v11",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "runtime_profiles", "stages"],
  "properties": {
    "schema_id": { "const": "cartulary.browser_e2e_batch_manifest.v11" },
    "runtime_profiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/record" } },
    "stages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stage" } }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1 } }
    },
    "group": {
      "type": "object",
      "required": ["name", "target", "kind", "runtime_profile_id", "resource_profile_id", "service_requirement", "service_dependencies", "selected_row_ids", "specs", "browser_session_group"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "runtime_profile_id": { "type": "string", "minLength": 1 },
        "resource_profile_id": { "type": "string", "minLength": 1 },
        "fixture_profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*_v[1-9][0-9]*$" },
        "service_requirement": { "enum": ["none", "test-services"] },
        "service_dependencies": { "$ref": "cartulary.test_catalog_defs.v1#/$defs/service_dependencies" },
        "selected_row_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "cartulary.test_catalog_defs.v1#/$defs/row_id" } },
        "specs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "cartulary.test_catalog_defs.v1#/$defs/repo_path" } },
        "browser_session_group": { "type": "string", "minLength": 1 }
      }
    },
    "stage": {
      "type": "object",
      "required": ["name", "target", "groups"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } }
      }
    }
  }
}
