{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.performance_evidence_verification_contract.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "contract_id",
    "fixture_contract_id",
    "fixture_profile_id",
    "measurement_policy_id",
    "warmup_passes",
    "measured_samples",
    "product_retries",
    "threshold_ms",
    "threshold_comparison",
    "view_schema_id",
    "viewport",
    "start_mark",
    "dispatch_mark",
    "admission_mark",
    "workload",
    "criterion_ids",
    "predicate_id"
  ],
  "properties": {
    "schema_id": {
      "const": "cartulary.performance_evidence_verification_contract.v1"
    },
    "contract_id": {
      "const": "cartulary.performance.evidence_verification.v1"
    },
    "fixture_contract_id": {
      "const": "cartulary.performance.ac045.v2"
    },
    "fixture_profile_id": {
      "const": "evidence_heavy_snapshot_v2"
    },
    "measurement_policy_id": {
      "const": "cartulary.measurement.single_observation.v1"
    },
    "warmup_passes": {
      "const": 0
    },
    "measured_samples": {
      "const": 1
    },
    "product_retries": {
      "const": 0
    },
    "threshold_ms": {
      "const": 1000
    },
    "threshold_comparison": {
      "const": "lte"
    },
    "view_schema_id": {
      "const": "cartulary.view.timeline.v2"
    },
    "viewport": {
      "const": {
        "width": 1920,
        "height": 1080,
        "device_scale_factor": 1
      }
    },
    "start_mark": {
      "const": "cartulary.workbook.evidence_verification_accepted"
    },
    "dispatch_mark": {
      "const": "cartulary.workbook.evidence_verification_dispatched"
    },
    "admission_mark": {
      "const": "cartulary.workbook.evidence_verification_admitted"
    },
    "workload": {
      "const": {
        "foreground_role": "editor",
        "source_selection": "lowest_record_id",
        "target_selection": "next_lowest_record_id",
        "field_key": "timeline.analyst_text",
        "draft_value": "x",
        "filename": "verification-workload.png",
        "content_type": "image/png",
        "object_bytes": 2097152,
        "clipboard_driver": "synthesized_file_event",
        "grid_driver": "pointer_select_keyboard_edit",
        "preview_preflight_records": 100,
        "inspector_open": false,
        "attachment_details_expanded": false
      }
    },
    "criterion_ids": {
      "const": [
        "AC-016",
        "AC-046"
      ]
    },
    "predicate_id": {
      "const": "perf.evidence_verification.visible_with_cancel.v1"
    }
  }
}
