{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.frontend_visual_capture_intent.v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "test_file",
    "capture_profile",
    "capture_id",
    "capture_intent",
    "expected_golden_path",
    "project_id",
    "renderer_profile_id",
    "screenshot_assertion_location",
    "test_title",
    "row_id",
    "scenario_id"
  ],
  "properties": {
    "capture_id": {
      "type": "string",
      "pattern": "^visual\\.capture\\.[0-9a-f]{20}$"
    },
    "capture_intent": {
      "type": "string",
      "minLength": 1
    },
    "expected_golden_path": {
      "type": "string",
      "pattern": "^apps/web/e2e/visual-goldens/[^/]+\\.png$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "renderer_profile_id": {
      "$ref": "cartulary.frontend_visual_reconciliation.v4#/$defs/profile_id"
    },
    "screenshot_assertion_location": {
      "type": "string",
      "minLength": 1
    },
    "test_title": {
      "type": "string",
      "minLength": 1
    },
    "schema_id": {
      "const": "cartulary.frontend_visual_capture_intent.v3"
    },
    "test_file": {
      "$ref": "cartulary.test_catalog_defs.v1#/$defs/repo_path"
    },
    "capture_profile": {
      "$ref": "cartulary.frontend_visual_reconciliation.v4#/$defs/capture_profile"
    },
    "row_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "$ref": "cartulary.test_catalog_defs.v1#/$defs/segment"
    }
  }
}
