{
  "schema_id": "cartulary.service_backed_schedule_profiles.v3",
  "defaults": {
    "go_shards_resource_claims": { "postgres": 1, "minio": 1 },
    "make_target_duration_baseline": "service_backed_make_target_duration_baselines.json",
    "make_target_weight_overrides": {},
    "backend_make_target_resource_claims": {
      "backend-process": {
        "postgres": 1,
        "minio": 1,
        "go_cpu": 1,
        "go_io": 1,
        "process": 1
      }
    },
    "browser_make_target_resource_claims": {
      "postgres": 1,
      "minio": 1,
      "process": 1,
      "browser_stack": 1
    }
  },
  "schedules": [
    {
      "target": "test-service-backed",
      "resource_limits": {
        "postgres": 32,
        "minio": 32,
        "go_cpu": "auto",
        "go_io": "auto",
        "postgres_reset": 1,
        "process": 4,
        "browser_stack": "auto"
      },
      "selectors": {
        "backend": {
          "service_backed": true,
          "check_service_backed_safe": true
        },
        "browser": {
          "schedule_tags": ["service_backed_full"]
        }
      }
    },
    {
      "target": "test-fast-service-backed",
      "resource_limits": {
        "postgres": 32,
        "minio": 32,
        "go_cpu": "auto",
        "go_io": "auto",
        "postgres_reset": 1,
        "process": 4
      },
      "selectors": {
        "backend": {
          "service_backed": true,
          "check_service_backed_safe": true
        }
      }
    },
    {
      "target": "check-service-backed",
      "resource_limits": {
        "postgres": 32,
        "minio": 32,
        "go_cpu": "auto",
        "go_io": "auto",
        "postgres_reset": 1,
        "process": 4,
        "browser_stack": "auto"
      },
      "selectors": {
        "backend": {
          "service_backed": true,
          "check_service_backed_safe": true
        },
        "browser": {
          "schedule_tags": ["service_backed_full"]
        }
      }
    }
  ]
}
