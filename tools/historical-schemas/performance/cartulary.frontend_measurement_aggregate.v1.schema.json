{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.frontend_measurement_aggregate.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "target_id",
    "status",
    "scheduler_overlap_count",
    "source_report_refs",
    "summaries"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.frontend_measurement_aggregate.v1" },
    "target_id": { "const": "browser-e2e-measurement" },
    "status": { "const": "qualified" },
    "scheduler_overlap_count": { "const": 0 },
    "source_report_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "summaries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "cartulary.frontend_measurement_summary.v1" }
    }
  }
}
