{
  "schema_id": "cartulary.check_schedule.v5",
  "schedules": [
    {
      "target": "check",
      "resource_limits": {
        "host_cpu": 12,
        "host_io": 12,
        "service_stack": 1
      },
      "work_units": [
        {
          "target": "check-setup-blockers",
          "weight": 50000,
          "needs": [],
          "resource_claims": {
            "host_cpu": 1
          },
          "make_jobs": "host_cpu"
        },
        {
          "target": "check-build-prereqs",
          "weight": 40000,
          "needs": [
            "check-setup-blockers"
          ],
          "resource_claims": {
            "host_cpu": "limit"
          },
          "make_jobs": "host_cpu"
        },
        {
          "target": "check-service-backed",
          "weight": 30000,
          "needs": [
            "check-build-prereqs"
          ],
          "resource_claims": {
            "host_cpu": {
              "mode": "bounded_limit",
              "reserve": 3,
              "min": 1,
              "max": 8
            },
            "host_io": {
              "mode": "bounded_limit",
              "reserve": 4,
              "min": 1,
              "max": 10
            },
            "service_stack": 1
          },
          "make_jobs": "host_cpu",
          "nested_scheduler": {
            "type": "service_backed",
            "target": "check-service-backed",
            "manifest": "tools/service_backed_schedule_manifest.json",
            "forwarding": "check_host_to_service_backed_go"
          }
        },
        {
          "target": "check-go-test-duration-baseline-drift",
          "weight": 29000,
          "needs": [
            "check-service-backed"
          ],
          "resource_claims": {
            "host_cpu": 1
          },
          "make_jobs": "host_cpu"
        },
        {
          "target": "check-browser-e2e-duration-baseline-drift",
          "weight": 28000,
          "needs": [
            "check-service-backed"
          ],
          "resource_claims": {
            "host_cpu": 1
          },
          "make_jobs": "host_cpu"
        },
        {
          "target": "check-local-product",
          "weight": 20000,
          "needs": [
            "check-build-prereqs"
          ],
          "produces_summary_targets": [
            "backend-unit",
            "frontend-typecheck"
          ],
          "resource_claims": {
            "host_cpu": 1
          },
          "make_jobs": "host_cpu"
        },
        {
          "target": "check-frontend-unit",
          "weight": 15000,
          "needs": [
            "check-build-prereqs"
          ],
          "produces_summary_targets": [
            "frontend-unit"
          ],
          "resource_claims": {
            "host_cpu": 1
          },
          "make_jobs": "host_cpu"
        },
        {
          "target": "check-meta-validation",
          "weight": 10000,
          "needs": [
            "check-build-prereqs"
          ],
          "produces_summary_targets": [
            "check-harness-smoke"
          ],
          "resource_claims": {
            "host_cpu": 1
          },
          "make_jobs": "host_cpu"
        }
      ]
    }
  ]
}
