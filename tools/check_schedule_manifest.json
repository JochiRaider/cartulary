{
  "schema_id": "cartulary.check_schedule.v2",
  "schedules": [
    {
      "target": "check",
      "resource_limits": {
        "cpu": 8,
        "io": 12,
        "service_stack": 1
      },
      "work_units": [
        {
          "target": "check-setup-blockers",
          "weight": 50000,
          "needs": [],
          "resource_claims": { "cpu": 1 },
          "make_jobs": "cpu"
        },
        {
          "target": "check-build-prereqs",
          "weight": 40000,
          "needs": ["check-setup-blockers"],
          "resource_claims": { "cpu": "limit" },
          "make_jobs": "cpu"
        },
        {
          "target": "check-service-backed",
          "weight": 30000,
          "needs": ["check-build-prereqs"],
          "resource_claims": { "cpu": "limit", "io": "limit", "service_stack": 1 },
          "make_jobs": "cpu",
          "nested_scheduler": {
            "type": "service_backed",
            "target": "check-service-backed",
            "manifest": "tools/service_backed_schedule_manifest.json",
            "resource_limit_env": {
              "cpu": "CARTULARY_SERVICE_BACKED_GO_CPU_LIMIT",
              "io": "CARTULARY_SERVICE_BACKED_GO_IO_LIMIT"
            }
          }
        },
        {
          "target": "check-go-test-duration-baseline-drift",
          "weight": 29000,
          "needs": ["check-service-backed"],
          "resource_claims": { "cpu": 1 },
          "make_jobs": "cpu"
        },
        {
          "target": "check-local-product",
          "weight": 20000,
          "needs": ["check-build-prereqs"],
          "resource_claims": { "cpu": 1 },
          "make_jobs": "cpu"
        },
        {
          "target": "check-frontend-unit",
          "weight": 15000,
          "needs": ["check-build-prereqs"],
          "resource_claims": { "cpu": 1 },
          "make_jobs": "cpu"
        },
        {
          "target": "check-meta-validation",
          "weight": 10000,
          "needs": ["check-build-prereqs"],
          "resource_claims": { "cpu": 1 },
          "make_jobs": "cpu"
        }
      ]
    }
  ]
}
