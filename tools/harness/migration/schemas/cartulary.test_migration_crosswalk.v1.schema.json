{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cartulary.local/migration-schemas/cartulary.test_migration_crosswalk.v1.schema.json",
  "title": "Cartulary test migration crosswalk v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "baseline_digest",
    "status",
    "pending_baseline_keys",
    "dispositions",
    "auxiliary_dispositions",
    "new_rows"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.test_migration_crosswalk.v1" },
    "baseline_digest": { "$ref": "#/$defs/digest" },
    "status": { "enum": ["in_progress", "reconciled"] },
    "pending_baseline_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/key" }
    },
    "dispositions": {
      "type": "array",
      "items": { "$ref": "#/$defs/disposition" }
    },
    "auxiliary_dispositions": {
      "type": "array",
      "items": { "$ref": "#/$defs/auxiliaryDisposition" }
    },
    "new_rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/newRow" }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^(?:module|platform|app|web|package|harness)\\.[a-z][a-z0-9_]{0,62}(?:\\.[a-z][a-z0-9_]{0,62}){0,2}$", "maxLength": 191 },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_registry_id", "legacy_row_id"],
      "properties": {
        "source_registry_id": { "enum": ["backend_phase_maps", "frontend_phase_maps", "graph_projection_subsystem"] },
        "legacy_row_id": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["governing_owner", "governing_requirement", "review_revision", "owner_review_evidence"],
      "properties": {
        "governing_owner": { "$ref": "#/$defs/id" },
        "governing_requirement": { "type": "string", "minLength": 1 },
        "review_revision": { "type": "string", "minLength": 1 },
        "owner_review_evidence": { "type": "string", "minLength": 1 }
      }
    },
    "migrated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_registry_id", "legacy_row_id", "disposition", "owner_id", "row_id", "verification_ids", "adjudication_rule", "collaborator_ids", "review"],
      "properties": {
        "source_registry_id": { "enum": ["backend_phase_maps", "frontend_phase_maps", "graph_projection_subsystem"] },
        "legacy_row_id": { "type": "string", "minLength": 1 },
        "disposition": { "const": "migrated" },
        "owner_id": { "$ref": "#/$defs/id" },
        "row_id": { "$ref": "#/$defs/id" },
        "verification_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "adjudication_rule": { "enum": ["normative_postcondition", "durable_mutation", "mechanism_owner"] },
        "collaborator_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "review": { "$ref": "#/$defs/review" }
      }
    },
    "consolidated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_registry_id", "legacy_row_id", "disposition", "owner_id", "row_id", "verification_ids", "adjudication_rule", "collaborator_ids", "review", "surviving_row_id", "assertion_preservation_evidence"],
      "properties": {
        "source_registry_id": { "enum": ["backend_phase_maps", "frontend_phase_maps", "graph_projection_subsystem"] },
        "legacy_row_id": { "type": "string", "minLength": 1 },
        "disposition": { "const": "consolidated" },
        "owner_id": { "$ref": "#/$defs/id" },
        "row_id": { "$ref": "#/$defs/id" },
        "verification_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "adjudication_rule": { "enum": ["normative_postcondition", "durable_mutation", "mechanism_owner"] },
        "collaborator_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "review": { "$ref": "#/$defs/review" },
        "surviving_row_id": { "$ref": "#/$defs/id" },
        "assertion_preservation_evidence": { "type": "string", "minLength": 1 }
      }
    },
    "deleted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_registry_id", "legacy_row_id", "disposition", "reason", "review"],
      "properties": {
        "source_registry_id": { "enum": ["backend_phase_maps", "frontend_phase_maps", "graph_projection_subsystem"] },
        "legacy_row_id": { "type": "string", "minLength": 1 },
        "disposition": { "const": "deleted" },
        "reason": { "enum": ["unsupported", "duplicate", "obsolete", "documentation_only", "non_production"] },
        "review": { "$ref": "#/$defs/review" }
      }
    },
    "disposition": { "oneOf": [{ "$ref": "#/$defs/migrated" }, { "$ref": "#/$defs/consolidated" }, { "$ref": "#/$defs/deleted" }] },
    "auxiliaryDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "disposition", "reason", "owner_review_evidence"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["retained", "deleted", "consolidated"] },
        "reason": { "type": "string", "minLength": 1 },
        "owner_review_evidence": { "type": "string", "minLength": 1 }
      }
    },
    "newRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_id", "row_id", "verification_ids", "provenance"],
      "properties": {
        "owner_id": { "$ref": "#/$defs/id" },
        "row_id": { "$ref": "#/$defs/id" },
        "verification_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "provenance": { "type": "string", "minLength": 1 }
      }
    }
  }
}
