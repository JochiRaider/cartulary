{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cartulary.local/migration-schemas/cartulary.test_migration_baseline.v1.schema.json",
  "title": "Cartulary test migration baseline v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "baseline_commit",
    "baseline_tree",
    "source_digest",
    "authoritative_population",
    "source_counts",
    "identities",
    "auxiliary_candidates",
    "inventories"
  ],
  "properties": {
    "schema_id": { "const": "cartulary.test_migration_baseline.v1" },
    "baseline_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "baseline_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_digest": { "$ref": "#/$defs/digest" },
    "authoritative_population": { "const": 548 },
    "source_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "frontend", "graph_projection"],
      "properties": {
        "backend": { "const": 456 },
        "frontend": { "const": 87 },
        "graph_projection": { "const": 5 }
      }
    },
    "identities": {
      "type": "array",
      "minItems": 548,
      "maxItems": 548,
      "items": { "$ref": "#/$defs/identity" }
    },
    "auxiliary_candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend_support", "vitest_classifications"],
      "properties": {
        "backend_support": {
          "type": "array",
          "minItems": 37,
          "maxItems": 37,
          "items": { "$ref": "#/$defs/auxiliary" }
        },
        "vitest_classifications": {
          "type": "array",
          "minItems": 228,
          "maxItems": 228,
          "items": { "$ref": "#/$defs/auxiliary" }
        }
      }
    },
    "inventories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledgers",
        "phase_identity_paths",
        "visual_goldens",
        "documentation_read_candidates",
        "production_followups",
        "generated_paths"
      ],
      "properties": {
        "ledgers": { "$ref": "#/$defs/paths" },
        "phase_identity_paths": { "$ref": "#/$defs/paths" },
        "visual_goldens": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "digest"],
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "digest": { "$ref": "#/$defs/digest" }
            }
          }
        },
        "documentation_read_candidates": { "$ref": "#/$defs/paths" },
        "production_followups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "classification", "owner_id", "reason"],
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "classification": { "enum": ["authored_historical_delivery_metadata", "generated_descendant"] },
              "owner_id": { "type": "string", "pattern": "^(?:module|platform|app|web|package|harness)\\.[a-z][a-z0-9_]{0,62}$" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "generated_paths": { "$ref": "#/$defs/paths" }
      }
    }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_registry_id",
        "legacy_row_id",
        "source_path",
        "source_group",
        "runner",
        "selector",
        "selector_digest"
      ],
      "properties": {
        "source_registry_id": { "enum": ["backend_phase_maps", "frontend_phase_maps", "graph_projection_subsystem"] },
        "legacy_row_id": { "type": "string", "minLength": 1 },
        "source_path": { "$ref": "#/$defs/path" },
        "source_group": { "type": "string", "minLength": 1 },
        "runner": { "enum": ["go", "vitest", "playwright", "shell"] },
        "selector": { "type": "object" },
        "selector_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "auxiliary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "source_path", "classification", "selector", "selector_digest"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "source_path": { "$ref": "#/$defs/path" },
        "classification": { "type": "string", "minLength": 1 },
        "selector": { "type": "object" },
        "selector_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
