{
  "schema_id": "cartulary.harness_redaction_manifest.v1",
  "replacement": "[REDACTED]",
  "redaction_tokens": {
    "password": "[REDACTED:password]",
    "token": "[REDACTED:token]",
    "key": "[REDACTED:key]",
    "dsn": "[REDACTED:dsn]",
    "object_store_credential": "[REDACTED:object-store-credential]",
    "private_key": "[REDACTED:private-key]"
  },
  "sensitive_key_patterns": [
    "^(?:authorization|cookie|set-cookie|x-cartulary-test-route-token)$",
    "^(?:password|pass|pwd|token|jwt|bearer|api[_-]?key|access[_-]?key|secret[_-]?key)$",
    "(?:^|[_-])(?:password|pass|pwd|token|jwt|bearer|api[_-]?key|access[_-]?key|secret[_-]?key)$",
    "^(?:password|pass|pwd|token|jwt|bearer|api[_-]?key|access[_-]?key|secret[_-]?key)(?:[_-]|$)"
  ],
  "value_patterns": [
    {
      "name": "bearer_token",
      "pattern": "(?i)\\bBearer\\s+[-._~+/A-Za-z0-9]+=*",
      "replacement": "Bearer [REDACTED:token]"
    },
    {
      "name": "basic_auth",
      "pattern": "(?i)\\bBasic\\s+[-._~+/A-Za-z0-9]+=*",
      "replacement": "Basic [REDACTED:token]"
    },
    {
      "name": "authorization_header",
      "pattern": "(?i)\\b(Authorization\\s*:\\s*)([^\\r\\n]+)",
      "replacement": "$1[REDACTED:token]"
    },
    {
      "name": "cookie_header",
      "pattern": "(?i)\\b((?:Cookie|Set-Cookie|X-Cartulary-Test-Route-Token)\\s*:\\s*)([^\\r\\n]+)",
      "replacement": "$1[REDACTED:token]"
    },
    {
      "name": "jwt",
      "pattern": "\\beyJ[-_A-Za-z0-9]+\\.[-_A-Za-z0-9]+\\.[-_A-Za-z0-9]+\\b",
      "replacement": "[REDACTED:token]"
    },
    {
      "name": "postgres_password",
      "pattern": "(?i)postgres(?:ql)?://([^:\\s/@]+):([^@\\s]+)@",
      "replacement": "postgres://$1:[REDACTED:dsn]@"
    },
    {
      "name": "postgres_password_assignment",
      "pattern": "(?i)\\b(password\\s*=\\s*)([^\\s&;]+)",
      "replacement": "$1[REDACTED:dsn]"
    },
    {
      "name": "generic_url_userinfo",
      "pattern": "(?i)\\b([a-z][a-z0-9+.-]*://)([^:/\\s@]+):([^@\\s]+)@",
      "replacement": "$1$2:[REDACTED:dsn]@"
    },
    {
      "name": "cli_secret_argument_equals",
      "pattern": "(?i)(--(?:password|passwd|pwd|secret|token|jwt|api[_-]?key|access[_-]?key|secret[_-]?key|private[_-]?key|client[_-]?secret|dsn)\\s*=\\s*)([^\\s]+)",
      "replacement": "$1[REDACTED]"
    },
    {
      "name": "cli_secret_argument_space",
      "pattern": "(?i)(--(?:password|passwd|pwd|secret|token|jwt|api[_-]?key|access[_-]?key|secret[_-]?key|private[_-]?key|client[_-]?secret|dsn)\\s+)([^\\s]+)",
      "replacement": "$1[REDACTED]"
    },
    {
      "name": "generic_password_assignment",
      "pattern": "(?i)\\b(password|passwd|pwd|secret|token|jwt|api[_-]?key|access[_-]?key|secret[_-]?key|private[_-]?key|client[_-]?secret|dsn)\\s*=\\s*([^\\s&]+)",
      "replacement": "$1=[REDACTED]"
    },
    {
      "name": "object_store_credential_assignment",
      "pattern": "(?i)\\b((?:minio|s3|aws)?[_-]?(?:access[_-]?key|secret[_-]?key|access[_-]?key[_-]?id|secret[_-]?access[_-]?key)\\s*=\\s*)([^\\s&]+)",
      "replacement": "$1[REDACTED:object-store-credential]"
    },
    {
      "name": "json_like_secret_assignment",
      "pattern": "(?i)(\"(?:authorization|cookie|set-cookie|x-cartulary-test-route-token|password|passwd|pwd|secret|token|jwt|api[_-]?key|access[_-]?key|secret[_-]?key|private[_-]?key|client[_-]?secret|dsn)\"\\s*:\\s*\")([^\"]+)(\")",
      "replacement": "$1[REDACTED]$3"
    },
    {
      "name": "private_key_block",
      "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----",
      "replacement": "[REDACTED:private-key]"
    }
  ]
}
