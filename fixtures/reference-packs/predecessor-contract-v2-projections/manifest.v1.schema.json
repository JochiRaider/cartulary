{
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "cartulary.reference_pack_manifest.v1"
    },
    "pack_contract_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,192}$"
    },
    "pack_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}(\\.[a-z][a-z0-9_]{0,31}){1,7}$",
      "minLength": 3,
      "maxLength": 128
    },
    "pack_kind": {
      "enum": [
        "type_registry",
        "framework",
        "enrichment"
      ]
    },
    "pack_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    },
    "pack_release_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "content_profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,192}$"
    },
    "content_profile_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,192}$"
    },
    "source_profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,192}$"
    },
    "source_profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trust_repository_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}(\\.[a-z][a-z0-9_]{0,31}){1,7}$",
          "minLength": 3,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "source_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_as_of": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "built_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "builder": {
      "type": "object",
      "properties": {
        "builder_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192
        },
        "builder_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "builder_source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "builder_id",
        "builder_version",
        "builder_source_sha256"
      ],
      "additionalProperties": false
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "source_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "source_ref",
          "source_version",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64,
      "x-limitId": "max_source_artifacts"
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "cartulary_contract_majors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required_capabilities": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,192}$"
          }
        }
      },
      "required": [
        "cartulary_contract_majors",
        "required_capabilities"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pack_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}(\\.[a-z][a-z0-9_]{0,31}){1,7}$",
            "minLength": 3,
            "maxLength": 128
          },
          "pack_version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
          },
          "payload_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "pack_key",
          "pack_version",
          "payload_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64,
      "x-limitId": "max_dependencies"
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pack_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}(\\.[a-z][a-z0-9_]{0,31}){1,7}$",
            "minLength": 3,
            "maxLength": 128
          },
          "pack_version": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "pack_key",
          "pack_version"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64,
      "x-limitId": "max_conflicts"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "role": {
            "enum": [
              "payload",
              "notice"
            ]
          },
          "media_type": {
            "enum": [
              "application/x-ndjson",
              "text/plain"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 268435456
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "role",
          "media_type",
          "size_bytes",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 66,
      "x-limitId": "max_manifest_files"
    },
    "content_summary": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "entries"
            },
            "entry_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2000000
            }
          },
          "required": [
            "kind",
            "entry_count"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "objects_relationships"
            },
            "object_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2000000
            },
            "relationship_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5000000
            }
          },
          "required": [
            "kind",
            "object_count",
            "relationship_count"
          ],
          "additionalProperties": false
        }
      ]
    },
    "license": {
      "type": "object",
      "properties": {
        "expression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "license_list_version": {
          "const": "3.28.0"
        },
        "redistribution": {
          "enum": [
            "allowed",
            "restricted",
            "prohibited"
          ]
        },
        "notice_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 0,
          "maxItems": 64
        },
        "license_ref_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "license_ref": {
                "type": "string",
                "pattern": "^LicenseRef-[A-Za-z0-9.-]+$"
              },
              "notice_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "license_ref",
              "notice_path"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 64
        }
      },
      "required": [
        "expression",
        "license_list_version",
        "redistribution",
        "notice_paths",
        "license_ref_bindings"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false
    }
  },
  "required": [
    "schema_id",
    "pack_contract_version",
    "pack_key",
    "pack_kind",
    "pack_version",
    "pack_release_sequence",
    "content_profile_id",
    "content_profile_version",
    "source_profile_id",
    "source_profile_sha256",
    "trust_repository_id",
    "source_identifier",
    "source_version",
    "source_as_of",
    "built_at",
    "builder",
    "source_artifacts",
    "compatibility",
    "dependencies",
    "conflicts",
    "files",
    "content_summary",
    "license",
    "extensions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.reference_pack_manifest.v1"
}
