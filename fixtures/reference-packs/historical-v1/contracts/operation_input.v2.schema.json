{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartulary.reference_pack_operation_input.v2",
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "cartulary.reference_pack_operation_input.v2"
    },
    "kind": {
      "enum": [
        "import",
        "reverify",
        "refresh",
        "activate",
        "disable",
        "remove",
        "integrity"
      ]
    },
    "admitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "pack_set_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^rpset_[0-9a-f]{64}$"
    },
    "set_revision": {
      "type": "integer",
      "minimum": 1
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "clock_trusted": {
      "type": "boolean"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 86400
    },
    "container_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "container_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "container_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "required": [
    "schema_id",
    "kind",
    "admitted_at",
    "pack_set_id",
    "set_revision",
    "configuration_sha256",
    "clock_trusted",
    "timeout_seconds",
    "container_reference",
    "container_sha256",
    "container_bytes"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "import"
          }
        }
      },
      "then": {
        "properties": {
          "container_reference": {
            "type": "string",
            "minLength": 1
          },
          "container_sha256": {
            "type": "string"
          },
          "container_bytes": {
            "type": "integer"
          }
        }
      },
      "else": {
        "properties": {
          "container_reference": {
            "type": "null"
          },
          "container_sha256": {
            "type": "null"
          },
          "container_bytes": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "integrity"
          }
        }
      },
      "else": {
        "properties": {
          "pack_set_id": {
            "type": "string"
          }
        }
      }
    }
  ]
}
