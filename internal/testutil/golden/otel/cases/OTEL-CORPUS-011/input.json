{
  "schema_id": "cartulary.otel_corpus_input.v1",
  "case_id": "OTEL-CORPUS-011",
  "title": "Object storage",
  "status": "adopted_conformant",
  "owner_requirement": "Upload target, attach, preview/download handle issuance, object-store unavailable, transfer size, and forbidden object-identifier cases emit only allowed object-store telemetry.",
  "objectstore_dependency_assertions": {
    "span_families": ["objectstore_dependency"],
    "span_names": ["cartulary.objectstore.operation"],
    "span_kinds": ["client"],
    "metrics": [
      "cartulary.objectstore.operation.duration",
      "cartulary.objectstore.transfer.bytes"
    ],
    "safe_operations": [
      "create_upload_target",
      "complete_upload_target",
      "put_object",
      "get_object",
      "get_object_range",
      "head_object",
      "list_prefix",
      "delete_object",
      "ensure_bucket_for_dev_test"
    ],
    "safe_error_classes": ["dependency_unavailable", "timeout", "internal_error"],
    "forbidden_values_absent": [
      "bucket",
      "key",
      "filename",
      "object_hash",
      "upload_id",
      "copy_source",
      "storage_ref",
      "aws.s3.*"
    ],
    "evidence": [
      "internal/platform/objectstore/telemetry_test.go::TestTelemetryStorePreservesStoreBehaviorNoSDK",
      "internal/platform/objectstore/telemetry_test.go::TestObjectStoreErrorClass",
      "internal/platform/telemetry/registry_test.go::TestSpanRegistryClosed",
      "internal/platform/telemetry/registry_test.go::TestMetricRegistryClosed"
    ]
  }
}
