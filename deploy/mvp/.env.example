# Copy this file to deploy/mvp/.env and replace every value before use.
# Values in this example are scaffolding only, not deployable secrets.

CARTULARY_IMAGE=cartulary/mvp:local
CARTULARY_HTTP_PORT=8080
CARTULARY_PUBLIC_ORIGIN=http://localhost:8080
# Optional: set this when wrapper scripts must join an existing Compose project.
# CARTULARY_MVP_COMPOSE_PROJECT_NAME=cartulary-mvp

POSTGRES_DB=cartulary
POSTGRES_USER=cartulary
POSTGRES_PASSWORD=replace-this-postgres-password
CARTULARY_POSTGRES_MIGRATION_PASSWORD=replace-this-migration-password
CARTULARY_POSTGRES_RUNTIME_PASSWORD=replace-this-runtime-password
CARTULARY_POSTGRES_RECOVERY_PASSWORD=replace-this-recovery-password

CARTULARY_AUTH_MASTER_KEY=replace-with-base64-32-bytes
CARTULARY_RECOVERY_MASTER_KEY=replace-with-base64-32-bytes
CARTULARY_SECRET_REVISIONS_CONFLICT_TOKEN_ACTIVE=replace-with-unpadded-base64url-32-bytes

CARTULARY_S3_PRIMARY_ACCESS_KEY_ID=replace-this-s3-access-key
CARTULARY_S3_PRIMARY_SECRET_ACCESS_KEY=replace-this-s3-secret-key
CARTULARY_S3_PRIMARY_BUCKET=cartulary

RESTORE_VERIFY_POSTGRES_DB=cartulary_restore_verify
CARTULARY_S3_RESTORE_VERIFY_ENDPOINT=seaweedfs-s3:8333
CARTULARY_S3_RESTORE_VERIFY_ACCESS_KEY_ID=replace-this-restore-verify-s3-access-key
CARTULARY_S3_RESTORE_VERIFY_SECRET_ACCESS_KEY=replace-this-restore-verify-s3-secret-key
CARTULARY_S3_RESTORE_VERIFY_BUCKET=cartulary-restore-verify
CARTULARY_S3_RESTORE_VERIFY_SECURE=false
