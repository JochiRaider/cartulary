config_schema_id = "cartulary.deployment_config.v3"
deployment_profile = "on_prem"

[application]
tls_certificate_path = "/etc/cartulary/tls/application.crt"
tls_private_key_path = "/etc/cartulary/tls/application.key"
public_origin = "https://localhost:8080"

[roots.database_storage]
binding_kind = "managed_service"
service_ref = "primary"

[roots.object_storage]
binding_kind = "managed_service"
service_ref = "primary"

[roots.backup_storage]
binding_kind = "filesystem_root"
path = "/var/lib/cartulary/backups"

[roots.reference_pack_storage]
binding_kind = "filesystem_root"
path = "/var/lib/cartulary/reference-packs"

[roots.temporary_work]
binding_kind = "filesystem_root"
path = "/var/lib/cartulary/tmp"

[roots.export_outputs]
binding_kind = "filesystem_root"
path = "/var/lib/cartulary/exports"

[bootstrap]
first_admin_manifest_path = "/etc/cartulary/bootstrap-admin.json"

[revisions]
conflict_token_key_ring_manifest_path = "/etc/cartulary/revisions-conflict-token-key-ring.json"
