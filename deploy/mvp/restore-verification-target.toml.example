config_schema_id = "cartulary.deployment_config.v2"
deployment_profile = "on_prem"

[application]
public_origin = "http://localhost:8080"

[roots.database_storage]
binding_kind = "managed_service"
service_ref = "restore_verify"

[roots.object_storage]
binding_kind = "managed_service"
service_ref = "restore_verify"

[roots.backup_storage]
binding_kind = "filesystem_root"
path = "/var/lib/cartulary/restore-verification-target/backups"

[roots.reference_pack_storage]
binding_kind = "filesystem_root"
path = "/var/lib/cartulary/restore-verification-target/reference-packs"

[roots.temporary_work]
binding_kind = "filesystem_root"
path = "/var/lib/cartulary/restore-verification-target/tmp"

[roots.export_outputs]
binding_kind = "filesystem_root"
path = "/var/lib/cartulary/restore-verification-target/exports"

[bootstrap]
first_admin_manifest_path = "/etc/cartulary/restore-verification-bootstrap-admin.json"

[revisions]
conflict_token_key_ring_manifest_path = "/etc/cartulary/revisions-conflict-token-key-ring.json"
