[Unit]
Description=Cartulary MVP restore verification due runner
After=network-online.target

[Service]
Type=oneshot
Environment=CARTULARY_MVP_DIR=/opt/cartulary
Environment=CARTULARY_MVP_ENV_FILE=/opt/cartulary/.env
Environment=CARTULARY_RESTORE_VERIFY_TARGET_CONFIG=/opt/cartulary/restore-verification-target.toml
Environment=CARTULARY_RESTORE_VERIFY_TARGET_ROOT=/var/lib/cartulary/restore-verification-target
ExecStart=/opt/cartulary/release/assets/scripts/package.sh restore-verify-due
