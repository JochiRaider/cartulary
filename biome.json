{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": "."
  },
  "files": {
    "includes": [
      "apps/web/src/**",
      "apps/web/e2e/**",
      "apps/web/vite.config.ts",
      "apps/web/playwright.config.ts",
      "apps/web/playwright.shared.config.ts",
      "apps/web/playwright.webserver-backed.config.ts",
      "packages/grid-adapter/src/**",
      "packages/ui-contracts/src/**",
      "!packages/ui-contracts/src/generated/**",
      "packages/view-contracts/src/**",
      "packages/test-utils/src/**",
      "packages/protocol-ts/src/**",
      "!packages/protocol-ts/src/generated/**",
      "scripts/**/*.mjs",
      "!tmp/**",
      "!.cache/**",
      "!.pnpm-store/**",
      "!node_modules/**",
      "!apps/web/dist/**",
      "!apps/web/test-results/**",
      "!apps/web/playwright-report/**",
      "!apps/web/coverage/**",
      "!coverage/**",
      "!playwright-report/**",
      "!test-results/**",
      "!dist/**",
      "!build/**",
      "!out/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useButtonType": "error"
      },
      "correctness": {
        "noUndeclaredDependencies": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error",
        "useJsxKeyInIterable": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error",
        "noGlobalEval": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "error",
        "noFocusedTests": "error",
        "noImportCycles": {
          "level": "error",
          "options": {
            "ignoreTypes": true
          }
        },
        "noSkippedTests": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/web/src/**",
        "!apps/web/src/*.test.ts",
        "!apps/web/src/*.test.tsx",
        "!apps/web/src/**/*.test.ts",
        "!apps/web/src/**/*.test.tsx",
        "!apps/web/src/fetchMockTestSupport.ts",
        "!apps/web/src/testSetup.ts",
        "!apps/web/src/testSetup.dom.ts",
        "!apps/web/src/timelineWorkbookTestSupport.ts",
        "packages/grid-adapter/src/**",
        "!packages/grid-adapter/src/*.test.ts",
        "!packages/grid-adapter/src/*.test.tsx",
        "!packages/grid-adapter/src/**/*.test.ts",
        "!packages/grid-adapter/src/**/*.test.tsx",
        "!packages/grid-adapter/src/test-support.tsx",
        "packages/ui-contracts/src/**",
        "!packages/ui-contracts/src/generated/**",
        "!packages/ui-contracts/src/*.test.ts",
        "!packages/ui-contracts/src/*.test.tsx",
        "!packages/ui-contracts/src/**/*.test.ts",
        "!packages/ui-contracts/src/**/*.test.tsx",
        "packages/view-contracts/src/**",
        "!packages/view-contracts/src/*.test.ts",
        "!packages/view-contracts/src/*.test.tsx",
        "!packages/view-contracts/src/**/*.test.ts",
        "!packages/view-contracts/src/**/*.test.tsx",
        "packages/protocol-ts/src/**",
        "!packages/protocol-ts/src/generated/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    }
  ]
}
