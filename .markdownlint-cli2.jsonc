{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/v0.22.1/schema/markdownlint-cli2-config-schema.json",
  "fix": false,
  "gitignore": true,
  "globs": [
    "*.md",
    "docs/*.md",
    "docs/spec/**/*.md",
    "docs/guides/**/*.md",
    "docs/research/**/*.md",
    "docs/user_guides/**/*.md",
    "apps/web/public/assets/fonts/*.md"
  ],
  "ignores": [
    "docs/archive/**",
    "docs/testing-harness-spec-recovery-docs/**",
    "internal/gen/**",
    "packages/protocol-ts/src/generated/**",
    "packages/ui-contracts/src/generated/**",
    "tmp/**",
    "temp/**",
    ".cartulary/**",
    ".cache/**",
    "node_modules/**",
    ".pnpm-store/**",
    "dist/**",
    "build/**",
    "out/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    "apps/web/dist/**",
    "apps/web/coverage/**",
    "apps/web/playwright-report/**",
    "apps/web/test-results/**"
  ],
  "noBanner": true,
  "noProgress": true,
  "config": {
    "default": false,
    "MD001": true,
    "MD009": true,
    "MD010": true,
    "MD011": true,
    "MD013": false,
    "MD018": true,
    "MD019": true,
    "MD020": true,
    "MD021": true,
    "MD023": true,
    "MD024": {
      "siblings_only": true
    },
    "MD040": true,
    "MD042": true,
    "MD047": true,
    "MD051": true,
    "MD052": true,
    "MD053": true,
    "MD056": true
  }
}
