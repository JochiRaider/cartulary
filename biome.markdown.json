{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": "."
  },
  "files": {
    "maxSize": 16777216,
    "includes": [
      "*.md",
      "internal/AGENTS.md",
      "tools/AGENTS.md",
      ".agents/skills/**/*.md",
      "docs/*.md",
      "docs/spec/*.md",
      "docs/guides/*.md",
      "docs/handoffs/*-refactor-tracker.md",
      "docs/research/*.md",
      "docs/user_guides/*.md",
      "apps/web/public/assets/fonts/*.md",
      "apps/web/src/**/README.md",
      "!!docs/archive",
      "!!docs/testing-harness-spec-recovery-docs",
      "!!internal/gen",
      "!!packages/protocol-ts/src/generated",
      "!!packages/ui-contracts/src/generated",
      "!!tmp",
      "!!temp",
      "!!.cartulary",
      "!!.cache",
      "!!node_modules",
      "!!.pnpm-store",
      "!!dist",
      "!!build",
      "!!out",
      "!!coverage",
      "!!playwright-report",
      "!!test-results",
      "!!apps/web/dist",
      "!!apps/web/coverage",
      "!!apps/web/playwright-report",
      "!!apps/web/test-results"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "nursery": {
        "useConsistentHeadingLevel": "error",
        "useFencedCodeLanguage": "error"
      }
    }
  },
  "markdown": {
    "parser": {
      "frontmatter": true
    },
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": true
    },
    "analyzeEmbeds": false
  }
}
